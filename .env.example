# Supabase public browser configuration.
# Copy this file to .env.local and fill in values from the Supabase project settings.
# Do not commit real secrets.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase admin key. Required for invited-account setup links.
# Keep this as a Cloudflare Worker secret in production.
SUPABASE_SERVICE_ROLE_KEY=

# Server-side invitation email delivery. Configure in Cloudflare Worker secrets/variables.
WATCHTOWER_EMAIL_PROVIDER=resend
WATCHTOWER_RESEND_API_KEY=
WATCHTOWER_EMAIL_FROM_NAME=Watchtower
WATCHTOWER_EMAIL_FROM_ADDRESS=invitations@watch-tower.co.uk
WATCHTOWER_INVITATION_REPLY_TO=
WATCHTOWER_SITE_URL=https://watch-tower.co.uk
