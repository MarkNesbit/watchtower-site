---
type Props = {
	message?: string;
	redirectTo?: string;
};

const { message = '', redirectTo = '/app' } = Astro.props;
---
<form class="auth-card" data-login-form method="post" action="/login" novalidate>
	<p class="eyebrow">Sign in</p>
	<h1>Log in to WatchTower</h1>
	<input name="redirectTo" type="hidden" value={redirectTo} />
	<label>Login name<input name="loginName" type="text" autocomplete="username" autocapitalize="none" spellcheck="false" required /></label>
	<label>Password<input name="password" type="password" autocomplete="current-password" required minlength="15" maxlength="128" /></label>
	<button class="button button--primary" type="submit">Log in</button>
	<p class="form-message" data-message>{message}</p>
	<p><a href="/forgot-password">Forgot your password?</a> · <a href="/register">Create an account</a></p>
</form>
