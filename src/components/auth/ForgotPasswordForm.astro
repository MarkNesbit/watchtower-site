---
type Props = {
	message?: string;
};

const { message = '' } = Astro.props;
---
<form class="auth-card" data-forgot-form method="post" action="/forgot-password" novalidate>
	<p class="eyebrow">Password reset</p>
	<h1>Reset your password</h1>
	<label>Login name<input name="loginName" type="text" autocomplete="username" autocapitalize="none" spellcheck="false" required /></label>
	<button class="button button--primary" type="submit">Send reset link</button>
	<p class="form-message" data-message>{message}</p>
	<p><a href="/login">Back to login</a></p>
</form>
