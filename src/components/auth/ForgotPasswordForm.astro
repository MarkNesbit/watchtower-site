<form class="auth-card" data-forgot-form>
	<p class="eyebrow">Password reset</p>
	<h1>Reset your password</h1>
	<label>Email<input name="email" type="email" autocomplete="email" required /></label>
	<button class="button button--primary" type="submit">Send reset link</button>
	<p class="form-message" data-message></p>
	<p><a href="/login">Back to login</a></p>
</form>
<script>
	import { recordAuthAuditEvent } from '../../lib/authClient';
	import { supabase } from '../../lib/supabaseClient';
	const form = document.querySelector('[data-forgot-form]');
	const message = form?.querySelector('[data-message]');
	form?.addEventListener('submit', async (event) => {
		event.preventDefault();
		const email = String(new FormData(form).get('email') ?? '');
		if (message) message.textContent = 'Sending reset link…';
		const { error } = await supabase.auth.resetPasswordForEmail(email, { redirectTo: `${window.location.origin}/reset-password` });
		await recordAuthAuditEvent('user.password_reset_requested', { email });
		if (error) {
			if (message) message.textContent = error.message;
			return;
		}
		if (message) message.textContent = 'If an account exists for that email, a reset link has been sent.';
		form.reset();
	});
</script>
