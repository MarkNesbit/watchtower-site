<form class="auth-card" data-reset-form>
	<p class="eyebrow">Choose a new password</p>
	<h1>Update password</h1>
	<label>New password<input name="password" type="password" autocomplete="new-password" required minlength="15" maxlength="128" /></label>
	<button class="button button--primary" type="submit">Update password</button>
	<p class="form-message" data-message></p>
</form>
<script>
	import { recordAuthAuditEvent } from '../../lib/authClient';
	import { getSafeRedirectPath } from '../../lib/redirect';
	import { supabase } from '../../lib/supabaseClient';
	const form = document.querySelector('[data-reset-form]');
	const message = form?.querySelector('[data-message]');
	form?.addEventListener('submit', async (event) => {
		event.preventDefault();
		const password = String(new FormData(form).get('password') ?? '');
		if (message) message.textContent = 'Updating password…';
		const { error } = await supabase.auth.updateUser({ password });
		if (error) {
			if (message) message.textContent = error.message;
			return;
		}
		await recordAuthAuditEvent('user.password_reset_completed');
		const { data } = await supabase.auth.getSession();
		const session = data.session;
		if (session) {
			const cookieOptions = `path=/; SameSite=Lax; max-age=${session.expires_in ?? 3600}`;
			document.cookie = `wt-access-token=${session.access_token}; ${cookieOptions}`;
			document.cookie = `wt-refresh-token=${session.refresh_token}; ${cookieOptions}`;
		}
		const returnTo = getSafeRedirectPath(new URLSearchParams(window.location.search).get('returnTo'));
		if (message) message.textContent = 'Password updated. You can now continue to WatchTower.';
		window.setTimeout(() => window.location.assign(returnTo), 1000);
	});
</script>
