<div class="auth-status" data-auth-status hidden></div>
<script>
	import { supabase } from '../../lib/supabaseClient';

	const status = document.querySelector('[data-auth-status]');
	const protectedShells = document.querySelectorAll('[data-authenticated-shell]');
	const dashboardRefreshTarget = document.querySelector('[data-dashboard-refresh-on-session="true"]');
	const publicAuthPaths = ['/login', '/register'];
	const protectedPrefixes = ['/app'];
	const path = window.location.pathname.replace(/\/$/, '') || '/';
	const accountSwitchCompleted = path === '/login' && new URLSearchParams(window.location.search).get('accountSwitched') === '1';
	const dashboardRefreshKey = `watchtower:dashboard-context-refresh:${window.location.pathname}${window.location.search}`;
	const serverAuthenticated = Boolean(document.querySelector('[data-server-authenticated="true"]'));
	const accountSwitchPrompt = Boolean(document.querySelector('[data-account-switch-prompt]'));

	function clearSessionCookies() {
		document.cookie = 'wt-access-token=; path=/; max-age=0; SameSite=Lax';
		document.cookie = 'wt-refresh-token=; path=/; max-age=0; SameSite=Lax';
		document.cookie = 'wt-login-switch-csrf=; path=/login; max-age=0; SameSite=Lax';
	}

	function clearWatchtowerSessionState() {
		try {
			for (let index = window.sessionStorage.length - 1; index >= 0; index -= 1) {
				const key = window.sessionStorage.key(index);
				if (key?.startsWith('watchtower:dashboard-context-refresh:')) {
					window.sessionStorage.removeItem(key);
				}
			}
		} catch {
			// Ignore storage failures; the server session cookies are the authority.
		}
	}

	function removeAccountSwitchMarker() {
		const url = new URL(window.location.href);
		url.searchParams.delete('accountSwitched');
		window.history.replaceState({}, '', `${url.pathname}${url.search}${url.hash}`);
	}

	function getDashboardRefreshAttempted() {
		try {
			return window.sessionStorage.getItem(dashboardRefreshKey) === '1';
		} catch {
			return false;
		}
	}

	function setDashboardRefreshAttempted() {
		try {
			window.sessionStorage.setItem(dashboardRefreshKey, '1');
		} catch {
			// Ignore storage failures; the reload still lets the server use the recovered cookie.
		}
	}

	function clearDashboardRefreshAttempted() {
		try {
			window.sessionStorage.removeItem(dashboardRefreshKey);
		} catch {
			// Ignore storage failures.
		}
	}

	async function syncAuthState() {
		const { data } = await supabase.auth.getSession();
		const session = data.session;
		const isProtected = protectedPrefixes.some((prefix) => path === prefix || path.startsWith(`${prefix}/`));

		if (accountSwitchCompleted) {
			if (session) {
				await supabase.auth.signOut();
			}
			clearSessionCookies();
			clearWatchtowerSessionState();
			removeAccountSwitchMarker();
			return;
		}

		if (!session && isProtected && !serverAuthenticated) {
			window.location.replace(`/login?redirectTo=${encodeURIComponent(window.location.pathname)}`);
			return;
		}

		if (session) {
			const cookieOptions = `path=/; SameSite=Lax; max-age=${session.expires_in ?? 3600}`;
			document.cookie = `wt-access-token=${session.access_token}; ${cookieOptions}`;
			document.cookie = `wt-refresh-token=${session.refresh_token}; ${cookieOptions}`;
		}

		if (session && publicAuthPaths.includes(path) && !accountSwitchPrompt) {
			window.location.replace('/app');
			return;
		}

		if (session && isProtected && dashboardRefreshTarget) {
			if (!getDashboardRefreshAttempted()) {
				setDashboardRefreshAttempted();
				window.location.reload();
				return;
			}
		} else {
			clearDashboardRefreshAttempted();
		}

		if (isProtected) {
			protectedShells.forEach((shell) => shell.removeAttribute('hidden'));
		}

		if (status) {
			status.toggleAttribute('hidden', true);
		}
	}

	supabase.auth.onAuthStateChange((event, session) => {
		if (event === 'SIGNED_OUT' && protectedPrefixes.some((prefix) => path === prefix || path.startsWith(`${prefix}/`))) {
			window.location.replace('/login');
		}
	});

	syncAuthState();
</script>
