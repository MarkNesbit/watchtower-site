---
type Props = {
	tone?: 'blue' | 'green' | 'amber' | 'red' | 'neutral' | 'unknown' | 'risk-low' | 'risk-medium' | 'risk-high' | 'risk-critical';
	label: string;
	statusLabel?: string;
	ariaLabel?: string;
	title?: string;
	compactActionState?: boolean;
};

const {
	tone = 'neutral',
	label,
	statusLabel = '',
	ariaLabel = '',
	title = '',
	compactActionState = false,
} = Astro.props;
const compactStateLabels: Record<string, string> = { Red: 'R', Amber: 'A', Green: 'G' };
const visibleStatusLabel = compactActionState
	? compactStateLabels[statusLabel] ?? statusLabel
	: statusLabel;
---

<span class={`rag-reference-pill rag-reference-pill--${tone} rag-pill rag-pill--${tone}`} aria-label={ariaLabel || undefined} title={title || undefined}>
	<span>{label}</span>
	{visibleStatusLabel && <span class="rag-reference-pill__status rag-pill__status">{visibleStatusLabel}</span>}
</span>
