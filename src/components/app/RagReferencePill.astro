---
type Props = {
	tone?: 'blue' | 'green' | 'amber' | 'red' | 'neutral' | 'unknown' | 'risk-low' | 'risk-medium' | 'risk-high' | 'risk-critical';
	label: string;
	statusLabel?: string;
	ariaLabel?: string;
};

const { tone = 'neutral', label, statusLabel = '', ariaLabel = '' } = Astro.props;
---

<span class={`rag-reference-pill rag-reference-pill--${tone} rag-pill rag-pill--${tone}`} aria-label={ariaLabel || undefined}>
	<span>{label}</span>
	{statusLabel && <span class="rag-reference-pill__status rag-pill__status">{statusLabel}</span>}
</span>
