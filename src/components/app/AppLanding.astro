---
import { loadAuthenticatedDashboardContext } from '../../lib/authenticatedDashboard';
import { createSupabaseServerClient, getServerAccessToken } from '../../lib/supabaseServer';

const accessToken = getServerAccessToken(Astro.cookies);
let dashboardContext = {
	personName: 'Signed-in user',
	workspaceName: 'Workspace unavailable',
	personFallbackUsed: true,
	workspaceFallbackUsed: true,
};

if (accessToken) {
	const serverSupabase = createSupabaseServerClient(accessToken);
	dashboardContext = await loadAuthenticatedDashboardContext(serverSupabase, accessToken);
}
const needsDashboardSessionRefresh = !accessToken || (dashboardContext.personFallbackUsed && dashboardContext.workspaceFallbackUsed);
---
<section
	class="section light-section"
	data-app-landing
	data-dashboard-refresh-on-session={needsDashboardSessionRefresh ? 'true' : undefined}
>
	<div class="content-card">
		<p class="eyebrow">Authenticated area</p>
		<h1>Welcome to WatchTower</h1>
		<p data-signed-in-person>Signed in as {dashboardContext.personName}</p>
		<p data-current-workspace>Workspace: {dashboardContext.workspaceName}</p>
	</div>
</section>
