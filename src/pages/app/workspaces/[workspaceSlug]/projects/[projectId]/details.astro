---
import AuthenticatedLayout from '../../../../../../layouts/AuthenticatedLayout.astro';
import DisabledActionHint from '../../../../../../components/app/DisabledActionHint.astro';
import ProjectContentPanel from '../../../../../../components/app/ProjectContentPanel.astro';
import ProjectControlPanel from '../../../../../../components/app/ProjectControlPanel.astro';
import ProjectPageHero from '../../../../../../components/app/ProjectPageHero.astro';
import RagReferencePill from '../../../../../../components/app/RagReferencePill.astro';
import { deriveProjectDetailsAreaSignal, deriveProjectDetailsSectionSignals } from '../../../../../../lib/dashboardTileSignals';
import {
	PROJECT_DATE_TYPES,
	buildProjectDateCards,
	canChangeProjectDates,
	canCommentOnProjectDates,
	createProjectDateComment,
	listProjectDates,
	projectDateTypeLabel,
	saveProjectDate,
} from '../../../../../../lib/projectDates';
import {
	PROJECT_PEOPLE_ROLES,
	listProjectPeople,
	listProjectPersonOptions,
	projectPeopleRoleLabel,
	saveProjectPersonForRole,
} from '../../../../../../lib/projectPeople';
import { can } from '../../../../../../lib/permissions';
import {
	DELIVERY_METHODS,
	PROJECT_CRITICALITIES,
	PROJECT_PRIORITIES,
	PROJECT_STATUSES,
	PROJECT_TYPES,
	REVIEW_CADENCES,
	buildProjectPath,
	getWorkspaceBySlug,
	projectFieldLabel,
	updateProjectCore,
	updateProjectInformation,
} from '../../../../../../lib/projects';
import { createSupabaseServerClient, getServerAccessToken } from '../../../../../../lib/supabaseServer';

const projectSlug = Astro.params.projectId;
const workspaceSlug = Astro.params.workspaceSlug;
const accessToken = getServerAccessToken(Astro.cookies);
let project = null;
let workspaceName = '';
let workspaceRole = '';
let message = '';
let saveMessage = '';
let creatorDisplayName = '';
let peopleLoadError = '';
let datesLoadError = '';
let assignments = [];
let personOptions = [];
let projectDateCards = [];
let canEditProjectDates = false;
let canCommentProjectDates = false;

const formatValue = (value, fallback = 'Not available') => value || fallback;
const formatStatusLabel = (value) => value ? value.charAt(0).toUpperCase() + value.slice(1) : 'Unknown';
const formatDateTime = (value, fallback = 'Not available') => value
	? `${new Intl.DateTimeFormat('en-GB', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'UTC' }).format(new Date(value))} UTC`
	: fallback;
const formatDate = (value, fallback = 'Not set') => value
	? new Intl.DateTimeFormat('en-GB', { dateStyle: 'medium', timeZone: 'UTC' }).format(new Date(`${value}T00:00:00Z`))
	: fallback;
const healthTone = (value) => {
	const health = value?.toLowerCase();
	if (health === 'green') return 'green';
	if (health === 'amber') return 'amber';
	if (health === 'red') return 'red';
	return 'unknown';
};
const assignmentName = (assignment) => {
	if (assignment.demo_person_id) return assignment.demoPerson?.display_name || 'Demo persona';
	return assignment.profile?.display_name || assignment.profile?.email || 'Workspace member';
};
const assignmentMeta = (assignment) => {
	if (assignment.demo_person_id) {
		const role = assignment.demoPerson?.workspace_role ? formatStatusLabel(assignment.demoPerson.workspace_role) : 'Demo persona';
		const projectRole = assignment.demoPerson?.project_role ? ` / ${projectPeopleRoleLabel(assignment.demoPerson.project_role)}` : '';
		return `${role}${projectRole}`;
	}
	return assignment.profile?.email || 'Real workspace member';
};
const optionLabel = (option) => {
	const role = option.workspaceRole ? formatStatusLabel(option.workspaceRole) : 'Workspace member';
	const projectRole = option.projectRole ? ` / ${projectPeopleRoleLabel(option.projectRole)}` : '';
	return `${option.displayName} - ${role}${projectRole}`;
};
const DEFAULT_PROJECT_PEOPLE_ROLES = [
	'sponsor',
	'project_manager',
	'delivery_lead',
	'product_owner',
	'assurance_lead',
	'default_risk_owner',
];
const GOVERNANCE_ROUTE_GUIDANCE = 'Define how this project is reviewed, governed and approved, including the forum, meeting or authority used for decisions.';
const ESCALATION_ROUTE_GUIDANCE = 'Define where delivery concerns, risks, blockers or decisions should be escalated, including the key role, team or governance forum.';

try {
	const serverSupabase = createSupabaseServerClient(accessToken);
	const workspace = await getWorkspaceBySlug(serverSupabase, workspaceSlug ?? '', accessToken);
	const organisation = Array.isArray(workspace?.organisations) ? workspace?.organisations[0] : workspace?.organisations;

	if (!workspace || !organisation) {
		message = 'Project not found or you do not have access.';
		Astro.response.status = 404;
	} else if (!can(workspace.role, 'project.view')) {
		message = 'Your workspace role does not permit project access.';
		Astro.response.status = 403;
	} else {
		workspaceName = organisation.name;
		workspaceRole = workspace.role;

		if (Astro.request.method === 'POST') {
			const formData = await Astro.request.formData();
			const intentValues = formData.getAll('intent');
			const intent = String(intentValues.at(-1) ?? '');
			try {
				if (intent === 'update-project-identity') {
					await updateProjectCore(workspaceSlug ?? '', projectSlug ?? '', {
						name: String(formData.get('name') ?? ''),
						status: String(formData.get('status') ?? 'proposed'),
					}, serverSupabase, accessToken);
					saveMessage = 'Project identity saved.';
				} else if (intent === 'update-project-description') {
					await updateProjectCore(workspaceSlug ?? '', projectSlug ?? '', {
						name: String(formData.get('name') ?? ''),
						description: String(formData.get('description') ?? ''),
						status: String(formData.get('status') ?? 'proposed'),
					}, serverSupabase, accessToken);
					saveMessage = 'Project description saved.';
				} else if (intent === 'update-project-context') {
					await updateProjectInformation(workspaceSlug ?? '', projectSlug ?? '', {
						projectType: String(formData.get('project_type') ?? ''),
						deliveryMethod: String(formData.get('delivery_method') ?? ''),
						priority: String(formData.get('priority') ?? ''),
						criticality: String(formData.get('criticality') ?? ''),
					}, serverSupabase, accessToken);
					saveMessage = 'Project context saved.';
				} else if (intent === 'update-project-governance') {
					await updateProjectInformation(workspaceSlug ?? '', projectSlug ?? '', {
						reviewCadence: String(formData.get('review_cadence') ?? ''),
						governanceRoute: String(formData.get('governance_route') ?? ''),
						escalationRoute: String(formData.get('escalation_route') ?? ''),
					}, serverSupabase, accessToken);
					saveMessage = 'Governance and escalation saved.';
				} else if (intent === 'save-project-date') {
					await saveProjectDate(workspaceSlug ?? '', projectSlug ?? '', {
						projectDateId: String(formData.get('project_date_id') ?? ''),
						dateType: String(formData.get('date_type') ?? ''),
						customLabel: String(formData.get('custom_label') ?? ''),
						targetDate: String(formData.get('target_date') ?? ''),
						comment: String(formData.get('comment') ?? ''),
					}, serverSupabase, accessToken);
					saveMessage = 'Project date saved.';
				} else if (intent === 'remove-project-date') {
					await saveProjectDate(workspaceSlug ?? '', projectSlug ?? '', {
						projectDateId: String(formData.get('project_date_id') ?? ''),
						remove: true,
					}, serverSupabase, accessToken);
					saveMessage = 'Project date removed.';
				} else if (intent === 'add-project-date-comment') {
					await createProjectDateComment(
						workspaceSlug ?? '',
						projectSlug ?? '',
						String(formData.get('project_date_id') ?? ''),
						String(formData.get('comment') ?? ''),
						serverSupabase,
						accessToken,
					);
					saveMessage = 'Project date comment added.';
				} else if (intent === 'save-project-person' || intent === 'add-project-person') {
					await saveProjectPersonForRole(workspaceSlug ?? '', projectSlug ?? '', {
						projectRole: String(formData.get('project_role') ?? ''),
						personSelection: String(formData.get('person_selection') ?? ''),
						responsibility: String(formData.get('responsibility') ?? ''),
					}, serverSupabase, accessToken);
					saveMessage = 'Project responsibility saved.';
				} else if (intent === 'remove-project-person') {
					await saveProjectPersonForRole(workspaceSlug ?? '', projectSlug ?? '', {
						projectRole: String(formData.get('project_role') ?? ''),
						personSelection: '',
						responsibility: '',
					}, serverSupabase, accessToken);
					saveMessage = 'Project responsibility removed.';
				}
			} catch (error) {
				saveMessage = error instanceof Error ? error.message : 'Unable to save project details.';
			}
		}

		const { data, error } = await serverSupabase
			.from('projects')
			.select('id, organisation_id, name, project_ref, description, slug, status, health, project_type, delivery_method, priority, criticality, start_date, target_end_date, next_review_date, review_cadence, governance_route, escalation_route, created_at, updated_at, created_by')
			.eq('slug', projectSlug)
			.eq('organisation_id', organisation.id)
			.is('deleted_at', null)
			.is('archived_at', null)
			.maybeSingle();
		if (error) throw error;
		project = data;
		if (!project) {
			message = 'Project not found or you do not have access.';
			Astro.response.status = 404;
		} else {
			if (project.created_by) {
				const { data: creator, error: creatorError } = await serverSupabase
					.from('profiles')
					.select('display_name, email')
					.eq('id', project.created_by)
					.maybeSingle();
				if (!creatorError && creator) creatorDisplayName = creator.display_name || creator.email || '';
			}

			try {
				assignments = await listProjectPeople(organisation.id, project.id, workspace.role, serverSupabase);
			} catch (error) {
				assignments = [];
				peopleLoadError = error instanceof Error ? error.message : 'Unable to load project responsibilities.';
			}

			try {
				const projectDates = await listProjectDates(organisation.id, project.id, workspace.role, serverSupabase);
				projectDateCards = buildProjectDateCards(projectDates, project);
			} catch (error) {
				projectDateCards = buildProjectDateCards([], project);
				datesLoadError = error instanceof Error ? error.message : 'Unable to load project dates.';
			}

			try {
				canEditProjectDates = await canChangeProjectDates(workspace, organisation.id, project.id, serverSupabase, accessToken);
				canCommentProjectDates = await canCommentOnProjectDates(workspace, organisation.id, project.id, serverSupabase, accessToken);
			} catch {
				canEditProjectDates = false;
				canCommentProjectDates = false;
			}

			if (can(workspace.role, 'project.editDetails')) {
				try {
					personOptions = await listProjectPersonOptions(organisation.id, workspace.role, serverSupabase);
				} catch {
					personOptions = [];
				}
			}
		}
	}
} catch (error) {
	message = error instanceof Error ? error.message : 'Unable to load project details.';
	Astro.response.status = 500;
}

const canEditProject = can(workspaceRole, 'project.editDetails');
const assignmentsByRole = new Map(assignments.map((assignment) => [assignment.project_role, assignment]));
const projectDetailsSectionSignals = deriveProjectDetailsSectionSignals(project, projectDateCards, peopleLoadError ? null : assignments);
const projectDetailsSignal = deriveProjectDetailsAreaSignal(project, projectDateCards, peopleLoadError ? null : assignments);
const projectDetailsAttentionReasons = projectDetailsSignal.reasons.filter((reason) => reason.state === 'red' || reason.state === 'amber');
const projectDetailsAttentionSections = projectDetailsSectionSignals
	.map((signal) => ({
		...signal,
		redReasons: signal.reasons.filter((reason) => reason.state === 'red'),
		amberReasons: signal.reasons.filter((reason) => reason.state === 'amber'),
	}))
	.filter((signal) => signal.redReasons.length > 0 || signal.amberReasons.length > 0);
const projectSectionSignal = (section) => projectDetailsSectionSignals.find((signal) => signal.section === section) ?? {
	section,
	state: 'unknown',
	label: 'Project section',
	anchor: '',
	reasons: [{ state: 'unknown', message: 'This section could not be assessed safely.' }],
};
const identitySignal = projectSectionSignal('project_identity');
const descriptionSignal = projectSectionSignal('project_description');
const contextSignal = projectSectionSignal('project_context');
const datesSignal = projectSectionSignal('project_dates');
const governanceSignal = projectSectionSignal('governance_escalation');
const peopleSignal = projectSectionSignal('project_roles_responsibilities');
const metadataSignal = projectSectionSignal('system_metadata');
const projectRoleCards = [
	...DEFAULT_PROJECT_PEOPLE_ROLES,
	...PROJECT_PEOPLE_ROLES.filter((role) => !DEFAULT_PROJECT_PEOPLE_ROLES.includes(role) && assignmentsByRole.has(role)),
];
const realPersonOptions = personOptions.filter((option) => option.source === 'user');
const demoPersonOptions = personOptions.filter((option) => option.source === 'demo');
const projectContextFields = [
	{ label: 'Project type', value: projectFieldLabel(project?.project_type) },
	{ label: 'Delivery method', value: projectFieldLabel(project?.delivery_method) },
	{ label: 'Priority', value: projectFieldLabel(project?.priority) },
	{ label: 'Criticality', value: projectFieldLabel(project?.criticality) },
];
const governanceFields = [
	{ label: 'Review cadence', value: projectFieldLabel(project?.review_cadence), guidance: '' },
	{ label: 'Governance route', value: project?.governance_route || GOVERNANCE_ROUTE_GUIDANCE, guidance: !project?.governance_route },
	{ label: 'Escalation route', value: project?.escalation_route || ESCALATION_ROUTE_GUIDANCE, guidance: !project?.escalation_route },
];
---
<AuthenticatedLayout title={project ? `${project.name} details | WatchTower` : 'Project Details | WatchTower'}>
	<section class="project-details-page" data-project-details>
		{project ? (
			<>
				<ProjectPageHero
					workspaceName={workspaceName}
					projectName={project.name}
					projectRef={project.project_ref}
					title="Project Details"
					description="Project setup, context, responsibilities and read-only system information."
					headingId="project-details-heading"
				/>

				<nav class="project-details-top-links" aria-label="Project navigation">
					<a class="button button--secondary" href={buildProjectPath(workspaceSlug ?? '', project.slug)}>Back to project dashboard</a>
				</nav>

				<ProjectControlPanel title="Editing access" status={canEditProject ? 'Editable' : 'Read-only'} headingId="project-details-access-heading">
					<p class="project-details-readonly" data-project-details-permission>
						{canEditProject
							? 'You can maintain permitted project detail fields for this workspace role.'
							: 'You can view these project details, but you do not have permission to edit them.'}
					</p>
					{saveMessage && <p class="form-message" data-project-details-save-message>{saveMessage}</p>}
				</ProjectControlPanel>

				{projectDetailsAttentionReasons.length > 0 && (
					<section
						class={`project-details-attention rag-panel rag-panel--${projectDetailsSignal.state}`}
						aria-labelledby="project-details-attention-heading"
						data-project-details-attention
					>
						<div class="project-details-attention__header">
							<div>
								<h2 id="project-details-attention-heading">Attention</h2>
							</div>
							<RagReferencePill tone={projectDetailsSignal.state} label={formatStatusLabel(projectDetailsSignal.state)} statusLabel="Project Details" />
						</div>
						<div class="project-details-attention__groups">
							{projectDetailsAttentionSections.map((section) => (
								<div class="project-details-attention__group">
									<h3>{section.label}</h3>
									{section.redReasons.length > 0 && (
										<>
											<p class="project-details-attention__level">Red attention</p>
											<ul>
												{section.redReasons.map((reason) => (
													<li>
														<span>{reason.message}</span>
														{reason.target && <a href={reason.target}>{reason.actionLabel ?? 'Review'}</a>}
													</li>
												))}
											</ul>
										</>
									)}
									{section.amberReasons.length > 0 && (
										<>
											<p class="project-details-attention__level">Amber attention</p>
											<ul>
												{section.amberReasons.map((reason) => (
													<li>
														<span>{reason.message}</span>
														{reason.target && <a href={reason.target}>{reason.actionLabel ?? 'Review'}</a>}
													</li>
												))}
											</ul>
										</>
									)}
								</div>
							))}
						</div>
					</section>
				)}

				<ProjectContentPanel
					title="Project identity"
					helper="Project reference, workspace, internal ID and health are read-only."
					headingId="project-identity-heading"
				>
					<div slot="action">
						<div class="project-section-marker" data-project-section-marker="project_identity" data-section-state={identitySignal.state}>
							<RagReferencePill tone={identitySignal.state} label={formatStatusLabel(identitySignal.state)} statusLabel="Section" ariaLabel={`${identitySignal.label}: ${formatStatusLabel(identitySignal.state)}, ${identitySignal.reasons.map((reason) => reason.message).join(' ')}`} />
						</div>
						{canEditProject ? (
							<button class="button button--secondary project-details-edit-action" type="button" data-project-dialog-open="project-identity-dialog">Edit identity</button>
						) : (
							<DisabledActionHint
								id="project-identity-edit-hint"
								allowed={false}
								allowedText=""
								disabledText="Identity editing is unavailable for your current role."
							/>
						)}
					</div>
					<dl class="details-grid">
						<div><dt>Project name</dt><dd>{formatValue(project.name)}</dd></div>
						<div><dt>Project reference</dt><dd>{formatValue(project.project_ref)}</dd></div>
						<div><dt>Workspace</dt><dd>{workspaceName}</dd></div>
						<div><dt>Project status</dt><dd>{formatStatusLabel(project.status)}</dd></div>
						<div>
							<dt>Project health</dt>
							<dd>
								<RagReferencePill
									tone={healthTone(project.health)}
									label={formatStatusLabel(formatValue(project.health, 'Not assessed'))}
								/>
							</dd>
						</div>
						<div><dt>Project slug</dt><dd>{formatValue(project.slug)}</dd></div>
						<div><dt>Internal project ID</dt><dd class="mono-value">{project.id}</dd></div>
					</dl>
				</ProjectContentPanel>

				<ProjectContentPanel
					title="Project description"
					helper="The short project description remains separate from RAID records and Project Narrative."
					headingId="project-description-heading"
				>
					<div slot="action">
						<div class="project-section-marker" data-project-section-marker="project_description" data-section-state={descriptionSignal.state}>
							<RagReferencePill tone={descriptionSignal.state} label={formatStatusLabel(descriptionSignal.state)} statusLabel="Section" ariaLabel={`${descriptionSignal.label}: ${formatStatusLabel(descriptionSignal.state)}, ${descriptionSignal.reasons.map((reason) => reason.message).join(' ')}`} />
						</div>
						{canEditProject ? (
							<button class="button button--secondary project-details-edit-action" type="button" data-project-dialog-open="project-description-dialog">Edit description</button>
						) : (
							<DisabledActionHint
								id="project-description-edit-hint"
								allowed={false}
								allowedText=""
								disabledText="Description editing is unavailable for your current role."
							/>
						)}
					</div>
					<dl class="details-grid details-grid--single">
						<div><dt>Description</dt><dd>{formatValue(project.description)}</dd></div>
					</dl>
				</ProjectContentPanel>

				<ProjectContentPanel
					title="Project context"
					helper="These fields describe setup context and do not replace structured RAID records."
					headingId="project-context-heading"
				>
					<div slot="action">
						<div class="project-section-marker" data-project-section-marker="project_context" data-section-state={contextSignal.state}>
							<RagReferencePill tone={contextSignal.state} label={formatStatusLabel(contextSignal.state)} statusLabel="Section" ariaLabel={`${contextSignal.label}: ${formatStatusLabel(contextSignal.state)}, ${contextSignal.reasons.map((reason) => reason.message).join(' ')}`} />
						</div>
						{canEditProject ? (
							<button class="button button--secondary project-details-edit-action" type="button" data-project-dialog-open="project-context-dialog">Edit context</button>
						) : (
							<DisabledActionHint
								id="project-context-edit-hint"
								allowed={false}
								allowedText=""
								disabledText="Project context editing is unavailable for your current role."
							/>
						)}
					</div>
					<dl class="details-grid" data-project-context-fields>
						{projectContextFields.map((field) => (
							<div>
								<dt>{field.label}</dt>
								<dd>{field.value}</dd>
							</div>
						))}
					</dl>
				</ProjectContentPanel>

				<ProjectContentPanel
					title="Project dates"
					helper="Timeline-ready setup dates show missing, approaching and overdue states without becoming RAID records."
					headingId="project-dates-heading"
				>
					<div slot="action">
						<div class="project-section-marker" data-project-section-marker="project_dates" data-section-state={datesSignal.state}>
							<RagReferencePill tone={datesSignal.state} label={formatStatusLabel(datesSignal.state)} statusLabel="Section" ariaLabel={`${datesSignal.label}: ${formatStatusLabel(datesSignal.state)}, ${datesSignal.reasons.map((reason) => reason.message).join(' ')}`} />
						</div>
						{canEditProjectDates ? (
							<button class="button button--primary project-details-edit-action" type="button" data-project-dialog-open="project-date-add-dialog">Add new date</button>
						) : (
							<DisabledActionHint
								id="project-date-add-hint"
								allowed={false}
								allowedText=""
								disabledText="Project date changes are unavailable for your current role."
							/>
						)}
					</div>
					{datesLoadError && <p class="form-message">{datesLoadError}</p>}
					<div class="project-date-grid" data-project-dates-section>
						{projectDateCards.map((card, index) => {
							const dialogId = `project-date-dialog-${index}`;
							return (
								<>
									<button
										class={`project-date-card project-date-card--${card.status.tone} rag-card rag-card--${card.status.tone}`}
										type="button"
										data-project-dialog-open={dialogId}
										aria-label={`Open ${card.label} project date details, ${card.status.text}`}
									>
										<span class="project-date-card__label">{card.label}</span>
										<span class="project-date-card__value">{formatDate(card.targetDate)}</span>
										<RagReferencePill tone={card.status.tone} label={card.status.text} />
										<span class="project-date-card__meta">
											{card.commentCount > 0 ? `${card.commentCount} comment${card.commentCount === 1 ? '' : 's'}` : 'No comments'}
										</span>
									</button>
									<dialog class="project-details-dialog" id={dialogId} aria-labelledby={`${dialogId}-title`} data-project-details-dialog>
										<div class="project-details-dialog__header">
											<div>
												<h3 id={`${dialogId}-title`}>{card.label}</h3>
												<p>{card.status.text}</p>
											</div>
											<form method="dialog">
												<button class="button button--secondary project-details-dialog__close" type="submit" aria-label="Close">Close</button>
											</form>
										</div>
										{canEditProjectDates ? (
											<form class="project-details-modal-form" method="post" data-project-date-modal>
												<input type="hidden" name="intent" value="save-project-date" />
												<input type="hidden" name="project_date_id" value={card.id ?? ''} />
												{card.isDefault ? (
													<>
														<input type="hidden" name="date_type" value={card.dateType} />
														<dl class="project-details-modal-readonly">
															<div><dt>Date type</dt><dd>{projectDateTypeLabel(card.dateType)}</dd></div>
															<div><dt>Warning period</dt><dd>{card.warningDays} days</dd></div>
														</dl>
													</>
												) : (
													<label>
														<span>Date type</span>
														<select name="date_type" required data-project-date-type-select>
															{PROJECT_DATE_TYPES.map((type) => (
																<option value={type} selected={type === card.dateType}>{projectDateTypeLabel(type)}</option>
															))}
														</select>
													</label>
												)}
												{!card.isDefault && (
													<label class="project-date-custom-label">
														<span>Custom label</span>
														<input name="custom_label" value={card.customLabel ?? ''} maxlength="120" data-project-date-custom-label />
													</label>
												)}
												<label>
													<span>Target date</span>
													<span class="project-date-input-row">
