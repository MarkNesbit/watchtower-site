---
import AuthenticatedLayout from '../../../../../../layouts/AuthenticatedLayout.astro';
import DisabledActionHint from '../../../../../../components/app/DisabledActionHint.astro';
import ProjectContentPanel from '../../../../../../components/app/ProjectContentPanel.astro';
import ProjectControlPanel from '../../../../../../components/app/ProjectControlPanel.astro';
import ProjectPageHero from '../../../../../../components/app/ProjectPageHero.astro';
import RagReferencePill from '../../../../../../components/app/RagReferencePill.astro';
import {
	PROJECT_PEOPLE_ROLES,
	listProjectPeople,
	listProjectPersonOptions,
	projectPeopleRoleLabel,
	saveProjectPersonForRole,
} from '../../../../../../lib/projectPeople';
import { can } from '../../../../../../lib/permissions';
import {
	DELIVERY_METHODS,
	PROJECT_CRITICALITIES,
	PROJECT_PRIORITIES,
	PROJECT_STATUSES,
	PROJECT_TYPES,
	REVIEW_CADENCES,
	buildProjectPath,
	getWorkspaceBySlug,
	projectFieldLabel,
	updateProjectCore,
	updateProjectInformation,
} from '../../../../../../lib/projects';
import { createSupabaseServerClient, getServerAccessToken } from '../../../../../../lib/supabaseServer';

const projectSlug = Astro.params.projectId;
const workspaceSlug = Astro.params.workspaceSlug;
const accessToken = getServerAccessToken(Astro.cookies);
let project = null;
let workspaceName = '';
let workspaceRole = '';
let message = '';
let saveMessage = '';
let creatorDisplayName = '';
let peopleLoadError = '';
let assignments = [];
let personOptions = [];

const formatValue = (value, fallback = 'Not available') => value || fallback;
const formatStatusLabel = (value) => value ? value.charAt(0).toUpperCase() + value.slice(1) : 'Unknown';
const formatDateTime = (value, fallback = 'Not available') => value
	? `${new Intl.DateTimeFormat('en-GB', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'UTC' }).format(new Date(value))} UTC`
	: fallback;
const formatDate = (value, fallback = 'Not set') => value
	? new Intl.DateTimeFormat('en-GB', { dateStyle: 'medium', timeZone: 'UTC' }).format(new Date(`${value}T00:00:00Z`))
	: fallback;
const healthTone = (value) => {
	const health = value?.toLowerCase();
	if (health === 'green') return 'green';
	if (health === 'amber') return 'amber';
	if (health === 'red') return 'red';
	return 'blue';
};
const assignmentName = (assignment) => {
	if (assignment.demo_person_id) return assignment.demoPerson?.display_name || 'Demo persona';
	return assignment.profile?.display_name || assignment.profile?.email || 'Workspace member';
};
const assignmentMeta = (assignment) => {
	if (assignment.demo_person_id) {
		const role = assignment.demoPerson?.workspace_role ? formatStatusLabel(assignment.demoPerson.workspace_role) : 'Demo persona';
		const projectRole = assignment.demoPerson?.project_role ? ` / ${projectPeopleRoleLabel(assignment.demoPerson.project_role)}` : '';
		return `${role}${projectRole}`;
	}
	return assignment.profile?.email || 'Real workspace member';
};
const optionLabel = (option) => {
	const role = option.workspaceRole ? formatStatusLabel(option.workspaceRole) : 'Workspace member';
	const projectRole = option.projectRole ? ` / ${projectPeopleRoleLabel(option.projectRole)}` : '';
	return `${option.displayName} - ${role}${projectRole}`;
};
const DEFAULT_PROJECT_PEOPLE_ROLES = [
	'sponsor',
	'project_manager',
	'delivery_lead',
	'product_owner',
	'assurance_lead',
	'default_risk_owner',
];

try {
	const serverSupabase = createSupabaseServerClient(accessToken);
	const workspace = await getWorkspaceBySlug(serverSupabase, workspaceSlug ?? '', accessToken);
	const organisation = Array.isArray(workspace?.organisations) ? workspace?.organisations[0] : workspace?.organisations;

	if (!workspace || !organisation) {
		message = 'Project not found or you do not have access.';
		Astro.response.status = 404;
	} else if (!can(workspace.role, 'project.view')) {
		message = 'Your workspace role does not permit project access.';
		Astro.response.status = 403;
	} else {
		workspaceName = organisation.name;
		workspaceRole = workspace.role;

		if (Astro.request.method === 'POST') {
			const formData = await Astro.request.formData();
			const intent = String(formData.get('intent') ?? '');
			try {
				if (intent === 'update-project-identity') {
					await updateProjectCore(workspaceSlug ?? '', projectSlug ?? '', {
						name: String(formData.get('name') ?? ''),
						status: String(formData.get('status') ?? 'proposed'),
					}, serverSupabase, accessToken);
					saveMessage = 'Project identity saved.';
				} else if (intent === 'update-project-description') {
					await updateProjectCore(workspaceSlug ?? '', projectSlug ?? '', {
						name: String(formData.get('name') ?? ''),
						description: String(formData.get('description') ?? ''),
						status: String(formData.get('status') ?? 'proposed'),
					}, serverSupabase, accessToken);
					saveMessage = 'Project description saved.';
				} else if (intent === 'update-project-context') {
					await updateProjectInformation(workspaceSlug ?? '', projectSlug ?? '', {
						projectType: String(formData.get('project_type') ?? ''),
						deliveryMethod: String(formData.get('delivery_method') ?? ''),
						priority: String(formData.get('priority') ?? ''),
						criticality: String(formData.get('criticality') ?? ''),
					}, serverSupabase, accessToken);
					saveMessage = 'Project context saved.';
				} else if (intent === 'update-project-governance') {
					await updateProjectInformation(workspaceSlug ?? '', projectSlug ?? '', {
						startDate: String(formData.get('start_date') ?? ''),
						targetEndDate: String(formData.get('target_end_date') ?? ''),
						nextReviewDate: String(formData.get('next_review_date') ?? ''),
						reviewCadence: String(formData.get('review_cadence') ?? ''),
						governanceRoute: String(formData.get('governance_route') ?? ''),
						escalationRoute: String(formData.get('escalation_route') ?? ''),
					}, serverSupabase, accessToken);
					saveMessage = 'Dates and governance saved.';
				} else if (intent === 'save-project-person' || intent === 'add-project-person') {
					await saveProjectPersonForRole(workspaceSlug ?? '', projectSlug ?? '', {
						projectRole: String(formData.get('project_role') ?? ''),
						personSelection: String(formData.get('person_selection') ?? ''),
						responsibility: String(formData.get('responsibility') ?? ''),
					}, serverSupabase, accessToken);
					saveMessage = 'Project responsibility saved.';
				} else if (intent === 'remove-project-person') {
					await saveProjectPersonForRole(workspaceSlug ?? '', projectSlug ?? '', {
						projectRole: String(formData.get('project_role') ?? ''),
						personSelection: '',
						responsibility: '',
					}, serverSupabase, accessToken);
					saveMessage = 'Project responsibility removed.';
				}
			} catch (error) {
				saveMessage = error instanceof Error ? error.message : 'Unable to save project details.';
			}
		}

		const { data, error } = await serverSupabase
			.from('projects')
			.select('id, organisation_id, name, project_ref, description, slug, status, health, project_type, delivery_method, priority, criticality, start_date, target_end_date, next_review_date, review_cadence, governance_route, escalation_route, created_at, updated_at, created_by')
			.eq('slug', projectSlug)
			.eq('organisation_id', organisation.id)
			.is('deleted_at', null)
			.is('archived_at', null)
			.maybeSingle();
		if (error) throw error;
		project = data;
		if (!project) {
			message = 'Project not found or you do not have access.';
			Astro.response.status = 404;
		} else {
			if (project.created_by) {
				const { data: creator, error: creatorError } = await serverSupabase
					.from('profiles')
					.select('display_name, email')
					.eq('id', project.created_by)
					.maybeSingle();
				if (!creatorError && creator) creatorDisplayName = creator.display_name || creator.email || '';
			}

			try {
				assignments = await listProjectPeople(organisation.id, project.id, workspace.role, serverSupabase);
			} catch (error) {
				assignments = [];
				peopleLoadError = error instanceof Error ? error.message : 'Unable to load project responsibilities.';
			}

			if (can(workspace.role, 'project.editDetails')) {
				try {
					personOptions = await listProjectPersonOptions(organisation.id, workspace.role, serverSupabase);
				} catch {
					personOptions = [];
				}
			}
		}
	}
} catch (error) {
	message = error instanceof Error ? error.message : 'Unable to load project details.';
	Astro.response.status = 500;
}

const canEditProject = can(workspaceRole, 'project.editDetails');
const assignmentsByRole = new Map(assignments.map((assignment) => [assignment.project_role, assignment]));
const projectRoleCards = [
	...DEFAULT_PROJECT_PEOPLE_ROLES,
	...PROJECT_PEOPLE_ROLES.filter((role) => !DEFAULT_PROJECT_PEOPLE_ROLES.includes(role) && assignmentsByRole.has(role)),
];
const realPersonOptions = personOptions.filter((option) => option.source === 'user');
const demoPersonOptions = personOptions.filter((option) => option.source === 'demo');
const projectContextFields = [
	{ label: 'Project type', value: projectFieldLabel(project?.project_type) },
	{ label: 'Delivery method', value: projectFieldLabel(project?.delivery_method) },
	{ label: 'Priority', value: projectFieldLabel(project?.priority) },
	{ label: 'Criticality', value: projectFieldLabel(project?.criticality) },
];
const governanceFields = [
	{ label: 'Start date', value: formatDate(project?.start_date) },
	{ label: 'Target end date', value: formatDate(project?.target_end_date) },
	{ label: 'Next review date', value: formatDate(project?.next_review_date) },
	{ label: 'Review cadence', value: projectFieldLabel(project?.review_cadence) },
	{ label: 'Governance route', value: formatValue(project?.governance_route, 'Not set') },
	{ label: 'Escalation route', value: formatValue(project?.escalation_route, 'Not set') },
];
---
<AuthenticatedLayout title={project ? `${project.name} details | WatchTower` : 'Project Details | WatchTower'}>
	<section class="project-details-page" data-project-details>
		{project ? (
			<>
				<ProjectPageHero
					workspaceName={workspaceName}
					projectName={project.name}
					projectRef={project.project_ref}
					title="Project Details"
					description="Project setup, context, responsibilities and read-only system information."
					headingId="project-details-heading"
				/>

				<nav class="project-details-top-links" aria-label="Project navigation">
					<a class="button button--secondary" href={buildProjectPath(workspaceSlug ?? '', project.slug)}>Back to project dashboard</a>
				</nav>

				<ProjectControlPanel title="Editing access" status={canEditProject ? 'Editable' : 'Read-only'} headingId="project-details-access-heading">
					<p class="project-details-readonly" data-project-details-permission>
						{canEditProject
							? 'You can maintain permitted project detail fields for this workspace role.'
							: 'You can view these project details, but you do not have permission to edit them.'}
					</p>
					{saveMessage && <p class="form-message" data-project-details-save-message>{saveMessage}</p>}
				</ProjectControlPanel>

				<ProjectContentPanel
					title="Project identity"
					helper="Project reference, workspace, internal ID and health are read-only."
					headingId="project-identity-heading"
				>
					<div slot="action">
						{canEditProject ? (
							<button class="button button--secondary project-details-edit-action" type="button" data-project-dialog-open="project-identity-dialog">Edit identity</button>
						) : (
							<DisabledActionHint
								id="project-identity-edit-hint"
								allowed={false}
								allowedText=""
								disabledText="Identity editing is unavailable for your current role."
							/>
						)}
					</div>
					<dl class="details-grid">
						<div><dt>Project name</dt><dd>{formatValue(project.name)}</dd></div>
						<div><dt>Project reference</dt><dd>{formatValue(project.project_ref)}</dd></div>
						<div><dt>Workspace</dt><dd>{workspaceName}</dd></div>
						<div><dt>Project status</dt><dd>{formatStatusLabel(project.status)}</dd></div>
						<div>
							<dt>Project health</dt>
							<dd>
								<RagReferencePill
									tone={healthTone(project.health)}
									label={formatStatusLabel(formatValue(project.health, 'Not assessed'))}
								/>
							</dd>
						</div>
						<div><dt>Project slug</dt><dd>{formatValue(project.slug)}</dd></div>
						<div><dt>Internal project ID</dt><dd class="mono-value">{project.id}</dd></div>
					</dl>
				</ProjectContentPanel>

				<ProjectContentPanel
					title="Project description"
					helper="The short project description remains separate from RAID records and Project Narrative."
					headingId="project-description-heading"
				>
					<div slot="action">
						{canEditProject ? (
							<button class="button button--secondary project-details-edit-action" type="button" data-project-dialog-open="project-description-dialog">Edit description</button>
						) : (
							<DisabledActionHint
								id="project-description-edit-hint"
								allowed={false}
								allowedText=""
								disabledText="Description editing is unavailable for your current role."
							/>
						)}
					</div>
					<dl class="details-grid details-grid--single">
						<div><dt>Description</dt><dd>{formatValue(project.description)}</dd></div>
					</dl>
				</ProjectContentPanel>

				<ProjectContentPanel
					title="Project context"
					helper="These fields describe setup context and do not replace structured RAID records."
					headingId="project-context-heading"
				>
					<div slot="action">
						{canEditProject ? (
							<button class="button button--secondary project-details-edit-action" type="button" data-project-dialog-open="project-context-dialog">Edit context</button>
						) : (
							<DisabledActionHint
								id="project-context-edit-hint"
								allowed={false}
								allowedText=""
								disabledText="Project context editing is unavailable for your current role."
							/>
						)}
					</div>
					<dl class="details-grid" data-project-context-fields>
						{projectContextFields.map((field) => (
							<div>
								<dt>{field.label}</dt>
								<dd>{field.value}</dd>
							</div>
						))}
					</dl>
				</ProjectContentPanel>

				<ProjectContentPanel
					title="Dates and governance"
					helper="Review and governance information supports project setup and assurance planning."
					headingId="project-governance-heading"
				>
					<div slot="action">
						{canEditProject ? (
							<button class="button button--secondary project-details-edit-action" type="button" data-project-dialog-open="project-governance-dialog">Edit dates and governance</button>
						) : (
							<DisabledActionHint
								id="project-governance-edit-hint"
								allowed={false}
								allowedText=""
								disabledText="Dates and governance editing is unavailable for your current role."
							/>
						)}
					</div>
					<dl class="details-grid governance-grid" data-project-governance-fields>
						{governanceFields.map((field) => (
							<div class="follow-up-field">
								<dt>{field.label}</dt>
								<dd>{field.value}</dd>
							</div>
						))}
					</dl>
				</ProjectContentPanel>

				<ProjectContentPanel
					title="Project roles and responsibilities"
					helper="Assignments describe accountability only; they do not grant edit permissions."
					headingId="project-people-heading"
				>
					<div slot="action">
						{canEditProject ? (
							<button class="button button--primary project-details-edit-action" type="button" data-project-dialog-open="project-add-person-dialog">Add another team member</button>
						) : (
							<DisabledActionHint
								id="project-people-edit-hint"
								allowed={false}
								allowedText=""
								disabledText="Responsibility assignment is unavailable for your current role."
							/>
						)}
					</div>
					{peopleLoadError && <p class="form-message">{peopleLoadError}</p>}
					<div class="project-people-grid" data-project-people-section>
						{projectRoleCards.map((role) => {
							const assignment = assignmentsByRole.get(role);
							const selectedValue = assignment?.user_id ? `user:${assignment.user_id}` : assignment?.demo_person_id ? `demo:${assignment.demo_person_id}` : '';
							return (
								<article class={`project-person-card ${canEditProject ? 'project-person-card--editable' : ''}`} data-project-role={role}>
									<div class="project-person-card__summary">
										<div>
											<h3>{projectPeopleRoleLabel(role)}</h3>
											{assignment ? (
												<>
													<p><strong>{assignmentName(assignment)}</strong></p>
													<p>{assignmentMeta(assignment)}</p>
													{assignment.demo_person_id && <span class="demo-person-badge">Demo persona</span>}
												</>
											) : (
												<p>No person assigned</p>
											)}
										</div>
										<p>{formatValue(assignment?.responsibility, projectPeopleRoleLabel(role))}</p>
									</div>
									{canEditProject && (
										<button class="project-person-card__button" type="button" data-project-dialog-open={`project-person-dialog-${role}`} aria-label={`${assignment ? 'Edit' : 'Assign'} ${projectPeopleRoleLabel(role)}`}>
											{assignment ? 'Edit assignment' : 'Assign person'}
										</button>
									)}
									{canEditProject && (
										<dialog class="project-details-dialog" id={`project-person-dialog-${role}`} aria-labelledby={`project-person-dialog-${role}-title`} data-project-details-dialog>
											<div class="project-details-dialog__header">
												<div>
													<h3 id={`project-person-dialog-${role}-title`}>{assignment ? 'Edit assignment' : 'Assign person'}</h3>
													<p>{projectPeopleRoleLabel(role)}</p>
												</div>
												<form method="dialog">
													<button class="project-details-dialog__close" type="submit" aria-label="Close">Close</button>
												</form>
											</div>
											<form class="project-details-modal-form" method="post" data-project-assignment-modal>
												<input type="hidden" name="intent" value="save-project-person" />
												<input type="hidden" name="project_role" value={role} />
												<label>
													<span>Assign person</span>
													<select name="person_selection" aria-label={`Assign ${projectPeopleRoleLabel(role)}`}>
														<option value="" selected={!selectedValue}>Unassigned</option>
														{realPersonOptions.length > 0 && (
															<optgroup label="Workspace members">
																{realPersonOptions.map((option) => (
																	<option value={`user:${option.id}`} selected={selectedValue === `user:${option.id}`}>{optionLabel(option)}</option>
																))}
															</optgroup>
														)}
														{demoPersonOptions.length > 0 && (
															<optgroup label="Demo personas">
																{demoPersonOptions.map((option) => (
																	<option value={`demo:${option.id}`} selected={selectedValue === `demo:${option.id}`}>{optionLabel(option)}</option>
																))}
															</optgroup>
														)}
													</select>
												</label>
												<label>
													<span>Responsibility</span>
													<input name="responsibility" value={assignment?.responsibility ?? projectPeopleRoleLabel(role)} />
												</label>
												<div class="project-details-modal-form__actions">
													{assignment && (
														<button class="button button--destructive" type="submit" name="intent" value="remove-project-person">Remove assignment</button>
													)}
													<button class="button button--secondary" type="button" data-project-dialog-cancel>Cancel</button>
													<button class="button button--primary" type="submit">Save assignment</button>
												</div>
											</form>
										</dialog>
									)}
								</article>
							);
						})}
					</div>
				</ProjectContentPanel>

				<ProjectContentPanel
					title="System metadata"
					helper="Generated and audit fields are displayed for context and cannot be edited here."
					headingId="project-system-metadata-heading"
				>
					<dl class="details-grid">
						<div><dt>Created by</dt><dd>{formatValue(creatorDisplayName)}</dd></div>
						<div><dt>Created at</dt><dd>{formatDateTime(project.created_at)}</dd></div>
						<div><dt>Updated at</dt><dd>{formatDateTime(project.updated_at)}</dd></div>
						<div><dt>Updated by</dt><dd>Not captured in the current project schema</dd></div>
					</dl>
				</ProjectContentPanel>

				{canEditProject && (
					<>
						<dialog class="project-details-dialog" id="project-identity-dialog" aria-labelledby="project-identity-dialog-title" data-project-details-dialog>
							<div class="project-details-dialog__header">
								<div>
									<h3 id="project-identity-dialog-title">Edit project identity</h3>
									<p>Only project name and status are editable here.</p>
								</div>
								<form method="dialog">
									<button class="project-details-dialog__close" type="submit" aria-label="Close">Close</button>
								</form>
							</div>
							<form class="project-details-modal-form" method="post" data-project-identity-modal>
								<input type="hidden" name="intent" value="update-project-identity" />
								<label>
									<span>Project name</span>
									<input name="name" value={project.name} required autocomplete="off" />
								</label>
								<label>
									<span>Status</span>
									<select name="status" aria-label="Project status">
										{PROJECT_STATUSES.map((status) => <option value={status} selected={status === project.status}>{formatStatusLabel(status)}</option>)}
									</select>
								</label>
								<dl class="project-details-modal-readonly">
									<div><dt>Project reference</dt><dd>{formatValue(project.project_ref)}</dd></div>
									<div><dt>Workspace</dt><dd>{workspaceName}</dd></div>
									<div><dt>Project health</dt><dd>{formatStatusLabel(formatValue(project.health, 'Not assessed'))}</dd></div>
									<div><dt>Project slug</dt><dd>{formatValue(project.slug)}</dd></div>
									<div><dt>Internal project ID</dt><dd class="mono-value">{project.id}</dd></div>
								</dl>
								<div class="project-details-modal-form__actions">
									<button class="button button--secondary" type="button" data-project-dialog-cancel>Cancel</button>
									<button class="button button--primary" type="submit">Save identity</button>
								</div>
							</form>
						</dialog>

						<dialog class="project-details-dialog" id="project-description-dialog" aria-labelledby="project-description-dialog-title" data-project-details-dialog>
							<div class="project-details-dialog__header">
								<div>
									<h3 id="project-description-dialog-title">Edit project description</h3>
									<p>Use current project schema fields only.</p>
								</div>
								<form method="dialog">
									<button class="project-details-dialog__close" type="submit" aria-label="Close">Close</button>
								</form>
							</div>
							<form class="project-details-modal-form" method="post" data-project-description-modal>
								<input type="hidden" name="intent" value="update-project-description" />
								<input type="hidden" name="name" value={project.name} />
								<input type="hidden" name="status" value={project.status} />
								<label>
									<span>Description</span>
									<textarea name="description" rows="6">{project.description ?? ''}</textarea>
								</label>
								<div class="project-details-modal-form__actions">
									<button class="button button--secondary" type="button" data-project-dialog-cancel>Cancel</button>
									<button class="button button--primary" type="submit">Save description</button>
								</div>
							</form>
						</dialog>

						<dialog class="project-details-dialog" id="project-context-dialog" aria-labelledby="project-context-dialog-title" data-project-details-dialog>
							<div class="project-details-dialog__header">
								<div>
									<h3 id="project-context-dialog-title">Edit project context</h3>
									<p>These fields support project setup and future assurance.</p>
								</div>
								<form method="dialog">
									<button class="project-details-dialog__close" type="submit" aria-label="Close">Close</button>
								</form>
							</div>
							<form class="project-details-modal-form" method="post" data-project-context-modal>
								<input type="hidden" name="intent" value="update-project-context" />
								<label>
									<span>Project type</span>
									<select name="project_type">
										<option value="" selected={!project.project_type}>Not set</option>
										{PROJECT_TYPES.map((value) => <option value={value} selected={project.project_type === value}>{projectFieldLabel(value)}</option>)}
									</select>
								</label>
								<label>
									<span>Delivery method</span>
									<select name="delivery_method">
										<option value="" selected={!project.delivery_method}>Not set</option>
										{DELIVERY_METHODS.map((value) => <option value={value} selected={project.delivery_method === value}>{projectFieldLabel(value)}</option>)}
									</select>
								</label>
								<label>
									<span>Priority</span>
									<select name="priority">
										<option value="" selected={!project.priority}>Not set</option>
										{PROJECT_PRIORITIES.map((value) => <option value={value} selected={project.priority === value}>{projectFieldLabel(value)}</option>)}
									</select>
								</label>
								<label>
									<span>Criticality</span>
									<select name="criticality">
										<option value="" selected={!project.criticality}>Not set</option>
										{PROJECT_CRITICALITIES.map((value) => <option value={value} selected={project.criticality === value}>{projectFieldLabel(value)}</option>)}
									</select>
								</label>
								<div class="project-details-modal-form__actions">
									<button class="button button--secondary" type="button" data-project-dialog-cancel>Cancel</button>
									<button class="button button--primary" type="submit">Save context</button>
								</div>
							</form>
						</dialog>

						<dialog class="project-details-dialog" id="project-governance-dialog" aria-labelledby="project-governance-dialog-title" data-project-details-dialog>
							<div class="project-details-dialog__header">
								<div>
									<h3 id="project-governance-dialog-title">Edit dates and governance</h3>
									<p>These fields support review planning. RAID items remain managed in their own modules.</p>
								</div>
								<form method="dialog">
									<button class="project-details-dialog__close" type="submit" aria-label="Close">Close</button>
								</form>
							</div>
							<form class="project-details-modal-form" method="post" data-project-governance-modal>
								<input type="hidden" name="intent" value="update-project-governance" />
								<label>
									<span>Start date</span>
									<input name="start_date" type="date" value={project.start_date ?? ''} />
								</label>
								<label>
									<span>Target end date</span>
									<input name="target_end_date" type="date" value={project.target_end_date ?? ''} />
								</label>
								<label>
									<span>Next review date</span>
									<input name="next_review_date" type="date" value={project.next_review_date ?? ''} />
								</label>
								<label>
									<span>Review cadence</span>
									<select name="review_cadence">
										<option value="" selected={!project.review_cadence}>Not set</option>
										{REVIEW_CADENCES.map((value) => <option value={value} selected={project.review_cadence === value}>{projectFieldLabel(value)}</option>)}
									</select>
								</label>
								<label>
									<span>Governance route</span>
									<textarea name="governance_route" rows="4" maxlength="500">{project.governance_route ?? ''}</textarea>
								</label>
								<label>
									<span>Escalation route</span>
									<textarea name="escalation_route" rows="4" maxlength="500">{project.escalation_route ?? ''}</textarea>
								</label>
								<div class="project-details-modal-form__actions">
									<button class="button button--secondary" type="button" data-project-dialog-cancel>Cancel</button>
									<button class="button button--primary" type="submit">Save dates and governance</button>
								</div>
							</form>
						</dialog>

						<dialog class="project-details-dialog" id="project-add-person-dialog" aria-labelledby="project-add-person-dialog-title" data-project-details-dialog>
							<div class="project-details-dialog__header">
								<div>
									<h3 id="project-add-person-dialog-title">Add another team member</h3>
									<p>Select a project role and assign a real member or active demo persona.</p>
								</div>
								<form method="dialog">
									<button class="project-details-dialog__close" type="submit" aria-label="Close">Close</button>
								</form>
							</div>
							<form class="project-details-modal-form" method="post" data-add-team-member-modal>
								<input type="hidden" name="intent" value="add-project-person" />
								<label>
									<span>Project role</span>
									<select name="project_role" required>
										{PROJECT_PEOPLE_ROLES.map((role) => <option value={role}>{projectPeopleRoleLabel(role)}</option>)}
									</select>
								</label>
								<label>
									<span>Assign person</span>
									<select name="person_selection" required aria-label="Assign team member">
										<option value="">Select a person</option>
										{realPersonOptions.length > 0 && (
											<optgroup label="Workspace members">
												{realPersonOptions.map((option) => (
													<option value={`user:${option.id}`}>{optionLabel(option)}</option>
												))}
											</optgroup>
										)}
										{demoPersonOptions.length > 0 && (
											<optgroup label="Demo personas">
												{demoPersonOptions.map((option) => (
													<option value={`demo:${option.id}`}>{optionLabel(option)}</option>
												))}
											</optgroup>
										)}
									</select>
								</label>
								<label>
									<span>Responsibility</span>
									<input name="responsibility" value="" />
								</label>
								<div class="project-details-modal-form__actions">
									<button class="button button--secondary" type="button" data-project-dialog-cancel>Cancel</button>
									<button class="button button--primary" type="submit">Save team member</button>
								</div>
							</form>
						</dialog>
					</>
				)}
			</>
		) : (
			<section class="content-card"><p>{message}</p></section>
		)}
	</section>
</AuthenticatedLayout>

<script>
	document.querySelectorAll('[data-project-dialog-open]').forEach((trigger) => {
		trigger.addEventListener('click', () => {
			if (!(trigger instanceof HTMLElement)) return;
			const dialog = document.getElementById(trigger.dataset.projectDialogOpen || '');
			if (dialog instanceof HTMLDialogElement) dialog.showModal();
		});
	});

	document.querySelectorAll('[data-project-dialog-cancel]').forEach((button) => {
		button.addEventListener('click', () => {
			const dialog = button.closest('dialog');
			if (dialog instanceof HTMLDialogElement) dialog.close();
		});
	});
</script>

