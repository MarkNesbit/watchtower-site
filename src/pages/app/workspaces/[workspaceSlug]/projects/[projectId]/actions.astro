---
import AuthenticatedLayout from '../../../../../../layouts/AuthenticatedLayout.astro';
import DisabledActionHint from '../../../../../../components/app/DisabledActionHint.astro';
import EmptyState from '../../../../../../components/app/EmptyState.astro';
import DateField from '../../../../../../components/forms/DateField.astro';
import ProjectContentPanel from '../../../../../../components/app/ProjectContentPanel.astro';
import ProjectPageHero from '../../../../../../components/app/ProjectPageHero.astro';
import { can } from '../../../../../../lib/permissions';
import {
	ACTION_DISPLAY_LABELS,
	ACTION_REGISTER_LOAD_INCREMENT,
	ACTION_REGISTER_SCOPE_LABELS,
	ACTION_REGISTER_TAB_LABELS,
	ACTION_REGISTER_TABS,
	actionConcernTone,
	actionDueDateDisplay,
	actionProfileName,
	actionTimingDisplayLabel,
	amendProjectActionBrief,
	assignProjectAction,
	briefPreview,
	canManageProjectAction,
	canTakeOverProjectAction,
	cancelProjectAction,
	changeProjectActionDueDate,
	completeProjectAction,
	createProjectAction,
	deriveActionTimingState,
	filterProjectActionsByScope,
	filterAndSortProjectActions,
	listEligibleActioners,
	listProjectActions,
	normaliseActionRegisterScope,
	normaliseActionRegisterSort,
	normaliseActionRegisterTab,
	parseActionRegisterVisibleCount,
	reissueProjectAction,
	returnProjectActionToActioner,
	saveProjectActionProgress,
	sourceLabelForAction,
	submitProjectAction,
	takeOverProjectActionAcceptance,
	type ActionRegisterTab,
	type ProjectAction,
} from '../../../../../../lib/projectActions';
import { buildLoginRedirectPath, createSupabaseServerClient, getServerAccessToken, isSupabaseAuthSessionError } from '../../../../../../lib/supabaseServer';
import { buildProjectActionsPath, buildProjectDetailsPath, buildProjectNarrativePath, buildProjectPath, buildProjectRiskPath, getWorkspaceBySlug } from '../../../../../../lib/projects';

const projectSlug = Astro.params.projectId;
const workspaceSlug = Astro.params.workspaceSlug;
const accessToken = getServerAccessToken(Astro.cookies);
const sessionRedirectPath = buildLoginRedirectPath(Astro.url.pathname);
let project = null;
let actions: ProjectAction[] = [];
let eligibleActioners = [];
let workspaceName = '';
let workspaceRole = '';
let actorId = '';
let message = '';
let actionsLoadError = '';
let createError = '';
let createValues = { brief: '', actionerId: '', dueDate: '' };
let createModalOpen = false;
let actionModalId = Astro.url.searchParams.get('action') ?? '';
let actionError = '';
let modalValues = { progress: '', reason: '', brief: '', actionerId: '', dueDate: '' };
let modalFormSubmitted = false;

const formatDateTime = (value, fallback = 'Not available') => value
	? `${new Intl.DateTimeFormat('en-GB', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'UTC' }).format(new Date(value))} UTC`
	: fallback;
const sourceHref = (record, projectRecord) => {
	if (!workspaceSlug || !projectRecord) return '';
	if (record.source_type === 'project') return buildProjectPath(workspaceSlug, projectRecord.slug);
	if (record.source_type === 'project_details') return buildProjectDetailsPath(workspaceSlug, projectRecord.slug);
	if (record.source_type === 'narrative') return buildProjectNarrativePath(workspaceSlug, projectRecord.slug);
	if (record.source_type === 'risk' && record.source_record_id) return buildProjectRiskPath(workspaceSlug, projectRecord.slug, record.source_record_id);
	return '';
};
const withQueryMessage = (path, key) => {
	const url = new URL(path, Astro.url.origin);
	url.searchParams.set(key, '1');
	return `${url.pathname}${url.search}`;
};
const safeRegisterReturnPath = (value, registerBasePath, fallback) => {
	try {
		const url = new URL(String(value ?? ''), Astro.url.origin);
		if (url.origin === Astro.url.origin && url.pathname === registerBasePath) return `${url.pathname}${url.search}`;
	} catch {
		return fallback;
	}
	return fallback;
};

try {
	const serverSupabase = createSupabaseServerClient(accessToken);
	const workspace = await getWorkspaceBySlug(serverSupabase, workspaceSlug ?? '', accessToken);
	const organisation = Array.isArray(workspace?.organisations) ? workspace?.organisations[0] : workspace?.organisations;
	const { data: userData } = accessToken
		? await serverSupabase.auth.getUser(accessToken)
		: await serverSupabase.auth.getUser();
	actorId = userData?.user?.id ?? '';

	if (!workspace || !organisation) {
		message = 'Project not found or you do not have access.';
		Astro.response.status = 404;
	} else if (!can(workspace.role, 'action.view')) {
		message = 'You do not have permission to view project Actions.';
		Astro.response.status = 403;
	} else {
		workspaceName = organisation.name;
		workspaceRole = workspace.role;
		const { data, error } = await serverSupabase
			.from('projects')
			.select('id, name, project_ref, slug')
			.eq('slug', projectSlug)
			.eq('organisation_id', organisation.id)
			.is('deleted_at', null)
			.is('archived_at', null)
			.maybeSingle();
		if (error) throw error;

		if (!data) {
			message = 'Project not found or you do not have access.';
			Astro.response.status = 404;
		} else {
			project = data;
			if (Astro.request.method === 'POST') {
				if (!accessToken) return Astro.redirect(sessionRedirectPath);
				const formData = await Astro.request.formData();
				const intent = String(formData.get('intent') ?? '');
				const actionId = String(formData.get('action_id') ?? '');
				const currentRegisterPath = buildProjectActionsPath(workspaceSlug ?? '', data.slug);
				const actionFallbackPath = actionId
					? `${currentRegisterPath}?action=${encodeURIComponent(actionId)}`
					: currentRegisterPath;
				const returnPath = safeRegisterReturnPath(formData.get('return_to'), currentRegisterPath, actionFallbackPath);
				if (intent === 'create-action') {
					createModalOpen = true;
					createValues = {
						brief: String(formData.get('brief') ?? ''),
						actionerId: String(formData.get('actioner_id') ?? ''),
						dueDate: String(formData.get('due_date') ?? ''),
					};
					try {
						if (!can(workspace.role, 'action.create')) throw new Error('Viewer access is read-only. Action creation is unavailable.');
						if (!createValues.brief.trim()) throw new Error('Action brief is required.');
						const created = await createProjectAction(serverSupabase, {
							projectId: data.id,
							brief: createValues.brief,
							dueDate: createValues.dueDate || null,
							actionerId: createValues.actionerId || null,
							sourceType: 'project',
							sourceLabel: data.name,
						});
						return Astro.redirect(`${currentRegisterPath}?scope=project&action=${encodeURIComponent(created.id)}&created=1`);
					} catch (error) {
						if (isSupabaseAuthSessionError(error)) return Astro.redirect(sessionRedirectPath);
						createError = error instanceof Error ? error.message : 'Unable to create Action.';
					}
				} else {
					actionModalId = actionId;
					modalFormSubmitted = true;
					const expectedStatus = String(formData.get('expected_status') ?? '');
					const expectedUpdatedAt = String(formData.get('expected_updated_at') ?? '');
					modalValues = {
						progress: String(formData.get('progress_update') ?? ''),
						reason: String(formData.get('reason') ?? ''),
						brief: String(formData.get('brief') ?? ''),
						actionerId: String(formData.get('actioner_id') ?? ''),
						dueDate: String(formData.get('due_date') ?? ''),
					};
					try {
						if (!actionId) throw new Error('Select an Action to update.');
						const expected = { actionId, expectedStatus, expectedUpdatedAt };
						if (intent === 'save-progress') {
							await saveProjectActionProgress(serverSupabase, { ...expected, response: modalValues.progress });
						} else if (intent === 'submit-for-review') {
							await submitProjectAction(serverSupabase, { ...expected, response: modalValues.progress });
						} else if (intent === 'direct-complete') {
							const submitted = await submitProjectAction(serverSupabase, { ...expected, response: modalValues.progress });
							await completeProjectAction(serverSupabase, { actionId, expectedStatus: submitted.status, expectedUpdatedAt: submitted.updated_at });
						} else if (intent === 'complete') {
							await completeProjectAction(serverSupabase, expected);
						} else if (intent === 'return-to-actioner') {
							await returnProjectActionToActioner(serverSupabase, { ...expected, reason: modalValues.reason });
						} else if (intent === 'cancel') {
							await cancelProjectAction(serverSupabase, { ...expected, reason: modalValues.reason });
						} else if (intent === 'amend-brief') {
							await amendProjectActionBrief(serverSupabase, { ...expected, brief: modalValues.brief });
						} else if (intent === 'change-due-date') {
							await changeProjectActionDueDate(serverSupabase, { ...expected, dueDate: modalValues.dueDate || null });
						} else if (intent === 'assign-actioner') {
							await assignProjectAction(serverSupabase, { ...expected, actionerId: modalValues.actionerId || null });
						} else if (intent === 'reissue') {
							await reissueProjectAction(serverSupabase, {
								...expected,
								brief: modalValues.brief || null,
								dueDate: modalValues.dueDate || null,
								actionerId: modalValues.actionerId || null,
							});
						} else if (intent === 'takeover') {
							await takeOverProjectActionAcceptance(serverSupabase, { ...expected, reason: modalValues.reason });
						} else {
							throw new Error('Select a valid Action operation.');
						}
						return Astro.redirect(withQueryMessage(returnPath, 'updated'));
					} catch (error) {
						if (isSupabaseAuthSessionError(error)) return Astro.redirect(sessionRedirectPath);
						actionError = error instanceof Error ? error.message : 'Unable to update Action.';
					}
				}
			}

			try {
				actions = await listProjectActions(organisation.id, data.id, workspace.role, serverSupabase);
			} catch (error) {
				actions = [];
				actionsLoadError = error instanceof Error ? error.message : 'Unable to load the Actions Register.';
			}

			try {
				eligibleActioners = await listEligibleActioners(organisation.id, workspace.role, serverSupabase);
			} catch {
				eligibleActioners = [];
			}
		}
	}
} catch (error) {
	if (isSupabaseAuthSessionError(error)) return Astro.redirect(sessionRedirectPath);
	message = error instanceof Error ? error.message : 'Unable to load Actions.';
	Astro.response.status = 500;
}

const canCreateAction = can(workspaceRole, 'action.create');
const registerPath = project && workspaceSlug ? buildProjectActionsPath(workspaceSlug, project.slug) : Astro.url.pathname;
const params = Astro.url.searchParams;
const now = new Date();
const selectedTab = normaliseActionRegisterTab(params.get('tab'));
const defaultSort = normaliseActionRegisterSort(null, selectedTab);
const selectedSearch = (params.get('q') ?? '').trim().slice(0, 120);
const selectedActioner = (params.get('actioner') ?? '').trim();
const selectedRaiser = (params.get('raiser') ?? '').trim();
const defaultScope = actorId && actions.some((action) => action.actioner_id === actorId) ? 'my' : 'project';
const selectedScope = normaliseActionRegisterScope(params.get('scope'), defaultScope);
const visibleCount = parseActionRegisterVisibleCount(params.get('visible'));
const scopedActions = filterProjectActionsByScope(actions, selectedScope, actorId);
const registerFilters = {
	tab: selectedTab,
	search: selectedSearch,
	actionerId: selectedActioner,
	raiserId: selectedRaiser,
	sort: defaultSort,
};
const filteredActions = filterAndSortProjectActions(scopedActions, registerFilters, now);
const visibleActions = filteredActions.slice(0, visibleCount);
const hasMoreActions = visibleActions.length < filteredActions.length;
const resultNoun = filteredActions.length === 1 ? 'action' : 'actions';
const tabItems = ACTION_REGISTER_TABS.map((tab: ActionRegisterTab) => ({
	id: tab,
	label: ACTION_REGISTER_TAB_LABELS[tab],
	count: scopedActions.filter((action) => {
		if (tab === 'outstanding') return ['open', 'returned_to_raiser', 'rejected_by_actioner', 'returned_to_actioner'].includes(action.status);
		if (tab === 'awaiting_review') return action.status === 'submitted';
		if (tab === 'complete') return action.status === 'complete';
		if (tab === 'cancelled') return action.status === 'cancelled';
		return false;
	}).length,
	active: selectedTab === tab,
}));
const actionerOptions = [...new Map(scopedActions
	.filter((action) => action.actioner_id)
	.map((action) => [action.actioner_id, actionProfileName(action.actioner, 'Workspace member')]))].sort((a, b) => a[1].localeCompare(b[1]));
const raiserOptions = [...new Map(scopedActions.map((action) => [action.raiser_id, actionProfileName(action.raiser, 'Workspace member')]))].sort((a, b) => a[1].localeCompare(b[1]));
const hasUnassignedActions = scopedActions.some((action) => !action.actioner_id);
const buildRegisterPath = (overrides = {}) => {
	const next = {
		tab: selectedTab,
		scope: selectedScope,
		q: selectedSearch,
		actioner: selectedActioner,
		raiser: selectedRaiser,
		visible: undefined,
		action: '',
		...overrides,
	};
	const query = new URLSearchParams();
	if (next.tab && next.tab !== 'outstanding') query.set('tab', next.tab);
	if (next.scope) query.set('scope', next.scope);
	if (next.q) query.set('q', next.q);
	if (next.actioner) query.set('actioner', next.actioner);
	if (next.raiser) query.set('raiser', next.raiser);
	if (Number(next.visible) > ACTION_REGISTER_LOAD_INCREMENT) query.set('visible', String(next.visible));
	if (next.action) query.set('action', next.action);
	const qs = query.toString();
	return qs ? `${registerPath}?${qs}` : registerPath;
};
const selectedAction = actionModalId ? actions.find((action) => action.id === actionModalId) ?? null : null;
if (actionModalId && !selectedAction && project && !actionsLoadError) actionError ||= 'Action not found or no longer available in this project.';
const selectedActionTiming = selectedAction ? deriveActionTimingState(selectedAction, now) : 'open';
const selectedActionTone = selectedAction ? actionConcernTone(selectedAction, now) : 'neutral';
const selectedActionDue = selectedAction ? actionDueDateDisplay(selectedAction, now) : { label: 'No due date', tone: 'amber' };
const selectedSourceUrl = selectedAction && project ? sourceHref(selectedAction, project) : '';
const modalCloseHref = buildRegisterPath({ action: '' });
const actionSuccessMessage = Astro.url.searchParams.get('created') === '1'
	? 'Action created.'
	: Astro.url.searchParams.get('updated') === '1'
		? 'Action updated.'
		: '';
const canManageSelectedAction = selectedAction ? canManageProjectAction(selectedAction, actorId, workspaceRole) : false;
const canTakeOverSelectedAction = selectedAction ? canTakeOverProjectAction(selectedAction, actorId, workspaceRole) : false;
const canRespondToSelectedAction = selectedAction
	? can(workspaceRole, 'action.respond') && selectedAction.actioner_id === actorId && ['open', 'returned_to_actioner'].includes(selectedAction.status)
	: false;
const canDirectCompleteSelectedAction = Boolean(canRespondToSelectedAction && selectedAction?.acceptance_owner_id === actorId);
const canSubmitSelectedAction = Boolean(canRespondToSelectedAction && !canDirectCompleteSelectedAction);
const canReviewSelectedAction = Boolean(canManageSelectedAction && selectedAction?.status === 'submitted');
const canReissueSelectedAction = Boolean(canManageSelectedAction && ['returned_to_raiser', 'rejected_by_actioner'].includes(selectedAction?.status ?? ''));
const canAssignSelectedAction = Boolean(canManageSelectedAction && selectedAction?.status !== 'submitted');
const canCancelSelectedAction = Boolean(canManageSelectedAction && selectedAction && !['complete', 'cancelled'].includes(selectedAction.status));
const modalProgressValue = modalValues.progress || selectedAction?.latest_response || '';
const modalBriefValue = modalValues.brief || selectedAction?.brief || '';
const modalDueDateValue = modalValues.dueDate || selectedAction?.due_date || '';
const modalActionerValue = modalFormSubmitted ? modalValues.actionerId : selectedAction?.actioner_id ?? '';
const scopeItems = [
	{ id: 'my', label: ACTION_REGISTER_SCOPE_LABELS.my, active: selectedScope === 'my', href: buildRegisterPath({ scope: 'my', visible: undefined }) },
	{ id: 'project', label: ACTION_REGISTER_SCOPE_LABELS.project, active: selectedScope === 'project', href: buildRegisterPath({ scope: 'project', visible: undefined }) },
];
---
<AuthenticatedLayout title={project ? `Actions — ${project.name} | WatchTower` : 'Actions | WatchTower'}>
	<section class="actions-register-page" data-actions-register-route>
		{project ? (
			<>
				<ProjectPageHero
					workspaceName={workspaceName}
					projectName={project.name}
					projectRef={project.project_ref}
					title="Actions"
					description="Track project actions from creation to closure."
					headingId="actions-register-heading"
				/>

				<ProjectContentPanel
					title="Action list"
					headingId="actions-register-table-heading"
				>
					<div slot="action" class="actions-register-action">
						{canCreateAction ? (
							<button class="button button--primary" type="button" data-action-create-open>New Action</button>
						) : (
							<button class="button button--primary" type="button" disabled aria-describedby="action-create-unavailable" data-viewer-read-only>New Action</button>
						)}
						{!canCreateAction && (
							<DisabledActionHint
								id="action-create-unavailable"
								allowed={false}
								allowedText=""
								disabledText="Viewers cannot create Actions. Contact the Project Owner, Project Manager or Delivery Manager if an Action should be raised."
							/>
						)}
					</div>

					{actionsLoadError ? (
						<EmptyState title="The Actions Register could not be loaded." tone="error" data-actions-list-error role="alert">
							<p>{actionsLoadError}</p>
						</EmptyState>
					) : (
						<div class="actions-register-main">
							{actions.length === 0 ? (
								<EmptyState title="No Actions have been recorded for this project yet." data-actions-empty-state>
									<p>When Actions are raised, this register will show their reference, Actioner, due date and raiser.</p>
									<p>{canCreateAction ? 'Create the first Action when assurance work needs to be tracked.' : 'Viewer access is read-only, so Action creation is unavailable for your role.'}</p>
								</EmptyState>
							) : (
								<>
									<nav class="actions-scope-switch" aria-label="Action scope" data-actions-scope-switch>
										{scopeItems.map((scope) => (
											<a class={`actions-scope-option${scope.active ? ' actions-scope-option--active' : ''}`} href={scope.href} aria-current={scope.active ? 'page' : undefined} data-actions-scope={scope.id}>{scope.label}</a>
										))}
									</nav>

									<nav class="actions-tabs" aria-label="Actions workflow views" data-actions-tabs>
										{tabItems.map((tab) => (
											<a class={`actions-tab${tab.active ? ' actions-tab--active' : ''}`} href={buildRegisterPath({ tab: tab.id, visible: undefined })} aria-current={tab.active ? 'page' : undefined} data-actions-tab={tab.id}>
												<span>{tab.label}</span>
												<span>{tab.count}</span>
											</a>
										))}
									</nav>

									<form class="actions-toolbar" method="get" action={registerPath} data-actions-controls>
										{selectedTab !== 'outstanding' && <input type="hidden" name="tab" value={selectedTab} />}
										<input type="hidden" name="scope" value={selectedScope} />
										<label><span>Search actions</span><input type="search" name="q" value={selectedSearch} placeholder="Search actions..." autocomplete="off" /></label>
										<label><span>Actioner</span><select name="actioner">
											<option value="" selected={!selectedActioner}>All actioners</option>
											{hasUnassignedActions && <option value="unassigned" selected={selectedActioner === 'unassigned'}>Unassigned</option>}
											{actionerOptions.map(([id, label]) => <option value={id} selected={selectedActioner === id}>{label}</option>)}
										</select></label>
										<label><span>Raiser</span><select name="raiser">
											<option value="" selected={!selectedRaiser}>All raisers</option>
											{raiserOptions.map(([id, label]) => <option value={id} selected={selectedRaiser === id}>{label}</option>)}
										</select></label>
										<div class="actions-toolbar__buttons">
											<button class="button button--secondary" type="submit">Apply</button>
											<a class="text-link" href={buildRegisterPath({ q: '', actioner: '', raiser: '', visible: undefined })}>Reset</a>
										</div>
									</form>

									<p class="actions-filter-status" role="status">Showing {visibleActions.length} of {filteredActions.length} {resultNoun}</p>

									{filteredActions.length === 0 ? (
										<EmptyState title="No Actions match the current filters." data-actions-filter-empty-state>
											<p>Adjust the selected search, Actioner or Raiser filter to bring matching Actions back into view.</p>
											<a class="button button--secondary" href={buildRegisterPath({ q: '', actioner: '', raiser: '', visible: undefined })}>Reset</a>
										</EmptyState>
									) : (
										<>
											<div class="actions-table-scroll">
												<table class="simple-table actions-table" data-actions-table>
													<thead>
														<tr>
															<th scope="col">Ref</th>
															<th scope="col">Action</th>
															<th scope="col">Actioner</th>
															<th scope="col">Due date</th>
															<th scope="col">Raiser</th>
														</tr>
													</thead>
													<tbody>
														{visibleActions.map((action) => {
															const timing = deriveActionTimingState(action, now);
															const concernTone = actionConcernTone(action, now);
															const dueDisplay = actionDueDateDisplay(action, now);
															const detailHref = buildRegisterPath({ action: action.id });
															return (
																<tr>
																	<td><a class={`actions-ref-pill actions-ref-pill--${concernTone}`} href={detailHref} aria-label={`Open ${action.action_ref} details. Signal: ${actionTimingDisplayLabel(timing)}`} data-action-modal-open={action.id}>{action.action_ref}</a></td>
																	<td><a class="actions-title" href={detailHref} title={action.brief} data-action-modal-open={action.id}>{briefPreview(action.brief)}</a></td>
																	<td><span class={action.actioner_id && !action.actioner?.isAssignable ? 'actions-person actions-person--warning' : 'actions-person'}>{action.actioner_id ? actionProfileName(action.actioner, 'Workspace member') : 'Unassigned'}</span></td>
																	<td><span class={`actions-due actions-due--${dueDisplay.tone}`} title={actionTimingDisplayLabel(timing)}>{dueDisplay.label}</span></td>
																	<td>{actionProfileName(action.raiser, 'Workspace member')}</td>
																</tr>
															);
														})}
													</tbody>
												</table>
											</div>

											{hasMoreActions && (
												<form class="actions-load-more" method="get" action={registerPath} data-actions-load-more>
													{selectedTab !== 'outstanding' && <input type="hidden" name="tab" value={selectedTab} />}
													<input type="hidden" name="scope" value={selectedScope} />
													{selectedSearch && <input type="hidden" name="q" value={selectedSearch} />}
													{selectedActioner && <input type="hidden" name="actioner" value={selectedActioner} />}
													{selectedRaiser && <input type="hidden" name="raiser" value={selectedRaiser} />}
													<input type="hidden" name="visible" value={visibleCount + ACTION_REGISTER_LOAD_INCREMENT} />
													<button class="button button--secondary" type="submit" data-actions-load-more-button>Load 20 more</button>
												</form>
											)}
										</>
									)}
								</>
							)}
						</div>
					)}

					<a class="text-link actions-back-link" href={buildProjectPath(workspaceSlug ?? '', project.slug)}>Back to project</a>
				</ProjectContentPanel>

				{selectedAction && (
					<dialog class="action-detail-dialog" aria-labelledby="action-detail-title" data-action-detail-dialog open>
						<div class="action-detail-modal">
							<header class="action-detail-modal__header">
								<div>
									<p class="eyebrow">Project Action</p>
									<h2 id="action-detail-title">{selectedAction.action_ref}</h2>
									<p>{selectedAction.brief}</p>
								</div>
								<a class="action-dialog-close" href={modalCloseHref} aria-label="Close Action detail">x</a>
							</header>

							{actionSuccessMessage && <p class="action-form-success" role="status">{actionSuccessMessage}</p>}
							{actionError && <p class="action-form-error" role="alert">{actionError}</p>}

							<div class="action-detail-modal__summary">
								<span class={`actions-ref-pill actions-ref-pill--${selectedActionTone}`}>{selectedAction.action_ref}</span>
								<span class={`actions-pill actions-pill--workflow actions-pill--${selectedAction.status}`}>{ACTION_DISPLAY_LABELS[selectedAction.status]}</span>
								<span class={`actions-pill actions-pill--${selectedActionTone}`}>{actionTimingDisplayLabel(selectedActionTiming)}</span>
							</div>

							<section class="action-detail-modal__section">
								<h3>Brief</h3>
								<p>{selectedAction.brief}</p>
							</section>

							<dl class="action-detail-modal__facts">
								<div><dt>Actioner</dt><dd>{selectedAction.actioner_id ? actionProfileName(selectedAction.actioner, 'Workspace member') : 'Unassigned'}</dd></div>
