---
import AuthenticatedLayout from '../../../../../../layouts/AuthenticatedLayout.astro';
import DisabledActionHint from '../../../../../../components/app/DisabledActionHint.astro';
import EmptyState from '../../../../../../components/app/EmptyState.astro';
import ProjectContentPanel from '../../../../../../components/app/ProjectContentPanel.astro';
import ProjectPageHero from '../../../../../../components/app/ProjectPageHero.astro';
import { can } from '../../../../../../lib/permissions';
import {
	ACTION_DISPLAY_LABELS,
	ACTION_REGISTER_PAGE_SIZES,
	ACTION_REGISTER_TAB_LABELS,
	ACTION_REGISTER_TABS,
	ACTION_SOURCE_DISPLAY_LABELS,
	DEFAULT_ACTION_REGISTER_PAGE_SIZE,
	actionProfileName,
	actionTimingDisplayLabel,
	briefPreview,
	createProjectAction,
	deriveActionDistribution,
	deriveActionTimingState,
	filterAndSortProjectActions,
	getActionRegisterPageNumbers,
	getProjectActionNeedsAttentionItems,
	listEligibleActioners,
	listProjectActions,
	normaliseActionRegisterSort,
	normaliseActionRegisterTab,
	normaliseActionTimingFilter,
	paginateProjectActions,
	parseActionRegisterPage,
	parseActionRegisterPageSize,
	sourceLabelForAction,
	summariseProjectActions,
	type ActionRegisterTab,
	type ProjectAction,
} from '../../../../../../lib/projectActions';
import { buildLoginRedirectPath, createSupabaseServerClient, getServerAccessToken, isSupabaseAuthSessionError } from '../../../../../../lib/supabaseServer';
import { buildProjectActionPath, buildProjectActionsPath, buildProjectDetailsPath, buildProjectNarrativePath, buildProjectPath, buildProjectRiskPath, getWorkspaceBySlug } from '../../../../../../lib/projects';

const projectSlug = Astro.params.projectId;
const workspaceSlug = Astro.params.workspaceSlug;
const accessToken = getServerAccessToken(Astro.cookies);
const sessionRedirectPath = buildLoginRedirectPath(Astro.url.pathname);
let project = null;
let actions: ProjectAction[] = [];
let eligibleActioners = [];
let workspaceName = '';
let workspaceRole = '';
let actorId = '';
let message = '';
let actionsLoadError = '';
let createError = '';
let createValues = { brief: '', actionerId: '', dueDate: '' };
let createModalOpen = false;

const formatDate = (value, fallback = 'Not available') => value
	? new Intl.DateTimeFormat('en-GB', { dateStyle: 'medium', timeZone: 'UTC' }).format(new Date(`${String(value).slice(0, 10)}T00:00:00Z`))
	: fallback;

const timingTone = (state) => {
	if (state === 'overdue' || state === 'due_today') return 'red';
	if (state === 'due_soon' || state === 'missing_due_date' || state === 'unassigned' || state === 'reassignment_required') return 'amber';
	if (state === 'complete') return 'green';
	if (state === 'cancelled') return 'grey';
	return 'blue';
};

const sourceHref = (action, projectRecord) => {
	if (!workspaceSlug || !projectRecord) return '';
	if (action.source_type === 'project') return buildProjectPath(workspaceSlug, projectRecord.slug);
	if (action.source_type === 'project_details') return buildProjectDetailsPath(workspaceSlug, projectRecord.slug);
	if (action.source_type === 'narrative') return buildProjectNarrativePath(workspaceSlug, projectRecord.slug);
	if (action.source_type === 'risk' && action.source_record_id) return buildProjectRiskPath(workspaceSlug, projectRecord.slug, action.source_record_id);
	return '';
};

try {
	const serverSupabase = createSupabaseServerClient(accessToken);
	const workspace = await getWorkspaceBySlug(serverSupabase, workspaceSlug ?? '', accessToken);
	const organisation = Array.isArray(workspace?.organisations) ? workspace?.organisations[0] : workspace?.organisations;
	const { data: userData } = accessToken
		? await serverSupabase.auth.getUser(accessToken)
		: await serverSupabase.auth.getUser();
	actorId = userData?.user?.id ?? '';

	if (!workspace || !organisation) {
		message = 'Project not found or you do not have access.';
		Astro.response.status = 404;
	} else if (!can(workspace.role, 'action.view')) {
		message = 'You do not have permission to view project Actions.';
		Astro.response.status = 403;
	} else {
		workspaceName = organisation.name;
		workspaceRole = workspace.role;
		const { data, error } = await serverSupabase
			.from('projects')
			.select('id, name, project_ref, slug')
			.eq('slug', projectSlug)
			.eq('organisation_id', organisation.id)
			.is('deleted_at', null)
			.is('archived_at', null)
			.maybeSingle();
		if (error) throw error;

		if (!data) {
			message = 'Project not found or you do not have access.';
			Astro.response.status = 404;
		} else {
			project = data;
			if (Astro.request.method === 'POST') {
				if (!accessToken) return Astro.redirect(sessionRedirectPath);
				const formData = await Astro.request.formData();
				const intent = String(formData.get('intent') ?? '');
				if (intent === 'create-action') {
					createModalOpen = true;
					createValues = {
						brief: String(formData.get('brief') ?? ''),
						actionerId: String(formData.get('actioner_id') ?? ''),
						dueDate: String(formData.get('due_date') ?? ''),
					};
					try {
						if (!can(workspace.role, 'action.create')) throw new Error('Viewer access is read-only. Action creation is unavailable.');
						if (!createValues.brief.trim()) throw new Error('Action brief is required.');
						const created = await createProjectAction(serverSupabase, {
							projectId: data.id,
							brief: createValues.brief,
							dueDate: createValues.dueDate || null,
							actionerId: createValues.actionerId || null,
							sourceType: 'project',
							sourceLabel: data.name,
						});
						return Astro.redirect(`${buildProjectActionPath(workspaceSlug ?? '', data.slug, created.id)}?created=1`);
					} catch (error) {
						if (isSupabaseAuthSessionError(error)) return Astro.redirect(sessionRedirectPath);
						createError = error instanceof Error ? error.message : 'Unable to create Action.';
					}
				}
			}

			try {
				actions = await listProjectActions(organisation.id, data.id, workspace.role, serverSupabase);
			} catch (error) {
				actions = [];
				actionsLoadError = error instanceof Error ? error.message : 'Unable to load the Actions Register.';
			}

			try {
				eligibleActioners = await listEligibleActioners(organisation.id, workspace.role, serverSupabase);
			} catch {
				eligibleActioners = [];
			}
		}
	}
} catch (error) {
	if (isSupabaseAuthSessionError(error)) return Astro.redirect(sessionRedirectPath);
	message = error instanceof Error ? error.message : 'Unable to load Actions.';
	Astro.response.status = 500;
}

const canCreateAction = can(workspaceRole, 'action.create');
const registerPath = project && workspaceSlug ? buildProjectActionsPath(workspaceSlug, project.slug) : Astro.url.pathname;
const params = Astro.url.searchParams;
const now = new Date();
const selectedTab = normaliseActionRegisterTab(params.get('tab'));
const defaultSort = normaliseActionRegisterSort(null, selectedTab);
const selectedSort = params.has('sort') ? normaliseActionRegisterSort(params.get('sort'), selectedTab) : defaultSort;
const selectedSearch = (params.get('q') ?? '').trim().slice(0, 120);
const selectedTiming = normaliseActionTimingFilter(params.get('timing'));
const selectedStatus = ACTION_DISPLAY_LABELS[params.get('status')] ? params.get('status') : '';
const selectedActioner = (params.get('actioner') ?? '').trim();
const selectedRaiser = (params.get('raiser') ?? '').trim();
const selectedSource = ACTION_SOURCE_DISPLAY_LABELS[params.get('source')] ? params.get('source') : '';
const selectedPage = parseActionRegisterPage(params.get('page'));
const selectedPageSize = parseActionRegisterPageSize(params.get('pageSize'));
const registerFilters = {
	tab: selectedTab,
	search: selectedSearch,
	timing: selectedTiming,
	status: selectedStatus,
	actionerId: selectedActioner,
	raiserId: selectedRaiser,
	sourceType: selectedSource,
	sort: selectedSort,
};
const filteredActions = filterAndSortProjectActions(actions, registerFilters, now);
const paginated = paginateProjectActions(filteredActions, selectedPage, selectedPageSize);
const pageNumbers = getActionRegisterPageNumbers(paginated.pagination.page, paginated.pagination.totalPages);
const summary = summariseProjectActions(actions, now);
const needsActionItems = getProjectActionNeedsAttentionItems(actions, 4, now);
const distribution = deriveActionDistribution(actions);
const chartRadius = 52;
const circumference = 2 * Math.PI * chartRadius;
let chartOffset = 0;
const chartSegments = distribution.segments.filter((segment) => segment.count > 0).map((segment) => {
	const arc = distribution.total ? (segment.count / distribution.total) * circumference : 0;
	const item = { ...segment, dashArray: `${Math.max(0.75, arc - 2)} ${circumference}`, dashOffset: -(chartOffset + 1) };
	chartOffset += arc;
	return item;
});
const tabItems = ACTION_REGISTER_TABS.map((tab: ActionRegisterTab) => ({
	id: tab,
	label: ACTION_REGISTER_TAB_LABELS[tab],
	count: actions.filter((action) => {
		if (tab === 'outstanding') return ['open', 'returned_to_raiser', 'rejected_by_actioner', 'returned_to_actioner'].includes(action.status);
		if (tab === 'awaiting_review') return action.status === 'submitted';
		if (tab === 'complete') return action.status === 'complete';
		if (tab === 'cancelled') return action.status === 'cancelled';
		return true;
	}).length,
	active: selectedTab === tab,
}));
const actionerOptions = [...new Map(actions
	.filter((action) => action.actioner_id)
	.map((action) => [action.actioner_id, actionProfileName(action.actioner, 'Workspace member')]))].sort((a, b) => a[1].localeCompare(b[1]));
const raiserOptions = [...new Map(actions.map((action) => [action.raiser_id, actionProfileName(action.raiser, 'Workspace member')]))].sort((a, b) => a[1].localeCompare(b[1]));
const sourceOptions = [...new Set(actions.map((action) => action.source_type))];
const hasUnassignedActions = actions.some((action) => !action.actioner_id);
const buildRegisterPath = (overrides = {}) => {
	const next = {
		tab: selectedTab,
		q: selectedSearch,
		timing: selectedTiming,
		status: selectedStatus,
		actioner: selectedActioner,
		raiser: selectedRaiser,
		source: selectedSource,
		sort: selectedSort,
		page: paginated.pagination.page,
		pageSize: selectedPageSize,
		...overrides,
	};
	const query = new URLSearchParams();
	if (next.tab && next.tab !== 'outstanding') query.set('tab', next.tab);
	if (next.q) query.set('q', next.q);
	if (next.timing && next.timing !== 'all') query.set('timing', next.timing);
	if (next.status) query.set('status', next.status);
	if (next.actioner) query.set('actioner', next.actioner);
	if (next.raiser) query.set('raiser', next.raiser);
	if (next.source) query.set('source', next.source);
	if (next.sort && next.sort !== normaliseActionRegisterSort(null, next.tab)) query.set('sort', next.sort);
	if (Number(next.page) > 1) query.set('page', String(next.page));
	if (Number(next.pageSize) !== DEFAULT_ACTION_REGISTER_PAGE_SIZE) query.set('pageSize', String(next.pageSize));
	const qs = query.toString();
	return qs ? `${registerPath}?${qs}` : registerPath;
};
const highestUrgencyLabel = summary.highestUrgency === 'none' ? 'None outstanding' : actionTimingDisplayLabel(summary.highestUrgency);
---
<AuthenticatedLayout title={project ? `Actions Register — ${project.name} | WatchTower` : 'Actions Register | WatchTower'}>
	<section class="actions-register-page" data-actions-register-route>
		{project ? (
			<>
				<ProjectPageHero
					workspaceName={workspaceName}
					projectName={project.name}
					projectRef={project.project_ref}
					title="Actions Register"
					description="A source-of-truth register of project assurance actions."
					headingId="actions-register-heading"
				/>

				<ProjectContentPanel
					title="Actions Register"
					helper="Track and manage project actions from raise to closure. Timing, workflow status and owners are shown."
					headingId="actions-register-table-heading"
				>
					<div slot="action" class="actions-register-action">
						{canCreateAction ? (
							<button class="button button--primary" type="button" data-action-create-open>New Action</button>
						) : (
							<button class="button button--primary" type="button" disabled aria-describedby="action-create-unavailable" data-viewer-read-only>New Action</button>
						)}
						{!canCreateAction && (
							<DisabledActionHint
								id="action-create-unavailable"
								allowed={false}
								allowedText=""
								disabledText="Viewers cannot create Actions. Contact the Project Owner, Project Manager or Delivery Manager if an Action should be raised."
							/>
						)}
					</div>

					{actionsLoadError ? (
						<EmptyState title="The Actions Register could not be loaded." tone="error" data-actions-list-error role="alert">
							<p>{actionsLoadError}</p>
						</EmptyState>
					) : (
						<div class="actions-register-layout">
							<div class="actions-register-main">
								<section class="actions-summary" aria-label="Actions summary" data-actions-summary>
									<article class="actions-summary-card actions-summary-card--blue">
										<span aria-hidden="true">□</span>
										<div><p>Open Actions</p><strong>{summary.openActions}</strong><small>Active project Actions</small></div>
									</article>
									<article class={`actions-summary-card ${summary.needAction > 0 ? 'actions-summary-card--amber' : 'actions-summary-card--neutral'}`}>
										<span aria-hidden="true">!</span>
										<div><p>Need Action</p><strong>{summary.needAction}</strong><small>Require attention</small></div>
									</article>
									<article class={`actions-summary-card actions-summary-card--${timingTone(summary.highestUrgency === 'none' ? 'open' : summary.highestUrgency)}`}>
										<span aria-hidden="true">⌖</span>
										<div><p>Highest urgency</p><strong>{highestUrgencyLabel}</strong><small>Across open Actions</small></div>
									</article>
								</section>

								{actions.length === 0 ? (
									<EmptyState title="No Actions have been recorded for this project yet." data-actions-empty-state>
										<p>When Actions are raised, this register will show their reference, Actioner, workflow state, timing state, source and history.</p>
										<p>{canCreateAction ? 'Create the first Action when assurance work needs to be tracked.' : 'Viewer access is read-only, so Action creation is unavailable for your role.'}</p>
									</EmptyState>
								) : (
									<>
										<nav class="actions-tabs" aria-label="Actions Register views" data-actions-tabs>
											{tabItems.map((tab) => (
												<a class={`actions-tab${tab.active ? ' actions-tab--active' : ''}`} href={buildRegisterPath({ tab: tab.id, sort: normaliseActionRegisterSort(null, tab.id), page: 1 })} aria-current={tab.active ? 'page' : undefined} data-actions-tab={tab.id}>
													<span>{tab.label}</span>
													<span>{tab.count}</span>
												</a>
											))}
										</nav>

										<form class="actions-toolbar" method="get" action={registerPath} data-actions-controls>
											<input type="hidden" name="tab" value={selectedTab} />
											<input type="hidden" name="pageSize" value={selectedPageSize} />
											<label><span>Search actions</span><input type="search" name="q" value={selectedSearch} placeholder="Search actions..." autocomplete="off" /></label>
											<label><span>Timing</span><select name="timing">
												<option value="all" selected={selectedTiming === 'all'}>All timing</option>
												{['open', 'due_soon', 'due_today', 'overdue', 'unassigned', 'reassignment_required', 'complete', 'cancelled'].map((state) => (
													<option value={state} selected={selectedTiming === state}>{actionTimingDisplayLabel(state)}</option>
												))}
											</select></label>
											<label><span>Workflow status</span><select name="status">
												<option value="" selected={!selectedStatus}>All statuses</option>
												{Object.entries(ACTION_DISPLAY_LABELS).map(([status, label]) => <option value={status} selected={selectedStatus === status}>{label}</option>)}
											</select></label>
											<label><span>Actioner</span><select name="actioner">
												<option value="" selected={!selectedActioner}>All actioners</option>
												{hasUnassignedActions && <option value="unassigned" selected={selectedActioner === 'unassigned'}>Unassigned</option>}
												{actionerOptions.map(([id, label]) => <option value={id} selected={selectedActioner === id}>{label}</option>)}
											</select></label>
											<label><span>Raiser</span><select name="raiser">
												<option value="" selected={!selectedRaiser}>All raisers</option>
												{raiserOptions.map(([id, label]) => <option value={id} selected={selectedRaiser === id}>{label}</option>)}
											</select></label>
											<label><span>Source</span><select name="source">
												<option value="" selected={!selectedSource}>All sources</option>
												{sourceOptions.map((source) => <option value={source} selected={selectedSource === source}>{ACTION_SOURCE_DISPLAY_LABELS[source]}</option>)}
											</select></label>
											<label><span>Sort</span><select name="sort">
												<option value="highest_urgency" selected={selectedSort === 'highest_urgency'}>Highest urgency</option>
												<option value="due_date_earliest" selected={selectedSort === 'due_date_earliest'}>Due date earliest</option>
												<option value="due_date_latest" selected={selectedSort === 'due_date_latest'}>Due date latest</option>
												<option value="recently_updated" selected={selectedSort === 'recently_updated'}>Most recently updated</option>
												<option value="oldest_updated" selected={selectedSort === 'oldest_updated'}>Oldest updated</option>
												<option value="action_ref" selected={selectedSort === 'action_ref'}>Action reference</option>
												<option value="actioner" selected={selectedSort === 'actioner'}>Actioner</option>
											</select></label>
											<div class="actions-toolbar__buttons">
												<button class="button button--secondary" type="submit">Apply</button>
												<a class="text-link" href={registerPath}>Reset filters</a>
											</div>
										</form>

										<p class="actions-filter-status" role="status">{filteredActions.length} of {actions.length} Actions shown</p>

										{filteredActions.length === 0 ? (
											<EmptyState title="No Actions match the current filters." data-actions-filter-empty-state>
												<p>Adjust the selected tab, search, filters or sort to bring matching Actions back into view.</p>
												<a class="button button--secondary" href={registerPath}>Reset filters</a>
											</EmptyState>
										) : (
											<>
												<div class="actions-table-scroll">
													<table class="simple-table actions-table" data-actions-table>
														<thead>
															<tr>
																<th scope="col">Ref</th>
																<th scope="col">Action</th>
																<th scope="col">Source</th>
																<th scope="col">Actioner</th>
																<th scope="col">Workflow state</th>
																<th scope="col">Timing state</th>
																<th scope="col">Due date</th>
																<th scope="col">Raiser</th>
																<th scope="col">More actions</th>
															</tr>
														</thead>
														<tbody>
															{paginated.items.map((action) => {
																const timing = deriveActionTimingState(action, now);
																const detailHref = buildProjectActionPath(workspaceSlug ?? '', project.slug, action.id);
																const sourceUrl = sourceHref(action, project);
																return (
																	<tr>
																		<td><a class="actions-ref" href={detailHref}>{action.action_ref}</a></td>
																		<td><a class="actions-title" href={detailHref} title={action.brief}>{briefPreview(action.brief)}</a></td>
																		<td>{sourceUrl ? <a class="text-link" href={sourceUrl}>{sourceLabelForAction(action)}</a> : sourceLabelForAction(action)}</td>
																		<td><span class={action.actioner_id && !action.actioner?.isAssignable ? 'actions-person actions-person--warning' : 'actions-person'}>{action.actioner_id ? actionProfileName(action.actioner, 'Workspace member') : 'Unassigned'}</span></td>
																		<td><span class={`actions-pill actions-pill--workflow actions-pill--${action.status}`}>{ACTION_DISPLAY_LABELS[action.status]}</span></td>
																		<td><span class={`actions-pill actions-pill--${timingTone(timing)}`} title={`Timing state: ${actionTimingDisplayLabel(timing)}`}>{actionTimingDisplayLabel(timing)}</span></td>
																		<td><span class={`actions-due actions-due--${timingTone(timing)}`}>{formatDate(action.due_date, 'No due date')}</span></td>
																		<td>{actionProfileName(action.raiser, 'Workspace member')}</td>
																		<td><a class="text-link" href={detailHref}>Open details</a></td>
																	</tr>
																);
															})}
														</tbody>
													</table>
												</div>
												<div class="actions-pagination">
													<form method="get" action={registerPath}>
														{selectedTab !== 'outstanding' && <input type="hidden" name="tab" value={selectedTab} />}
														{selectedSearch && <input type="hidden" name="q" value={selectedSearch} />}
														{selectedTiming !== 'all' && <input type="hidden" name="timing" value={selectedTiming} />}
														{selectedStatus && <input type="hidden" name="status" value={selectedStatus} />}
														{selectedActioner && <input type="hidden" name="actioner" value={selectedActioner} />}
														{selectedRaiser && <input type="hidden" name="raiser" value={selectedRaiser} />}
														{selectedSource && <input type="hidden" name="source" value={selectedSource} />}
														{selectedSort !== defaultSort && <input type="hidden" name="sort" value={selectedSort} />}
														<label><span>Show</span><select name="pageSize" aria-label="Actions per page">
															{ACTION_REGISTER_PAGE_SIZES.map((size) => <option value={size} selected={paginated.pagination.pageSize === size}>{size}</option>)}
														</select></label>
														<button class="button button--secondary" type="submit">Apply</button>
														<span>{paginated.pagination.startItem}–{paginated.pagination.endItem} of {paginated.pagination.totalItems} Actions</span>
													</form>
													<nav aria-label="Actions Register pages">
														{paginated.pagination.hasPrevious ? <a class="actions-page-link" href={buildRegisterPath({ page: paginated.pagination.page - 1 })}>Previous</a> : <button class="actions-page-link" type="button" disabled>Previous</button>}
														{pageNumbers.map((pageNumber) => pageNumber === paginated.pagination.page ? <span class="actions-page-link actions-page-link--current" aria-current="page">{pageNumber}</span> : <a class="actions-page-link" href={buildRegisterPath({ page: pageNumber })}>{pageNumber}</a>)}
														{paginated.pagination.hasNext ? <a class="actions-page-link" href={buildRegisterPath({ page: paginated.pagination.page + 1 })}>Next</a> : <button class="actions-page-link" type="button" disabled>Next</button>}
													</nav>
												</div>
											</>
										)}
									</>
								)}
							</div>

							<div class="actions-side-panels">
								<aside class="actions-side-panel" aria-labelledby="actions-needs-heading" data-actions-needs-action-panel>
									<h3 id="actions-needs-heading">Needs action</h3>
									{needsActionItems.length === 0 ? <p>No project Actions currently require attention.</p> : (
										<ul>
											{needsActionItems.map((item) => (
												<li>
													<a href={buildProjectActionPath(workspaceSlug ?? '', project.slug, item.actionId)}>
														<strong>{item.label}</strong>
														<span>{item.actionRef} · {briefPreview(item.brief, 58)}</span>
														<small>{item.reason}</small>
													</a>
												</li>
											))}
										</ul>
									)}
									<a class="text-link" href={buildRegisterPath({ tab: 'all', timing: '', status: '', sort: 'highest_urgency', page: 1 })}>View all need action items</a>
								</aside>

								<aside class="actions-side-panel actions-distribution" aria-labelledby="actions-distribution-heading" data-actions-distribution>
									<h3 id="actions-distribution-heading">Action distribution</h3>
									<p>Breakdown of open and closed Actions by status.</p>
									<p class="visually-hidden">{distribution.summary}</p>
									{distribution.total === 0 ? <p>No Actions to chart.</p> : (
										<div class="actions-distribution__body">
											<div class="actions-donut" aria-hidden="true">
												<svg viewBox="0 0 140 140" focusable="false">
													<circle class="actions-donut__track" cx="70" cy="70" r={chartRadius}></circle>
													{chartSegments.map((segment) => <circle class={`actions-donut__segment actions-donut__segment--${segment.key}`} cx="70" cy="70" r={chartRadius} stroke-dasharray={segment.dashArray} stroke-dashoffset={segment.dashOffset}></circle>)}
												</svg>
												<div><strong>{distribution.total}</strong><span>Total</span></div>
											</div>
											<ul>
												{distribution.segments.map((segment) => (
													<li><span><i class={`actions-swatch actions-swatch--${segment.key}`}></i>{segment.label}</span><strong>{segment.count} <small>({segment.percentage}%)</small></strong></li>
												))}
											</ul>
										</div>
									)}
								</aside>
							</div>
						</div>
					)}

					<div class="actions-guidance">
						<div><strong>About Actions</strong><p>Actions are specific pieces of work raised to address project concerns. The raiser remains responsible for closure.</p></div>
						<div><strong>Need to raise an Action?</strong><p>If you do not have edit rights, contact the Project Owner, Project Manager or Delivery Manager.</p></div>
						<div><strong>Learn more</strong><p>Action guidance will be expanded as the workflow matures.</p></div>
					</div>
					<a class="text-link actions-back-link" href={buildProjectPath(workspaceSlug ?? '', project.slug)}>Back to project</a>
				</ProjectContentPanel>

				<dialog class="action-create-dialog" aria-labelledby="action-create-title" data-action-create-dialog data-open-on-load={createModalOpen || undefined}>
					<form method="post" class="action-create-form">
						<input type="hidden" name="intent" value="create-action" />
						<div class="action-create-form__header">
							<div>
								<p class="eyebrow">Project Action</p>
								<h2 id="action-create-title">New Action</h2>
								<p>This Action will be raised directly against the project source.</p>
							</div>
							<button class="action-dialog-close" type="button" value="cancel" data-action-create-close aria-label="Close New Action dialog">x</button>
						</div>
						{createError && <p class="action-form-error" role="alert">{createError}</p>}
						<label><span>Brief</span><textarea name="brief" rows="4" required>{createValues.brief}</textarea></label>
						<label><span>Actioner</span><select name="actioner_id">
							<option value="" selected={!createValues.actionerId}>Unassigned</option>
							{eligibleActioners.map((person) => <option value={person.id} selected={createValues.actionerId === person.id}>{actionProfileName(person, 'Workspace member')} {person.role ? `(${person.role})` : ''}</option>)}
						</select></label>
						<label><span>Due date</span><input type="date" name="due_date" value={createValues.dueDate} /></label>
						<div class="action-create-form__footer">
							<button class="button button--secondary" type="button" data-action-create-cancel>Cancel</button>
							<button class="button button--primary" type="submit" data-action-create-submit>Create Action</button>
						</div>
					</form>
				</dialog>
			</>
		) : (
			<section class="content-card" data-actions-unavailable-message>
				<p class="eyebrow">Project Actions</p>
				<h1>Actions unavailable</h1>
				<p>{message}</p>
				<a class="button button--secondary" href={workspaceSlug && projectSlug ? buildProjectPath(workspaceSlug, projectSlug) : '/app/projects'}>Back to project</a>
			</section>
		)}
	</section>
</AuthenticatedLayout>

<script>
	const dialog = document.querySelector('[data-action-create-dialog]');
	const openButton = document.querySelector('[data-action-create-open]');
	const closeButtons = document.querySelectorAll('[data-action-create-close], [data-action-create-cancel]');
	let lastTrigger = null;
	const setScrollLocked = (locked) => {
		document.documentElement.classList.toggle('modal-scroll-locked', locked);
		document.body.classList.toggle('modal-scroll-locked', locked);
	};
	const openDialog = (trigger) => {
		if (!(dialog instanceof HTMLDialogElement)) return;
		lastTrigger = trigger;
		if (!dialog.open) dialog.showModal();
		setScrollLocked(true);
		dialog.querySelector('textarea')?.focus();
	};
	openButton?.addEventListener('click', () => {
		openDialog(openButton);
	});
	closeButtons.forEach((button) => button.addEventListener('click', () => {
		dialog?.close();
		lastTrigger?.focus();
	}));
	if (dialog instanceof HTMLDialogElement && dialog.dataset.openOnLoad === 'true') {
		openDialog(openButton instanceof HTMLElement ? openButton : null);
	}
	dialog?.addEventListener('close', () => {
		setScrollLocked(false);
		lastTrigger?.focus();
	});
	dialog?.querySelector('form')?.addEventListener('submit', (event) => {
		const submitButton = event.currentTarget?.querySelector('[data-action-create-submit]');
		if (submitButton) {
			submitButton.disabled = true;
			submitButton.textContent = 'Creating...';
		}
	});
</script>

