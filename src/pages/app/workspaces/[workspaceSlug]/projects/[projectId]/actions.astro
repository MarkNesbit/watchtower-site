</AuthenticatedLayout>

<script>
	const dialog = document.querySelector('[data-action-create-dialog]');
	const detailDialog = document.querySelector('[data-action-detail-dialog]');
	const openButton = document.querySelector('[data-action-create-open]');
	const closeButtons = document.querySelectorAll('[data-action-create-close], [data-action-create-cancel]');
	let lastTrigger = null;
	const focusStorageKey = 'watchtower:last-action-modal-trigger';
	const setScrollLocked = (locked) => {
		document.documentElement.classList.toggle('modal-scroll-locked', locked);
		document.body.classList.toggle('modal-scroll-locked', locked);
	};
	const openDialog = (trigger) => {
		if (!(dialog instanceof HTMLDialogElement)) return;
		lastTrigger = trigger;
		if (!dialog.open) dialog.showModal();
		setScrollLocked(true);
		dialog.querySelector('textarea')?.focus();
	};
	openButton?.addEventListener('click', () => {
		openDialog(openButton);
	});
	closeButtons.forEach((button) => button.addEventListener('click', () => {
		dialog?.close();
		lastTrigger?.focus();
	}));
	document.querySelectorAll('[data-action-modal-open]').forEach((trigger) => {
		trigger.addEventListener('click', () => {
			if (trigger instanceof HTMLElement) {
				sessionStorage.setItem(focusStorageKey, trigger.dataset.actionModalOpen ?? '');
			}
		});
	});
	if (detailDialog instanceof HTMLDialogElement) {
		if (detailDialog.open) detailDialog.close();
		detailDialog.showModal();
		setScrollLocked(true);
		detailDialog.querySelector('a, button, textarea, select, input')?.focus();
	}
	if (dialog instanceof HTMLDialogElement && dialog.dataset.openOnLoad === 'true') {
		openDialog(openButton instanceof HTMLElement ? openButton : null);
	}
	dialog?.addEventListener('close', () => {
		setScrollLocked(false);
		lastTrigger?.focus();
	});
	detailDialog?.addEventListener('close', () => {
		setScrollLocked(false);
	});
	if (!detailDialog) {
		const actionId = sessionStorage.getItem(focusStorageKey);
		if (actionId) {
			document.querySelector(`[data-action-modal-open="${CSS.escape(actionId)}"]`)?.focus();
			sessionStorage.removeItem(focusStorageKey);
		}
	}
	dialog?.querySelector('form')?.addEventListener('submit', (event) => {
		const submitButton = event.currentTarget?.querySelector('[data-action-create-submit]');
		if (submitButton) {
			submitButton.disabled = true;
			submitButton.textContent = 'Creating...';
		}
	});
	document.querySelector('[data-actions-load-more]')?.addEventListener('submit', (event) => {
		const submitButton = event.currentTarget?.querySelector('[data-actions-load-more-button]');
		if (submitButton) {
			submitButton.disabled = true;
			submitButton.setAttribute('aria-busy', 'true');
			submitButton.textContent = 'Loading...';
		}
	});
</script>

