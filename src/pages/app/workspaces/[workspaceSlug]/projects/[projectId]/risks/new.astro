---
import AuthenticatedLayout from '../../../../../../../layouts/AuthenticatedLayout.astro';
import ProjectContentPanel from '../../../../../../../components/app/ProjectContentPanel.astro';
import ProjectControlPanel from '../../../../../../../components/app/ProjectControlPanel.astro';
import ProjectPageHero from '../../../../../../../components/app/ProjectPageHero.astro';
import RiskForm from '../../../../../../../components/app/RiskForm.astro';
import { getFeatureAccess, loadFeatureAccess } from '../../../../../../../lib/featureFlags';
import { can } from '../../../../../../../lib/permissions';
import {
	createProjectRisk,
	isValidRiskProjectRef,
	listRiskOwnerOptions,
	validateRiskFormInput,
} from '../../../../../../../lib/projectRisks';
import { buildProjectPath, buildProjectRiskPath, buildProjectRisksPath, getWorkspaceBySlug } from '../../../../../../../lib/projects';
import { buildLoginRedirectPath, createSupabaseServerClient, getServerAccessToken, isSupabaseAuthSessionError } from '../../../../../../../lib/supabaseServer';

const projectSlug = Astro.params.projectId;
const workspaceSlug = Astro.params.workspaceSlug;
const accessToken = getServerAccessToken(Astro.cookies);
const sessionRedirectPath = buildLoginRedirectPath(Astro.url.pathname);
let project = null;
let ownerOptions = [];
let workspaceName = '';
let workspaceRole = '';
let message = '';
let saveMessage = '';
let formErrors = {};
let featureAccess = getFeatureAccess('riskManagement');
let canCreateRisk = false;
let formValues = {
	title: '',
	description: '',
	status: 'draft',
	probability: '',
	impact: '',
	ownerId: '',
	actionerId: '',
	reviewDate: '',
	dueDate: '',
	mitigationPlan: '',
	contingencyPlan: '',
};

const formDataToValues = (formData) => ({
	title: String(formData.get('title') ?? ''),
	description: String(formData.get('description') ?? ''),
	status: 'draft',
	probability: String(formData.get('probability') ?? ''),
	impact: String(formData.get('impact') ?? ''),
	ownerId: String(formData.get('owner_id') ?? ''),
	actionerId: String(formData.get('actioner_id') ?? ''),
	reviewDate: String(formData.get('review_date') ?? ''),
	dueDate: String(formData.get('due_date') ?? ''),
	mitigationPlan: String(formData.get('mitigation_plan') ?? ''),
	contingencyPlan: String(formData.get('contingency_plan') ?? ''),
});

try {
	if (!accessToken) return Astro.redirect(sessionRedirectPath);
	const serverSupabase = createSupabaseServerClient(accessToken);
	const workspace = await getWorkspaceBySlug(serverSupabase, workspaceSlug ?? '', accessToken);
	const organisation = Array.isArray(workspace?.organisations) ? workspace?.organisations[0] : workspace?.organisations;

	if (!workspace || !organisation) {
		message = 'Project not found or you do not have access.';
		Astro.response.status = 404;
	} else if (!can(workspace.role, 'risk.view')) {
		message = 'You do not have permission to view project risks.';
		Astro.response.status = 403;
	} else {
		workspaceName = organisation.name;
		workspaceRole = workspace.role;
		canCreateRisk = can(workspace.role, 'risk.create');
		const { data, error } = await serverSupabase
			.from('projects')
			.select('id, name, project_ref, slug')
			.eq('slug', projectSlug)
			.eq('organisation_id', organisation.id)
			.is('deleted_at', null)
			.is('archived_at', null)
			.maybeSingle();
		if (error) throw error;

		if (!data) {
			message = 'Project not found or you do not have access.';
			Astro.response.status = 404;
		} else {
			featureAccess = await loadFeatureAccess(serverSupabase, 'riskManagement', accessToken);
			if (!featureAccess.isAccessible) {
				message = featureAccess.unavailableReason ?? 'This feature is not currently available to your account.';
				Astro.response.status = featureAccess.state === 'hidden' ? 404 : 403;
			} else {
				project = data;
				if (!canCreateRisk) {
					message = 'Viewer access is read-only. Risk creation is unavailable.';
					Astro.response.status = 403;
				} else if (!isValidRiskProjectRef(data.project_ref)) {
					message = 'This project needs a valid project reference before risks can be created.';
					canCreateRisk = false;
					Astro.response.status = 403;
				} else {
					try {
						ownerOptions = await listRiskOwnerOptions(organisation.id, workspace.role, serverSupabase);
					} catch (error) {
						if (isSupabaseAuthSessionError(error)) return Astro.redirect(sessionRedirectPath);
						ownerOptions = [];
					}

					if (Astro.request.method === 'POST') {
						const formData = await Astro.request.formData();
						formValues = formDataToValues(formData);
						formErrors = validateRiskFormInput(formValues, { mode: 'create' });

						if (Object.keys(formErrors).length === 0) {
							try {
								const risk = await createProjectRisk(workspaceSlug ?? '', projectSlug ?? '', formValues, serverSupabase, accessToken);
								return Astro.redirect(`${buildProjectRiskPath(workspaceSlug ?? '', data.slug, risk.risk_id)}?created=draft`);
							} catch (error) {
								if (isSupabaseAuthSessionError(error)) return Astro.redirect(sessionRedirectPath);
								const errorMessage = error instanceof Error ? error.message : 'Unable to create risk.';
								formErrors = errorMessage.includes('actioner')
									? { actionerId: errorMessage }
									: errorMessage.includes('owner')
									? { ownerId: errorMessage }
									: { general: errorMessage };
							}
						}
						saveMessage = formErrors.general ?? 'Please fix the highlighted fields.';
					}
				}
			}
		}
	}
} catch (error) {
	if (isSupabaseAuthSessionError(error)) return Astro.redirect(sessionRedirectPath);
	message = error instanceof Error ? error.message : 'Unable to load Risk Management.';
	Astro.response.status = 500;
}
---
<AuthenticatedLayout title={project ? `New Risk — ${project.name} | WatchTower` : 'New Risk | WatchTower'}>
	<section class="risk-form-page" data-risk-new-route data-feature-state={featureAccess.state}>
		{project && canCreateRisk ? (
			<>
				<ProjectPageHero
					workspaceName={workspaceName}
					projectName={project.name}
					projectRef={project.project_ref}
					title="New Risk"
					description="Create a project-level source-of-truth risk record."
					headingId="risk-new-heading"
				/>

				<ProjectControlPanel title="Risk controls" status="Create risk" headingId="risk-new-controls-heading">
					<p class="risk-form-page__copy">This risk will be created as a Draft for review and assessment.</p>
				</ProjectControlPanel>

				<ProjectContentPanel
					title="Draft risk details"
					helper="Only the title is required now. Optional details can be added now or refined before opening."
					headingId="risk-new-form-heading"
				>
					<RiskForm
						mode="create"
						values={formValues}
						errors={formErrors}
						ownerOptions={ownerOptions}
						actionerOptions={ownerOptions}
						projectRef={project.project_ref}
						message={saveMessage}
						cancelHref={buildProjectRisksPath(workspaceSlug ?? '', project.slug)}
					/>
				</ProjectContentPanel>
			</>
		) : (
			<section class="content-card" data-risk-create-unavailable-message>
				<p class="eyebrow">Risk Management</p>
				<h1>Risk creation unavailable</h1>
				<p>{message || saveMessage}</p>
				<a class="button button--secondary" href={project ? buildProjectRisksPath(workspaceSlug ?? '', project.slug) : (workspaceSlug && projectSlug ? buildProjectPath(workspaceSlug, projectSlug) : '/app/projects')}>Back to Risk Register</a>
			</section>
		)}
	</section>
</AuthenticatedLayout>

<style>
	.risk-form-page {
		display: grid;
		gap: 0.9rem;
	}

	.risk-form-page :global(.project-content-panel h2) {
		font-size: clamp(1.45rem, 2.4vw, 2rem);
	}

	.risk-form-page__copy {
		margin: 0.7rem 0 0;
		color: var(--muted-strong);
	}
</style>
