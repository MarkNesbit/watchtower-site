---
import AuthenticatedLayout from '../../../../../../../../layouts/AuthenticatedLayout.astro';
import ProjectContentPanel from '../../../../../../../../components/app/ProjectContentPanel.astro';
import ProjectControlPanel from '../../../../../../../../components/app/ProjectControlPanel.astro';
import ProjectPageHero from '../../../../../../../../components/app/ProjectPageHero.astro';
import RiskForm from '../../../../../../../../components/app/RiskForm.astro';
import { getFeatureAccess, loadFeatureAccess } from '../../../../../../../../lib/featureFlags';
import { can } from '../../../../../../../../lib/permissions';
import {
	getProjectRisk,
	listRiskOwnerOptions,
	updateProjectRisk,
	validateRiskFormInput,
} from '../../../../../../../../lib/projectRisks';
import { buildProjectPath, buildProjectRiskPath, buildProjectRisksPath, getWorkspaceBySlug } from '../../../../../../../../lib/projects';
import { createSupabaseServerClient, getServerAccessToken } from '../../../../../../../../lib/supabaseServer';

const projectSlug = Astro.params.projectId;
const riskId = Astro.params.riskId;
const workspaceSlug = Astro.params.workspaceSlug;
const accessToken = getServerAccessToken(Astro.cookies);
let project = null;
let risk = null;
let ownerOptions = [];
let workspaceName = '';
let workspaceRole = '';
let message = '';
let saveMessage = '';
let formErrors = {};
let featureAccess = getFeatureAccess('riskManagement');
let canEditRisk = false;
let formValues = {
	title: '',
	description: '',
	status: 'open',
	ragStatus: 'blue',
	ownerId: '',
	reviewDate: '',
};

const formDataToValues = (formData) => ({
	title: String(formData.get('title') ?? ''),
	description: String(formData.get('description') ?? ''),
	status: String(formData.get('status') ?? 'open'),
	ragStatus: String(formData.get('rag_status') ?? 'blue'),
	ownerId: String(formData.get('owner_id') ?? ''),
	reviewDate: String(formData.get('review_date') ?? ''),
});

const riskToValues = (record) => ({
	title: record?.title ?? '',
	description: record?.description ?? '',
	status: record?.status ?? 'open',
	ragStatus: record?.rag_status ?? 'blue',
	ownerId: record?.owner_id ?? '',
	reviewDate: record?.review_date ?? '',
});

try {
	const serverSupabase = createSupabaseServerClient(accessToken);
	const workspace = await getWorkspaceBySlug(serverSupabase, workspaceSlug ?? '', accessToken);
	const organisation = Array.isArray(workspace?.organisations) ? workspace?.organisations[0] : workspace?.organisations;

	if (!workspace || !organisation) {
		message = 'Risk not found or you do not have access.';
		Astro.response.status = 404;
	} else if (!can(workspace.role, 'risk.view')) {
		message = 'You do not have permission to view project risks.';
		Astro.response.status = 403;
	} else {
		workspaceName = organisation.name;
		workspaceRole = workspace.role;
		canEditRisk = can(workspace.role, 'risk.edit');
		const { data, error } = await serverSupabase
			.from('projects')
			.select('id, name, project_ref, slug')
			.eq('slug', projectSlug)
			.eq('organisation_id', organisation.id)
			.is('deleted_at', null)
			.is('archived_at', null)
			.maybeSingle();
		if (error) throw error;

		if (!data) {
			message = 'Risk not found or you do not have access.';
			Astro.response.status = 404;
		} else {
			featureAccess = await loadFeatureAccess(serverSupabase, 'riskManagement', accessToken);
			if (!featureAccess.isAccessible) {
				message = featureAccess.unavailableReason ?? 'This feature is not currently available to your account.';
				Astro.response.status = featureAccess.state === 'hidden' ? 404 : 403;
			} else {
				project = data;
				risk = riskId
					? await getProjectRisk(organisation.id, data.id, riskId, workspace.role, serverSupabase)
					: null;

				if (!risk) {
					message = 'Risk not found or you do not have access.';
					Astro.response.status = 404;
				} else if (!canEditRisk) {
					message = 'Viewer access is read-only. Risk editing is unavailable.';
					Astro.response.status = 403;
				} else {
					try {
						ownerOptions = await listRiskOwnerOptions(organisation.id, workspace.role, serverSupabase);
					} catch {
						ownerOptions = [];
					}

					formValues = riskToValues(risk);
					if (Astro.request.method === 'POST') {
						const formData = await Astro.request.formData();
						formValues = formDataToValues(formData);
						formErrors = validateRiskFormInput(formValues);

						if (Object.keys(formErrors).length === 0) {
							try {
								await updateProjectRisk(workspaceSlug ?? '', projectSlug ?? '', risk.risk_id, formValues, serverSupabase, accessToken);
								return Astro.redirect(buildProjectRiskPath(workspaceSlug ?? '', data.slug, risk.risk_id));
							} catch (error) {
								const errorMessage = error instanceof Error ? error.message : 'Unable to save risk.';
								formErrors = errorMessage.includes('owner')
									? { ownerId: errorMessage }
									: { general: errorMessage };
							}
						}
						saveMessage = formErrors.general ?? 'Please fix the highlighted fields.';
					}
				}
			}
		}
	}
} catch (error) {
	message = error instanceof Error ? error.message : 'Unable to load risk edit.';
	Astro.response.status = 500;
}
---
<AuthenticatedLayout title={risk && project ? `Edit ${risk.risk_ref} — ${project.name} | WatchTower` : 'Edit Risk | WatchTower'}>
	<section class="risk-form-page" data-risk-edit-route data-feature-state={featureAccess.state}>
		{project && risk && canEditRisk ? (
			<>
				<ProjectPageHero
					workspaceName={workspaceName}
					projectName={project.name}
					projectRef={project.project_ref}
					title={`Edit ${risk.risk_ref}`}
					description={risk.title}
					headingId="risk-edit-heading"
				/>

				<ProjectControlPanel title="Risk controls" status="Edit risk" headingId="risk-edit-controls-heading">
					<p class="risk-form-page__copy">Saving this form updates the Risk record only. It does not create diary entries, attention items, notifications or health score changes.</p>
				</ProjectControlPanel>

				<ProjectContentPanel
					title="Risk details"
					helper="Update the source-of-truth fields for this project risk."
					headingId="risk-edit-form-heading"
				>
					<RiskForm
						mode="edit"
						values={formValues}
						errors={formErrors}
						ownerOptions={ownerOptions}
						projectRef={project.project_ref}
						riskRef={risk.risk_ref}
						message={saveMessage}
						cancelHref={buildProjectRiskPath(workspaceSlug ?? '', project.slug, risk.risk_id)}
					/>
				</ProjectContentPanel>
			</>
		) : (
			<section class="content-card" data-risk-edit-unavailable-message>
				<p class="eyebrow">Risk Management</p>
				<h1>Risk editing unavailable</h1>
				<p>{message}</p>
				<a class="button button--secondary" href={project ? buildProjectRisksPath(workspaceSlug ?? '', project.slug) : (workspaceSlug && projectSlug ? buildProjectPath(workspaceSlug, projectSlug) : '/app/projects')}>Back to Risk Register</a>
			</section>
		)}
	</section>
</AuthenticatedLayout>

<style>
	.risk-form-page {
		display: grid;
		gap: 0.9rem;
	}

	.risk-form-page :global(.project-content-panel h2) {
		font-size: clamp(1.45rem, 2.4vw, 2rem);
	}

	.risk-form-page__copy {
		margin: 0.7rem 0 0;
		color: var(--muted-strong);
	}
</style>
