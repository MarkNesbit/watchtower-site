---
import AuthenticatedLayout from '../../../../../../../layouts/AuthenticatedLayout.astro';
import ProjectContentPanel from '../../../../../../../components/app/ProjectContentPanel.astro';
import ProjectControlPanel from '../../../../../../../components/app/ProjectControlPanel.astro';
import ProjectPageHero from '../../../../../../../components/app/ProjectPageHero.astro';
import RagReferencePill from '../../../../../../../components/app/RagReferencePill.astro';
import { getFeatureAccess, loadFeatureAccess } from '../../../../../../../lib/featureFlags';
import { can } from '../../../../../../../lib/permissions';
import {
	RISK_LEVELS,
	RISK_STATUSES,
	createProjectRiskComment,
	deriveRiskReferenceTone,
	getRiskAssuranceBlocks,
	getProjectRisk,
	isActiveRiskStatus,
	isClosedRiskStatus,
	isDraftRiskStatus,
	listProjectRiskComments,
	listRiskOwnerOptions,
	riskDisplayLabel,
	riskLifecycleLabel,
	riskProfileName,
	riskReferenceStatusLabel,
	transitionProjectRiskLifecycle,
} from '../../../../../../../lib/projectRisks';
import { buildProjectPath, buildProjectRiskEditPath, buildProjectRisksPath, getWorkspaceBySlug } from '../../../../../../../lib/projects';
import { buildLoginRedirectPath, createSupabaseServerClient, getServerAccessToken, isSupabaseAuthSessionError } from '../../../../../../../lib/supabaseServer';

const projectSlug = Astro.params.projectId;
const riskId = Astro.params.riskId;
const workspaceSlug = Astro.params.workspaceSlug;
const accessToken = getServerAccessToken(Astro.cookies);
const sessionRedirectPath = buildLoginRedirectPath(Astro.url.pathname);
let project = null;
let risk = null;
let comments = [];
let ownerOptions = [];
let workspaceName = '';
let workspaceRole = '';
let message = '';
let commentError = '';
let lifecycleError = '';
let featureAccess = getFeatureAccess('riskManagement');

const formatDate = (value, fallback = 'Not available') => value
	? new Intl.DateTimeFormat('en-GB', { dateStyle: 'medium', timeZone: 'UTC' }).format(new Date(value))
	: fallback;
const formatDateTime = (value, fallback = 'Not available') => value
	? `${new Intl.DateTimeFormat('en-GB', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'UTC' }).format(new Date(value))} UTC`
	: fallback;
const creatorName = (record) => riskProfileName(record.creator, 'Workspace member');
const updaterName = (record) => record.updated_by ? riskProfileName(record.updater, 'Workspace member') : 'Not available';
const commentAuthorName = (comment) => riskProfileName(comment.author, 'Workspace member');

try {
	const serverSupabase = createSupabaseServerClient(accessToken);
	const workspace = await getWorkspaceBySlug(serverSupabase, workspaceSlug ?? '', accessToken);
	const organisation = Array.isArray(workspace?.organisations) ? workspace?.organisations[0] : workspace?.organisations;

	if (!workspace || !organisation) {
		message = 'Risk not found or you do not have access.';
		Astro.response.status = 404;
	} else if (!can(workspace.role, 'risk.view')) {
		message = 'You do not have permission to view project risks.';
		Astro.response.status = 403;
	} else {
		workspaceName = organisation.name;
		workspaceRole = workspace.role;
		const { data, error } = await serverSupabase
			.from('projects')
			.select('id, name, project_ref, slug')
			.eq('slug', projectSlug)
			.eq('organisation_id', organisation.id)
			.is('deleted_at', null)
			.is('archived_at', null)
			.maybeSingle();
		if (error) throw error;

		if (!data) {
			message = 'Risk not found or you do not have access.';
			Astro.response.status = 404;
		} else {
			featureAccess = await loadFeatureAccess(serverSupabase, 'riskManagement', accessToken);
			if (!featureAccess.isAccessible) {
				message = featureAccess.unavailableReason ?? 'This feature is not currently available to your account.';
				Astro.response.status = featureAccess.state === 'hidden' ? 404 : 403;
			} else {
				project = data;
				risk = riskId
					? await getProjectRisk(organisation.id, data.id, riskId, workspace.role, serverSupabase)
					: null;
				if (!risk) {
					message = 'Risk not found or you do not have access.';
					Astro.response.status = 404;
				} else {
					if (can(workspace.role, 'risk.edit')) {
						try {
							ownerOptions = await listRiskOwnerOptions(organisation.id, workspace.role, serverSupabase);
						} catch (error) {
							if (isSupabaseAuthSessionError(error)) return Astro.redirect(sessionRedirectPath);
							ownerOptions = [];
						}
					}

					if (Astro.request.method === 'POST') {
						if (!accessToken) return Astro.redirect(sessionRedirectPath);
						const formData = await Astro.request.formData();
						const intent = String(formData.get('intent') ?? '');
						if (intent === 'add-comment') {
							try {
								await createProjectRiskComment(workspaceSlug ?? '', data.slug, risk.risk_id, String(formData.get('comment') ?? ''), serverSupabase, accessToken);
								return Astro.redirect(Astro.url.pathname);
							} catch (error) {
								if (isSupabaseAuthSessionError(error)) return Astro.redirect(sessionRedirectPath);
								commentError = error instanceof Error ? error.message : 'Unable to add comment.';
							}
						} else if (intent === 'risk-lifecycle') {
							try {
								await transitionProjectRiskLifecycle(
									workspaceSlug ?? '',
									data.slug,
									risk.risk_id,
									String(formData.get('lifecycle_action') ?? ''),
									String(formData.get('reason') ?? ''),
									serverSupabase,
									accessToken,
								);
								return Astro.redirect(Astro.url.pathname);
							} catch (error) {
								if (isSupabaseAuthSessionError(error)) return Astro.redirect(sessionRedirectPath);
								lifecycleError = error instanceof Error ? error.message : 'Unable to update the risk lifecycle.';
							}
						}
					}

					comments = await listProjectRiskComments(organisation.id, data.id, risk.risk_id, workspace.role, serverSupabase);
				}
			}
		}
	}
} catch (error) {
	if (isSupabaseAuthSessionError(error)) return Astro.redirect(sessionRedirectPath);
	message = error instanceof Error ? error.message : 'Unable to load risk detail.';
	Astro.response.status = 500;
}

const canEditRisk = can(workspaceRole, 'risk.edit');
const editHref = project && risk ? buildProjectRiskEditPath(workspaceSlug ?? '', project.slug, risk.risk_id) : '';
const assuranceBlocks = risk ? getRiskAssuranceBlocks(risk, new Date()) : [];
const referenceTone = risk ? deriveRiskReferenceTone(risk, new Date()) : 'neutral';
const referenceStatus = risk ? riskReferenceStatusLabel(risk, new Date()) : 'Neutral';
const riskIsDraft = risk ? isDraftRiskStatus(risk.status) : false;
const riskIsActive = risk ? isActiveRiskStatus(risk.status) : false;
const riskIsClosed = risk ? isClosedRiskStatus(risk.status) : false;
const editActionLabel = riskIsDraft ? 'Continue editing' : 'Edit Risk';
const blockValue = (block) => {
	if (block.id === 'review-date') return formatDate(risk?.review_date, block.value);
	if (block.id === 'due-date') return formatDate(risk?.due_date, block.value);
	if (block.id === 'updated') return formatDateTime(risk?.updated_at, block.value);
	return block.value;
};
const riskFormFields = risk ? {
	title: risk.title ?? '',
	description: risk.description ?? '',
	status: risk.status ?? 'open',
	probability: risk.probability ?? 'medium',
	impact: risk.impact ?? 'medium',
	owner_id: risk.owner_id ?? '',
	actioner_id: risk.actioner_id ?? '',
	review_date: risk.review_date ?? '',
	due_date: risk.due_date ?? '',
	mitigation_plan: risk.mitigation_plan ?? '',
	contingency_plan: risk.contingency_plan ?? '',
} : {};
const modalConfigs = {
	description: { title: 'Edit summary', fields: ['title', 'description'], submit: 'Save summary' },
	status: { title: 'Edit lifecycle status', fields: ['status'], submit: 'Save status' },
	exposure: { title: 'Edit exposure', fields: ['probability', 'impact'], submit: 'Save exposure' },
	owner: { title: 'Edit risk owner', fields: ['owner_id'], submit: 'Save owner' },
	actioner: { title: 'Edit action responsibility', fields: ['actioner_id'], submit: 'Save actioner' },
	'review-date': { title: 'Edit review cadence', fields: ['review_date'], submit: 'Save review date' },
	'due-date': { title: 'Edit due date', fields: ['due_date'], submit: 'Save due date' },
	mitigation: { title: 'Edit mitigation plan', fields: ['mitigation_plan'], submit: 'Save mitigation plan' },
	contingency: { title: 'Edit contingency plan', fields: ['contingency_plan'], submit: 'Save contingency plan' },
	updated: { title: 'Review risk record', fields: ['title', 'description', 'status', 'review_date'], submit: 'Save review' },
};
const modalConfig = (blockId) => modalConfigs[blockId] ?? modalConfigs.description;
const hasModalConfig = (blockId) => Boolean(modalConfigs[blockId]);
const hiddenFieldsFor = (blockId) => Object.entries(riskFormFields).filter(([name]) => !modalConfig(blockId).fields.includes(name));
const modalHasField = (blockId, fieldName) => modalConfig(blockId).fields.includes(fieldName);
---
<AuthenticatedLayout title={risk && project ? `${risk.risk_ref} — ${project.name} | WatchTower` : 'Risk detail | WatchTower'}>
	<section class="risk-detail-page" data-risk-detail-route data-feature-state={featureAccess.state}>
		{project && risk ? (
			<>
				<ProjectPageHero
					workspaceName={workspaceName}
					projectName={project.name}
					projectRef={project.project_ref}
					title={risk.risk_ref}
					description={risk.title}
					headingId="risk-detail-heading"
				>
					<h1 slot="title" id="risk-detail-heading" class="risk-detail-heading">
						<span class="risk-detail-heading__reference">
							<RagReferencePill
								tone={referenceTone}
								label={risk.risk_ref}
								statusLabel={referenceStatus}
								ariaLabel={`${risk.risk_ref}, ${referenceStatus}`}
							/>
						</span>
					</h1>
				</ProjectPageHero>

				<nav class="risk-detail-top-links" aria-label="Risk navigation">
					<a class="button button--secondary" href={buildProjectRisksPath(workspaceSlug ?? '', project.slug)}>Back to Risk Register</a>
					<a class="button button--secondary" href={buildProjectPath(workspaceSlug ?? '', project.slug)}>Back to project</a>
				</nav>

				<ProjectControlPanel title="Current risk" headingId="risk-detail-controls-heading">
					<dl class="risk-detail-summary-strip" data-risk-summary-strip>
						<div>
							<dt>Lifecycle status</dt>
							<dd>{riskLifecycleLabel(risk.status)} / {riskDisplayLabel(risk.status)}</dd>
						</div>
						<div>
							<dt>Created by</dt>
							<dd>{creatorName(risk)}</dd>
						</div>
						<div>
							<dt>Updated by</dt>
							<dd>{updaterName(risk)}</dd>
						</div>
						<div>
							<dt>Updated</dt>
							<dd><time datetime={risk.updated_at}>{formatDateTime(risk.updated_at)}</time></dd>
						</div>
					</dl>
					{canEditRisk && (
						<div class="risk-lifecycle-actions" data-risk-lifecycle-actions>
							{riskIsDraft && (
								<form method="post" data-risk-lifecycle-form>
									<input type="hidden" name="intent" value="risk-lifecycle" />
									<input type="hidden" name="lifecycle_action" value="open" />
									<label>
										<span>Open note</span>
										<textarea name="reason" rows="2" placeholder="Optional note for the risk history"></textarea>
									</label>
									<button class="button button--primary" type="submit" data-risk-open-action>Open / Publish risk</button>
								</form>
							)}
							{riskIsActive && (
								<form method="post" data-risk-lifecycle-form>
									<input type="hidden" name="intent" value="risk-lifecycle" />
									<input type="hidden" name="lifecycle_action" value="close" />
									<label>
										<span>Closure reason</span>
										<textarea name="reason" rows="2" placeholder="Optional closure note"></textarea>
									</label>
									<button class="button button--secondary" type="submit" data-risk-close-action>Close risk</button>
								</form>
							)}
							{riskIsClosed && (
								<form method="post" data-risk-lifecycle-form>
									<input type="hidden" name="intent" value="risk-lifecycle" />
									<input type="hidden" name="lifecycle_action" value="reopen" />
									<label>
										<span>Reopen reason</span>
										<textarea name="reason" rows="2" placeholder="Optional reopen note"></textarea>
									</label>
									<button class="button button--primary" type="submit" data-risk-reopen-action>Reopen risk</button>
								</form>
							)}
							{lifecycleError && <p class="field-error" role="alert" data-risk-lifecycle-error>{lifecycleError}</p>}
						</div>
					)}
				</ProjectControlPanel>

				<ProjectContentPanel
					title="Core Risk Detail"
					helper="Open a card to update the field behind that assurance signal."
					headingId="risk-detail-record-heading"
				>
					<div slot="action" class="risk-detail-action">
						{canEditRisk ? (
							<a
								class="button button--primary"
								href={editHref}
								data-risk-edit-action
							>{editActionLabel}</a>
						) : (
							<button
								class="button button--primary"
								type="button"
								disabled
								aria-label="Viewer access is read-only. Risk editing is unavailable."
								data-risk-edit-disabled
								data-viewer-read-only
							>{editActionLabel}</button>
						)}
					</div>

					<div class="risk-assurance-grid" data-risk-assurance-blocks>
						{assuranceBlocks.map((block) => (
							<article class={`risk-assurance-block risk-assurance-block--${block.tone} rag-card rag-card--${block.tone}`} data-risk-assurance-block={block.id} data-assurance-tone={block.tone}>
								{hasModalConfig(block.id) ? (
									<>
										<button class="risk-assurance-block__button" type="button" aria-haspopup="dialog" data-risk-dialog-open={`risk-dialog-${block.id}`}>
											<span class="risk-assurance-block__heading">
												<span class="risk-assurance-block__title">{block.title}</span>
												<RagReferencePill tone={block.tone} label={block.statusLabel} />
											</span>
											<span class="risk-assurance-block__value">{blockValue(block)}</span>
											{block.prompt && <span class="risk-assurance-block__prompt">{block.prompt}</span>}
										</button>

										<dialog class="risk-action-dialog" id={`risk-dialog-${block.id}`} aria-labelledby={`risk-dialog-${block.id}-title`} data-risk-dialog data-risk-modal-backdrop-blur>
											<div class="risk-action-dialog__header">
												<div>
													<p class="eyebrow">{block.title}</p>
													<h3 id={`risk-dialog-${block.id}-title`}>{modalConfig(block.id).title}</h3>
												</div>
												<form method="dialog">
													<button class="risk-action-dialog__close" type="submit" aria-label="Close">x</button>
												</form>
											</div>

											{canEditRisk ? (
												<form class="risk-action-form" method="post" action={editHref} data-risk-detail-save-form>
													{hiddenFieldsFor(block.id).map(([name, value]) => (
														<input type="hidden" name={name} value={value} />
													))}

											{modalHasField(block.id, 'title') && (
												<label>
													<span>Risk title</span>
													<input name="title" value={riskFormFields.title} required autocomplete="off" />
												</label>
											)}

											{modalHasField(block.id, 'description') && (
												<label>
													<span>Description</span>
													<textarea name="description" rows="5">{riskFormFields.description}</textarea>
												</label>
											)}

											{modalHasField(block.id, 'status') && (
												<label>
													<span>Status</span>
													<select name="status" required>
														{RISK_STATUSES.map((status) => <option value={status} selected={riskFormFields.status === status}>{riskDisplayLabel(status)}</option>)}
													</select>
												</label>
											)}

											{modalHasField(block.id, 'probability') && (
												<label>
													<span>Probability</span>
													<select name="probability" required>
														{RISK_LEVELS.map((level) => <option value={level} selected={riskFormFields.probability === level}>{riskDisplayLabel(level)}</option>)}
													</select>
												</label>
											)}

											{modalHasField(block.id, 'impact') && (
												<label>
													<span>Impact</span>
													<select name="impact" required>
														{RISK_LEVELS.map((level) => <option value={level} selected={riskFormFields.impact === level}>{riskDisplayLabel(level)}</option>)}
													</select>
												</label>
											)}

											{modalHasField(block.id, 'owner_id') && (
												<label>
													<span>Risk owner</span>
													<select name="owner_id">
														<option value="">Unassigned</option>
														{ownerOptions.map((owner) => (
															<option value={owner.id} selected={riskFormFields.owner_id === owner.id}>{riskProfileName(owner, `Workspace member ${owner.id.slice(0, 8)}`)}</option>
														))}
													</select>
												</label>
											)}

											{modalHasField(block.id, 'actioner_id') && (
												<label>
													<span>Actioner</span>
													<select name="actioner_id">
														<option value="">Unassigned</option>
														{ownerOptions.map((actioner) => (
															<option value={actioner.id} selected={riskFormFields.actioner_id === actioner.id}>{riskProfileName(actioner, `Workspace member ${actioner.id.slice(0, 8)}`)}</option>
														))}
													</select>
												</label>
											)}

											{modalHasField(block.id, 'review_date') && (
												<label>
													<span>Review date</span>
													<div class="risk-date-quick-actions" aria-label="Review date quick actions">
														<button type="button" data-review-date-offset="7">1 week</button>
														<button type="button" data-review-date-offset="14">2 weeks</button>
														<button type="button" data-review-date-manual>Manual</button>
													</div>
													<input name="review_date" type="date" value={riskFormFields.review_date} />
												</label>
											)}

											{modalHasField(block.id, 'due_date') && (
												<label>
													<span>Due date</span>
													<input name="due_date" type="date" value={riskFormFields.due_date} />
												</label>
											)}

											{modalHasField(block.id, 'mitigation_plan') && (
												<label>
													<span>Mitigation plan</span>
													<textarea name="mitigation_plan" rows="6">{riskFormFields.mitigation_plan}</textarea>
												</label>
											)}

											{modalHasField(block.id, 'contingency_plan') && (
												<label>
													<span>Contingency plan</span>
													<textarea name="contingency_plan" rows="6">{riskFormFields.contingency_plan}</textarea>
												</label>
											)}

											<div class="risk-action-form__actions">
												<button class="button button--secondary" type="button" data-risk-dialog-cancel>Cancel</button>
												<button class="button button--primary" type="submit">{modalConfig(block.id).submit}</button>
											</div>
												</form>
											) : (
												<div class="risk-action-form" data-viewer-read-only>
													<p>{blockValue(block)}</p>
													<p>Viewer access is read-only. Risk editing is unavailable.</p>
													<form method="dialog">
														<button class="button button--secondary" type="submit">Close</button>
													</form>
												</div>
											)}
										</dialog>
									</>
								) : (
									<div class="risk-assurance-block__button risk-assurance-block__button--static">
										<span class="risk-assurance-block__heading">
											<span class="risk-assurance-block__title">{block.title}</span>
											<RagReferencePill tone={block.tone} label={block.statusLabel} />
										</span>
										<span class="risk-assurance-block__value">{blockValue(block)}</span>
										{block.prompt && <span class="risk-assurance-block__prompt">{block.prompt}</span>}
									</div>
								)}
							</article>
						))}
					</div>

					<section class="risk-comments-section" aria-labelledby="risk-comments-heading" data-risk-comments-section>
						<div class="risk-comments-section__heading">
							<h3 id="risk-comments-heading">Comments</h3>
						</div>

						<form class="risk-comment-form" method="post" data-risk-comment-form>
							<input type="hidden" name="intent" value="add-comment" />
							<label for="risk-comment">Add comment</label>
							<textarea id="risk-comment" name="comment" rows="3" required disabled={!canEditRisk} aria-describedby={commentError ? 'risk-comment-error' : undefined}></textarea>
							{commentError && <p class="field-error" id="risk-comment-error">{commentError}</p>}
							<div class="risk-comment-form__actions">
								<button class="button button--primary" type="submit" disabled={!canEditRisk}>Add comment</button>
							</div>
						</form>

						<div class="risk-comments-list" data-risk-comments-list>
							{comments.length > 0 ? comments.map((comment) => (
								<article class="risk-comment" data-risk-comment>
									<header>
										<strong>{commentAuthorName(comment)}</strong>
										<time datetime={comment.created_at}>{formatDateTime(comment.created_at)}</time>
									</header>
									<p>{comment.note}</p>
								</article>
							)) : (
								<p class="risk-comments-empty">No comments yet.</p>
							)}
						</div>
					</section>

					<div class="risk-detail-links">
						<a class="button button--secondary" href={buildProjectRisksPath(workspaceSlug ?? '', project.slug)}>Back to Risk Register</a>
						<a class="button button--secondary" href={buildProjectPath(workspaceSlug ?? '', project.slug)}>Back to project</a>
					</div>
				</ProjectContentPanel>
			</>
		) : (
			<section class="content-card" data-risk-detail-unavailable-message>
				<p class="eyebrow">Risk Management</p>
				<h1>Risk unavailable</h1>
				<p>{message}</p>
				<a class="button button--secondary" href={workspaceSlug && projectSlug ? buildProjectRisksPath(workspaceSlug, projectSlug) : '/app/projects'}>Back to Risk Register</a>
			</section>
		)}
	</section>
</AuthenticatedLayout>

<script>
	import { supabase } from '../../../../../../../lib/supabaseClient';

	const writeSessionCookies = (session) => {
		const cookieOptions = `path=/; SameSite=Lax; max-age=${session.expires_in ?? 3600}`;
		document.cookie = `wt-access-token=${session.access_token}; ${cookieOptions}`;
		document.cookie = `wt-refresh-token=${session.refresh_token}; ${cookieOptions}`;
	};

	const syncSessionBeforeSubmit = (form) => {
		let sessionSynced = false;
		form.addEventListener('submit', async (event) => {
			if (sessionSynced) return;
			event.preventDefault();
			const { data } = await supabase.auth.getSession();
			if (!data.session) {
				window.location.assign(`/login?redirectTo=${encodeURIComponent(window.location.pathname)}`);
				return;
			}

			writeSessionCookies(data.session);
			sessionSynced = true;
			if (form instanceof HTMLFormElement) form.submit();
		});
	};

	const toDateInputValue = (date) => {
		const year = date.getFullYear();
		const month = String(date.getMonth() + 1).padStart(2, '0');
		const day = String(date.getDate()).padStart(2, '0');
		return `${year}-${month}-${day}`;
	};

	document.querySelectorAll('[data-risk-dialog-open]').forEach((button) => {
		button.addEventListener('click', () => {
			if (!(button instanceof HTMLElement)) return;
			const dialog = document.getElementById(button.dataset.riskDialogOpen || '');
			if (dialog instanceof HTMLDialogElement) dialog.showModal();
		});
	});

	document.querySelectorAll('[data-risk-dialog-cancel]').forEach((button) => {
		button.addEventListener('click', () => {
			const dialog = button.closest('dialog');
			if (dialog instanceof HTMLDialogElement) dialog.close();
		});
	});

	document.querySelectorAll('[data-risk-detail-save-form], [data-risk-comment-form], [data-risk-lifecycle-form]').forEach((form) => {
		if (form instanceof HTMLFormElement) syncSessionBeforeSubmit(form);
	});

	document.querySelectorAll('[data-risk-detail-save-form]').forEach((form) => {
		const reviewDateInput = form.querySelector('[name="review_date"]');
		form.querySelectorAll('[data-review-date-offset]').forEach((button) => {
			button.addEventListener('click', () => {
				if (!(reviewDateInput instanceof HTMLInputElement) || !(button instanceof HTMLElement)) return;
				const offsetDays = Number(button.dataset.reviewDateOffset || '0');
				const date = new Date();
				date.setDate(date.getDate() + offsetDays);
				reviewDateInput.value = toDateInputValue(date);
				reviewDateInput.focus();
			});
		});

		form.querySelector('[data-review-date-manual]')?.addEventListener('click', () => {
			if (reviewDateInput instanceof HTMLInputElement) reviewDateInput.focus();
		});
	});
</script>

