	.narrative-risk-signal > span:first-child { color: var(--muted-strong); font-size: 0.75rem; font-weight: 850; text-transform: uppercase; }
	.narrative-risk-signal strong { color: var(--text); overflow-wrap: anywhere; }
	.narrative-risk-preview__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.65rem; margin: 0.7rem 0 0; }
	.narrative-risk-preview__grid div { display: grid; gap: 0.2rem; min-width: 0; }
	.narrative-risk-preview__grid .narrative-risk-preview__wide { grid-column: 1 / -1; }
	.narrative-risk-preview__grid dt { color: var(--text); font-size: 0.82rem; font-weight: 850; }
	.narrative-risk-preview__grid dd { margin: 0; overflow-wrap: anywhere; }
	.narrative-detail__meta { display: grid; gap: 0.65rem; margin: 0; padding-top: 0.85rem; border-top: 1px solid var(--border); }
	.narrative-detail__meta div { display: grid; grid-template-columns: minmax(9rem, 0.45fr) 1fr; gap: 0.75rem; }
	.narrative-detail__meta dt { color: var(--text); font-weight: 850; }
	.narrative-detail__meta dd { margin: 0; overflow-wrap: anywhere; }
	@media (max-width: 760px) {
		.narrative-attention, .narrative-link-row, .narrative-risk-preview__signals, .narrative-risk-preview__grid, .narrative-detail__meta div { grid-template-columns: 1fr; }
		.narrative-risk-preview__header { display: grid; }
		.narrative-link-row label:nth-of-type(2), .narrative-link-row input:nth-of-type(2), .narrative-link-row .button { grid-column: 1; grid-row: auto; }
		.narrative-form__actions { display: grid; }
	}
</style>
