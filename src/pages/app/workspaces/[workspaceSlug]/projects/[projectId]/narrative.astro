	.narrative-form input, .narrative-form textarea { width: 100%; border: 1px solid var(--border); border-radius: 0.75rem; padding: 0.75rem 0.85rem; background: #07111d; color: var(--text); font: inherit; }
	.narrative-form input[aria-invalid='true'], .narrative-form textarea[aria-invalid='true'] { border-color: #ff817a; box-shadow: 0 0 0 2px rgba(255, 69, 58, 0.16); }
