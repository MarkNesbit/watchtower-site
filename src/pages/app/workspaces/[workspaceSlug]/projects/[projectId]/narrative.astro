	.narrative-link-row input:nth-of-type(1) { grid-column: 1; }
	.narrative-link-row label:nth-of-type(2) { grid-column: 2; grid-row: 1; }
	.narrative-link-row input:nth-of-type(2) { grid-column: 2; }
	.narrative-link-row .button { grid-column: 3; grid-row: 2; white-space: nowrap; }
	.narrative-link-row .field-error { grid-column: span 1; }
	.narrative-add-link { justify-self: start; }
	.narrative-form__actions { display: flex; justify-content: flex-end; gap: 0.75rem; margin-top: 0.25rem; }
	.narrative-detail section { display: grid; gap: 0.35rem; }
	.narrative-detail h3 { margin: 0; font-size: 1rem; }
