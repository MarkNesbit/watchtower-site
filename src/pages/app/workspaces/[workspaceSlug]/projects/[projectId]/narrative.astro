	.narrative-attention, .narrative-links { display: grid; gap: 0.65rem; margin: 0; border: 1px solid var(--border); border-radius: 0.9rem; padding: 0.85rem; }
	.narrative-attention { grid-template-columns: repeat(4, minmax(0, 1fr)); }
	.narrative-attention legend, .narrative-links legend { padding-inline: 0.35rem; }
	.narrative-attention label { display: flex; align-items: center; gap: 0.4rem; color: var(--text); font-size: 0.9rem; }
	.narrative-links p { margin: 0; font-size: 0.86rem; }
