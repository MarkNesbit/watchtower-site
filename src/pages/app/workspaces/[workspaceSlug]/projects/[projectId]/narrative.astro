---
import AuthenticatedLayout from '../../../../../../layouts/AuthenticatedLayout.astro';
import { getFeatureAccess, loadFeatureAccess } from '../../../../../../lib/featureFlags';
import { getNarrativeDisplayRef, listProjectNarrativeEntries } from '../../../../../../lib/projectNarrative';
import { can } from '../../../../../../lib/permissions';
import { buildProjectPath, getWorkspaceBySlug } from '../../../../../../lib/projects';
import { createSupabaseServerClient, getServerAccessToken } from '../../../../../../lib/supabaseServer';

const projectSlug = Astro.params.projectId;
const workspaceSlug = Astro.params.workspaceSlug;
const accessToken = getServerAccessToken(Astro.cookies);
let project = null;
let entries = [];
let workspaceRole = '';
let message = '';
let featureAccess = getFeatureAccess('projectDiary');

try {
	const serverSupabase = createSupabaseServerClient(accessToken);
	const workspace = await getWorkspaceBySlug(serverSupabase, workspaceSlug ?? '', accessToken);
	const organisation = Array.isArray(workspace?.organisations) ? workspace?.organisations[0] : workspace?.organisations;

	if (!workspace || !organisation) {
		message = 'Project not found or you do not have access.';
		Astro.response.status = 404;
	} else if (!can(workspace.role, 'narrative.view')) {
		message = 'You do not have permission to view Project Narrative.';
		Astro.response.status = 403;
	} else {
		workspaceRole = workspace.role;
		const { data, error } = await serverSupabase
			.from('projects')
			.select('id, name, project_ref, slug')
			.eq('slug', projectSlug)
			.eq('organisation_id', organisation.id)
			.is('deleted_at', null)
			.is('archived_at', null)
			.maybeSingle();
		if (error) throw error;

		if (!data) {
			message = 'Project not found or you do not have access.';
			Astro.response.status = 404;
		} else {
			featureAccess = await loadFeatureAccess(serverSupabase, 'projectDiary', accessToken);
			if (!featureAccess.isAccessible) {
				message = featureAccess.unavailableReason ?? 'This feature is not currently available to your account.';
				Astro.response.status = featureAccess.state === 'hidden' ? 404 : 403;
			} else {
				project = data;
				entries = await listProjectNarrativeEntries(organisation.id, data.id, workspace.role, serverSupabase);
			}
		}
	}
} catch (error) {
	message = error instanceof Error ? error.message : 'Unable to load Project Narrative.';
	Astro.response.status = 500;
}

const canCreateNarrative = can(workspaceRole, 'narrative.create');
const formatAttention = (value) => value ? value.charAt(0).toUpperCase() + value.slice(1) : 'Neutral';
const formatCreatedAt = (value) => value
	? `${new Intl.DateTimeFormat('en-GB', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'UTC' }).format(new Date(value))} UTC`
	: 'Not available';
const creatorName = (entry) => {
	const creator = Array.isArray(entry.creator) ? entry.creator[0] : entry.creator;
	return creator?.display_name || creator?.email || 'Workspace member';
};
---
<AuthenticatedLayout title={project ? `Project Narrative — ${project.name} | WatchTower` : 'Project Narrative | WatchTower'}>
	<section class="narrative-page" data-project-narrative-route data-feature-state={featureAccess.state}>
		{project ? (
			<>
				<section class="content-card narrative-hero" aria-labelledby="project-narrative-heading">
					<div class="narrative-hero__heading">
						<div>
							<p class="eyebrow">{project.name}</p>
							<h1 id="project-narrative-heading">Project Narrative</h1>
							<p>A project-level timeline of key events, updates and decisions.</p>
						</div>
						<div class="narrative-action">
							<span
								class="button button--primary"
								aria-disabled="true"
								aria-describedby="narrative-action-help"
								data-viewer-read-only={!canCreateNarrative || undefined}
							>Add narrative entry</span>
							<small id="narrative-action-help">
								{canCreateNarrative ? 'Manual entry creation will be added in a later story.' : 'Viewer access is read-only. Manual entry creation is unavailable.'}
							</small>
						</div>
					</div>

					<fieldset class="narrative-filters" disabled aria-describedby="narrative-filter-help">
						<legend>Filter narrative entries</legend>
						<label>Entry/source type<select name="source-type"><option>All types</option></select></label>
						<label>Attention<select name="attention"><option>All levels</option></select></label>
						<label>Date range<select name="date-range"><option>All dates</option></select></label>
						<label>Source<select name="source"><option>All sources</option></select></label>
					</fieldset>
					<p id="narrative-filter-help" class="narrative-helper">Filters will become available in a later story.</p>
				</section>

				<section class="content-card narrative-table-card" aria-labelledby="narrative-table-heading">
					<div class="narrative-table-card__heading">
						<div>
							<p class="eyebrow">Assurance timeline</p>
							<h2 id="narrative-table-heading">Narrative entries</h2>
						</div>
						<a class="button button--secondary" href={buildProjectPath(workspaceSlug ?? '', project.slug)}>Back to project</a>
					</div>

					{entries.length === 0 ? (
						<div class="narrative-empty" data-narrative-empty-state>
							<h3>No narrative entries yet.</h3>
							<p>Project Narrative will show key project events, manual updates and future RAID-linked activity in one assurance timeline.</p>
							<p>Manual entry creation will be added in a later story.</p>
						</div>
					) : (
						<>
							<p id="narrative-ref-help" class="narrative-helper">Reference details will open from this column in a later story.</p>
							<div class="narrative-table-scroll">
								<table class="simple-table narrative-table">
									<thead>
										<tr><th scope="col">Ref</th><th scope="col">Attention</th><th scope="col">Details</th><th scope="col">Created by</th><th scope="col">Created</th></tr>
									</thead>
									<tbody>
										{entries.map((entry) => (
											<tr>
												<td><button class="narrative-ref" type="button" aria-disabled="true" aria-describedby="narrative-ref-help">{getNarrativeDisplayRef(entry)}</button></td>
												<td><span class={`attention-badge attention-badge--${entry.attention_level}`}><span aria-hidden="true" class="attention-badge__dot"></span>{formatAttention(entry.attention_level)}</span></td>
												<td class="narrative-details">{entry.title && <strong>{entry.title}</strong>}{entry.details && <span>{entry.details}</span>}</td>
												<td>{creatorName(entry)}</td>
												<td><time datetime={entry.created_at}>{formatCreatedAt(entry.created_at)}</time></td>
											</tr>
										))}
									</tbody>
								</table>
							</div>
						</>
					)}
				</section>
			</>
		) : (
			<section class="content-card" data-feature-unavailable-message>
				<p class="eyebrow">Project Narrative</p>
				<h1>Feature unavailable</h1>
				<p>{message}</p>
				<a class="button button--secondary" href={workspaceSlug && projectSlug ? buildProjectPath(workspaceSlug, projectSlug) : '/app/projects'}>Back to project</a>
			</section>
		)}
	</section>
</AuthenticatedLayout>

<style>
	.narrative-page { display: grid; gap: 0.9rem; }
	.narrative-hero { display: grid; gap: 1.5rem; background: radial-gradient(circle at 92% 8%, rgba(0, 160, 255, 0.16), transparent 18rem), linear-gradient(180deg, rgba(18, 31, 42, 0.94), rgba(8, 17, 27, 0.96)); }
	.narrative-hero__heading, .narrative-table-card__heading { display: flex; align-items: start; justify-content: space-between; gap: 1.5rem; }
	.narrative-hero__heading h1, .narrative-table-card__heading h2 { margin-bottom: 0.35rem; }
	.narrative-hero__heading p:not(.eyebrow) { margin: 0; color: var(--muted-strong); }
	.narrative-action { display: grid; justify-items: end; gap: 0.45rem; max-width: 21rem; text-align: right; }
	.narrative-action [aria-disabled='true'] { opacity: 0.68; cursor: not-allowed; }
	.narrative-action small, .narrative-helper { color: var(--muted-strong); font-size: 0.85rem; }
	.narrative-filters { display: grid; grid-template-columns: repeat(4, minmax(9rem, 1fr)); gap: 0.9rem; margin: 0; border: 0; padding: 0; }
	.narrative-filters legend { grid-column: 1 / -1; margin-bottom: 0.15rem; color: var(--text); font-weight: 850; }
	.narrative-filters label { display: grid; gap: 0.4rem; color: var(--muted-strong); font-size: 0.82rem; font-weight: 800; }
	.narrative-filters select { width: 100%; border: 1px solid var(--border); border-radius: 0.75rem; padding: 0.7rem 0.8rem; background: #07111d; color: var(--muted-strong); font: inherit; }
	.narrative-filters[disabled] { opacity: 0.72; }
	.narrative-helper { margin: -0.65rem 0 0; }
	.narrative-table-card { padding: clamp(1rem, 2vw, 1.5rem); }
	.narrative-table-card__heading { align-items: center; margin-bottom: 0.75rem; }
	.narrative-table-scroll { overflow-x: auto; }
	.narrative-table { min-width: 52rem; }
	.narrative-table th:first-child { width: 10rem; }
	.narrative-table th:nth-child(2) { width: 8rem; }
	.narrative-table th:nth-child(4) { width: 11rem; }
	.narrative-table th:last-child { width: 12rem; }
	.narrative-table td { vertical-align: top; }
	.narrative-ref { border: 0; padding: 0.15rem 0.2rem; background: transparent; color: var(--accent-strong); font: inherit; font-weight: 900; text-decoration: underline; text-decoration-thickness: 0.08em; text-underline-offset: 0.18em; cursor: not-allowed; }
	.narrative-ref:focus-visible { border-radius: 0.25rem; outline: 3px solid var(--accent-strong); outline-offset: 3px; }
	.attention-badge { display: inline-flex; align-items: center; gap: 0.45rem; border: 1px solid color-mix(in srgb, var(--attention-tone) 65%, transparent); border-radius: 999px; padding: 0.25rem 0.55rem; color: var(--text); font-size: 0.82rem; font-weight: 850; }
	.attention-badge__dot { width: 0.55rem; height: 0.55rem; border-radius: 50%; background: var(--attention-tone); }
	.attention-badge--neutral { --attention-tone: #7c8b98; color: var(--muted-strong); }
	.attention-badge--green { --attention-tone: #21d36b; }
	.attention-badge--amber { --attention-tone: #f6a400; }
	.attention-badge--red { --attention-tone: #ff453a; }
	.narrative-details { max-width: 36rem; overflow-wrap: anywhere; }
	.narrative-details strong, .narrative-details span { display: block; }
	.narrative-details span { color: var(--muted-strong); }
	.narrative-details strong + span { margin-top: 0.25rem; }
	.narrative-empty { border: 1px dashed var(--border); border-radius: 1rem; padding: clamp(1.2rem, 3vw, 2rem); background: rgba(4, 12, 24, 0.35); text-align: center; }
	.narrative-empty h3 { margin-top: 0; }
	.narrative-empty p { max-width: 48rem; margin-inline: auto; color: var(--muted-strong); }
	@media (max-width: 760px) {
		.narrative-hero__heading, .narrative-table-card__heading { display: grid; }
		.narrative-action { justify-items: start; max-width: none; text-align: left; }
		.narrative-filters { grid-template-columns: repeat(2, minmax(0, 1fr)); }
	}
	@media (max-width: 460px) { .narrative-filters { grid-template-columns: 1fr; } }
</style>
