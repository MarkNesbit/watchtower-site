---
import AuthenticatedLayout from '../../../../../../layouts/AuthenticatedLayout.astro';
import EmptyState from '../../../../../../components/app/EmptyState.astro';
import ProjectContentPanel from '../../../../../../components/app/ProjectContentPanel.astro';
import ProjectControlPanel from '../../../../../../components/app/ProjectControlPanel.astro';
import ProjectPageHero from '../../../../../../components/app/ProjectPageHero.astro';
import RagReferencePill from '../../../../../../components/app/RagReferencePill.astro';
import { getFeatureAccess, loadFeatureAccess } from '../../../../../../lib/featureFlags';
import {
	createProjectNarrativeEntry,
	getNarrativeDisplayRef,
	isNarrativeAttentionLevel,
	listProjectNarrativeEntries,
	markProjectNarrativeViewed,
	normaliseProjectNarrativeLinkUrl,
} from '../../../../../../lib/projectNarrative';
import {
	deriveRiskAssuranceTone,
	deriveRiskExposureTone,
	deriveRiskReferenceTone,
	listProjectRisksByIds,
	riskDisplayLabel,
	riskProfileName,
	riskReferenceStatusLabel,
} from '../../../../../../lib/projectRisks';
import { can } from '../../../../../../lib/permissions';
import { buildProjectPath, buildProjectRiskPath, getWorkspaceBySlug } from '../../../../../../lib/projects';
import { createSupabaseServerClient, getServerAccessToken } from '../../../../../../lib/supabaseServer';

const projectSlug = Astro.params.projectId;
const workspaceSlug = Astro.params.workspaceSlug;
const accessToken = getServerAccessToken(Astro.cookies);
let project = null;
let entries = [];
let workspaceName = '';
let workspaceRole = '';
let message = '';
let entriesLoadError = '';
let featureAccess = getFeatureAccess('projectDiary');
let sourceRisksById = new Map();
let createModalOpen = false;
let saveMessage = '';
let formValues = {
	title: '',
	attentionLevel: 'neutral',
	details: '',
};
let formLinks = [];
let formErrors = {};

const parseLinkRows = (formData) => {
	const labels = formData.getAll('link_label').map((value) => String(value ?? ''));
	const urls = formData.getAll('link_url').map((value) => String(value ?? ''));
	return Array.from({ length: Math.max(labels.length, urls.length) }, (_, index) => ({
		label: labels[index] ?? '',
		url: urls[index] ?? '',
	}));
};

const validateForm = (values, links) => {
	const errors = {};
	if (!values.title.trim()) errors.title = 'Title is required.';
	if (!values.details.trim()) errors.details = 'Details are required.';
	if (!isNarrativeAttentionLevel(values.attentionLevel)) errors.attentionLevel = 'Select a valid attention level.';

	links.forEach((link, index) => {
		if (!link.label.trim()) errors[`link_label_${index}`] = 'Link label is required when adding a link.';
		if (!link.url.trim()) {
			errors[`link_url_${index}`] = 'Link URL is required when adding a link.';
			return;
		}
		try {
			normaliseProjectNarrativeLinkUrl(link.url);
		} catch (error) {
			errors[`link_url_${index}`] = error instanceof Error ? error.message : 'Enter a valid link URL.';
		}
	});

	return errors;
};

try {
	const serverSupabase = createSupabaseServerClient(accessToken);
	const workspace = await getWorkspaceBySlug(serverSupabase, workspaceSlug ?? '', accessToken);
	const organisation = Array.isArray(workspace?.organisations) ? workspace?.organisations[0] : workspace?.organisations;

	if (!workspace || !organisation) {
		message = 'Project not found or you do not have access.';
		Astro.response.status = 404;
	} else if (!can(workspace.role, 'narrative.view')) {
		message = 'You do not have permission to view Project Narrative.';
		Astro.response.status = 403;
	} else {
		workspaceName = organisation.name;
		workspaceRole = workspace.role;
		const { data, error } = await serverSupabase
			.from('projects')
			.select('id, name, project_ref, slug')
			.eq('slug', projectSlug)
			.eq('organisation_id', organisation.id)
			.is('deleted_at', null)
			.is('archived_at', null)
			.maybeSingle();
		if (error) throw error;

		if (!data) {
			message = 'Project not found or you do not have access.';
			Astro.response.status = 404;
		} else {
			featureAccess = await loadFeatureAccess(serverSupabase, 'projectDiary', accessToken);
			if (!featureAccess.isAccessible) {
				message = featureAccess.unavailableReason ?? 'This feature is not currently available to your account.';
				Astro.response.status = featureAccess.state === 'hidden' ? 404 : 403;
			} else {
				project = data;
				if (Astro.request.method === 'POST') {
					const formData = await Astro.request.formData();
					formValues = {
						title: String(formData.get('title') ?? ''),
						attentionLevel: String(formData.get('attention_level') ?? 'neutral'),
						details: String(formData.get('details') ?? ''),
					};
					formLinks = parseLinkRows(formData);
					createModalOpen = true;

					if (!can(workspace.role, 'narrative.create')) {
						formErrors = { general: 'Your workspace role does not permit Project Narrative entry creation.' };
					} else {
						formErrors = validateForm(formValues, formLinks);
						if (Object.keys(formErrors).length === 0) {
							try {
								await createProjectNarrativeEntry(
									{
										projectId: data.id,
										title: formValues.title,
										attentionLevel: formValues.attentionLevel,
										details: formValues.details,
										createdTimezone: String(formData.get('created_timezone') ?? ''),
										links: formLinks,
									},
									workspace.role,
									serverSupabase,
								);
								return Astro.redirect(Astro.url.pathname);
							} catch (error) {
								formErrors = { general: error instanceof Error ? error.message : 'Unable to save narrative entry.' };
							}
						}
					}
					saveMessage = formErrors.general ?? 'Please fix the highlighted fields.';
				}
				try {
					entries = await listProjectNarrativeEntries(organisation.id, data.id, workspace.role, serverSupabase);
					try {
						await markProjectNarrativeViewed(organisation.id, data.id, workspace.role, serverSupabase, accessToken);
					} catch {
						// Read-state is personal view metadata; a transient failure must not block Narrative access.
					}
					const riskSourceIds = entries
						.filter((entry) => entry.source_type === 'risk' && entry.source_record_id)
						.map((entry) => entry.source_record_id);
					if (riskSourceIds.length > 0) {
						try {
							const sourceRisks = await listProjectRisksByIds(organisation.id, data.id, riskSourceIds, workspace.role, serverSupabase);
							sourceRisksById = new Map(sourceRisks.map((risk) => [risk.risk_id, risk]));
						} catch {
							sourceRisksById = new Map();
						}
					}
				} catch (error) {
					entries = [];
					sourceRisksById = new Map();
					entriesLoadError = error instanceof Error ? error.message : 'Unable to load Project Narrative entries.';
				}
			}
		}
	}
} catch (error) {
	message = error instanceof Error ? error.message : 'Unable to load Project Narrative.';
	Astro.response.status = 500;
}

const canCreateNarrative = can(workspaceRole, 'narrative.create');
const formatAttention = (value) => value ? value.charAt(0).toUpperCase() + value.slice(1) : 'Neutral';
const getAttentionPillTone = (value) => {
	if (value === 'green' || value === 'amber' || value === 'red') return value;
	return 'neutral';
};
const formatSourceType = (value) => {
	if (!value) return 'Manual';
	const labels = { manual: 'Manual', risk: 'Risk', issue: 'Issue', dependency: 'Dependency', assumption: 'Assumption', system: 'System' };
	return labels[value] ?? formatAttention(value);
};
const formatCreatedAt = (value) => value
	? `${new Intl.DateTimeFormat('en-GB', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'UTC' }).format(new Date(value))} UTC`
	: 'Not available';
const formatDate = (value) => value
	? new Intl.DateTimeFormat('en-GB', { dateStyle: 'medium', timeZone: 'UTC' }).format(new Date(value))
	: 'Not available';
const profileName = (profile) => {
	const resolvedProfile = Array.isArray(profile) ? profile[0] : profile;
	return resolvedProfile?.display_name || resolvedProfile?.email || 'Workspace member';
};
const creatorName = (entry) => profileName(entry.creator);
const updaterName = (entry) => entry.updated_by ? profileName(entry.updater) : '';
const riskPreviewFor = (entry) => {
	if (entry.source_type !== 'risk' || !entry.source_record_id) return null;
	const risk = sourceRisksById.get(entry.source_record_id);
	if (!risk) return {
		available: false,
		reference: entry.source_ref,
		title: 'Risk detail unavailable',
		unavailableReason: 'The linked risk could not be loaded for this project. It may have been archived, deleted, or unavailable to your current workspace access.',
		openHref: buildProjectRiskPath(workspaceSlug ?? '', project?.slug ?? projectSlug ?? '', entry.source_record_id),
	};
	const concern = deriveRiskReferenceTone(risk, new Date());
	const exposure = deriveRiskExposureTone(risk.probability, risk.impact);
	const assurance = deriveRiskAssuranceTone(risk, new Date());
	return {
		available: true,
		reference: risk.risk_ref,
		title: risk.title,
		description: risk.description || 'No description recorded.',
		status: riskDisplayLabel(risk.status),
		assurance: riskDisplayLabel(assurance),
		assuranceTone: assurance,
		concern: riskReferenceStatusLabel(risk, new Date()),
		concernTone: concern,
		exposure: riskDisplayLabel(exposure),
		exposureTone: exposure,
		probability: riskDisplayLabel(risk.probability),
		impact: riskDisplayLabel(risk.impact),
		owner: riskProfileName(risk.owner, 'Unassigned'),
		actioner: riskProfileName(risk.actioner, 'Unassigned'),
		reviewDate: formatDate(risk.review_date),
		dueDate: formatDate(risk.due_date),
		mitigation: risk.mitigation_plan || 'No mitigation plan recorded.',
		contingency: risk.contingency_plan || 'No contingency plan recorded.',
		updatedAt: formatCreatedAt(risk.updated_at),
		openHref: buildProjectRiskPath(workspaceSlug ?? '', project?.slug ?? projectSlug ?? '', risk.risk_id),
	};
};
const narrativeEntriesJson = JSON.stringify(entries.map((entry) => ({
	id: entry.id,
	displayRef: getNarrativeDisplayRef(entry),
	narrativeRef: entry.narrative_ref,
	sourceType: formatSourceType(entry.source_type),
	sourceRef: entry.source_ref,
	sourceRecordId: entry.source_record_id,
	attentionLevel: entry.attention_level,
	attentionLabel: formatAttention(entry.attention_level),
	title: entry.title,
	details: entry.details,
	links: entry.links ?? [],
	sourceRisk: riskPreviewFor(entry),
	createdBy: creatorName(entry),
	createdAt: formatCreatedAt(entry.created_at),
	updatedBy: updaterName(entry),
	updatedAt: entry.updated_at ? formatCreatedAt(entry.updated_at) : '',
}))).replace(/</g, '\\u003c');
---
<AuthenticatedLayout title={project ? `Project Narrative — ${project.name} | WatchTower` : 'Project Narrative | WatchTower'}>
	<section class="narrative-page" data-project-narrative-route data-feature-state={featureAccess.state}>
		{project ? (
			<>
				<ProjectPageHero
					workspaceName={workspaceName}
					projectName={project.name}
					projectRef={project.project_ref}
					title="Project Narrative"
					description="A project-level timeline of key events, updates and decisions."
					headingId="project-narrative-heading"
				/>

				<ProjectControlPanel title="Filters" status="Coming soon" headingId="narrative-filters-heading" />

				<ProjectContentPanel
					title="Narrative entries"
					headingId="narrative-table-heading"
				>
					<div slot="action" class="narrative-action">
						{canCreateNarrative ? (
							<button
								class="button button--primary"
								type="button"
								data-open-create-narrative
							>New Entry</button>
						) : (
							<button
								class="button button--primary"
								type="button"
								disabled
								data-viewer-read-only
							>New Entry</button>
						)}
					</div>

					{entriesLoadError ? (
						<EmptyState title="Project Narrative entries could not be loaded." tone="error" data-narrative-list-error role="alert">
							<p>{entriesLoadError}</p>
							<p>Refresh the page, or try again after checking workspace access.</p>
						</EmptyState>
					) : entries.length === 0 ? (
						<EmptyState title="No narrative entries yet." data-narrative-empty-state>
							<p>Project Narrative will show key project events, manual updates and future RAID-linked activity in one assurance timeline.</p>
							<p>{canCreateNarrative ? 'Create the first manual entry when there is project context to capture.' : 'Viewer access is read-only, so entry creation is unavailable for your role.'}</p>
						</EmptyState>
					) : (
						<>
							<div class="narrative-table-scroll">
								<table class="simple-table narrative-table">
									<thead>
										<tr><th scope="col">Ref</th><th scope="col">Details</th><th scope="col">Created by</th><th scope="col">Created</th></tr>
									</thead>
									<tbody>
										{entries.map((entry) => (
											<tr>
												<td>
													<button
														class="narrative-ref"
														type="button"
														data-entry-id={entry.id}
														data-risk-detail-trigger={entry.source_type === 'risk' && entry.source_record_id ? '' : undefined}
														aria-label={entry.source_type === 'risk' && entry.source_record_id
															? `View risk detail for ${getNarrativeDisplayRef(entry)}`
															: `Open ${getNarrativeDisplayRef(entry)}, ${formatAttention(entry.attention_level)} attention`}
													>
														<RagReferencePill
															tone={getAttentionPillTone(entry.attention_level)}
															label={getNarrativeDisplayRef(entry)}
															statusLabel={formatAttention(entry.attention_level)}
														/>
													</button>
												</td>
												<td class="narrative-details">
													{entry.title && <strong>{entry.title}</strong>}
													{entry.details && <span>{entry.details}</span>}
												</td>
												<td>{creatorName(entry)}</td>
												<td><time datetime={entry.created_at}>{formatCreatedAt(entry.created_at)}</time></td>
											</tr>
										))}
									</tbody>
								</table>
							</div>
						</>
					)}
					<a class="text-link narrative-back-link" href={buildProjectPath(workspaceSlug ?? '', project.slug)}>Back to project</a>
				</ProjectContentPanel>

				<dialog class="narrative-modal" aria-labelledby="create-narrative-title" data-create-narrative-modal data-open-on-load={createModalOpen || undefined}>
					<form method="dialog" class="narrative-modal__close-form">
						<button class="narrative-modal__close" type="submit" aria-label="Close create narrative entry modal">Close</button>
					</form>
					<form class="narrative-form" method="post" novalidate data-create-narrative-form>
						<div>
							<p class="eyebrow">Manual entry</p>
							<h2 id="create-narrative-title">Create Project Narrative Entry</h2>
							<p>This entry will be saved to Project Narrative. It will not create or update a Risk, Issue, Dependency or Assumption.</p>
						</div>

						{saveMessage && <p class="form-message narrative-form__message" role="alert">{saveMessage}</p>}

						<label for="narrative-title">Title <span aria-hidden="true">*</span></label>
						<input
							id="narrative-title"
							name="title"
							value={formValues.title}
							required
							aria-required="true"
							aria-invalid={Boolean(formErrors.title) || undefined}
							aria-describedby={formErrors.title ? 'narrative-title-error' : undefined}
							autocomplete="off"
						/>
						{formErrors.title && <p class="field-error" id="narrative-title-error">{formErrors.title}</p>}

						<fieldset class="narrative-attention" aria-describedby={formErrors.attentionLevel ? 'narrative-attention-error' : undefined}>
							<legend>Attention level <span aria-hidden="true">*</span></legend>
							{['neutral', 'green', 'amber', 'red'].map((level) => (
								<label>
									<input type="radio" name="attention_level" value={level} required checked={formValues.attentionLevel === level} />
									<span>{formatAttention(level)}</span>
								</label>
							))}
						</fieldset>
						{formErrors.attentionLevel && <p class="field-error" id="narrative-attention-error">{formErrors.attentionLevel}</p>}

						<label for="narrative-details">Details <span aria-hidden="true">*</span></label>
						<textarea
							id="narrative-details"
							name="details"
							rows="6"
							required
							aria-required="true"
							aria-invalid={Boolean(formErrors.details) || undefined}
							aria-describedby={formErrors.details ? 'narrative-details-error' : undefined}
						>{formValues.details}</textarea>
						{formErrors.details && <p class="field-error" id="narrative-details-error">{formErrors.details}</p>}

						<fieldset class="narrative-links" data-link-list aria-describedby="narrative-links-help">
							<legend>Links</legend>
							<p id="narrative-links-help">Add supporting links only when they are useful evidence or context.</p>
							{formLinks.map((link, index) => (
								<div class="narrative-link-row" data-link-row>
									<label for={`link-label-${index}`}>Label <span aria-hidden="true">*</span></label>
									<input
										id={`link-label-${index}`}
										name="link_label"
										value={link.label}
										aria-invalid={Boolean(formErrors[`link_label_${index}`]) || undefined}
										aria-describedby={formErrors[`link_label_${index}`] ? `link-label-error-${index}` : undefined}
									/>
									{formErrors[`link_label_${index}`] && <p class="field-error" id={`link-label-error-${index}`}>{formErrors[`link_label_${index}`]}</p>}
									<label for={`link-url-${index}`}>URL <span aria-hidden="true">*</span></label>
									<input
										id={`link-url-${index}`}
										name="link_url"
										value={link.url}
										inputmode="url"
										aria-invalid={Boolean(formErrors[`link_url_${index}`]) || undefined}
										aria-describedby={formErrors[`link_url_${index}`] ? `link-url-error-${index}` : undefined}
									/>
									{formErrors[`link_url_${index}`] && <p class="field-error" id={`link-url-error-${index}`}>{formErrors[`link_url_${index}`]}</p>}
									<button class="button button--secondary" type="button" data-remove-link>Remove link</button>
								</div>
							))}
						</fieldset>
						<button class="button button--secondary narrative-add-link" type="button" data-add-link>Add another link</button>
						<input type="hidden" name="created_timezone" value="" data-created-timezone />

						<div class="narrative-form__actions">
							<button class="button button--secondary" type="button" data-close-create-narrative>Cancel</button>
							<button class="button button--primary" type="submit">Save entry</button>
						</div>
					</form>
				</dialog>

				<dialog class="narrative-modal narrative-detail-modal" aria-labelledby="narrative-detail-title" data-detail-modal>
					<form method="dialog" class="narrative-modal__close-form">
						<button class="narrative-modal__close" type="submit" aria-label="Close narrative entry detail modal">Close</button>
					</form>
					<div class="narrative-detail">
						<div>
							<p class="eyebrow" data-detail-ref></p>
							<h2 id="narrative-detail-title" data-detail-title></h2>
							<span class="attention-badge rag-pill rag-pill--neutral" data-detail-attention></span>
						</div>
						<section>
							<h3>Details</h3>
							<p data-detail-body></p>
						</section>
						<section data-detail-links-section hidden>
							<h3>Links</h3>
							<ul data-detail-links></ul>
						</section>
						<section class="narrative-risk-preview rag-panel rag-panel--neutral" data-detail-risk-section hidden>
							<div class="narrative-risk-preview__header">
								<div>
									<p class="eyebrow">Current source risk</p>
									<h3>Risk detail</h3>
									<p data-detail-risk-title></p>
								</div>
								<a
									class="button button--secondary"
									href="#"
									target="_blank"
									rel="noopener noreferrer"
									aria-label="Open full risk in new tab"
									data-detail-risk-open
								>Open full risk in new tab</a>
							</div>
							<p class="narrative-risk-preview__fallback" data-detail-risk-fallback hidden></p>
							<div class="narrative-risk-preview__signals" data-detail-risk-signals>
								<article class="narrative-risk-signal rag-card rag-card--neutral" data-detail-risk-concern-card>
									<span>Overall concern</span>
									<strong data-detail-risk-concern-value>Not available</strong>
									<span class="attention-badge rag-pill rag-pill--neutral" data-detail-risk-concern></span>
								</article>
								<article class="narrative-risk-signal rag-card rag-card--neutral" data-detail-risk-exposure-card>
									<span>Exposure</span>
									<strong data-detail-risk-exposure-value>Not available</strong>
									<span class="attention-badge rag-pill rag-pill--neutral" data-detail-risk-exposure></span>
								</article>
								<article class="narrative-risk-signal rag-card rag-card--neutral" data-detail-risk-assurance-card>
									<span>Attention / assurance</span>
									<strong data-detail-risk-assurance-value>Not available</strong>
									<span class="attention-badge rag-pill rag-pill--neutral" data-detail-risk-assurance></span>
								</article>
							</div>
							<dl class="narrative-risk-preview__grid" data-detail-risk-grid>
								<div><dt>Reference</dt><dd data-detail-risk-reference></dd></div>
								<div><dt>Lifecycle status</dt><dd data-detail-risk-status></dd></div>
								<div><dt>Probability</dt><dd data-detail-risk-probability></dd></div>
								<div><dt>Impact</dt><dd data-detail-risk-impact></dd></div>
								<div><dt>Owner</dt><dd data-detail-risk-owner></dd></div>
								<div><dt>Actioner</dt><dd data-detail-risk-actioner></dd></div>
								<div><dt>Review date</dt><dd data-detail-risk-review-date></dd></div>
								<div><dt>Due date</dt><dd data-detail-risk-due-date></dd></div>
								<div><dt>Last updated</dt><dd data-detail-risk-updated-at></dd></div>
								<div class="narrative-risk-preview__wide"><dt>Description</dt><dd data-detail-risk-description></dd></div>
								<div class="narrative-risk-preview__wide"><dt>Mitigation / response</dt><dd data-detail-risk-mitigation></dd></div>
								<div class="narrative-risk-preview__wide"><dt>Contingency</dt><dd data-detail-risk-contingency></dd></div>
							</dl>
						</section>
						<dl class="narrative-detail__meta">
							<div><dt>Narrative reference</dt><dd data-detail-narrative-ref></dd></div>
							<div><dt>Source type</dt><dd data-detail-source-type></dd></div>
							<div data-detail-source-ref-row hidden><dt>Source reference</dt><dd data-detail-source-ref></dd></div>
							<div><dt>Created by</dt><dd data-detail-created-by></dd></div>
							<div><dt>Created</dt><dd data-detail-created-at></dd></div>
							<div data-detail-updated-by-row hidden><dt>Updated by</dt><dd data-detail-updated-by></dd></div>
							<div data-detail-updated-at-row hidden><dt>Updated</dt><dd data-detail-updated-at></dd></div>
						</dl>
					</div>
				</dialog>

				<script type="application/json" id="narrative-entry-data" set:html={narrativeEntriesJson}></script>
				<script>
					const createModal = document.querySelector('[data-create-narrative-modal]');
					const createTrigger = document.querySelector('[data-open-create-narrative]');
					const createCancel = document.querySelector('[data-close-create-narrative]');
					const createForm = document.querySelector('[data-create-narrative-form]');
					const linkList = document.querySelector('[data-link-list]');
					const addLinkButton = document.querySelector('[data-add-link]');
					const timezoneInput = document.querySelector('[data-created-timezone]');
					const detailModal = document.querySelector('[data-detail-modal]');
					const entriesData = JSON.parse(document.getElementById('narrative-entry-data')?.textContent || '[]');
					const entriesById = new Map(entriesData.map((entry) => [entry.id, entry]));
					let lastTrigger = null;

					const openDialog = (dialog, trigger) => {
						if (!(dialog instanceof HTMLDialogElement)) return;
						lastTrigger = trigger instanceof HTMLElement ? trigger : null;
						if (!dialog.open) dialog.showModal();
					};

					const closeCreateModal = () => {
						if (createModal instanceof HTMLDialogElement) createModal.close();
					};

					createTrigger?.addEventListener('click', (event) => openDialog(createModal, event.currentTarget));
					createCancel?.addEventListener('click', closeCreateModal);
					createModal?.addEventListener('close', () => {
						if (lastTrigger instanceof HTMLElement) lastTrigger.focus();
					});
					detailModal?.addEventListener('close', () => {
						if (lastTrigger instanceof HTMLElement) lastTrigger.focus();
					});

					if (createModal instanceof HTMLDialogElement && createModal.dataset.openOnLoad === 'true') {
						createModal.showModal();
					}

					if (timezoneInput instanceof HTMLInputElement) {
						timezoneInput.value = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
					}

					const linkRowCount = () => linkList?.querySelectorAll('[data-link-row]').length ?? 0;
					const addLinkRow = () => {
						if (!(linkList instanceof HTMLElement)) return;
						const index = linkRowCount();
						const row = document.createElement('div');
						row.className = 'narrative-link-row';
						row.dataset.linkRow = '';

						const labelLabel = document.createElement('label');
						labelLabel.setAttribute('for', `link-label-${index}`);
						labelLabel.textContent = 'Label *';
						const labelInput = document.createElement('input');
						labelInput.id = `link-label-${index}`;
						labelInput.name = 'link_label';

						const urlLabel = document.createElement('label');
						urlLabel.setAttribute('for', `link-url-${index}`);
						urlLabel.textContent = 'URL *';
						const urlInput = document.createElement('input');
						urlInput.id = `link-url-${index}`;
						urlInput.name = 'link_url';
						urlInput.inputMode = 'url';

						const removeButton = document.createElement('button');
						removeButton.className = 'button button--secondary';
						removeButton.type = 'button';
						removeButton.dataset.removeLink = '';
						removeButton.textContent = 'Remove link';

						row.append(labelLabel, labelInput, urlLabel, urlInput, removeButton);
						linkList.append(row);
						labelInput.focus();
					};

					addLinkButton?.addEventListener('click', addLinkRow);
					linkList?.addEventListener('click', (event) => {
						const target = event.target;
						if (!(target instanceof HTMLElement) || !target.matches('[data-remove-link]')) return;
						target.closest('[data-link-row]')?.remove();
					});

					createForm?.addEventListener('submit', () => {
						if (timezoneInput instanceof HTMLInputElement) {
							timezoneInput.value = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
						}
					});

					const setText = (selector, value) => {
						const target = detailModal?.querySelector(selector);
						if (target) target.textContent = value || 'Not available';
					};

					const setRagClass = (element, baseClasses, tone) => {
						if (!(element instanceof HTMLElement)) return;
						element.className = `${baseClasses} rag-card--${tone || 'neutral'}`;
					};

					const setPill = (selector, value, tone) => {
						const target = detailModal?.querySelector(selector);
						if (target instanceof HTMLElement) {
							target.className = `attention-badge rag-pill rag-pill--${tone || 'neutral'}`;
							target.textContent = value || 'Not available';
						}
					};

					const setOptionalRow = (rowSelector, valueSelector, value) => {
						const row = detailModal?.querySelector(rowSelector);
						const target = detailModal?.querySelector(valueSelector);
						if (!(row instanceof HTMLElement) || !target) return;
						row.hidden = !value;
						target.textContent = value || '';
					};

					const openDetail = (entry, trigger) => {
						if (!(detailModal instanceof HTMLDialogElement)) return;
						setText('[data-detail-ref]', entry.displayRef);
						setText('[data-detail-title]', entry.title);
						const attention = detailModal.querySelector('[data-detail-attention]');
						if (attention instanceof HTMLElement) {
							attention.className = `attention-badge rag-pill rag-pill--${entry.attentionLevel}`;
							attention.textContent = entry.attentionLabel;
						}
						setText('[data-detail-body]', entry.details);
						setText('[data-detail-narrative-ref]', entry.narrativeRef);
						setText('[data-detail-source-type]', entry.sourceType);
						setOptionalRow('[data-detail-source-ref-row]', '[data-detail-source-ref]', entry.sourceRef);
						setText('[data-detail-created-by]', entry.createdBy);
						setText('[data-detail-created-at]', entry.createdAt);
						setOptionalRow('[data-detail-updated-by-row]', '[data-detail-updated-by]', entry.updatedBy);
						setOptionalRow('[data-detail-updated-at-row]', '[data-detail-updated-at]', entry.updatedAt);

						const riskSection = detailModal.querySelector('[data-detail-risk-section]');
						if (riskSection instanceof HTMLElement) {
							riskSection.hidden = !entry.sourceRisk;
						}
						if (entry.sourceRisk) {
							if (riskSection instanceof HTMLElement) {
								riskSection.className = `narrative-risk-preview rag-panel rag-panel--${entry.sourceRisk.assuranceTone || 'neutral'}`;
							}
							const riskFallback = detailModal.querySelector('[data-detail-risk-fallback]');
							const riskSignals = detailModal.querySelector('[data-detail-risk-signals]');
							const riskGrid = detailModal.querySelector('[data-detail-risk-grid]');
							if (riskFallback instanceof HTMLElement) {
								riskFallback.hidden = entry.sourceRisk.available !== false;
								riskFallback.textContent = entry.sourceRisk.unavailableReason || '';
							}
							if (riskSignals instanceof HTMLElement) riskSignals.hidden = entry.sourceRisk.available === false;
							if (riskGrid instanceof HTMLElement) riskGrid.hidden = entry.sourceRisk.available === false;
							setText('[data-detail-risk-title]', entry.sourceRisk.title);
							setText('[data-detail-risk-reference]', entry.sourceRisk.reference || entry.sourceRef);
							setText('[data-detail-risk-status]', entry.sourceRisk.status);
							setText('[data-detail-risk-probability]', entry.sourceRisk.probability);
							setText('[data-detail-risk-impact]', entry.sourceRisk.impact);
							setText('[data-detail-risk-owner]', entry.sourceRisk.owner);
							setText('[data-detail-risk-actioner]', entry.sourceRisk.actioner);
							setText('[data-detail-risk-review-date]', entry.sourceRisk.reviewDate);
							setText('[data-detail-risk-due-date]', entry.sourceRisk.dueDate);
							setText('[data-detail-risk-updated-at]', entry.sourceRisk.updatedAt);
							setText('[data-detail-risk-description]', entry.sourceRisk.description);
							setText('[data-detail-risk-mitigation]', entry.sourceRisk.mitigation);
							setText('[data-detail-risk-contingency]', entry.sourceRisk.contingency);
							setText('[data-detail-risk-concern-value]', entry.sourceRisk.concern);
							setText('[data-detail-risk-exposure-value]', entry.sourceRisk.exposure);
							setText('[data-detail-risk-assurance-value]', entry.sourceRisk.assurance);
							setPill('[data-detail-risk-concern]', entry.sourceRisk.concern, entry.sourceRisk.concernTone);
							setPill('[data-detail-risk-exposure]', entry.sourceRisk.exposure, entry.sourceRisk.exposureTone);
							setPill('[data-detail-risk-assurance]', entry.sourceRisk.assurance, entry.sourceRisk.assuranceTone);
							setRagClass(detailModal.querySelector('[data-detail-risk-concern-card]'), 'narrative-risk-signal rag-card', entry.sourceRisk.concernTone);
							setRagClass(detailModal.querySelector('[data-detail-risk-exposure-card]'), 'narrative-risk-signal rag-card', entry.sourceRisk.exposureTone);
							setRagClass(detailModal.querySelector('[data-detail-risk-assurance-card]'), 'narrative-risk-signal rag-card', entry.sourceRisk.assuranceTone);
							const openRisk = detailModal.querySelector('[data-detail-risk-open]');
							if (openRisk instanceof HTMLAnchorElement) {
								openRisk.href = entry.sourceRisk.openHref;
							}
						}

						const linksSection = detailModal.querySelector('[data-detail-links-section]');
						const linksList = detailModal.querySelector('[data-detail-links]');
						if (linksSection instanceof HTMLElement && linksList) {
							linksList.replaceChildren();
							linksSection.hidden = entry.links.length === 0;
							entry.links.forEach((link) => {
								const item = document.createElement('li');
								const anchor = document.createElement('a');
								anchor.href = link.url;
								anchor.textContent = link.label;
								anchor.rel = 'noreferrer';
								anchor.target = '_blank';
								item.append(anchor);
								linksList.append(item);
							});
						}

						openDialog(detailModal, trigger);
					};

					document.querySelectorAll('[data-entry-id]').forEach((button) => {
						button.addEventListener('click', (event) => {
							const target = event.currentTarget;
							if (!(target instanceof HTMLElement)) return;
							const entry = entriesById.get(target.dataset.entryId);
							if (entry) openDetail(entry, target);
						});
					});
				</script>
			</>
		) : (
			<section class="content-card" data-feature-unavailable-message>
				<p class="eyebrow">Project Narrative</p>
				<h1>Feature unavailable</h1>
				<p>{message}</p>
				<a class="button button--secondary" href={workspaceSlug && projectSlug ? buildProjectPath(workspaceSlug, projectSlug) : '/app/projects'}>Back to project</a>
			</section>
		)}
	</section>
</AuthenticatedLayout>

<style>
