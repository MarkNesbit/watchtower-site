---
import AuthenticatedLayout from '../../../../../../layouts/AuthenticatedLayout.astro';
import DisabledActionHint from '../../../../../../components/app/DisabledActionHint.astro';
import EmptyState from '../../../../../../components/app/EmptyState.astro';
import ProjectPageHero from '../../../../../../components/app/ProjectPageHero.astro';
import RagReferencePill from '../../../../../../components/app/RagReferencePill.astro';
import { getFeatureAccess, loadFeatureAccess } from '../../../../../../lib/featureFlags';
import { can } from '../../../../../../lib/permissions';
import {
	deriveRiskReviewDateTone,
	DEFAULT_RISK_REGISTER_PAGE_SIZE,
	defaultRiskRegisterSortForView,
	filterAndSortRisksForRegister,
	getDraftRiskRegisterReadinessDisplay,
	getExposureDistribution,
	getRiskRegisterExposureDisplay,
	getRiskRegisterPageNumbers,
	getTopRiskActionItems,
	buildRiskDetailReturnPath,
	listProjectRisks,
	normaliseRiskRegisterSort,
	normaliseRiskRegisterViewTab,
	paginateRisksForRegister,
	parseRiskRegisterPage,
	parseRiskRegisterPageSize,
	RISK_REGISTER_EXPOSURE_FILTERS,
	RISK_REGISTER_PAGE_SIZES,
	RISK_REGISTER_SORTS,
	RISK_REGISTER_VIEW_TABS,
	riskDisplayLabel,
	riskExposureTone,
	riskLifecycleCategory,
	riskLifecycleLabel,
	riskProfileName,
	riskMatchesRegisterView,
	summarizeRiskRegister,
} from '../../../../../../lib/projectRisks';
import { getRiskReferencePillPresentation } from '../../../../../../lib/riskReferencePills';
import { getDefaultRiskPromptLibraryForSelection, type RiskPromptLibraryForSelection } from '../../../../../../lib/riskPrompts';
import { buildProjectNewRiskPath, buildProjectPath, buildProjectRiskPath, getWorkspaceBySlug } from '../../../../../../lib/projects';
import { createSupabaseServerClient, getServerAccessToken } from '../../../../../../lib/supabaseServer';

const projectSlug = Astro.params.projectId;
const workspaceSlug = Astro.params.workspaceSlug;
const accessToken = getServerAccessToken(Astro.cookies);
let project = null;
let risks = [];
let workspaceName = '';
let workspaceRole = '';
let message = '';
let risksLoadError = '';
let featureAccess = getFeatureAccess('riskManagement');
let riskPromptLibrary: RiskPromptLibraryForSelection | null = null;
let riskPromptLibraryLoadError = false;

const formatDate = (value, fallback = 'Not available') => value
	? new Intl.DateTimeFormat('en-GB', { dateStyle: 'medium', timeZone: 'UTC' }).format(new Date(value))
	: fallback;
const formatDateTime = (value, fallback = 'Not available') => value
	? `${new Intl.DateTimeFormat('en-GB', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'UTC' }).format(new Date(value))} UTC`
	: fallback;
const reviewDueState = (risk, now = new Date()) => {
	const category = riskLifecycleCategory(risk.status);
	const review = deriveRiskReviewDateTone(risk.review_date, now);
	if (category !== 'active') return {
		tone: 'neutral',
		label: risk.review_date ? formatDate(risk.review_date) : 'No review date',
		statusLabel: '',
	};
	return {
		tone: review.tone,
		label: risk.review_date ? formatDate(risk.review_date) : review.value,
		statusLabel: review.status === 'missing'
			? 'Missing'
			: review.status === 'overdue'
				? 'Overdue'
				: review.status === 'due-soon'
					? 'Due soon'
					: '',
	};
};
try {
	const serverSupabase = createSupabaseServerClient(accessToken);
	const workspace = await getWorkspaceBySlug(serverSupabase, workspaceSlug ?? '', accessToken);
	const organisation = Array.isArray(workspace?.organisations) ? workspace?.organisations[0] : workspace?.organisations;

	if (!workspace || !organisation) {
		message = 'Project not found or you do not have access.';
		Astro.response.status = 404;
	} else if (!can(workspace.role, 'risk.view')) {
		message = 'You do not have permission to view project risks.';
		Astro.response.status = 403;
	} else {
		workspaceName = organisation.name;
		workspaceRole = workspace.role;
		const { data, error } = await serverSupabase
			.from('projects')
			.select('id, name, project_ref, slug')
			.eq('slug', projectSlug)
			.eq('organisation_id', organisation.id)
			.is('deleted_at', null)
			.is('archived_at', null)
			.maybeSingle();
		if (error) throw error;

		if (!data) {
			message = 'Project not found or you do not have access.';
			Astro.response.status = 404;
		} else {
			featureAccess = await loadFeatureAccess(serverSupabase, 'riskManagement', accessToken);
			if (!featureAccess.isAccessible) {
				message = featureAccess.unavailableReason ?? 'This feature is not currently available to your account.';
				Astro.response.status = featureAccess.state === 'hidden' ? 404 : 403;
			} else {
				project = data;
				try {
					risks = await listProjectRisks(organisation.id, data.id, workspace.role, serverSupabase);
				} catch (error) {
					risks = [];
					risksLoadError = error instanceof Error ? error.message : 'Unable to load the Risk Register.';
				}
				try {
					riskPromptLibrary = await getDefaultRiskPromptLibraryForSelection(serverSupabase);
				} catch (error) {
					riskPromptLibraryLoadError = true;
					console.error('Unable to load risk prompt library for Risk Register modal.', error);
				}
			}
		}
	}
} catch (error) {
	message = error instanceof Error ? error.message : 'Unable to load Risk Management.';
	Astro.response.status = 500;
}

const canCreateRisk = can(workspaceRole, 'risk.create');
const registerUrl = new URL(Astro.request.url);
const registerPath = registerUrl.pathname;
const registerParams = registerUrl.searchParams;
const riskPromptDraftCreatePath = `${registerPath.replace(/\/$/, '')}/prompt-drafts`;
const registerNow = new Date();
const selectedView = normaliseRiskRegisterViewTab(registerParams.get('view'));
const showDraftColumns = selectedView === 'draft';
const requestedSort = registerParams.get('sort');
const defaultSort = defaultRiskRegisterSortForView(selectedView);
const selectedSort = requestedSort ? normaliseRiskRegisterSort(requestedSort) : defaultSort;
const requestedPage = parseRiskRegisterPage(registerParams.get('page'));
const selectedPageSize = parseRiskRegisterPageSize(registerParams.get('pageSize'));
const selectedSearch = (registerParams.get('q') ?? '').trim().slice(0, 120);
const requestedExposure = registerParams.get('exposure') ?? '';
const selectedExposure = selectedView === 'closed'
	? ''
	: RISK_REGISTER_EXPOSURE_FILTERS.includes(requestedExposure) ? requestedExposure : '';
const selectedActionState = '';
const selectedLifecycle = '';
const promptDraftsCreated = Math.max(0, Number(registerParams.get('promptDraftsCreated')) || 0);
const promptDraftsSkipped = Math.max(0, Number(registerParams.get('promptDraftsSkipped')) || 0);
const promptDraftFeedback = promptDraftsCreated > 0
	? `${promptDraftsCreated} draft ${promptDraftsCreated === 1 ? 'risk has' : 'risks have'} been created from selected prompts.${promptDraftsSkipped > 0 ? ` ${promptDraftsSkipped} duplicate ${promptDraftsSkipped === 1 ? 'prompt was' : 'prompts were'} skipped.` : ''}`
	: '';
const ownerOptions = [...new Map(risks
	.filter((risk) => risk.owner_id)
	.map((risk) => [risk.owner_id, riskProfileName(risk.owner, `Workspace member ${String(risk.owner_id).slice(0, 8)}`)]))]
	.sort((a, b) => a[1].localeCompare(b[1]));
const hasUnassignedRisks = risks.some((risk) => !risk.owner_id);
const requestedOwnerId = (registerParams.get('owner') ?? '').trim();
const selectedOwnerId = requestedOwnerId === 'unassigned' && hasUnassignedRisks
	? 'unassigned'
	: ownerOptions.some(([ownerId]) => ownerId === requestedOwnerId)
		? requestedOwnerId
		: '';
const registerFilters = {
	view: selectedView,
	search: selectedSearch,
	exposure: selectedExposure,
	actionState: selectedActionState,
	ownerId: selectedOwnerId,
	lifecycle: selectedLifecycle,
	sort: selectedSort,
};
const filteredRisks = filterAndSortRisksForRegister(risks, registerFilters, registerNow);
const paginatedRegister = paginateRisksForRegister(filteredRisks, requestedPage, selectedPageSize);
const pagedRisks = paginatedRegister.items;
const pagination = paginatedRegister.pagination;
const pageNumbers = getRiskRegisterPageNumbers(pagination.page, pagination.totalPages);
const registerSummary = summarizeRiskRegister(risks, registerNow);
const needsActionItems = getTopRiskActionItems(risks, 4, registerNow);
const exposureDistribution = getExposureDistribution(risks);
const exposureChartRadius = 54;
const exposureChartCircumference = 2 * Math.PI * exposureChartRadius;
const exposureChartGap = exposureDistribution.segments.filter((segment) => segment.count > 0).length > 1 ? 2 : 0;
let exposureChartOffset = 0;
const exposureChartSegments = exposureDistribution.segments
	.filter((segment) => segment.count > 0 && exposureDistribution.chartedRisks > 0)
	.map((segment) => {
		const arcLength = (segment.count / exposureDistribution.chartedRisks) * exposureChartCircumference;
		const visibleArcLength = Math.max(0.75, arcLength - exposureChartGap);
		const chartSegment = {
			...segment,
			dashArray: `${visibleArcLength} ${exposureChartCircumference - visibleArcLength}`,
			dashOffset: -(exposureChartOffset + exposureChartGap / 2),
		};
		exposureChartOffset += arcLength;
		return chartSegment;
	});
const tabLabels = {
	active: 'Active risks',
	'need-action': 'Need action',
	draft: 'Draft',
	closed: 'Closed',
};
const sortLabels = {
	'highest-exposure': 'Highest exposure first',
	'action-needed': 'Action needed first',
	'review-due': 'Review due soonest',
	'recently-updated': 'Recently updated',
};
const draftTabTone = (count) => count > 5 ? 'red' : count > 0 ? 'amber' : 'neutral';
const buildRegisterPath = (overrides = {}) => {
	const next = {
		view: selectedView,
		q: selectedSearch,
		exposure: selectedExposure,
		actionState: selectedActionState,
		owner: selectedOwnerId,
		lifecycle: selectedLifecycle,
		sort: selectedSort,
		page: pagination.page,
		pageSize: selectedPageSize,
		...overrides,
	};
	const params = new URLSearchParams();
	if (next.view && next.view !== 'active') params.set('view', next.view);
	if (next.q) params.set('q', next.q);
	if (next.exposure) params.set('exposure', next.exposure);
	if (next.owner) params.set('owner', next.owner);
	if (next.sort && next.sort !== defaultRiskRegisterSortForView(next.view)) params.set('sort', next.sort);
	if (next.page && Number(next.page) > 1) params.set('page', String(next.page));
	if (next.pageSize && Number(next.pageSize) !== DEFAULT_RISK_REGISTER_PAGE_SIZE) params.set('pageSize', String(next.pageSize));
	const query = params.toString();
	return query ? `${registerPath}?${query}` : registerPath;
};
const buildRiskDetailPath = (riskId, returnTab = selectedView) => buildRiskDetailReturnPath(
	buildProjectRiskPath(workspaceSlug ?? '', project.slug, riskId),
	returnTab,
);
const needsActionHref = buildRegisterPath({
	view: 'need-action',
	q: '',
	exposure: '',
	owner: '',
	sort: 'action-needed',
	page: 1,
});
const tabItems = RISK_REGISTER_VIEW_TABS.map((tab) => {
	const count = risks.filter((risk) => riskMatchesRegisterView(risk, tab, registerNow)).length;
	return {
		id: tab,
		label: tabLabels[tab],
		count,
		href: buildRegisterPath({ view: tab, sort: defaultRiskRegisterSortForView(tab), page: 1 }),
		active: selectedView === tab,
		countTone: tab === 'draft' ? draftTabTone(count) : 'neutral',
	};
});
const pageSizeHiddenFields = [
	['view', selectedView !== 'active' ? selectedView : ''],
	['q', selectedSearch],
	['exposure', selectedExposure],
	['owner', selectedOwnerId],
	['sort', selectedSort !== defaultSort ? selectedSort : ''],
	['page', '1'],
].filter(([, value]) => Boolean(value));
const ownerFilterLabel = selectedOwnerId === 'unassigned'
	? 'Unassigned'
	: ownerOptions.find(([ownerId]) => ownerId === selectedOwnerId)?.[1] ?? '';
const activeFilterChips = [
	selectedSearch ? `Search: ${selectedSearch}` : '',
	selectedExposure ? `Exposure: ${riskDisplayLabel(selectedExposure)}` : '',
	selectedOwnerId ? `Owner: ${ownerFilterLabel}` : '',
	selectedSort !== defaultSort ? `Sort: ${sortLabels[selectedSort]}` : '',
].filter(Boolean);
const hasSelectedControls = selectedView !== 'active' || activeFilterChips.length > 0;
const hasNarrowedFilters = Boolean(selectedSearch || selectedExposure || selectedOwnerId);
const filteredEmptyTitle = hasNarrowedFilters
	? 'No risks match the current filters.'
	: selectedView === 'need-action'
		? 'No risks currently need action.'
		: selectedView === 'draft'
			? 'No draft risks.'
			: selectedView === 'closed'
				? 'No closed risks.'
				: 'No risks match the current filters.';
const highestExposureTone = registerSummary.highestExposure ? riskExposureTone(registerSummary.highestExposure) : 'neutral';
const highestExposureLabel = registerSummary.highestExposure ? riskDisplayLabel(registerSummary.highestExposure) : 'Not assessed';
const summaryCards = [
	{
		label: 'Open risks',
		value: String(registerSummary.openRisks),
		helper: 'Active project risks',
		tone: 'blue',
		icon: '!',
	},
	{
		label: 'Need action',
		value: String(registerSummary.needAction),
		helper: 'Red or Amber action state',
		tone: registerSummary.needAction > 0 ? 'attention' : 'neutral',
		icon: '!',
	},
	{
		label: 'Highest exposure',
		value: highestExposureLabel,
		helper: 'Across active risks',
		tone: highestExposureTone,
		icon: '^',
	},
];
const activePromptAreas = riskPromptLibrary?.areas ?? [];
const firstPromptArea = activePromptAreas[0] ?? null;
const activePromptCount = activePromptAreas.reduce((total, area) => total + area.prompts.length, 0);
const riskPromptAreaTabLabels: Record<string, string> = {
	'governance-decision-making': 'Governance',
	'scope-requirements': 'Requirements',
	'schedule-milestones': 'Schedule',
	'financial-commercial': 'Financial',
	'people-skills-capacity': 'People',
	'stakeholders-communications': 'Communication',
	'technology-architecture': 'Technology',
	'data-privacy-security': 'Data',
	'suppliers-dependencies': 'Dependencies',
	'quality-testing-acceptance': 'Quality',
	'change-adoption': 'Adoption',
	'operational-readiness-transition': 'Readiness',
};
const riskPromptAreaTabLabel = (area: RiskPromptLibraryForSelection['areas'][number]) => riskPromptAreaTabLabels[area.risk_area_key] ?? area.risk_area_title;
---
<AuthenticatedLayout title={project ? `Project Risks — ${project.name} | WatchTower` : 'Project Risks | WatchTower'}>
	<section class="risk-register-page" data-risk-management-route data-risk-register-route data-feature-state={featureAccess.state}>
		{project ? (
			<>
				<ProjectPageHero
					workspaceName={workspaceName}
					projectName={project.name}
					projectRef={project.project_ref}
					title="Project Risks"
					description="A clean register of source-of-truth project risks."
					headingId="risk-register-heading"
					inlineContext
				/>

				<section class="content-card risk-register-panel" aria-label="Project risks">
					<div class="risk-register-panel__actions">
						<a class="button button--secondary" href={buildProjectPath(workspaceSlug ?? '', project.slug)}>Back to Project</a>
						<div class="risk-register-action">
							<button
								class="button button--secondary"
								type="button"
								aria-haspopup="dialog"
								data-risk-prompts-open
							>Risk Suggestions</button>
							{canCreateRisk ? (
								<a
									class="button button--primary"
									href={buildProjectNewRiskPath(workspaceSlug ?? '', project.slug)}
									data-risk-create-action
								>New Risk</a>
							) : (
								<button
									class="button button--primary"
									type="button"
									disabled
									aria-describedby="risk-create-unavailable"
									data-risk-create-disabled
									data-viewer-read-only
								>New Risk</button>
							)}
							{!canCreateRisk && (
								<DisabledActionHint
									id="risk-create-unavailable"
									allowed={false}
									allowedText=""
									disabledText="Viewer access is read-only. Risk creation is unavailable."
								/>
							)}
						</div>
					</div>

					{promptDraftFeedback && (
						<div class="risk-register-feedback" role="status" data-risk-prompt-create-page-feedback>
							<p>{promptDraftFeedback}</p>
						</div>
					)}

					{risksLoadError ? (
						<EmptyState title="The Risk Register could not be loaded." tone="error" data-risk-list-error role="alert">
							<p>{risksLoadError}</p>
							<p>Refresh the page, or try again after checking workspace access.</p>
						</EmptyState>
					) : (
						<div class="risk-register-layout">
							<div class="risk-register-main">
								<section class="risk-register-summary" aria-label="Risk Register summary" data-risk-register-summary>
									{summaryCards.map((card) => (
										<article class={`risk-register-summary-card risk-register-summary-card--${card.tone}`}>
											<span class="risk-register-summary-card__icon" aria-hidden="true">{card.icon}</span>
											<span class="risk-register-summary-card__body">
												<span class="risk-register-summary-card__label">{card.label}</span>
												<strong class="risk-register-summary-card__value">{card.value}</strong>
												<span class="risk-register-summary-card__helper">{card.helper}</span>
											</span>
										</article>
									))}
								</section>

								{risks.length === 0 ? (
									<EmptyState title="No risks have been recorded for this project yet." data-risk-empty-state>
										<p>When risks are recorded, this register will show the project’s source-of-truth risk reference, action state, exposure, lifecycle, owner, review due date and latest update.</p>
										<p>{canCreateRisk ? 'Create the first risk when there is a delivery concern to manage.' : 'Viewer access is read-only, so risk creation is unavailable for your role.'}</p>
									</EmptyState>
								) : (
									<>
										<nav class="risk-register-tabs" aria-label="Risk Register views" data-risk-register-tabs>
											{tabItems.map((tab) => (
												<a
													class={`risk-register-tab${tab.active ? ' risk-register-tab--active' : ''}`}
													href={tab.href}
													aria-current={tab.active ? 'page' : undefined}
													data-risk-register-tab={tab.id}
												>
													<span>{tab.label}</span>
													<span class={`risk-register-tab__count risk-register-tab__count--${tab.countTone}`} aria-label={`${tab.count} ${tab.label.toLowerCase()}`}>{tab.count}</span>
												</a>
											))}
										</nav>

										<form class="risk-register-toolbar" method="get" action={registerPath} data-risk-register-controls>
											<input type="hidden" name="view" value={selectedView} />
											<input type="hidden" name="pageSize" value={selectedPageSize} />
											<label class="risk-register-field risk-register-field--search">
												<span>Search risks</span>
												<input type="search" name="q" value={selectedSearch} placeholder="Search risks..." autocomplete="off" />
											</label>
											<label class="risk-register-field">
												<span>Exposure</span>
												<select name="exposure" disabled={selectedView === 'closed'} aria-describedby={selectedView === 'closed' ? 'risk-register-exposure-filter-note' : undefined}>
													<option value="" selected={!selectedExposure}>All exposures</option>
													{[...RISK_REGISTER_EXPOSURE_FILTERS].reverse().map((exposure) => (
														<option value={exposure} selected={selectedExposure === exposure}>{riskDisplayLabel(exposure)}</option>
													))}
												</select>
												{selectedView === 'closed' && <span class="risk-register-field__note" id="risk-register-exposure-filter-note">Closed risks have no current exposure.</span>}
											</label>
											<label class="risk-register-field">
												<span>Owner</span>
												<select name="owner">
													<option value="" selected={!selectedOwnerId}>All owners</option>
													{hasUnassignedRisks && <option value="unassigned" selected={selectedOwnerId === 'unassigned'}>Unassigned</option>}
													{ownerOptions.map(([ownerId, label]) => (
														<option value={ownerId} selected={selectedOwnerId === ownerId}>{label}</option>
													))}
												</select>
											</label>
											<label class="risk-register-field">
												<span>Sort</span>
												<select name="sort">
													{RISK_REGISTER_SORTS.map((sort) => (
														<option value={sort} selected={selectedSort === sort}>{sortLabels[sort]}</option>
													))}
												</select>
											</label>
											<div class="risk-register-toolbar__actions">
												<button class="button button--secondary" type="submit">Apply</button>
												<a class="button button--secondary" href={registerPath} data-risk-register-reset>Reset</a>
											</div>
										</form>

										<div class="risk-register-filter-status" role="status" aria-live="polite" data-risk-register-filter-status>
											<span>{filteredRisks.length} of {risks.length} risks shown</span>
											{hasSelectedControls ? (
												<span class="risk-register-filter-status__chips">
													<span class="risk-register-chip">View: {tabLabels[selectedView]}</span>
													{activeFilterChips.map((chip) => <span class="risk-register-chip">{chip}</span>)}
												</span>
											) : (
												<span class="risk-register-filter-status__muted">Default view and sort</span>
											)}
										</div>

										{filteredRisks.length === 0 ? (
											<EmptyState title={filteredEmptyTitle} data-risk-filter-empty-state>
												<p>Adjust the search, filters or selected view to bring matching risks back into the register.</p>
												<a class="button button--secondary" href={registerPath}>Reset</a>
											</EmptyState>
										) : (
											<>
												<div class="risk-register-table-scroll">
													<table class="simple-table risk-register-table" data-risk-register-table>
														<thead>
															<tr>
																<th scope="col" class="risk-register-table__col-ref">Ref</th>
																<th scope="col" class="risk-register-table__col-risk">Risk</th>
																<th scope="col" class="risk-register-table__col-exposure">Exposure</th>
																<th scope="col" class="risk-register-table__col-status">Lifecycle / Status</th>
																{showDraftColumns && <th scope="col" class="risk-register-table__col-readiness">Readiness</th>}
																{showDraftColumns && <th scope="col" class="risk-register-table__col-age">Draft age</th>}
																<th scope="col" class="risk-register-table__col-owner">Owner</th>
																<th scope="col" class="risk-register-table__col-review">Review due</th>
																<th scope="col" class="risk-register-table__col-updated">Updated</th>
															</tr>
														</thead>
														<tbody>
															{pagedRisks.map((risk) => {
																const exposure = getRiskRegisterExposureDisplay(risk);
																const reviewDue = reviewDueState(risk);
																const ownerLabel = riskProfileName(risk.owner, 'Unassigned');
																const riskHref = buildRiskDetailPath(risk.risk_id);
																const lifecycleCategory = riskLifecycleCategory(risk.status);
																const lifecycle = riskLifecycleLabel(risk.status);
																const referencePill = getRiskReferencePillPresentation(risk, registerNow);
																const referenceAriaLabel = `Open ${referencePill.ariaLabel}`;
																const draftReadiness = showDraftColumns ? getDraftRiskRegisterReadinessDisplay(risk, registerNow) : null;
																const draftReadinessId = `risk-draft-readiness-${risk.risk_id}`;
																return (
																	<tr data-risk-lifecycle={lifecycleCategory}>
																		<td>
																			<a
																				class="risk-reference-link"
																				href={riskHref}
																				aria-label={`Open ${risk.risk_ref}`}
																			>
																				<RagReferencePill
																					tone={referencePill.tone}
																					label={referencePill.label}
																					statusLabel={referencePill.statusLabel}
																					ariaLabel={referenceAriaLabel}
																					title={referencePill.title}
																					compactActionState={referencePill.compactActionState}
																				/>
																			</a>
																		</td>
																		<td class="risk-register-table__risk">
																			<a class="risk-register-title-link" href={riskHref} title={risk.title}>{risk.title}</a>
																		</td>
																		<td>
																			<RagReferencePill
																				tone={exposure.tone}
																				label={exposure.label}
																				ariaLabel={exposure.ariaLabel}
																			/>
																			{exposure.isProvisional && <span class="risk-register-table__exposure-note">Estimated exposure</span>}
																		</td>
																		<td>
																			<span class="risk-register-table__status">
																				<strong>{lifecycle}</strong>
																				<span>{riskDisplayLabel(risk.status)}</span>
																			</span>
																		</td>
																		{showDraftColumns && draftReadiness && (
																			<td>
																				<div class="risk-register-draft-readiness" data-risk-draft-readiness>
																					{draftReadiness.ready ? (
																						<span
																							class="risk-register-draft-readiness__label risk-register-draft-readiness__label--ready"
																							title={draftReadiness.missingSummary}
																							aria-label={`${risk.risk_ref}: ${draftReadiness.label}. ${draftReadiness.missingSummary}`}
																						>{draftReadiness.label}</span>
																					) : (
																						<details class="risk-register-draft-readiness__details">
																							<summary aria-controls={draftReadinessId} aria-label={`${risk.risk_ref}: ${draftReadiness.label}. Show missing activation requirements.`}>
																								<span>{draftReadiness.label}</span>
																							</summary>
																							<div id={draftReadinessId} class="risk-register-draft-readiness__panel">
																								<ul>
																									{draftReadiness.missing.map((requirement) => (
																										<li><strong>{requirement.label}</strong><span>{requirement.message}</span></li>
																									))}
																								</ul>
																								<p>Open the Draft risk detail page to complete these fields.</p>
																							</div>
																						</details>
																					)}
																				</div>
																			</td>
																		)}
																		{showDraftColumns && draftReadiness && (
																			<td>
																				<span
																					class={`risk-register-draft-age${draftReadiness.reviewChallenge ? ' risk-register-draft-age--challenge' : ''}`}
																					aria-label={`${risk.risk_ref}: Draft age ${draftReadiness.reviewDescription}`}
																					title={draftReadiness.reviewDescription}
																					data-risk-draft-age
																				>
																					<span>{draftReadiness.ageLabel}</span>
																					{draftReadiness.reviewChallenge && <strong>{draftReadiness.reviewLabel}</strong>}
																				</span>
																			</td>
																		)}
																		<td>
																			<span class={`risk-register-table__owner${risk.owner_id ? '' : ' risk-register-table__owner--missing'}`}>
																				{ownerLabel}
																			</span>
																		</td>
																		<td>
																			<span class={`risk-register-table__review risk-register-table__review--${reviewDue.tone}`}>
																				{reviewDue.statusLabel && <span>{reviewDue.statusLabel}</span>}
																				<span>{reviewDue.label}</span>
																			</span>
																		</td>
																		<td><time datetime={risk.updated_at}>{formatDateTime(risk.updated_at)}</time></td>
																	</tr>
																);
															})}
														</tbody>
													</table>
												</div>
												<div class="risk-register-pagination" aria-label="Risk Register pagination" data-risk-register-pagination>
													<form class="risk-register-page-size" method="get" action={registerPath} data-risk-register-page-size>
														{pageSizeHiddenFields.map(([name, value]) => <input type="hidden" name={name} value={value} />)}
														<label>
															<span>Show</span>
															<select name="pageSize" aria-label="Risks per page">
																{RISK_REGISTER_PAGE_SIZES.map((size) => (
																	<option value={size} selected={pagination.pageSize === size}>{size}</option>
																))}
															</select>
														</label>
														<button class="button button--secondary" type="submit">Apply</button>
														<span class="risk-register-pagination__range" data-risk-register-result-range>
															{pagination.startItem}–{pagination.endItem} of {pagination.totalItems} risks
														</span>
													</form>
													<nav class="risk-register-pagination__nav" aria-label="Risk Register pages">
														{pagination.hasPrevious ? (
															<a class="risk-register-page-link" href={buildRegisterPath({ page: pagination.page - 1 })} rel="prev" aria-label="Go to previous Risk Register page">Previous</a>
														) : (
															<button class="risk-register-page-link" type="button" disabled aria-label="Previous Risk Register page unavailable">Previous</button>
														)}
														<span class="risk-register-pagination__pages" aria-label={`Page ${pagination.page} of ${pagination.totalPages}`}>
															{pageNumbers.map((pageNumber) => (
																pageNumber === pagination.page ? (
																	<span class="risk-register-page-link risk-register-page-link--current" aria-current="page">{pageNumber}</span>
																) : (
																	<a class="risk-register-page-link" href={buildRegisterPath({ page: pageNumber })} aria-label={`Go to Risk Register page ${pageNumber}`}>{pageNumber}</a>
																)
															))}
														</span>
														<span class="risk-register-pagination__summary">Page {pagination.page} of {pagination.totalPages}</span>
														{pagination.hasNext ? (
															<a class="risk-register-page-link" href={buildRegisterPath({ page: pagination.page + 1 })} rel="next" aria-label="Go to next Risk Register page">Next</a>
														) : (
															<button class="risk-register-page-link" type="button" disabled aria-label="Next Risk Register page unavailable">Next</button>
														)}
													</nav>
												</div>
											</>
										)}
									</>
								)}
							</div>

							<div class="risk-register-side-panels">
								<aside class="risk-register-needs-action" aria-labelledby="risk-register-needs-action-heading" data-risk-needs-action-panel>
									<div class="risk-register-needs-action__heading">
										<div>
											<h3 id="risk-register-needs-action-heading">Needs action</h3>
											<p>Highest-priority risk work</p>
										</div>
										<span class="risk-register-needs-action__count" aria-label={`${needsActionItems.length} visible needs action items`}>{needsActionItems.length}</span>
									</div>
									{needsActionItems.length === 0 ? (
										<p class="risk-register-needs-action__empty" data-risk-needs-action-empty>No active risk work currently needs attention.</p>
									) : (
										<ul class="risk-register-needs-action__list">
											{needsActionItems.map((item) => {
												const riskHref = buildRiskDetailPath(item.riskId, 'need-action');
												return (
													<li class={`risk-register-needs-action__item risk-register-needs-action__item--${item.tone}`}>
														<a href={riskHref} aria-label={`${item.label} for ${item.riskReference}: ${item.riskTitle}`}>
															<span class="risk-register-needs-action__item-label">{item.label}</span>
															<span class="risk-register-needs-action__risk">{item.riskReference} · {item.riskTitle}</span>
															<span class="risk-register-needs-action__reason">{item.reason}</span>
														</a>
													</li>
												);
											})}
										</ul>
									)}
									<a class="text-link risk-register-needs-action__all" href={needsActionHref} data-risk-needs-action-view-all>View all need action items</a>
								</aside>

								<aside class="risk-register-exposure-chart" aria-labelledby="risk-register-exposure-chart-heading" data-risk-exposure-distribution>
									<div class="risk-register-exposure-chart__heading">
										<h3 id="risk-register-exposure-chart-heading">Exposure distribution</h3>
										<p>Active exposure and closed risks</p>
									</div>
									<p class="visually-hidden" data-risk-exposure-chart-summary>{exposureDistribution.summary}</p>
									{exposureDistribution.totalActiveRisks === 0 && exposureDistribution.closedRisks === 0 ? (
										<p class="risk-register-exposure-chart__empty" data-risk-exposure-chart-empty>No active or closed risks to chart.</p>
									) : exposureDistribution.chartedRisks === 0 ? (
										<p class="risk-register-exposure-chart__empty" data-risk-exposure-chart-unassessed>Exposure distribution will appear when active risks are assessed. {exposureDistribution.unassessedActiveRisks} active {exposureDistribution.unassessedActiveRisks === 1 ? 'risk needs' : 'risks need'} exposure assessment.</p>
									) : (
										<div class="risk-register-exposure-chart__body">
											<div class="risk-register-exposure-chart__donut" aria-hidden="true">
												<svg viewBox="0 0 140 140" role="presentation" focusable="false">
													<circle class="risk-register-exposure-chart__track" cx="70" cy="70" r={exposureChartRadius}></circle>
													{exposureChartSegments.map((segment) => (
														<circle
															class={`risk-register-exposure-chart__segment risk-register-exposure-chart__segment--${segment.exposure}`}
															cx="70"
															cy="70"
															r={exposureChartRadius}
															stroke-dasharray={segment.dashArray}
															stroke-dashoffset={segment.dashOffset}
														></circle>
													))}
												</svg>
												<div class="risk-register-exposure-chart__total">
													<strong>{exposureDistribution.chartedRisks}</strong>
													<span>charted</span>
												</div>
											</div>
											<ul class="risk-register-exposure-chart__legend">
												{exposureDistribution.segments.map((segment) => (
													<li class={`risk-register-exposure-chart__legend-item risk-register-exposure-chart__legend-item--${segment.exposure}`}>
														<span class="risk-register-exposure-chart__legend-label">
															<span class="risk-register-exposure-chart__swatch" aria-hidden="true"></span>
															<span>{segment.label}</span>
														</span>
														<span class="risk-register-exposure-chart__legend-value">{segment.count} <span>{segment.percentage}%</span></span>
													</li>
												))}
											</ul>
										</div>
									)}
									{exposureDistribution.unassessedActiveRisks > 0 && exposureDistribution.assessedActiveRisks > 0 && (
										<p class="risk-register-exposure-chart__note">{exposureDistribution.unassessedActiveRisks} active {exposureDistribution.unassessedActiveRisks === 1 ? 'risk is' : 'risks are'} not assessed and excluded from percentages.</p>
									)}
								</aside>
							</div>
						</div>
					)}
					<a class="button button--secondary risk-register-back-link" href={buildProjectPath(workspaceSlug ?? '', project.slug)}>Back to Project</a>
				</section>

				<dialog class="risk-prompt-modal" aria-labelledby="risk-prompt-modal-title" data-risk-prompt-modal>
					<div class="risk-prompt-modal__header">
						<div class="risk-prompt-modal__icon" aria-hidden="true">?</div>
						<div>
							<p class="eyebrow">Guided risk identification</p>
							<h2 id="risk-prompt-modal-title">Create risks from prompts</h2>
							<p>Review common risk areas and select any prompts that may apply to this project. These prompts are not assessed project risks; selected prompts will later be created as draft risk records for review and assessment.</p>
						</div>
						<form method="dialog">
							<button class="risk-prompt-modal__close" type="submit" aria-label="Close risk prompt modal">x</button>
						</form>
					</div>

					<div class="risk-prompt-modal__loading" data-risk-prompt-loading hidden>
						<p>Loading risk prompts...</p>
					</div>

					{riskPromptLibraryLoadError ? (
						<div class="risk-prompt-modal__state" role="alert" data-risk-prompt-error>
							<h3>We could not load the risk prompt library.</h3>
							<p>Close the modal and try again.</p>
						</div>
					) : !riskPromptLibrary ? (
						<div class="risk-prompt-modal__state" data-risk-prompt-no-library>
							<h3>The Watchtower Default Risk Prompt Library is not currently available.</h3>
							<p>No prompts can be selected until the active default library has been seeded.</p>
						</div>
					) : activePromptAreas.length === 0 ? (
						<div class="risk-prompt-modal__state" data-risk-prompt-no-areas>
							<h3>No active risk areas are available in this library.</h3>
							<p>Prompt selection will be available when active risk areas are configured.</p>
						</div>
					) : (
						<div class="risk-prompt-modal__workspace" data-risk-prompt-workspace data-total-prompt-count={activePromptCount}>
							<div class="risk-prompt-tabs" role="tablist" aria-label="Risk prompt areas" data-risk-prompt-tabs>
								{activePromptAreas.map((area) => {
									const selected = area.id === firstPromptArea?.id;
									return (
										<button
											class={`risk-prompt-tab${selected ? ' risk-prompt-tab--active' : ''}`}
											id={`risk-prompt-tab-${area.risk_area_key}`}
											type="button"
											role="tab"
											aria-selected={selected ? 'true' : 'false'}
											aria-controls={`risk-prompt-panel-${area.risk_area_key}`}
											aria-label={`${area.risk_area_title}, 0 prompts selected`}
											tabindex={selected ? '0' : '-1'}
											data-risk-prompt-tab={area.id}
											data-risk-prompt-tab-title={area.risk_area_title}
										>
											<span>{riskPromptAreaTabLabel(area)}</span>
											<span class="risk-prompt-tab__count" aria-hidden="true" data-risk-prompt-tab-count={area.id} hidden>0</span>
										</button>
									);
								})}
							</div>

							<div class="risk-prompt-panels" data-risk-prompt-panels>
								{activePromptAreas.map((area) => {
									const selected = area.id === firstPromptArea?.id;
									return (
										<section
											class="risk-prompt-panel"
											id={`risk-prompt-panel-${area.risk_area_key}`}
											role="tabpanel"
											aria-labelledby={`risk-prompt-tab-${area.risk_area_key}`}
											data-risk-prompt-panel={area.id}
											hidden={!selected}
										>
											<div class="risk-prompt-panel__heading">
												<h3>{area.risk_area_title}</h3>
												<p>{area.prompts.length} active {area.prompts.length === 1 ? 'prompt' : 'prompts'}</p>
											</div>
											{area.prompts.length > 0 ? (
												<ul class="risk-prompt-list" data-risk-prompt-list>
													{area.prompts.map((prompt) => (
														<li class="risk-prompt-row" data-risk-prompt-row={prompt.risk_prompt_id}>
															<label>
																<span class="risk-prompt-row__text">
																	<strong>{prompt.risk_prompt_title}</strong>
																	<span class="visually-hidden">{prompt.risk_prompt_guidance}</span>
																</span>
																<input
																	type="checkbox"
																	value={prompt.risk_prompt_id}
																	aria-label={`Select risk prompt: ${prompt.risk_prompt_title}`}
																	aria-describedby={`risk-prompt-guidance-${prompt.risk_prompt_id}`}
																	data-risk-prompt-checkbox
																	data-risk-prompt-id={prompt.risk_prompt_id}
																	data-risk-prompt-area-id={area.id}
																/>
																<span class="risk-prompt-row__switch" aria-hidden="true"></span>
															</label>
															<span class="visually-hidden" id={`risk-prompt-guidance-${prompt.risk_prompt_id}`}>{prompt.risk_prompt_guidance}</span>
														</li>
													))}
												</ul>
											) : (
												<p class="risk-prompt-panel__empty" data-risk-prompt-empty-area>No active risk prompts are available in this area.</p>
											)}
										</section>
									);
								})}

								<section
									class="risk-prompt-selected-review"
									aria-labelledby="risk-prompt-selected-review-title"
									data-risk-prompt-selected-view
									tabindex="-1"
									hidden
								>
									<div class="risk-prompt-panel__heading risk-prompt-selected-review__heading">
										<div>
											<h3 id="risk-prompt-selected-review-title">Selected risk prompts</h3>
											<p>Review the prompts selected across all risk areas. Remove any that no longer apply before creating draft risk records.</p>
										</div>
									</div>
									<div class="risk-prompt-selected-review__groups" data-risk-prompt-selected-groups>
										{activePromptAreas.map((area) => (
											<article class="risk-prompt-selected-review__group" data-risk-prompt-review-group={area.id} hidden>
												<div class="risk-prompt-selected-review__group-heading">
													<h4>{area.risk_area_title}</h4>
													<p data-risk-prompt-review-group-count={area.id}>0 prompts selected</p>
												</div>
												<ul class="risk-prompt-list" data-risk-prompt-review-list={area.id}>
													{area.prompts.map((prompt) => (
														<li
															class="risk-prompt-row risk-prompt-selected-review__row"
															data-risk-prompt-row={prompt.risk_prompt_id}
															data-risk-prompt-review-row={prompt.risk_prompt_id}
															hidden
														>
															<label>
																<span class="risk-prompt-row__text">
																	<strong>{prompt.risk_prompt_title}</strong>
																	<span class="visually-hidden">{prompt.risk_prompt_guidance}</span>
																</span>
																<input
																	type="checkbox"
																	value={prompt.risk_prompt_id}
																	aria-label={`Select risk prompt: ${prompt.risk_prompt_title}`}
																	aria-describedby={`risk-prompt-review-guidance-${prompt.risk_prompt_id}`}
																	data-risk-prompt-checkbox
																	data-risk-prompt-id={prompt.risk_prompt_id}
																	data-risk-prompt-area-id={area.id}
																/>
																<span class="risk-prompt-row__switch" aria-hidden="true"></span>
															</label>
															<span class="visually-hidden" id={`risk-prompt-review-guidance-${prompt.risk_prompt_id}`}>{prompt.risk_prompt_guidance}</span>
														</li>
													))}
												</ul>
											</article>
										))}
									</div>
									<div class="risk-prompt-selected-review__empty" data-risk-prompt-selected-empty hidden>
										<h4>No risk prompts are selected.</h4>
										<p>Return to the risk areas to choose prompts.</p>
										<button class="button button--secondary" type="button" data-risk-prompt-browse-areas>Browse risk areas</button>
									</div>
								</section>

								<section
									class="risk-prompt-confirmation"
									aria-labelledby="risk-prompt-confirmation-title"
									data-risk-prompt-confirmation-view
									tabindex="-1"
									hidden
								>
									<div class="risk-prompt-confirmation__heading">
										<p class="eyebrow">Guided risk identification</p>
										<h3 id="risk-prompt-confirmation-title">Create Draft risks</h3>
									</div>
									<div class="risk-prompt-confirmation__metrics" aria-live="polite">
										<div class="risk-prompt-confirmation__metric risk-prompt-confirmation__metric--selected">
											<strong data-risk-prompt-confirm-selected-count>0</strong>
											<span>prompts selected</span>
										</div>
										<div class="risk-prompt-confirmation__metric risk-prompt-confirmation__metric--create">
											<strong data-risk-prompt-confirm-create-count>0</strong>
											<span>Draft risks will be created</span>
										</div>
										<div class="risk-prompt-confirmation__metric risk-prompt-confirmation__metric--duplicate">
											<strong data-risk-prompt-confirm-duplicate-count>0</strong>
											<span>risks already exist in this project</span>
										</div>
									</div>
									<p class="risk-prompt-confirmation__notice" data-risk-prompt-confirm-invalid-notice hidden></p>
									<div class="risk-prompt-confirmation__sections">
										<section class="risk-prompt-confirmation__section risk-prompt-confirmation__section--create" data-risk-prompt-new-section>
											<div class="risk-prompt-confirmation__section-heading">
												<h4><span class="risk-prompt-confirmation__section-icon" aria-hidden="true">+</span> New Draft risks</h4>
												<p data-risk-prompt-new-count>0 risks</p>
											</div>
											<ul class="risk-prompt-confirmation__list" data-risk-prompt-new-list></ul>
										</section>
										<section class="risk-prompt-confirmation__section risk-prompt-confirmation__section--duplicate" data-risk-prompt-duplicate-section hidden>
											<div class="risk-prompt-confirmation__section-heading">
												<h4><span class="risk-prompt-confirmation__section-icon" aria-hidden="true">!</span> Already in this project</h4>
												<p data-risk-prompt-duplicate-list-count>0 risks</p>
											</div>
											<ul class="risk-prompt-confirmation__list" data-risk-prompt-duplicate-list></ul>
										</section>
									</div>
								</section>
							</div>

							<div class="risk-prompt-modal__footer">
								<p class="risk-prompt-create-status" role="status" aria-live="polite" data-risk-prompt-create-status hidden></p>
								<p class="risk-prompt-selected-total" aria-live="polite" data-risk-prompt-selected-total>0 prompts selected</p>
								<button
									class="button button--secondary"
									type="button"
									disabled
									aria-pressed="false"
									aria-describedby="risk-prompt-show-selected-description"
									data-risk-prompt-review-toggle
								>Show selected only</button>
								<span class="visually-hidden" id="risk-prompt-show-selected-description">Review selected prompts when one or more prompts are selected.</span>
								<form method="dialog" data-risk-prompt-cancel-form>
									<button class="button button--secondary" type="submit">Cancel</button>
								</form>
								<button
									class="button button--secondary"
									type="button"
									data-risk-prompt-confirm-back
									hidden
								>Back to selection</button>
								<button
									class="button button--primary"
									type="button"
									disabled
									aria-describedby="risk-prompt-create-disabled"
									data-risk-prompt-create-action={riskPromptDraftCreatePath}
									data-risk-prompt-can-create={canCreateRisk ? 'true' : 'false'}
								>Create risks</button>
								<button
									class="button button--primary"
									type="button"
									disabled
									data-risk-prompt-confirm-create
									hidden
								>No new Draft risks to create</button>
								<span class="visually-hidden" id="risk-prompt-create-disabled">{canCreateRisk ? 'Select one or more prompts to create draft risks.' : 'Viewer access is read-only. Risk creation is unavailable.'}</span>
							</div>
						</div>
					)}
				</dialog>
			</>
		) : (
			<section class="content-card" data-feature-unavailable-message>
				<p class="eyebrow">Risk Management</p>
				<h1>Feature unavailable</h1>
				<p>{message}</p>
				<a class="button button--secondary" href={workspaceSlug && projectSlug ? buildProjectPath(workspaceSlug, projectSlug) : '/app/projects'}>Back to project</a>
			</section>
		)}
	</section>
</AuthenticatedLayout>

<script>
	import {
		clearRiskPromptSelections,
		createRiskPromptSelectionState,
		getSelectedPromptCount,
		getSelectedPromptCountsByArea,
		getSelectedPromptTotalLabel,
		isRiskPromptSelected,
		removeUnknownRiskPromptSelections,
		toggleRiskPrompt,
	} from '../../../../../../lib/riskPromptSelection';

	const promptModal = document.querySelector('[data-risk-prompt-modal]');
	const promptOpenButton = document.querySelector('[data-risk-prompts-open]');
	const promptTabsContainer = document.querySelector('[data-risk-prompt-tabs]');
	const promptReviewToggle = document.querySelector('[data-risk-prompt-review-toggle]');
	const promptSelectedView = document.querySelector('[data-risk-prompt-selected-view]');
	const promptConfirmationView = document.querySelector('[data-risk-prompt-confirmation-view]');
	const promptSelectedEmpty = document.querySelector('[data-risk-prompt-selected-empty]');
	const promptBrowseAreasButton = document.querySelector('[data-risk-prompt-browse-areas]');
	const promptCreateButton = document.querySelector('[data-risk-prompt-create-action]');
	const promptConfirmCreateButton = document.querySelector('[data-risk-prompt-confirm-create]');
	const promptConfirmBackButton = document.querySelector('[data-risk-prompt-confirm-back]');
	const promptCancelForm = document.querySelector('[data-risk-prompt-cancel-form]');
	const promptCreateStatus = document.querySelector('[data-risk-prompt-create-status]');
	const promptConfirmSelectedCount = document.querySelector('[data-risk-prompt-confirm-selected-count]');
	const promptConfirmCreateCount = document.querySelector('[data-risk-prompt-confirm-create-count]');
	const promptConfirmDuplicateCount = document.querySelector('[data-risk-prompt-confirm-duplicate-count]');
	const promptConfirmInvalidNotice = document.querySelector('[data-risk-prompt-confirm-invalid-notice]');
	const promptNewSection = document.querySelector('[data-risk-prompt-new-section]');
	const promptNewCount = document.querySelector('[data-risk-prompt-new-count]');
	const promptNewList = document.querySelector('[data-risk-prompt-new-list]');
	const promptDuplicateSection = document.querySelector('[data-risk-prompt-duplicate-section]');
	const promptDuplicateListCount = document.querySelector('[data-risk-prompt-duplicate-list-count]');
	const promptDuplicateList = document.querySelector('[data-risk-prompt-duplicate-list]');
	type RiskPromptConfirmationView = 'areas' | 'selected' | 'confirm';
	type RiskPromptPreflight = {
		selectedPromptCount: number;
		createableCount: number;
		duplicateCount: number;
		invalidPromptCount: number;
		createablePrompts: { riskPromptId: string; title: string }[];
		duplicatePrompts: {
			riskPromptId: string;
			title: string;
			existingRiskId?: string;
			existingRiskRef?: string;
			existingRiskTitle?: string;
			existingRiskPath?: string;
		}[];
	};
	let selectedPromptIds = createRiskPromptSelectionState();
	let knownRiskPromptIds = new Set<string>();
	let riskPromptAreaByPromptId = new Map<string, string>();
	let promptModalTrigger = null;
	let promptModalView: RiskPromptConfirmationView = 'areas';
	let activePromptTabBeforeReview: HTMLElement | null = null;
	let isCreatingPromptDrafts = false;
	let promptDraftPreflight: RiskPromptPreflight | null = null;

	const promptTabs = () => Array.from(document.querySelectorAll('[data-risk-prompt-tab]'));
	const promptPanels = () => Array.from(document.querySelectorAll('[data-risk-prompt-panel]'));
	const promptCheckboxes = () => Array.from(document.querySelectorAll('[data-risk-prompt-checkbox]'));
	const promptReviewGroups = () => Array.from(document.querySelectorAll('[data-risk-prompt-review-group]'));
	const promptReviewRows = () => Array.from(document.querySelectorAll('[data-risk-prompt-review-row]'));

	const setRiskPromptCreateStatus = (message = '', tone = 'neutral') => {
		if (!(promptCreateStatus instanceof HTMLElement)) return;
		promptCreateStatus.textContent = message;
		promptCreateStatus.hidden = !message;
		promptCreateStatus.dataset.tone = tone;
	};

	const setPromptModalScrollLock = (locked: boolean) => {
		document.documentElement.classList.toggle('modal-scroll-locked', locked);
		document.body.classList.toggle('modal-scroll-locked', locked);
	};

	const rebuildRiskPromptSelectionIndex = () => {
		knownRiskPromptIds = new Set<string>();
		riskPromptAreaByPromptId = new Map<string, string>();
		promptCheckboxes().forEach((checkbox) => {
			if (!(checkbox instanceof HTMLInputElement)) return;
			const promptId = checkbox.dataset.riskPromptId || checkbox.value;
			const areaId = checkbox.dataset.riskPromptAreaId || '';
			if (!promptId || !areaId) return;
			knownRiskPromptIds.add(promptId);
			riskPromptAreaByPromptId.set(promptId, areaId);
		});
		selectedPromptIds = removeUnknownRiskPromptSelections(selectedPromptIds, knownRiskPromptIds);
	};

	const syncRiskPromptControls = () => {
		promptCheckboxes().forEach((checkbox) => {
			if (!(checkbox instanceof HTMLInputElement)) return;
			const promptId = checkbox.dataset.riskPromptId || checkbox.value;
			checkbox.checked = isRiskPromptSelected(selectedPromptIds, promptId);
		});
	};

	const updateRiskPromptReview = () => {
		const countsByArea = getSelectedPromptCountsByArea(selectedPromptIds, riskPromptAreaByPromptId);
		promptReviewRows().forEach((row) => {
			if (!(row instanceof HTMLElement)) return;
			const promptId = row.dataset.riskPromptReviewRow || '';
			row.hidden = !isRiskPromptSelected(selectedPromptIds, promptId);
		});
		promptReviewGroups().forEach((group) => {
			if (!(group instanceof HTMLElement)) return;
			const areaId = group.dataset.riskPromptReviewGroup || '';
			const count = countsByArea.get(areaId) || 0;
			group.hidden = count === 0;
			const countLabel = group.querySelector('[data-risk-prompt-review-group-count]');
			if (countLabel) countLabel.textContent = getSelectedPromptTotalLabel(count);
		});
		if (promptSelectedEmpty instanceof HTMLElement) {
			promptSelectedEmpty.hidden = promptModalView !== 'selected' || getSelectedPromptCount(selectedPromptIds) > 0;
		}
	};

	const updateRiskPromptReviewToggle = () => {
		if (!(promptReviewToggle instanceof HTMLButtonElement)) return;
		const total = getSelectedPromptCount(selectedPromptIds);
		const isReviewMode = promptModalView === 'selected';
		promptReviewToggle.hidden = promptModalView === 'confirm';
		promptReviewToggle.disabled = promptModalView === 'confirm' || (!isReviewMode && total === 0);
		promptReviewToggle.textContent = isReviewMode ? 'Show all risk areas' : 'Show selected only';
		promptReviewToggle.setAttribute('aria-pressed', isReviewMode ? 'true' : 'false');
		promptReviewToggle.setAttribute('aria-label', isReviewMode
			? 'Return to all risk areas'
			: total > 0
				? `Show ${total} selected ${total === 1 ? 'risk prompt' : 'risk prompts'}`
				: 'Show selected risk prompts');
	};

	const updateRiskPromptCreateButton = () => {
		if (!(promptCreateButton instanceof HTMLButtonElement)) return;
		const total = getSelectedPromptCount(selectedPromptIds);
		const canCreate = promptCreateButton.dataset.riskPromptCanCreate === 'true';
		promptCreateButton.hidden = promptModalView === 'confirm';
		promptCreateButton.disabled = promptModalView === 'confirm' || isCreatingPromptDrafts || !canCreate || total === 0;
		if (isCreatingPromptDrafts) {
			promptCreateButton.textContent = 'Checking selected prompts...';
		} else if (total > 0) {
			promptCreateButton.textContent = `Create ${total} draft ${total === 1 ? 'risk' : 'risks'}`;
		} else {
			promptCreateButton.textContent = 'Create risks';
		}
		if (promptConfirmCreateButton instanceof HTMLButtonElement) {
			const createableCount = promptDraftPreflight?.createableCount ?? 0;
			const canConfirm = promptCreateButton.dataset.riskPromptCanCreate === 'true';
			promptConfirmCreateButton.hidden = promptModalView !== 'confirm';
			promptConfirmCreateButton.disabled = isCreatingPromptDrafts || !canConfirm || createableCount === 0;
			if (isCreatingPromptDrafts) {
				promptConfirmCreateButton.textContent = 'Creating Draft risks...';
			} else if (createableCount > 0) {
				promptConfirmCreateButton.textContent = `Create ${createableCount} Draft ${createableCount === 1 ? 'risk' : 'risks'}`;
			} else {
				promptConfirmCreateButton.textContent = 'No new Draft risks to create';
			}
		}
		if (promptConfirmBackButton instanceof HTMLButtonElement) {
			promptConfirmBackButton.hidden = promptModalView !== 'confirm';
			promptConfirmBackButton.disabled = isCreatingPromptDrafts;
		}
		if (promptCancelForm instanceof HTMLElement) promptCancelForm.hidden = promptModalView === 'confirm';
	};

	const updateRiskPromptCounts = () => {
		const countsByArea = getSelectedPromptCountsByArea(selectedPromptIds, riskPromptAreaByPromptId);
		promptTabs().forEach((tab) => {
			if (!(tab instanceof HTMLElement)) return;
			const areaId = tab.dataset.riskPromptTab || '';
			const areaTitle = tab.dataset.riskPromptTabTitle || 'Risk area';
			const count = countsByArea.get(areaId) || 0;
			tab.setAttribute('aria-label', `${areaTitle}, ${getSelectedPromptTotalLabel(count)}`);
		});

		document.querySelectorAll('[data-risk-prompt-tab-count]').forEach((badge) => {
			if (!(badge instanceof HTMLElement)) return;
			const areaId = badge.dataset.riskPromptTabCount || '';
			const count = countsByArea.get(areaId) || 0;
			badge.textContent = String(count);
			badge.hidden = count === 0;
		});

		const total = getSelectedPromptCount(selectedPromptIds);
		const selectedTotal = document.querySelector('[data-risk-prompt-selected-total]');
		if (selectedTotal) selectedTotal.textContent = getSelectedPromptTotalLabel(total);
		updateRiskPromptReview();
		updateRiskPromptReviewToggle();
		updateRiskPromptCreateButton();
	};

	const setActiveRiskPromptTab = (tabToActivate, focusTab = true) => {
		if (!(tabToActivate instanceof HTMLElement)) return;
		const areaId = tabToActivate.dataset.riskPromptTab || '';
		promptTabs().forEach((tab) => {
			if (!(tab instanceof HTMLElement)) return;
			const isActive = tab === tabToActivate;
			tab.classList.toggle('risk-prompt-tab--active', isActive);
			tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
			tab.tabIndex = isActive ? 0 : -1;
		});
		promptPanels().forEach((panel) => {
			if (!(panel instanceof HTMLElement)) return;
			panel.hidden = panel.dataset.riskPromptPanel !== areaId;
		});
		if (focusTab) tabToActivate.focus();
	};

	const selectedRiskPromptReviewTarget = () => {
		const visibleReviewRow = promptReviewRows().find((row) => row instanceof HTMLElement && !row.hidden);
		const checkbox = visibleReviewRow instanceof HTMLElement
			? visibleReviewRow.querySelector('[data-risk-prompt-checkbox]')
			: null;
		if (checkbox instanceof HTMLElement) return checkbox;
		if (promptBrowseAreasButton instanceof HTMLElement) return promptBrowseAreasButton;
		return promptReviewToggle instanceof HTMLElement ? promptReviewToggle : null;
	};

	const formatRiskPromptCount = (count: number, noun = 'risk') => `${count} ${noun}${count === 1 ? '' : 's'}`;

	const replaceListItems = (list: Element | null, items: Element[]) => {
		if (!(list instanceof HTMLElement)) return;
		list.replaceChildren(...items);
	};

	const renderRiskPromptPreflight = (preflight: RiskPromptPreflight) => {
		const selectedCount = Number(preflight.selectedPromptCount) || getSelectedPromptCount(selectedPromptIds);
		const createableCount = Number(preflight.createableCount) || 0;
		const duplicateCount = Number(preflight.duplicateCount) || 0;
		const invalidCount = Number(preflight.invalidPromptCount) || 0;
		if (promptConfirmSelectedCount) promptConfirmSelectedCount.textContent = String(selectedCount);
		if (promptConfirmCreateCount) promptConfirmCreateCount.textContent = String(createableCount);
		if (promptConfirmDuplicateCount) promptConfirmDuplicateCount.textContent = String(duplicateCount);
		if (promptConfirmInvalidNotice instanceof HTMLElement) {
			promptConfirmInvalidNotice.textContent = invalidCount > 0
				? `${invalidCount} selected ${invalidCount === 1 ? 'prompt is' : 'prompts are'} no longer active and will not be created.`
				: '';
			promptConfirmInvalidNotice.hidden = invalidCount === 0;
		}
		if (promptNewCount) promptNewCount.textContent = formatRiskPromptCount(createableCount);
		replaceListItems(promptNewList, preflight.createablePrompts.map((prompt) => {
			const item = document.createElement('li');
			item.textContent = prompt.title;
			return item;
		}));
		if (promptNewSection instanceof HTMLElement) promptNewSection.hidden = createableCount === 0;
		if (promptDuplicateListCount) promptDuplicateListCount.textContent = formatRiskPromptCount(duplicateCount);
		replaceListItems(promptDuplicateList, preflight.duplicatePrompts.map((prompt) => {
			const item = document.createElement('li');
			item.className = 'risk-prompt-confirmation__duplicate-item';
			const ref = prompt.existingRiskRef || 'Existing risk';
			let reference: HTMLElement;
			if (prompt.existingRiskPath) {
				const link = document.createElement('a');
				link.href = prompt.existingRiskPath;
				link.target = '_blank';
				link.rel = 'noopener noreferrer';
				link.className = 'text-link risk-prompt-confirmation__risk-ref';
				link.textContent = ref;
				reference = link;
			} else {
				const fallback = document.createElement('span');
				fallback.className = 'risk-prompt-confirmation__risk-ref';
				fallback.textContent = ref;
				reference = fallback;
			}
			const title = document.createElement('span');
			title.className = 'risk-prompt-confirmation__risk-title';
			title.textContent = prompt.existingRiskTitle || prompt.title;
			item.append(reference, title);
			return item;
		}));
		if (promptDuplicateSection instanceof HTMLElement) promptDuplicateSection.hidden = duplicateCount === 0;
	};

	const setRiskPromptModalView = (view: RiskPromptConfirmationView, focusTarget = true) => {
		const nextView = view === 'confirm'
			? 'confirm'
			: view === 'selected' && getSelectedPromptCount(selectedPromptIds) > 0
				? 'selected'
				: 'areas';
		if (nextView === 'selected') {
			const activeTab = document.querySelector('[data-risk-prompt-tab][aria-selected="true"]');
			activePromptTabBeforeReview = activeTab instanceof HTMLElement ? activeTab : null;
		}
		promptModalView = nextView;
		if (promptTabsContainer instanceof HTMLElement) promptTabsContainer.hidden = nextView !== 'areas';
		promptPanels().forEach((panel) => {
			if (panel instanceof HTMLElement) panel.hidden = nextView !== 'areas' || panel.getAttribute('aria-labelledby') !== document.querySelector('[data-risk-prompt-tab][aria-selected="true"]')?.id;
		});
		if (promptSelectedView instanceof HTMLElement) promptSelectedView.hidden = nextView !== 'selected';
		if (promptConfirmationView instanceof HTMLElement) promptConfirmationView.hidden = nextView !== 'confirm';
		updateRiskPromptCounts();
		if (nextView === 'areas') {
			const tabToRestore = activePromptTabBeforeReview && document.contains(activePromptTabBeforeReview)
				? activePromptTabBeforeReview
				: promptTabs()[0];
			if (tabToRestore instanceof HTMLElement) setActiveRiskPromptTab(tabToRestore, focusTarget);
			return;
		}
		if (nextView === 'confirm') {
			if (focusTarget && promptConfirmationView instanceof HTMLElement) promptConfirmationView.focus();
			return;
		}
		if (!focusTarget) return;
		const target = selectedRiskPromptReviewTarget();
		if (target instanceof HTMLElement) target.focus();
	};

	const resetRiskPromptSelection = () => {
		selectedPromptIds = clearRiskPromptSelections();
		isCreatingPromptDrafts = false;
		promptDraftPreflight = null;
		setRiskPromptCreateStatus();
		syncRiskPromptControls();
		setRiskPromptModalView('areas', false);
		const firstTab = promptTabs()[0];
		if (firstTab instanceof HTMLElement) setActiveRiskPromptTab(firstTab, false);
		activePromptTabBeforeReview = null;
		updateRiskPromptCounts();
	};

	if (promptOpenButton instanceof HTMLElement && promptModal instanceof HTMLDialogElement) {
		promptOpenButton.addEventListener('click', () => {
			promptModalTrigger = promptOpenButton;
			rebuildRiskPromptSelectionIndex();
			resetRiskPromptSelection();
			promptModal.showModal();
			setPromptModalScrollLock(true);
			const firstFocus = promptModal.querySelector('[data-risk-prompt-tab], button, [href], input, select, textarea');
			if (firstFocus instanceof HTMLElement) firstFocus.focus();
		});

		promptModal.addEventListener('close', () => {
			setPromptModalScrollLock(false);
			resetRiskPromptSelection();
			if (promptModalTrigger instanceof HTMLElement && document.contains(promptModalTrigger)) {
				promptModalTrigger.focus();
			}
			promptModalTrigger = null;
		});
	}

	promptTabs().forEach((tab, index, tabs) => {
		if (!(tab instanceof HTMLElement)) return;
		tab.addEventListener('click', () => setActiveRiskPromptTab(tab));
		tab.addEventListener('keydown', (event) => {
			const keyActions = {
				ArrowRight: 1,
				ArrowDown: 1,
				ArrowLeft: -1,
				ArrowUp: -1,
			};
			if (event.key === 'Home') {
				event.preventDefault();
				setActiveRiskPromptTab(tabs[0]);
				return;
			}
			if (event.key === 'End') {
				event.preventDefault();
				setActiveRiskPromptTab(tabs[tabs.length - 1]);
				return;
			}
			const direction = keyActions[event.key];
			if (!direction) return;
			event.preventDefault();
			const nextIndex = (index + direction + tabs.length) % tabs.length;
			setActiveRiskPromptTab(tabs[nextIndex]);
		});
	});

	promptCheckboxes().forEach((checkbox) => {
		if (!(checkbox instanceof HTMLInputElement)) return;
		checkbox.addEventListener('change', () => {
			const promptId = checkbox.dataset.riskPromptId || checkbox.value;
			const changedInReviewMode = promptModalView === 'selected' && Boolean(checkbox.closest('[data-risk-prompt-selected-view]'));
			selectedPromptIds = toggleRiskPrompt(selectedPromptIds, promptId, checkbox.checked, knownRiskPromptIds);
			setRiskPromptCreateStatus();
			syncRiskPromptControls();
			updateRiskPromptCounts();
			if (changedInReviewMode && !checkbox.checked) {
				const target = selectedRiskPromptReviewTarget();
				if (target instanceof HTMLElement) target.focus();
			}
		});
	});

	if (promptReviewToggle instanceof HTMLButtonElement) {
		promptReviewToggle.addEventListener('click', () => {
			setRiskPromptModalView(promptModalView === 'selected' ? 'areas' : 'selected');
		});
	}

	if (promptBrowseAreasButton instanceof HTMLButtonElement) {
		promptBrowseAreasButton.addEventListener('click', () => {
			setRiskPromptModalView('areas');
		});
	}

	if (promptConfirmBackButton instanceof HTMLButtonElement) {
		promptConfirmBackButton.addEventListener('click', () => {
			if (isCreatingPromptDrafts) return;
			setRiskPromptCreateStatus();
			setRiskPromptModalView(getSelectedPromptCount(selectedPromptIds) > 0 ? 'selected' : 'areas');
		});
	}

	if (promptCreateButton instanceof HTMLButtonElement) {
		promptCreateButton.addEventListener('click', async () => {
			const riskPromptIds = [...selectedPromptIds];
			const endpoint = promptCreateButton.dataset.riskPromptCreateAction || '';
			if (isCreatingPromptDrafts || riskPromptIds.length === 0 || !endpoint) return;

			isCreatingPromptDrafts = true;
			setRiskPromptCreateStatus('Checking selected prompts...', 'neutral');
			updateRiskPromptCreateButton();

			try {
				const response = await fetch(endpoint, {
					method: 'POST',
					credentials: 'same-origin',
					headers: { 'content-type': 'application/json' },
					body: JSON.stringify({ mode: 'preflight', riskPromptIds }),
				});
				const payload = await response.json().catch(() => ({}));
				if (response.status === 401 && typeof payload.loginPath === 'string') {
					window.location.assign(payload.loginPath);
					return;
				}
				if (!response.ok || payload.ok !== true) {
					throw new Error(typeof payload.message === 'string' ? payload.message : 'Unable to create draft risks from the selected prompts.');
				}

				promptDraftPreflight = {
					selectedPromptCount: Number(payload.selectedPromptCount) || riskPromptIds.length,
					createableCount: Number(payload.createableCount) || 0,
					duplicateCount: Number(payload.duplicateCount) || 0,
					invalidPromptCount: Number(payload.invalidPromptCount) || 0,
					createablePrompts: Array.isArray(payload.createablePrompts) ? payload.createablePrompts : [],
					duplicatePrompts: Array.isArray(payload.duplicatePrompts) ? payload.duplicatePrompts : [],
				};
				renderRiskPromptPreflight(promptDraftPreflight);
				setRiskPromptCreateStatus(promptDraftPreflight.createableCount > 0 ? '' : 'No new Draft risks to create', promptDraftPreflight.createableCount > 0 ? 'neutral' : 'warning');
				setRiskPromptModalView('confirm');
			} catch (error) {
				setRiskPromptCreateStatus(error instanceof Error ? error.message : 'Unable to create draft risks from the selected prompts.', 'error');
			} finally {
				isCreatingPromptDrafts = false;
				updateRiskPromptCreateButton();
			}
		});
	}

	if (promptConfirmCreateButton instanceof HTMLButtonElement && promptCreateButton instanceof HTMLButtonElement) {
		promptConfirmCreateButton.addEventListener('click', async () => {
			const riskPromptIds = [...selectedPromptIds];
			const endpoint = promptCreateButton.dataset.riskPromptCreateAction || '';
			if (isCreatingPromptDrafts || riskPromptIds.length === 0 || !endpoint || !promptDraftPreflight || promptDraftPreflight.createableCount === 0) return;

			isCreatingPromptDrafts = true;
			setRiskPromptCreateStatus('Creating Draft risks...', 'neutral');
			updateRiskPromptCreateButton();

			try {
				const response = await fetch(endpoint, {
					method: 'POST',
					credentials: 'same-origin',
					headers: { 'content-type': 'application/json' },
					body: JSON.stringify({ mode: 'create', riskPromptIds }),
				});
				const payload = await response.json().catch(() => ({}));
				if (response.status === 401 && typeof payload.loginPath === 'string') {
					window.location.assign(payload.loginPath);
					return;
				}
				if (!response.ok || payload.ok !== true) {
					throw new Error(typeof payload.message === 'string' ? payload.message : 'Unable to create draft risks from the selected prompts.');
				}

				const createdCount = Number(payload.createdCount) || 0;
				const skippedDuplicateCount = Number(payload.skippedDuplicateCount) || 0;
				if (createdCount > 0) {
					const nextUrl = new URL(window.location.href);
					nextUrl.searchParams.set('view', 'draft');
					nextUrl.searchParams.set('page', '1');
					nextUrl.searchParams.set('promptDraftsCreated', String(createdCount));
					nextUrl.searchParams.set('promptDraftsSkipped', String(skippedDuplicateCount));
					window.location.assign(nextUrl.toString());
					return;
				}

				promptDraftPreflight = {
					...promptDraftPreflight,
					createableCount: 0,
					duplicateCount: Math.max(promptDraftPreflight.duplicateCount, skippedDuplicateCount),
					createablePrompts: [],
				};
				renderRiskPromptPreflight(promptDraftPreflight);
				setRiskPromptCreateStatus('No new Draft risks to create', 'warning');
			} catch (error) {
				setRiskPromptCreateStatus(error instanceof Error ? error.message : 'Unable to create draft risks from the selected prompts.', 'error');
			} finally {
				isCreatingPromptDrafts = false;
				updateRiskPromptCreateButton();
			}
		});
	}

	rebuildRiskPromptSelectionIndex();
	syncRiskPromptControls();
	updateRiskPromptCounts();
</script>

<style>
	.risk-register-page {
		display: grid;
		gap: 0.9rem;
	}

	.risk-register-panel {
		display: grid;
		gap: 1rem;
		padding: clamp(1rem, 2vw, 1.5rem);
	}

	.risk-register-panel__actions {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1rem;
	}

	.risk-register-action {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: flex-end;
		gap: 0.45rem;
	}

	.risk-register-action [disabled] {
		opacity: 0.68;
		cursor: not-allowed;
	}

	.risk-register-summary {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.55rem;
		margin-bottom: 0.8rem;
	}

	.risk-register-summary-card {
		--summary-accent: var(--rag-neutral-accent);
		--summary-border: var(--rag-neutral-border);
		--summary-background: var(--rag-neutral-background);
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		align-items: center;
		gap: 0.64rem;
		min-height: 4.9rem;
		padding: 0.7rem 0.78rem;
		border: 1px solid var(--summary-border);
		border-radius: 8px;
		background:
			linear-gradient(135deg, var(--summary-background), rgba(8, 13, 23, 0.42)),
			rgba(8, 13, 23, 0.56);
	}

	.risk-register-summary-card__icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.18rem;
		height: 2.18rem;
		border: 1px solid var(--summary-border);
		border-radius: 999px;
		background: color-mix(in srgb, var(--summary-background) 78%, rgba(4, 12, 24, 0.58));
		color: var(--summary-accent);
		font-size: 1.02rem;
		font-weight: 950;
		line-height: 1;
		box-shadow: 0 0 0 0.34rem color-mix(in srgb, var(--summary-background) 42%, transparent);
	}

	.risk-register-summary-card__body {
		display: grid;
		gap: 0.22rem;
		min-width: 0;
	}

	.risk-register-summary-card--blue {
		--summary-accent: var(--rag-reference);
		--summary-border: var(--rag-reference-border);
		--summary-background: var(--rag-reference-background);
	}

	.risk-register-summary-card--attention {
		--summary-accent: var(--rag-red-accent);
		--summary-border: color-mix(in srgb, var(--rag-red-border) 58%, var(--rag-amber-border));
