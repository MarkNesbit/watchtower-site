---
import AuthenticatedLayout from '../../../../../../layouts/AuthenticatedLayout.astro';
import DisabledActionHint from '../../../../../../components/app/DisabledActionHint.astro';
import EmptyState from '../../../../../../components/app/EmptyState.astro';
import ProjectContentPanel from '../../../../../../components/app/ProjectContentPanel.astro';
import ProjectControlPanel from '../../../../../../components/app/ProjectControlPanel.astro';
import ProjectPageHero from '../../../../../../components/app/ProjectPageHero.astro';
import RagReferencePill from '../../../../../../components/app/RagReferencePill.astro';
import { getFeatureAccess, loadFeatureAccess } from '../../../../../../lib/featureFlags';
import { can } from '../../../../../../lib/permissions';
import {
	deriveRiskExposureTone,
	deriveRiskReferenceTone,
	listProjectRisks,
	riskDisplayLabel,
	riskExposureToneLabel,
	riskLifecycleCategory,
	riskLifecycleLabel,
	riskProfileName,
	riskReferenceStatusLabel,
} from '../../../../../../lib/projectRisks';
import { buildProjectNewRiskPath, buildProjectPath, buildProjectRiskPath, getWorkspaceBySlug } from '../../../../../../lib/projects';
import { createSupabaseServerClient, getServerAccessToken } from '../../../../../../lib/supabaseServer';

const projectSlug = Astro.params.projectId;
const workspaceSlug = Astro.params.workspaceSlug;
const accessToken = getServerAccessToken(Astro.cookies);
let project = null;
let risks = [];
let workspaceName = '';
let workspaceRole = '';
let message = '';
let risksLoadError = '';
let featureAccess = getFeatureAccess('riskManagement');

const formatDate = (value, fallback = 'Not available') => value
	? new Intl.DateTimeFormat('en-GB', { dateStyle: 'medium', timeZone: 'UTC' }).format(new Date(value))
	: fallback;
const formatDateTime = (value, fallback = 'Not available') => value
	? `${new Intl.DateTimeFormat('en-GB', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'UTC' }).format(new Date(value))} UTC`
	: fallback;
const startOfUtcDay = (date) => new Date(Date.UTC(date.getUTCFullYear(), date.getUTCMonth(), date.getUTCDate()));
const parseReviewDate = (value) => {
	if (!value || typeof value !== 'string' || !/^\d{4}-\d{2}-\d{2}$/.test(value)) return null;
	const date = new Date(`${value}T00:00:00Z`);
	return Number.isNaN(date.getTime()) ? null : date;
};
const reviewDueState = (risk, now = new Date()) => {
	const category = riskLifecycleCategory(risk.status);
	const date = parseReviewDate(risk.review_date);
	if (!date) return {
		tone: category === 'active' ? 'amber' : 'neutral',
		label: 'No review date',
		statusLabel: category === 'active' ? 'Missing' : '',
	};
	if (category === 'active' && date < startOfUtcDay(now)) return {
		tone: 'red',
		label: formatDate(risk.review_date),
		statusLabel: 'Overdue',
	};
	return {
		tone: 'neutral',
		label: formatDate(risk.review_date),
		statusLabel: '',
	};
};
const actionStateFor = (risk) => {
	if (riskLifecycleCategory(risk.status) !== 'active') return {
		tone: 'neutral',
		label: 'Not active',
		statusLabel: riskLifecycleLabel(risk.status),
	};
	return {
		tone: deriveRiskReferenceTone(risk),
		label: riskReferenceStatusLabel(risk),
		statusLabel: 'Action state',
	};
};
const lifecycleRank = (risk) => {
	const category = riskLifecycleCategory(risk.status);
	if (category === 'active') return 0;
	if (category === 'draft') return 1;
	return 2;
};
try {
	const serverSupabase = createSupabaseServerClient(accessToken);
	const workspace = await getWorkspaceBySlug(serverSupabase, workspaceSlug ?? '', accessToken);
	const organisation = Array.isArray(workspace?.organisations) ? workspace?.organisations[0] : workspace?.organisations;

	if (!workspace || !organisation) {
		message = 'Project not found or you do not have access.';
		Astro.response.status = 404;
	} else if (!can(workspace.role, 'risk.view')) {
		message = 'You do not have permission to view project risks.';
		Astro.response.status = 403;
	} else {
		workspaceName = organisation.name;
		workspaceRole = workspace.role;
		const { data, error } = await serverSupabase
			.from('projects')
			.select('id, name, project_ref, slug')
			.eq('slug', projectSlug)
			.eq('organisation_id', organisation.id)
			.is('deleted_at', null)
			.is('archived_at', null)
			.maybeSingle();
		if (error) throw error;

		if (!data) {
			message = 'Project not found or you do not have access.';
			Astro.response.status = 404;
		} else {
			featureAccess = await loadFeatureAccess(serverSupabase, 'riskManagement', accessToken);
			if (!featureAccess.isAccessible) {
				message = featureAccess.unavailableReason ?? 'This feature is not currently available to your account.';
				Astro.response.status = featureAccess.state === 'hidden' ? 404 : 403;
			} else {
				project = data;
				try {
					risks = await listProjectRisks(organisation.id, data.id, workspace.role, serverSupabase);
				} catch (error) {
					risks = [];
					risksLoadError = error instanceof Error ? error.message : 'Unable to load the Risk Register.';
				}
			}
		}
	}
} catch (error) {
	message = error instanceof Error ? error.message : 'Unable to load Risk Management.';
	Astro.response.status = 500;
}

const canCreateRisk = can(workspaceRole, 'risk.create');
const orderedRisks = [...risks].sort((a, b) => (
	lifecycleRank(a) - lifecycleRank(b)
	|| (a.risk_sequence ?? 0) - (b.risk_sequence ?? 0)
	|| String(a.risk_ref ?? '').localeCompare(String(b.risk_ref ?? ''))
	|| new Date(b.updated_at ?? 0).getTime() - new Date(a.updated_at ?? 0).getTime()
));
---
<AuthenticatedLayout title={project ? `Risk Register — ${project.name} | WatchTower` : 'Risk Register | WatchTower'}>
	<section class="risk-register-page" data-risk-management-route data-risk-register-route data-feature-state={featureAccess.state}>
		{project ? (
			<>
				<ProjectPageHero
					workspaceName={workspaceName}
					projectName={project.name}
					projectRef={project.project_ref}
					title="Risk Register"
					description="A clean register of source-of-truth project risks."
					headingId="risk-register-heading"
				/>

				<ProjectControlPanel title="Risk controls" status="Create and edit enabled" headingId="risk-register-controls-heading">
					<p class="risk-register-controls__copy">Create and update project-level source-of-truth risks. Routine edit narratives, attention items, notifications and health scoring remain outside this slice.</p>
				</ProjectControlPanel>

				<ProjectContentPanel
					title="Risk Register"
					helper="Scan all project risks in one register. Exposure, action state and lifecycle/status are shown separately."
					headingId="risk-register-table-heading"
				>
					<div slot="action" class="risk-register-action">
						{canCreateRisk ? (
							<a
								class="button button--primary"
								href={buildProjectNewRiskPath(workspaceSlug ?? '', project.slug)}
								data-risk-create-action
							>New Risk</a>
						) : (
							<button
								class="button button--primary"
								type="button"
								disabled
								aria-describedby="risk-create-unavailable"
								data-risk-create-disabled
								data-viewer-read-only
							>New Risk</button>
						)}
						<DisabledActionHint
							id="risk-create-unavailable"
							allowed={canCreateRisk}
							allowedText="Create a new project risk."
							disabledText="Viewer access is read-only. Risk creation is unavailable."
						/>
					</div>

					{risksLoadError ? (
						<EmptyState title="The Risk Register could not be loaded." tone="error" data-risk-list-error role="alert">
							<p>{risksLoadError}</p>
							<p>Refresh the page, or try again after checking workspace access.</p>
						</EmptyState>
					) : risks.length === 0 ? (
						<EmptyState title="No risks have been recorded for this project yet." data-risk-empty-state>
							<p>When risks are recorded, this register will show the project’s source-of-truth risk reference, exposure, action state, lifecycle, owner, review due date and latest update.</p>
							<p>{canCreateRisk ? 'Create the first risk when there is a delivery concern to manage.' : 'Viewer access is read-only, so risk creation is unavailable for your role.'}</p>
						</EmptyState>
					) : (
						<div class="risk-register-table-scroll">
							<table class="simple-table risk-register-table" data-risk-register-table>
								<thead>
									<tr>
										<th scope="col">Ref</th>
										<th scope="col">Risk</th>
										<th scope="col">Exposure</th>
										<th scope="col">Action state</th>
										<th scope="col">Lifecycle / Status</th>
										<th scope="col">Owner</th>
										<th scope="col">Review due</th>
										<th scope="col">Updated</th>
										<th scope="col">Actions</th>
									</tr>
								</thead>
								<tbody>
									{orderedRisks.map((risk) => {
										const exposureTone = deriveRiskExposureTone(risk.probability, risk.impact);
										const exposureLabel = riskExposureToneLabel(exposureTone);
										const actionState = actionStateFor(risk);
										const reviewDue = reviewDueState(risk);
										const ownerLabel = riskProfileName(risk.owner, 'Unassigned');
										const riskHref = buildProjectRiskPath(workspaceSlug ?? '', project.slug, risk.risk_id);
										const lifecycle = riskLifecycleLabel(risk.status);
										return (
											<tr data-risk-lifecycle={riskLifecycleCategory(risk.status)}>
												<td>
													<a
														class="risk-reference-link"
														href={riskHref}
														aria-label={`Open ${risk.risk_ref}`}
													>
														<RagReferencePill
															tone="blue"
															label={risk.risk_ref}
														/>
													</a>
												</td>
												<td class="risk-register-table__risk">
													<strong title={risk.title}>{risk.title}</strong>
												</td>
												<td>
													<RagReferencePill
														tone={exposureTone}
														label={exposureLabel}
														statusLabel="Exposure"
														ariaLabel={`${risk.risk_ref} exposure: ${exposureLabel}`}
													/>
												</td>
												<td>
													<RagReferencePill
														tone={actionState.tone}
														label={actionState.label}
														statusLabel={actionState.statusLabel}
														ariaLabel={`${risk.risk_ref} action state: ${actionState.label}`}
													/>
												</td>
												<td>
													<span class="risk-register-table__status">
														<strong>{lifecycle}</strong>
														<span>{riskDisplayLabel(risk.status)}</span>
													</span>
												</td>
												<td>
													<span class={`risk-register-table__owner${risk.owner_id ? '' : ' risk-register-table__owner--missing'}`}>
														{ownerLabel}
													</span>
												</td>
												<td>
													<span class={`risk-register-table__review risk-register-table__review--${reviewDue.tone}`}>
														{reviewDue.statusLabel && <span>{reviewDue.statusLabel}</span>}
														<span>{reviewDue.label}</span>
													</span>
												</td>
												<td><time datetime={risk.updated_at}>{formatDateTime(risk.updated_at)}</time></td>
												<td>
													<a class="text-link risk-register-table__open" href={riskHref} aria-label={`Open ${risk.risk_ref} detail`}>Open</a>
												</td>
											</tr>
										);
									})}
								</tbody>
							</table>
						</div>
					)}
					<a class="text-link risk-register-back-link" href={buildProjectPath(workspaceSlug ?? '', project.slug)}>Back to project</a>
				</ProjectContentPanel>
			</>
		) : (
			<section class="content-card" data-feature-unavailable-message>
				<p class="eyebrow">Risk Management</p>
				<h1>Feature unavailable</h1>
				<p>{message}</p>
				<a class="button button--secondary" href={workspaceSlug && projectSlug ? buildProjectPath(workspaceSlug, projectSlug) : '/app/projects'}>Back to project</a>
			</section>
		)}
	</section>
</AuthenticatedLayout>

<style>
	.risk-register-page {
		display: grid;
		gap: 0.9rem;
	}

	.risk-register-page :global(.project-content-panel h2) {
		font-size: clamp(1.45rem, 2.4vw, 2rem);
	}

	.risk-register-controls__copy {
		margin: 0.7rem 0 0;
		color: var(--muted-strong);
	}

	.risk-register-action {
		display: grid;
		justify-items: end;
		gap: 0.45rem;
	}

	.risk-register-action [disabled] {
		opacity: 0.68;
		cursor: not-allowed;
	}

	.risk-register-table-scroll {
		overflow-x: auto;
	}

	.risk-register-table {
		min-width: 78rem;
		table-layout: fixed;
	}

	.risk-register-table th:first-child {
		width: 10.5rem;
	}

	.risk-register-table th:nth-child(2) {
		width: 20rem;
	}

	.risk-register-table th:nth-child(3),
	.risk-register-table th:nth-child(4) {
		width: 9.25rem;
	}

	.risk-register-table th:nth-child(5) {
		width: 10rem;
	}

	.risk-register-table th:nth-child(6) {
		width: 10rem;
	}

	.risk-register-table th:nth-child(7) {
		width: 9rem;
	}

	.risk-register-table th:nth-child(8) {
		width: 11rem;
	}

	.risk-register-table th:nth-child(9) {
		width: 5rem;
	}

	.risk-register-table td {
		vertical-align: middle;
		padding-top: 0.62rem;
		padding-bottom: 0.62rem;
	}

	.risk-reference-link {
		display: inline-flex;
		border-radius: 999px;
		text-decoration: none;
	}

	.risk-reference-link:hover :global(.rag-reference-pill) {
		transform: translateY(-1px);
		background: color-mix(in srgb, var(--rag-pill-tone) 22%, transparent);
	}

	.risk-reference-link:focus-visible {
		outline: 3px solid var(--accent-strong);
		outline-offset: 3px;
	}

	.risk-register-table__risk {
		min-width: 0;
	}

	.risk-register-table__risk strong {
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		overflow: hidden;
		line-height: 1.35;
	}

	.risk-register-table__status,
	.risk-register-table__review {
		display: grid;
		gap: 0.18rem;
	}

	.risk-register-table__status strong,
	.risk-register-table__review span:first-child {
		color: var(--text);
		font-weight: 850;
	}

	.risk-register-table__status span,
	.risk-register-table__review span:last-child,
	.risk-register-table__owner {
		color: var(--muted-strong);
	}

	.risk-register-table__owner--missing,
	.risk-register-table__review--amber span:first-child {
		color: var(--rag-amber-accent);
		font-weight: 850;
	}

	.risk-register-table__review--red span:first-child {
		color: var(--rag-red-accent);
		font-weight: 850;
	}

	.risk-register-table__open {
		font-weight: 850;
	}

	.risk-register-back-link {
		justify-self: start;
	}

	@media (max-width: 760px) {
		.risk-register-action {
			justify-items: stretch;
		}
	}
</style>
