---
import AuthenticatedLayout from '../../../../../../layouts/AuthenticatedLayout.astro';
import DisabledActionHint from '../../../../../../components/app/DisabledActionHint.astro';
import EmptyState from '../../../../../../components/app/EmptyState.astro';
import ProjectContentPanel from '../../../../../../components/app/ProjectContentPanel.astro';
import ProjectControlPanel from '../../../../../../components/app/ProjectControlPanel.astro';
import ProjectPageHero from '../../../../../../components/app/ProjectPageHero.astro';
import RagReferencePill from '../../../../../../components/app/RagReferencePill.astro';
import { getFeatureAccess, loadFeatureAccess } from '../../../../../../lib/featureFlags';
import { can } from '../../../../../../lib/permissions';
import {
	listProjectRisks,
	riskDisplayLabel,
	riskRagTone,
} from '../../../../../../lib/projectRisks';
import { buildProjectNewRiskPath, buildProjectPath, buildProjectRiskPath, getWorkspaceBySlug } from '../../../../../../lib/projects';
import { createSupabaseServerClient, getServerAccessToken } from '../../../../../../lib/supabaseServer';

const projectSlug = Astro.params.projectId;
const workspaceSlug = Astro.params.workspaceSlug;
const accessToken = getServerAccessToken(Astro.cookies);
let project = null;
let risks = [];
let workspaceName = '';
let workspaceRole = '';
let message = '';
let risksLoadError = '';
let featureAccess = getFeatureAccess('riskManagement');

const formatDate = (value, fallback = 'Not available') => value
	? new Intl.DateTimeFormat('en-GB', { dateStyle: 'medium', timeZone: 'UTC' }).format(new Date(value))
	: fallback;
const formatDateTime = (value, fallback = 'Not available') => value
	? `${new Intl.DateTimeFormat('en-GB', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'UTC' }).format(new Date(value))} UTC`
	: fallback;

try {
	const serverSupabase = createSupabaseServerClient(accessToken);
	const workspace = await getWorkspaceBySlug(serverSupabase, workspaceSlug ?? '', accessToken);
	const organisation = Array.isArray(workspace?.organisations) ? workspace?.organisations[0] : workspace?.organisations;

	if (!workspace || !organisation) {
		message = 'Project not found or you do not have access.';
		Astro.response.status = 404;
	} else if (!can(workspace.role, 'risk.view')) {
		message = 'You do not have permission to view project risks.';
		Astro.response.status = 403;
	} else {
		workspaceName = organisation.name;
		workspaceRole = workspace.role;
		const { data, error } = await serverSupabase
			.from('projects')
			.select('id, name, project_ref, slug')
			.eq('slug', projectSlug)
			.eq('organisation_id', organisation.id)
			.is('deleted_at', null)
			.is('archived_at', null)
			.maybeSingle();
		if (error) throw error;

		if (!data) {
			message = 'Project not found or you do not have access.';
			Astro.response.status = 404;
		} else {
			featureAccess = await loadFeatureAccess(serverSupabase, 'riskManagement', accessToken);
			if (!featureAccess.isAccessible) {
				message = featureAccess.unavailableReason ?? 'This feature is not currently available to your account.';
				Astro.response.status = featureAccess.state === 'hidden' ? 404 : 403;
			} else {
				project = data;
				try {
					risks = await listProjectRisks(organisation.id, data.id, workspace.role, serverSupabase);
				} catch (error) {
					risks = [];
					risksLoadError = error instanceof Error ? error.message : 'Unable to load the Risk Register.';
				}
			}
		}
	}
} catch (error) {
	message = error instanceof Error ? error.message : 'Unable to load Risk Management.';
	Astro.response.status = 500;
}

const canCreateRisk = can(workspaceRole, 'risk.create');
---
<AuthenticatedLayout title={project ? `Risk Register — ${project.name} | WatchTower` : 'Risk Register | WatchTower'}>
	<section class="risk-register-page" data-risk-management-route data-risk-register-route data-feature-state={featureAccess.state}>
		{project ? (
			<>
				<ProjectPageHero
					workspaceName={workspaceName}
					projectName={project.name}
					projectRef={project.project_ref}
					title="Risk Register"
					description="A clean register of source-of-truth project risks."
					headingId="risk-register-heading"
				/>

				<ProjectControlPanel title="Risk controls" status="Create and edit enabled" headingId="risk-register-controls-heading">
					<p class="risk-register-controls__copy">Create and update project-level source-of-truth risks. Notes, diary integration, attention items, notifications and health scoring remain outside this slice.</p>
				</ProjectControlPanel>

				<ProjectContentPanel
					title="Project risks"
					helper="Review current project risks and open each reference for the assurance view."
					headingId="risk-register-table-heading"
				>
					<div slot="action" class="risk-register-action">
						{canCreateRisk ? (
							<a
								class="button button--primary"
								href={buildProjectNewRiskPath(workspaceSlug ?? '', project.slug)}
								data-risk-create-action
							>New Risk</a>
						) : (
							<button
								class="button button--primary"
								type="button"
								disabled
								aria-describedby="risk-create-unavailable"
								data-risk-create-disabled
								data-viewer-read-only
							>New Risk</button>
						)}
						<DisabledActionHint
							id="risk-create-unavailable"
							allowed={canCreateRisk}
							allowedText="Create a new project risk."
							disabledText="Viewer access is read-only. Risk creation is unavailable."
						/>
					</div>

					{risksLoadError ? (
						<EmptyState title="The Risk Register could not be loaded." tone="error" data-risk-list-error role="alert">
							<p>{risksLoadError}</p>
							<p>Refresh the page, or try again after checking workspace access.</p>
						</EmptyState>
					) : risks.length === 0 ? (
						<EmptyState title="No risks have been recorded for this project yet." data-risk-empty-state>
							<p>When risks are recorded, this register will show the project’s source-of-truth risk reference, title, status, review date and latest update.</p>
							<p>{canCreateRisk ? 'Create the first risk when there is a delivery concern to manage.' : 'Viewer access is read-only, so risk creation is unavailable for your role.'}</p>
						</EmptyState>
					) : (
						<div class="risk-register-table-scroll">
							<table class="simple-table risk-register-table">
								<thead>
									<tr>
										<th scope="col">Ref</th>
										<th scope="col">Risk</th>
										<th scope="col">Status</th>
										<th scope="col">Review date</th>
										<th scope="col">Updated</th>
									</tr>
								</thead>
								<tbody>
									{risks.map((risk) => (
										<tr>
											<td>
												<a
													class="risk-reference-link"
													href={buildProjectRiskPath(workspaceSlug ?? '', project.slug, risk.risk_id)}
													aria-label={`Open ${risk.risk_ref}, ${riskDisplayLabel(risk.rag_status)} risk`}
												>
													<RagReferencePill
														tone={riskRagTone(risk.rag_status)}
														label={risk.risk_ref}
														statusLabel={riskDisplayLabel(risk.rag_status)}
													/>
												</a>
											</td>
											<td class="risk-register-table__risk"><strong>{risk.title}</strong></td>
											<td>{riskDisplayLabel(risk.status)}</td>
											<td>{formatDate(risk.review_date, 'No review date')}</td>
											<td><time datetime={risk.updated_at}>{formatDateTime(risk.updated_at)}</time></td>
										</tr>
									))}
								</tbody>
							</table>
						</div>
					)}
					<a class="text-link risk-register-back-link" href={buildProjectPath(workspaceSlug ?? '', project.slug)}>Back to project</a>
				</ProjectContentPanel>
			</>
		) : (
			<section class="content-card" data-feature-unavailable-message>
				<p class="eyebrow">Risk Management</p>
				<h1>Feature unavailable</h1>
				<p>{message}</p>
				<a class="button button--secondary" href={workspaceSlug && projectSlug ? buildProjectPath(workspaceSlug, projectSlug) : '/app/projects'}>Back to project</a>
			</section>
		)}
	</section>
</AuthenticatedLayout>

<style>
	.risk-register-page {
		display: grid;
		gap: 0.9rem;
	}

	.risk-register-page :global(.project-content-panel h2) {
		font-size: clamp(1.45rem, 2.4vw, 2rem);
	}

	.risk-register-controls__copy {
		margin: 0.7rem 0 0;
		color: var(--muted-strong);
	}

	.risk-register-action {
		display: grid;
		justify-items: end;
		gap: 0.45rem;
	}

	.risk-register-action [disabled] {
		opacity: 0.68;
		cursor: not-allowed;
	}

	.risk-register-table-scroll {
		overflow-x: auto;
	}

	.risk-register-table {
		min-width: 46rem;
	}

	.risk-register-table th:first-child {
		width: 12rem;
	}

	.risk-register-table th:nth-child(2) {
		min-width: 22rem;
	}

	.risk-register-table td {
		vertical-align: top;
	}

	.risk-reference-link {
		display: inline-flex;
		border-radius: 999px;
		text-decoration: none;
	}

	.risk-reference-link:hover :global(.rag-reference-pill) {
		transform: translateY(-1px);
		background: color-mix(in srgb, var(--rag-pill-tone) 22%, transparent);
	}

	.risk-reference-link:focus-visible {
		outline: 3px solid var(--accent-strong);
		outline-offset: 3px;
	}

	.risk-register-table__risk {
		max-width: 32rem;
		overflow-wrap: anywhere;
	}

	.risk-register-table__risk strong {
		display: block;
	}

	.risk-register-table__risk strong + span {
		margin-top: 0.25rem;
	}

	.risk-register-back-link {
		justify-self: start;
	}

	@media (max-width: 760px) {
		.risk-register-action {
			justify-items: stretch;
		}
	}
</style>
