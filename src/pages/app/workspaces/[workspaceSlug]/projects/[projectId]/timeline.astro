---
import AuthenticatedLayout from '../../../../../../layouts/AuthenticatedLayout.astro';
import EmptyState from '../../../../../../components/app/EmptyState.astro';
import ProjectPageHero from '../../../../../../components/app/ProjectPageHero.astro';
import { can } from '../../../../../../lib/permissions';
import { buildProjectPath, getWorkspaceBySlug } from '../../../../../../lib/projects';
import { createSupabaseServerClient, getServerAccessToken } from '../../../../../../lib/supabaseServer';
import {
	DEFAULT_TIMELINE_LAYERS,
	TIMELINE_POINT_EVENT_LIMIT,
	TIMELINE_RANGE_LANE_LIMIT,
	TIMELINE_WEEKDAYS,
	aggregateTimelineEvents,
	buildTimelineCalendarGrid,
	createTimelineFixtureAdapter,
	formatTimelineDateLong,
	formatTimelineMonthHeading,
	getTimelineMonthFromDate,
	getTodayDateOnly,
	getDefaultVisibleTimelineLayerKeys,
	timelineDayAriaLabel,
	timelineDayClassName,
	timelineMonthStartDate,
	timelineMonthValue,
} from '../../../../../../lib/timeline';
import type { TimelineEvent, TimelineSourceType } from '../../../../../../lib/timeline';

const projectSlug = Astro.params.projectId;
const workspaceSlug = Astro.params.workspaceSlug;
const accessToken = getServerAccessToken(Astro.cookies);
const todayDate = getTodayDateOnly();
const currentMonth = getTimelineMonthFromDate(todayDate);
const calendarWeeks = buildTimelineCalendarGrid(currentMonth, todayDate);
const initialSelectedDate = todayDate;
const initialSelectedDateLabel = formatTimelineDateLong(initialSelectedDate);
const initialMonthHeading = formatTimelineMonthHeading(currentMonth);
const initialMonthValue = timelineMonthValue(currentMonth);
let project = null;
let workspaceName = '';
let message = '';
let timelineLoadError = '';
let timelineEventCount = 0;
let timelineEvents: TimelineEvent[] = [];

const timelineSourcePresentation: Record<TimelineSourceType, { label: string; icon: string }> = {
	'project-date': { label: 'Project delivery', icon: '◆' },
	risk: { label: 'Risk', icon: '!' },
	issue: { label: 'Issue', icon: '!' },
	dependency: { label: 'Dependency', icon: '↔' },
	assumption: { label: 'Assumption', icon: '?' },
	decision: { label: 'Decision', icon: '✓' },
	action: { label: 'Action', icon: '☑' },
	'project-event': { label: 'Project event', icon: '○' },
	'delivery-period': { label: 'Delivery period', icon: '▬' },
};

try {
	const serverSupabase = createSupabaseServerClient(accessToken);
	const workspace = await getWorkspaceBySlug(serverSupabase, workspaceSlug ?? '', accessToken);
	const organisation = Array.isArray(workspace?.organisations) ? workspace?.organisations[0] : workspace?.organisations;

	if (!workspace || !organisation) {
		message = 'Project not found or you do not have access.';
		Astro.response.status = 404;
	} else if (!can(workspace.role, 'project.viewDashboard')) {
		message = 'Your workspace role does not permit project Timeline access.';
		Astro.response.status = 403;
	} else {
		workspaceName = organisation.name;
		const { data, error } = await serverSupabase
			.from('projects')
			.select('id, name, project_ref, slug')
			.eq('slug', projectSlug)
			.eq('organisation_id', organisation.id)
			.is('deleted_at', null)
			.is('archived_at', null)
			.maybeSingle();
		if (error) throw error;

		if (!data) {
			message = 'Project not found or you do not have access.';
			Astro.response.status = 404;
		} else {
			project = data;
			try {
				const { data: userData } = accessToken
					? await serverSupabase.auth.getUser(accessToken)
					: await serverSupabase.auth.getUser();
				const aggregatedTimelineEvents = await aggregateTimelineEvents(
					{
						workspaceId: organisation.id,
						projectId: data.id,
						visibleStartDate: '2026-06-01',
						visibleEndDate: '2026-08-31',
						viewerId: userData.user?.id ?? '',
						permissionContext: {
							viewerId: userData.user?.id ?? '',
							workspaceRole: workspace.role,
						},
					},
					[createTimelineFixtureAdapter()],
				);
				timelineEventCount = aggregatedTimelineEvents.length;
				timelineEvents = aggregatedTimelineEvents;
			} catch {
				timelineLoadError = 'Timeline entries could not be loaded. The calendar shell is still available.';
			}
		}
	}
} catch {
	message = 'Unable to load project Timeline.';
	Astro.response.status = 500;
}

const timelineEventsJson = JSON.stringify(timelineEvents);
const timelineLayersJson = JSON.stringify(DEFAULT_TIMELINE_LAYERS);
const defaultVisibleLayerKeysJson = JSON.stringify(getDefaultVisibleTimelineLayerKeys(DEFAULT_TIMELINE_LAYERS));
const legendSourceTypes = Array.from(new Set(timelineEvents.map((event) => event.sourceType)));
---
<AuthenticatedLayout title={project ? `Timeline — ${project.name} | WatchTower` : 'Timeline | WatchTower'}>
	<section
		class="timeline-page"
		data-project-timeline-route
		data-timeline-month={initialMonthValue}
		data-timeline-today={todayDate}
		data-timeline-selected-date={initialSelectedDate}
		data-timeline-event-count={timelineEventCount}
		data-timeline-range-lane-limit={TIMELINE_RANGE_LANE_LIMIT}
		data-timeline-point-limit={TIMELINE_POINT_EVENT_LIMIT}
	>
		{project ? (
			<>
				<ProjectPageHero
					workspaceName={workspaceName}
					projectName={project.name}
					projectRef={project.project_ref}
					title="Timeline"
					description="View significant project delivery dates and assurance events across the month."
					headingId="project-timeline-heading"
				>
					<div slot="actions" class="timeline-hero-actions">
						<a class="button button--secondary" href={buildProjectPath(workspaceSlug ?? '', project.slug)}>Back to project dashboard</a>
					</div>
				</ProjectPageHero>

				<div class="timeline-loading-state content-card" data-timeline-loading hidden aria-live="polite">
					<div class="timeline-loading-state__calendar" aria-hidden="true">
						{Array.from({ length: 35 }).map(() => <span></span>)}
					</div>
					<div class="timeline-loading-state__panel" aria-hidden="true">
						<span></span>
						<span></span>
						<span></span>
					</div>
					<p class="visually-hidden">Loading Timeline month.</p>
				</div>

				<div class="timeline-layout" data-timeline-ready>
					<section class="content-card timeline-calendar-card" aria-labelledby="timeline-month-heading" data-timeline-calendar-card>
						<div class="timeline-month-nav">
							<button class="button button--secondary timeline-month-nav__button" type="button" data-timeline-previous aria-label="Show previous month">‹</button>
							<div class="timeline-month-nav__heading">
								<p class="eyebrow">Monthly view</p>
								<h2 id="timeline-month-heading" data-timeline-month-heading>{initialMonthHeading}</h2>
							</div>
							<button class="button button--secondary timeline-month-nav__button" type="button" data-timeline-next aria-label="Show next month">›</button>
							<button class="button button--secondary timeline-month-nav__today" type="button" data-timeline-today-control>Today</button>
							<details class="timeline-layer-control" data-timeline-layer-control>
								<summary class="button button--secondary" aria-controls="timeline-layer-options">Layers</summary>
								<fieldset id="timeline-layer-options" class="timeline-layer-control__panel" data-timeline-layer-options>
									<legend>Timeline layers</legend>
									{DEFAULT_TIMELINE_LAYERS.map((layer) => (
										<label class={`timeline-layer-toggle${layer.enabled ? '' : ' timeline-layer-toggle--disabled'}`}>
											<input
												type="checkbox"
												value={layer.key}
												checked={layer.enabled && layer.defaultVisible}
												disabled={!layer.enabled}
												data-timeline-layer-toggle={layer.key}
											/>
											<span class="timeline-layer-toggle__body">
												<span class="timeline-layer-toggle__label">{layer.label}</span>
												<span class="timeline-layer-toggle__status">
													{layer.enabled ? (layer.defaultVisible ? 'Shown by default' : 'Hidden by default') : 'Source not connected yet'}
												</span>
											</span>
										</label>
									))}
								</fieldset>
							</details>
						</div>

						{timelineLoadError && (
							<div class="timeline-inline-error" role="status">
								<p>{timelineLoadError}</p>
							</div>
						)}

						<div
							class="timeline-calendar-grid"
							role="grid"
							aria-labelledby="timeline-month-heading"
							aria-describedby="timeline-calendar-help"
							data-timeline-calendar-grid
						>
							<div class="timeline-weekdays" role="row">
								{TIMELINE_WEEKDAYS.map((weekday) => (
									<div
										class={`timeline-weekday${weekday.isWeekend ? ' timeline-weekday--weekend' : ''}`}
										role="columnheader"
										aria-label={weekday.label}
									>
										<span aria-hidden="true">{weekday.shortLabel}</span>
										<span class="visually-hidden">{weekday.label}</span>
									</div>
								))}
							</div>

							<div class="timeline-week-rows" data-timeline-week-rows>
								{calendarWeeks.map((week) => (
									<div class="timeline-week" role="row">
										{week.days.map((day) => {
											return (
												<div
													class={timelineDayClassName(day, initialSelectedDate)}
													role="gridcell"
													tabindex="0"
													data-timeline-day-contract="timeline-day-v1"
													data-timeline-day={day.date}
													data-current-month={day.isCurrentMonth ? 'true' : 'false'}
													data-weekend={day.isWeekend ? 'true' : 'false'}
													aria-label={timelineDayAriaLabel(day, initialSelectedDate)}
													aria-pressed={day.date === initialSelectedDate ? 'true' : 'false'}
													aria-selected={day.date === initialSelectedDate ? 'true' : 'false'}
													aria-current={day.isToday ? 'date' : undefined}
												>
													<span class="timeline-day__header">
														<span class="timeline-day__number" data-timeline-day-number>{day.dayNumber}</span>
														<span class="timeline-day__markers">
															<span class="timeline-day__today-marker" data-timeline-today-marker hidden={!day.isToday}>Today</span>
															<span class="timeline-day__weekend-marker" data-timeline-weekend-marker hidden={!day.isWeekend}>Weekend</span>
														</span>
													</span>
													<span class="timeline-day__range-lanes" aria-hidden="true"></span>
													<span class="timeline-day__point-area"></span>
													<span class="timeline-day__overflow"></span>
												</div>
											);
										})}
									</div>
								))}
							</div>
						</div>
						<template data-timeline-week-template>
							<div class="timeline-week" role="row"></div>
						</template>
						<template data-timeline-day-template>
							<div
								class="timeline-day"
								role="gridcell"
								tabindex="0"
								data-timeline-day-contract="timeline-day-v1"
								data-timeline-day=""
								data-current-month="false"
								data-weekend="false"
								aria-label=""
								aria-pressed="false"
								aria-selected="false"
							>
								<span class="timeline-day__header">
									<span class="timeline-day__number" data-timeline-day-number></span>
									<span class="timeline-day__markers">
										<span class="timeline-day__today-marker" data-timeline-today-marker hidden>Today</span>
										<span class="timeline-day__weekend-marker" data-timeline-weekend-marker hidden>Weekend</span>
									</span>
								</span>
								<span class="timeline-day__range-lanes" aria-hidden="true"></span>
								<span class="timeline-day__point-area"></span>
								<span class="timeline-day__overflow"></span>
							</div>
						</template>
						<template data-timeline-range-template>
							<button class="timeline-range-segment" type="button" data-timeline-event-control data-timeline-range-segment>
								<span class="timeline-range-segment__status" aria-hidden="true"></span>
								<span class="timeline-range-segment__label" data-timeline-event-label></span>
							</button>
						</template>
						<template data-timeline-range-overflow-template>
							<button class="timeline-overflow timeline-overflow--range" type="button" data-timeline-range-overflow></button>
						</template>
						<template data-timeline-point-template>
							<button class="timeline-point-event" type="button" data-timeline-event-control data-timeline-point-event>
								<span class="timeline-point-event__icon" data-timeline-event-icon aria-hidden="true"></span>
								<span class="timeline-point-event__status" aria-hidden="true"></span>
								<span class="visually-hidden" data-timeline-event-label></span>
							</button>
						</template>
						<template data-timeline-point-overflow-template>
							<button class="timeline-overflow timeline-overflow--point" type="button" data-timeline-point-overflow></button>
						</template>
						<p id="timeline-calendar-help" class="timeline-calendar-help">
							Use the month controls to move between months. Select any visible day to update the activity panel.
						</p>
						<div class="timeline-legend" aria-label="Timeline event legend" data-timeline-legend>
							{legendSourceTypes.map((sourceType) => (
								<span class="timeline-legend__item">
									<span class="timeline-legend__icon" aria-hidden="true">{timelineSourcePresentation[sourceType].icon}</span>
									<span>{timelineSourcePresentation[sourceType].label}</span>
								</span>
							))}
						</div>
					</section>

					<aside class="content-card timeline-day-panel" aria-labelledby="timeline-selected-date-heading" data-timeline-day-panel>
						<div class="timeline-day-panel__header" data-timeline-day-panel-header>
							<p class="eyebrow">Selected day</p>
							<h2 id="timeline-selected-date-heading" data-timeline-selected-heading>{initialSelectedDateLabel}</h2>
							<p data-timeline-selected-copy>Fixture Timeline entries for this date will appear here when visible layers overlap the selected day.</p>
						</div>
						<div class="timeline-day-panel__groups" data-timeline-day-groups tabindex="0" aria-label="Selected day Timeline entries">
							<EmptyState title="No project activity is currently shown for this date.">
								<p>No visible fixture entries overlap this date.</p>
							</EmptyState>
						</div>
						<template data-timeline-panel-group-template>
							<section class="timeline-panel-group">
								<h3 data-timeline-panel-group-heading></h3>
								<ul data-timeline-panel-group-list></ul>
							</section>
						</template>
						<template data-timeline-panel-row-template>
							<li>
								<button class="timeline-panel-event" type="button" data-timeline-panel-event>
									<span class="timeline-panel-event__icon" data-timeline-event-icon aria-hidden="true"></span>
									<span class="timeline-panel-event__body">
										<span class="timeline-panel-event__meta">
											<span class="timeline-panel-event__reference" data-timeline-event-reference></span>
											<span class="timeline-pill timeline-pill--type" data-timeline-event-type></span>
											<span class="timeline-pill timeline-pill--status" data-timeline-event-status></span>
										</span>
										<span class="timeline-panel-event__title" data-timeline-event-title></span>
										<span class="timeline-panel-event__summary" data-timeline-event-summary></span>
										<span class="timeline-panel-event__date" data-timeline-event-date></span>
									</span>
									<span class="timeline-panel-event__chevron" aria-hidden="true">›</span>
								</button>
							</li>
						</template>
					</aside>
				</div>
				<script type="application/json" data-timeline-events set:html={timelineEventsJson}></script>
				<script type="application/json" data-timeline-layers set:html={timelineLayersJson}></script>
				<script type="application/json" data-timeline-default-layers set:html={defaultVisibleLayerKeysJson}></script>
				<div class="timeline-event-summary-overlay" id="timeline-event-summary-overlay" role="tooltip" data-timeline-event-summary-overlay hidden>
					<p class="timeline-event-summary-overlay__reference" data-timeline-summary-reference></p>
					<p class="timeline-event-summary-overlay__title" data-timeline-summary-title></p>
					<p class="timeline-event-summary-overlay__meta" data-timeline-summary-meta></p>
					<p class="timeline-event-summary-overlay__date" data-timeline-summary-date></p>
					<p class="timeline-event-summary-overlay__summary" data-timeline-summary-copy></p>
				</div>
			</>
		) : (
			<section class="content-card timeline-error-state" data-timeline-error-state>
				<EmptyState title="Timeline could not be loaded." tone="error">
					<p>{message || 'The Timeline is unavailable right now.'}</p>
					<a class="button button--secondary" href={workspaceSlug && projectSlug ? buildProjectPath(workspaceSlug, projectSlug) : '/app/projects'}>Back to project</a>
				</EmptyState>
			</section>
		)}
	</section>
</AuthenticatedLayout>

<script>
	import {
		TIMELINE_POINT_EVENT_LIMIT,
		TIMELINE_RANGE_LANE_LIMIT,
		addTimelineMonths,
		allocateTimelineRangeLanes,
		buildTimelineCalendarGrid,
		filterTimelineEventsByLayers,
		formatTimelineDateLong,
		formatTimelineMonthHeading,
		getTimelineEventsActiveOnDate,
		getTimelinePointEventsByDate,
		getTimelinePointOverflowCount,
		getTimelineRangeOverflowCountsByDate,
		getTimelineMonthFromDate,
		getTodayDateOnly,
		groupTimelineEventsByLayer,
		segmentTimelineRangeEventsByWeek,
		sortTimelineEventsForDisplay,
		timelineDayAriaLabel,
		timelineDayClassName,
		timelineMonthStartDate,
		timelineMonthValue,
	} from '../../../../../../lib/timeline';

	const page = document.querySelector('[data-project-timeline-route]');
	const calendarCard = document.querySelector('[data-timeline-calendar-card]');
	const dayPanel = document.querySelector('[data-timeline-day-panel]');
	const heading = document.querySelector('[data-timeline-month-heading]');
	const weekRows = document.querySelector('[data-timeline-week-rows]');
	const previousButton = document.querySelector('[data-timeline-previous]');
	const nextButton = document.querySelector('[data-timeline-next]');
	const todayButton = document.querySelector('[data-timeline-today-control]');
	const selectedHeading = document.querySelector('[data-timeline-selected-heading]');
	const selectedCopy = document.querySelector('[data-timeline-selected-copy]');
	const weekTemplate = document.querySelector('[data-timeline-week-template]');
	const dayTemplate = document.querySelector('[data-timeline-day-template]');
	const rangeTemplate = document.querySelector('[data-timeline-range-template]');
	const rangeOverflowTemplate = document.querySelector('[data-timeline-range-overflow-template]');
	const pointTemplate = document.querySelector('[data-timeline-point-template]');
	const pointOverflowTemplate = document.querySelector('[data-timeline-point-overflow-template]');
	const panelGroups = document.querySelector('[data-timeline-day-groups]');
	const panelGroupTemplate = document.querySelector('[data-timeline-panel-group-template]');
	const panelRowTemplate = document.querySelector('[data-timeline-panel-row-template]');
	const layerControl = document.querySelector('[data-timeline-layer-control]');
	const layerToggles = [...document.querySelectorAll('[data-timeline-layer-toggle]')];
	const eventSummaryOverlay = document.querySelector('[data-timeline-event-summary-overlay]');
	const summaryReference = eventSummaryOverlay?.querySelector('[data-timeline-summary-reference]');
	const summaryTitle = eventSummaryOverlay?.querySelector('[data-timeline-summary-title]');
	const summaryMeta = eventSummaryOverlay?.querySelector('[data-timeline-summary-meta]');
	const summaryDate = eventSummaryOverlay?.querySelector('[data-timeline-summary-date]');
	const summaryCopy = eventSummaryOverlay?.querySelector('[data-timeline-summary-copy]');
	const sourcePresentation = {
		'project-date': { label: 'Project delivery', icon: '◆' },
		risk: { label: 'Risk', icon: '!' },
		issue: { label: 'Issue', icon: '!' },
		dependency: { label: 'Dependency', icon: '↔' },
		assumption: { label: 'Assumption', icon: '?' },
		decision: { label: 'Decision', icon: '✓' },
		action: { label: 'Action', icon: '☑' },
		'project-event': { label: 'Project event', icon: '○' },
		'delivery-period': { label: 'Delivery period', icon: '▬' },
	};
	const parseJson = (selector, fallback) => {
		const element = document.querySelector(selector);
		if (!element?.textContent) return fallback;
		try {
			return JSON.parse(element.textContent);
		} catch {
			return fallback;
		}
	};
	const timelineEvents = parseJson('[data-timeline-events]', []);
	const timelineLayers = parseJson('[data-timeline-layers]', []);
	const defaultLayerKeys = parseJson('[data-timeline-default-layers]', []);
	const todayDate = page?.getAttribute('data-timeline-today') || getTodayDateOnly();
	const rangeLaneLimit = Number(page?.getAttribute('data-timeline-range-lane-limit') || TIMELINE_RANGE_LANE_LIMIT);
	const pointEventLimit = Number(page?.getAttribute('data-timeline-point-limit') || TIMELINE_POINT_EVENT_LIMIT);
	let activeMonth = getTimelineMonthFromDate(page?.getAttribute('data-timeline-month') ? `${page.getAttribute('data-timeline-month')}-01` : todayDate);
	let selectedDate = page?.getAttribute('data-timeline-selected-date') || todayDate;
	let selectedEventId = '';
	let activeSummaryTrigger = /** @type {HTMLElement | null} */ (null);
	let panelHeightSyncFrame = 0;
	const visibleLayerKeys = new Set(defaultLayerKeys);
	const desktopPanelHeightQuery = window.matchMedia('(min-width: 981px)');

	function clearPanelHeightSync() {
		if (!(dayPanel instanceof HTMLElement)) return;
		dayPanel.style.removeProperty('--timeline-calendar-card-height');
		dayPanel.removeAttribute('data-timeline-height-synced');
	}

	function syncPanelHeightToCalendar() {
		if (!(calendarCard instanceof HTMLElement) || !(dayPanel instanceof HTMLElement)) return;
		if (!desktopPanelHeightQuery.matches) {
			clearPanelHeightSync();
			return;
		}
		const calendarHeight = Math.ceil(calendarCard.getBoundingClientRect().height);
		if (calendarHeight <= 0) return;
		dayPanel.style.setProperty('--timeline-calendar-card-height', `${calendarHeight}px`);
		dayPanel.setAttribute('data-timeline-height-synced', 'true');
	}

	function schedulePanelHeightSync() {
		if (panelHeightSyncFrame) window.cancelAnimationFrame(panelHeightSyncFrame);
		panelHeightSyncFrame = window.requestAnimationFrame(() => {
			panelHeightSyncFrame = 0;
			syncPanelHeightToCalendar();
			if (activeSummaryTrigger) positionEventSummary(activeSummaryTrigger);
		});
	}

	function eventTypeLabel(event) {
		return sourcePresentation[event.sourceType]?.label || event.sourceType;
	}

	function eventIcon(event) {
		return sourcePresentation[event.sourceType]?.icon || '•';
	}

	function eventTone(event) {
		return event.attentionTone || 'neutral';
	}

	function formatShortDate(date) {
		return new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', timeZone: 'UTC' }).format(new Date(`${date}T00:00:00Z`));
	}

	function dayDifference(startDate, endDate) {
		const start = new Date(`${startDate}T00:00:00Z`);
		const end = new Date(`${endDate}T00:00:00Z`);
		return Math.round((end.getTime() - start.getTime()) / 86400000);
	}

	function eventEndDate(event) {
		return event.endDate || event.startDate;
	}

	function eventDateLabel(event) {
		if (event.presentationType !== 'range') return formatTimelineDateLong(event.startDate);
		return `${formatShortDate(event.startDate)}–${formatShortDate(eventEndDate(event))}`;
	}

	function eventSummaryDateLabel(event, activeDate) {
		if (event.presentationType !== 'range') return formatTimelineDateLong(activeDate);
		return `${formatTimelineDateLong(event.startDate)} to ${formatTimelineDateLong(eventEndDate(event))}`;
	}

	function rangeContextLabel(event, activeDate) {
		if (event.presentationType !== 'range') return eventDateLabel(event);
		const totalDays = dayDifference(event.startDate, eventEndDate(event)) + 1;
		const currentDay = dayDifference(event.startDate, activeDate) + 1;
		return `${eventDateLabel(event)} · Day ${currentDay} of ${totalDays}`;
	}

	function eventAccessibleLabel(event, activeDate = selectedDate) {
		const type = eventTypeLabel(event);
		const state = event.status || event.attentionTone || 'No status';
		const reference = event.sourceReference ? `${event.sourceReference}, ` : '';
		const shape = event.presentationType === 'range' ? 'range event' : 'point event';
		const date = event.presentationType === 'range' ? rangeContextLabel(event, activeDate) : eventDateLabel(event);
		return `${reference}${event.title}, ${type}, ${shape}, ${date}, ${state}. ${event.summary || ''}`.trim();
	}

	function eventSummaryText(event, activeDate = selectedDate) {
		return {
			reference: event.sourceReference || '',
			title: event.title,
			meta: `${eventTypeLabel(event)} · ${event.status || event.attentionTone || 'No status'}`,
			date: eventSummaryDateLabel(event, activeDate),
			summary: event.summary || '',
		};
	}

	function eventReferenceLabel(event) {
		return event.sourceReference || event.category || 'Fixture';
	}

	function eventReferenceIdentifiesSource(event) {
		if (!event.sourceReference) return false;
		return /^(RISK|ISSUE|DEP|DEC|ACT)-/i.test(event.sourceReference);
	}

	function eventStatusDuplicatesTone(event) {
		const status = (event.status || '').toLowerCase();
		const tone = eventTone(event).toLowerCase();
		return ['red', 'amber', 'green', 'neutral'].includes(status) && status === tone;
	}

	function panelPresentationForEvent(event) {
		return {
			referenceLabel: eventReferenceLabel(event),
			referenceTone: eventTone(event),
			showTypePill: (!event.sourceReference && !event.category) || (!eventReferenceIdentifiesSource(event) && event.sourceType !== 'project-date'),
			typeLabel: eventTypeLabel(event),
			showStatusPill: Boolean(event.status) && !eventStatusDuplicatesTone(event),
			statusLabel: event.status || '',
		};
	}

	function eventClassName(baseClass, event) {
		return `${baseClass} ${baseClass}--${event.sourceType} ${baseClass}--${eventTone(event)}${event.status === 'Completed' ? ` ${baseClass}--completed` : ''}`;
	}

	function updateSelectedPanel() {
		const visibleEvents = filterTimelineEventsByLayers(timelineEvents, [...visibleLayerKeys]);
		const selectedEvents = getTimelineEventsActiveOnDate(visibleEvents, selectedDate, timelineLayers);
		if (selectedHeading) selectedHeading.textContent = `${formatTimelineDateLong(selectedDate)} · ${selectedEvents.length} ${selectedEvents.length === 1 ? 'entry' : 'entries'}`;
		if (selectedCopy) selectedCopy.textContent = selectedEvents.length
			? 'Fixture entries only. Source opening and editing arrive in later Timeline slices.'
			: 'No visible fixture entries overlap this date.';
		page?.setAttribute('data-timeline-selected-date', selectedDate);
		page?.setAttribute('data-timeline-selected-event', selectedEventId);
		renderSelectedPanel(selectedEvents);
	}

	function applyDayState(button, day) {
		button.className = timelineDayClassName(day, selectedDate);
		button.setAttribute('data-timeline-day', day.date);
		button.setAttribute('data-current-month', day.isCurrentMonth ? 'true' : 'false');
		button.setAttribute('data-weekend', day.isWeekend ? 'true' : 'false');
		button.setAttribute('aria-label', timelineDayAriaLabel(day, selectedDate));
		button.setAttribute('aria-pressed', day.date === selectedDate ? 'true' : 'false');
		button.setAttribute('aria-selected', day.date === selectedDate ? 'true' : 'false');
		button.setAttribute('tabindex', '0');
		if (day.isToday) button.setAttribute('aria-current', 'date');
		else button.removeAttribute('aria-current');
		const dayNumber = button.querySelector('[data-timeline-day-number]');
		if (dayNumber) dayNumber.textContent = String(day.dayNumber);
		const todayMarker = button.querySelector('[data-timeline-today-marker]');
		todayMarker?.toggleAttribute('hidden', !day.isToday);
		const weekendMarker = button.querySelector('[data-timeline-weekend-marker]');
		weekendMarker?.toggleAttribute('hidden', !day.isWeekend);
	}

	function clearEventChrome(scope = document) {
		scope.querySelectorAll('[data-timeline-range-segment], [data-timeline-range-overflow]').forEach((element) => element.remove());
		scope.querySelectorAll('[data-timeline-point-event], [data-timeline-point-overflow]').forEach((element) => element.remove());
		hideEventSummary();
	}

	function updateRenderedDayStates() {
		const weeks = buildTimelineCalendarGrid(activeMonth, todayDate);
		const dayByDate = new Map(weeks.flatMap((week) => week.days.map((day) => [day.date, day])));
		document.querySelectorAll('[data-timeline-day]').forEach((button) => {
			const date = button.getAttribute('data-timeline-day') || '';
			const day = dayByDate.get(date);
			if (day) applyDayState(button, day);
		});
		renderEventsForWeeks(weeks);
	}

	function selectDate(date, eventId = '') {
		selectedDate = date;
		selectedEventId = eventId;
		updateRenderedDayStates();
		updateSelectedPanel();
	}

	function selectEvent(eventId, date) {
		selectDate(date, eventId);
	}

	function createWeekRow() {
		const templateContent = weekTemplate instanceof HTMLTemplateElement ? weekTemplate.content.firstElementChild : null;
		const row = templateContent?.cloneNode(true);
		if (row instanceof HTMLElement) return row;
		const fallbackRow = document.createElement('div');
		fallbackRow.className = 'timeline-week';
		fallbackRow.setAttribute('role', 'row');
		return fallbackRow;
	}

	function createDayButton(day) {
		const templateContent = dayTemplate instanceof HTMLTemplateElement ? dayTemplate.content.firstElementChild : null;
		const button = templateContent?.cloneNode(true);
		const resolvedButton = button instanceof HTMLElement ? button : document.createElement('div');
		resolvedButton.setAttribute('role', 'gridcell');
		resolvedButton.setAttribute('data-timeline-day-contract', 'timeline-day-v1');
		applyDayState(resolvedButton, day);
		resolvedButton.addEventListener('click', () => selectDate(day.date));
		resolvedButton.addEventListener('keydown', (keyboardEvent) => {
			if (keyboardEvent.key !== 'Enter' && keyboardEvent.key !== ' ') return;
			keyboardEvent.preventDefault();
			selectDate(day.date);
		});
		return resolvedButton;
	}

	function createTemplateElement(template, fallbackTagName, fallbackClassName) {
		const templateContent = template instanceof HTMLTemplateElement ? template.content.firstElementChild : null;
		const element = templateContent?.cloneNode(true);
		if (element instanceof HTMLElement) return element;
		const fallback = document.createElement(fallbackTagName);
		fallback.className = fallbackClassName;
		return fallback;
	}

	function populateEventControl(control, event, activeDate) {
		control.setAttribute('data-timeline-event-id', event.id);
		control.setAttribute('data-timeline-event-date', activeDate);
		control.setAttribute('data-timeline-event-layer', event.layer);
		control.setAttribute('data-timeline-event-tone', eventTone(event));
		control.setAttribute('aria-label', eventAccessibleLabel(event, activeDate));
		control.removeAttribute('title');
		control.setAttribute('aria-pressed', selectedEventId === event.id ? 'true' : 'false');
		control.classList.toggle('timeline-event--selected', selectedEventId === event.id);
		const icon = control.querySelector('[data-timeline-event-icon]');
		if (icon) icon.textContent = eventIcon(event);
		const label = control.querySelector('[data-timeline-event-label]');
		if (label) label.textContent = event.sourceReference || event.title;
		control.addEventListener('pointerenter', () => showEventSummary(control, event, activeDate));
		control.addEventListener('pointerleave', () => hideEventSummary(control));
		control.addEventListener('focus', () => showEventSummary(control, event, activeDate));
		control.addEventListener('blur', () => hideEventSummary(control));
		control.addEventListener('click', (eventClick) => {
			eventClick.stopPropagation();
			selectEvent(event.id, activeDate);
		});
		control.addEventListener('keydown', (keyboardEvent) => {
			if (keyboardEvent.key !== 'Enter' && keyboardEvent.key !== ' ') return;
			keyboardEvent.preventDefault();
			keyboardEvent.stopPropagation();
			selectEvent(event.id, activeDate);
		});
	}

	function setSummaryText(target, value, hiddenWhenEmpty = false) {
		if (!target) return;
		target.textContent = value;
		target.toggleAttribute('hidden', hiddenWhenEmpty && !value);
	}

	function positionEventSummary(trigger) {
		if (!(eventSummaryOverlay instanceof HTMLElement) || !(trigger instanceof HTMLElement)) return;
		const triggerRect = trigger.getBoundingClientRect();
		const overlayRect = eventSummaryOverlay.getBoundingClientRect();
		const margin = 12;
		const viewportWidth = window.innerWidth;
		const viewportHeight = window.innerHeight;
		const preferredLeft = triggerRect.left + (triggerRect.width / 2) - (overlayRect.width / 2);
		const left = Math.min(Math.max(margin, preferredLeft), Math.max(margin, viewportWidth - overlayRect.width - margin));
		const aboveTop = triggerRect.top - overlayRect.height - margin;
		const belowTop = triggerRect.bottom + margin;
		const top = aboveTop >= margin
			? aboveTop
			: Math.min(Math.max(margin, belowTop), Math.max(margin, viewportHeight - overlayRect.height - margin));
		eventSummaryOverlay.style.left = `${left}px`;
		eventSummaryOverlay.style.top = `${top}px`;
	}

	function showEventSummary(trigger, event, activeDate) {
		if (!(eventSummaryOverlay instanceof HTMLElement) || !(trigger instanceof HTMLElement)) return;
		const summary = eventSummaryText(event, activeDate);
		activeSummaryTrigger?.removeAttribute('aria-describedby');
		activeSummaryTrigger = trigger;
		setSummaryText(summaryReference, summary.reference, true);
		setSummaryText(summaryTitle, summary.title);
		setSummaryText(summaryMeta, summary.meta);
		setSummaryText(summaryDate, summary.date);
		setSummaryText(summaryCopy, summary.summary, true);
		trigger.setAttribute('aria-describedby', eventSummaryOverlay.id);
		eventSummaryOverlay.hidden = false;
		eventSummaryOverlay.setAttribute('data-placement', 'open');
		positionEventSummary(trigger);
	}

	function hideEventSummary(trigger = activeSummaryTrigger) {
		if (!(eventSummaryOverlay instanceof HTMLElement)) return;
		if (trigger && activeSummaryTrigger && trigger !== activeSummaryTrigger) return;
		activeSummaryTrigger?.removeAttribute('aria-describedby');
		activeSummaryTrigger = null;
		eventSummaryOverlay.hidden = true;
		eventSummaryOverlay.removeAttribute('data-placement');
	}

	function createPointEventButton(event) {
		const button = createTemplateElement(pointTemplate, 'button', 'timeline-point-event');
		button.className = eventClassName('timeline-point-event', event);
		button.type = 'button';
		populateEventControl(button, event, event.startDate);
		return button;
	}

	function createRangeSegmentButton(segment) {
		const button = createTemplateElement(rangeTemplate, 'button', 'timeline-range-segment');
		button.className = eventClassName('timeline-range-segment', segment.event);
		button.type = 'button';
		button.style.gridColumn = `${segment.startColumn + 1} / ${segment.endColumn + 2}`;
		button.style.setProperty('--timeline-range-lane', String(segment.lane || 0));
		button.classList.toggle('timeline-range-segment--start', segment.isTrueStart);
		button.classList.toggle('timeline-range-segment--end', segment.isTrueEnd);
		button.classList.toggle('timeline-range-segment--continues-before', segment.continuesFromPreviousRow);
		button.classList.toggle('timeline-range-segment--continues-after', segment.continuesToNextRow);
		populateEventControl(button, segment.event, segment.visibleStartDate);
		return button;
	}

	function createOverflowButton(template, className, label, date) {
		const button = createTemplateElement(template, 'button', className);
		button.className = className;
		button.type = 'button';
		button.textContent = label;
		button.setAttribute('aria-label', `${label} hidden Timeline entries on ${formatTimelineDateLong(date)}`);
		button.addEventListener('click', (eventClick) => {
			eventClick.stopPropagation();
			selectDate(date);
			panelGroups?.focus?.();
		});
		return button;
	}

	function renderEventsForWeeks(weeks) {
		if (!weekRows) return;
		clearEventChrome(weekRows);
		const visibleEvents = filterTimelineEventsByLayers(timelineEvents, [...visibleLayerKeys]);
		const pointEventsByDate = getTimelinePointEventsByDate(weeks, visibleEvents, timelineLayers);
		const rangeSegments = allocateTimelineRangeLanes(
			segmentTimelineRangeEventsByWeek(weeks, visibleEvents, timelineLayers),
			rangeLaneLimit,
		);
		const rangeOverflowByDate = getTimelineRangeOverflowCountsByDate(rangeSegments);
		const weekElements = [...weekRows.querySelectorAll('.timeline-week')];

		for (const segment of rangeSegments) {
			if (!segment.isVisible) continue;
			const week = weekElements[segment.weekIndex];
			week?.append(createRangeSegmentButton(segment));
		}

		document.querySelectorAll('[data-timeline-day]').forEach((dayElement) => {
			const date = dayElement.getAttribute('data-timeline-day') || '';
			const pointArea = dayElement.querySelector('.timeline-day__point-area');
			const overflowArea = dayElement.querySelector('.timeline-day__overflow');
			const pointEvents = pointEventsByDate.get(date) || [];
			const pointOverflowCount = getTimelinePointOverflowCount(pointEvents, pointEventLimit);
			pointEvents.slice(0, pointEventLimit).forEach((event) => pointArea?.append(createPointEventButton(event)));
			if (pointOverflowCount > 0) overflowArea?.append(createOverflowButton(pointOverflowTemplate, 'timeline-overflow timeline-overflow--point', `+${pointOverflowCount}`, date));
			const rangeOverflowCount = rangeOverflowByDate.get(date) || 0;
			if (rangeOverflowCount > 0) overflowArea?.append(createOverflowButton(rangeOverflowTemplate, 'timeline-overflow timeline-overflow--range', `+${rangeOverflowCount} ranges`, date));
		});
	}

	function createPanelGroup() {
		return createTemplateElement(panelGroupTemplate, 'section', 'timeline-panel-group');
	}

	function createPanelRow(event) {
		const item = createTemplateElement(panelRowTemplate, 'li', '');
		const button = item.querySelector('[data-timeline-panel-event]');
		if (!(button instanceof HTMLButtonElement)) return item;
		const presentation = panelPresentationForEvent(event);
		button.className = eventClassName('timeline-panel-event', event);
		button.setAttribute('data-timeline-event-id', event.id);
		button.setAttribute('aria-selected', selectedEventId === event.id ? 'true' : 'false');
		button.classList.toggle('timeline-event--selected', selectedEventId === event.id);
		button.setAttribute('aria-label', eventAccessibleLabel(event, selectedDate));
		const icon = button.querySelector('[data-timeline-event-icon]');
		if (icon) icon.textContent = eventIcon(event);
		const reference = button.querySelector('[data-timeline-event-reference]');
		if (reference) {
			reference.textContent = presentation.referenceLabel;
			reference.className = `timeline-panel-event__reference timeline-panel-event__reference--${presentation.referenceTone}`;
		}
		const type = button.querySelector('[data-timeline-event-type]');
		if (type) {
			type.textContent = presentation.typeLabel;
			type.toggleAttribute('hidden', !presentation.showTypePill);
		}
		const status = button.querySelector('[data-timeline-event-status]');
		if (status) {
			status.textContent = presentation.statusLabel;
			status.className = `timeline-pill timeline-pill--status timeline-pill--${eventTone(event)}`;
			status.toggleAttribute('hidden', !presentation.showStatusPill);
		}
		const title = button.querySelector('[data-timeline-event-title]');
		if (title) title.textContent = event.title;
		const summary = button.querySelector('[data-timeline-event-summary]');
		if (summary) summary.textContent = event.summary || 'Fixture event for Timeline visual testing.';
		const date = button.querySelector('[data-timeline-event-date]');
		if (date) date.textContent = event.presentationType === 'range' ? rangeContextLabel(event, selectedDate) : eventDateLabel(event);
		button.addEventListener('click', () => selectEvent(event.id, selectedDate));
		return item;
	}

	function renderSelectedPanel(selectedEvents) {
		if (!panelGroups) return;
		if (!selectedEvents.length) {
			const empty = document.createElement('div');
			empty.className = 'empty-state empty-state--neutral';
			empty.innerHTML = '<h3>No project activity is currently shown for this date.</h3><p>No visible fixture entries overlap this date.</p>';
			panelGroups.replaceChildren(empty);
			return;
		}
		const groups = groupTimelineEventsByLayer(selectedEvents, timelineLayers);
		const groupElements = groups.map((group) => {
			const groupElement = createPanelGroup();
			const heading = groupElement.querySelector('[data-timeline-panel-group-heading]');
			if (heading) heading.textContent = group.layer.label;
			const list = groupElement.querySelector('[data-timeline-panel-group-list]');
			for (const event of group.events) list?.append(createPanelRow(event));
			return groupElement;
		});
		panelGroups.replaceChildren(...groupElements);
	}

	function renderMonth(month) {
		if (!weekRows || !heading) return;
		activeMonth = month;
		const weeks = buildTimelineCalendarGrid(activeMonth, todayDate);
		heading.textContent = formatTimelineMonthHeading(activeMonth);
		page?.setAttribute('data-timeline-month', timelineMonthValue(activeMonth));
		weekRows.replaceChildren(...weeks.map((week) => {
			const row = createWeekRow();
			week.days.forEach((day, index) => {
				const button = createDayButton(day);
				button.style.gridColumn = String(index + 1);
				button.style.gridRow = '1';
				row.append(button);
			});
			return row;
		}));
		renderEventsForWeeks(weeks);
		updateSelectedPanel();
		schedulePanelHeightSync();
	}

	const calendarResizeObserver = typeof ResizeObserver === 'function' && calendarCard instanceof HTMLElement
		? new ResizeObserver(() => schedulePanelHeightSync())
		: null;
	calendarResizeObserver?.observe(calendarCard);
	if (typeof desktopPanelHeightQuery.addEventListener === 'function') {
		desktopPanelHeightQuery.addEventListener('change', () => schedulePanelHeightSync());
	} else {
		desktopPanelHeightQuery.addListener?.(() => schedulePanelHeightSync());
	}

	document.querySelectorAll('[data-timeline-day]').forEach((button) => {
		button.addEventListener('click', () => {
			const date = button.getAttribute('data-timeline-day');
			if (date) selectDate(date);
		});
		button.addEventListener('keydown', (keyboardEvent) => {
			if (keyboardEvent.key !== 'Enter' && keyboardEvent.key !== ' ') return;
			const date = button.getAttribute('data-timeline-day');
			if (!date) return;
			keyboardEvent.preventDefault();
			selectDate(date);
		});
	});

	function navigateMonth(offset) {
		const nextMonth = addTimelineMonths(activeMonth, offset);
		selectedDate = timelineMonthStartDate(nextMonth);
		selectedEventId = '';
		renderMonth(nextMonth);
		const selectedCell = document.querySelector(`[data-timeline-day="${CSS.escape(selectedDate)}"]`);
		if (selectedCell instanceof HTMLElement) selectedCell.focus();
	}

	previousButton?.addEventListener('click', () => navigateMonth(-1));
	nextButton?.addEventListener('click', () => navigateMonth(1));
	todayButton?.addEventListener('click', () => {
		selectedDate = todayDate;
		selectedEventId = '';
		renderMonth(getTimelineMonthFromDate(todayDate));
		const todayCell = document.querySelector(`[data-timeline-day="${CSS.escape(todayDate)}"]`);
		if (todayCell instanceof HTMLElement) todayCell.focus();
	});
	layerToggles.forEach((toggle) => {
		toggle.addEventListener('change', () => {
			const layerKey = toggle.getAttribute('data-timeline-layer-toggle');
			if (!layerKey) return;
			if (toggle.checked) visibleLayerKeys.add(layerKey);
			else visibleLayerKeys.delete(layerKey);
			const selectedEvent = timelineEvents.find((event) => event.id === selectedEventId);
			if (selectedEvent && !visibleLayerKeys.has(selectedEvent.layer)) selectedEventId = '';
			renderMonth(activeMonth);
		});
	});
	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape') {
			hideEventSummary();
			if (layerControl instanceof HTMLDetailsElement) layerControl.open = false;
		}
	});
	window.addEventListener('scroll', () => {
		if (activeSummaryTrigger) positionEventSummary(activeSummaryTrigger);
	}, true);
	window.addEventListener('resize', () => {
		schedulePanelHeightSync();
		if (activeSummaryTrigger) positionEventSummary(activeSummaryTrigger);
	});
	renderMonth(activeMonth);
</script>

