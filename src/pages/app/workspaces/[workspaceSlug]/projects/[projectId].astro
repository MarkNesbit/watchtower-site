---
import AuthenticatedLayout from '../../../../../layouts/AuthenticatedLayout.astro';
import ProjectContentPanel from '../../../../../components/app/ProjectContentPanel.astro';
import ProjectControlPanel from '../../../../../components/app/ProjectControlPanel.astro';
import ProjectPageHero from '../../../../../components/app/ProjectPageHero.astro';
import RagReferencePill from '../../../../../components/app/RagReferencePill.astro';
import { getFeatureAccess, loadFeatureAccess } from '../../../../../lib/featureFlags';
import type { FeatureAccess, FeatureKey } from '../../../../../lib/featureFlags';
import { can } from '../../../../../lib/permissions';
import { buildProjectEditPath, buildProjectNarrativePath, buildProjectRisksPath, getWorkspaceBySlug } from '../../../../../lib/projects';
import {
	deriveProjectRiskDashboardAssuranceTone,
	listProjectRisks,
	riskAssuranceToneLabel,
	type RiskDashboardAssuranceTone,
} from '../../../../../lib/projectRisks';
import { createSupabaseServerClient, getServerAccessToken } from '../../../../../lib/supabaseServer';

const projectSlug = Astro.params.projectId;
const workspaceSlug = Astro.params.workspaceSlug;
const accessToken = getServerAccessToken(Astro.cookies);
let project = null;
let workspaceName = '';
let canEditProject = false;
let message = '';
let creatorDisplayName = '';
let riskDashboardIconTone: RiskDashboardAssuranceTone = 'neutral';

const formatDate = (value) => value ? new Date(value).toLocaleString() : 'Not available';
const formatValue = (value, fallback = 'Not available') => value || fallback;
const formatStatusLabel = (value) => value ? value.charAt(0).toUpperCase() + value.slice(1) : 'Unknown';
const healthTone = (value) => {
	const health = value?.toLowerCase();
	if (health === 'green') return 'green';
	if (health === 'amber') return 'amber';
	if (health === 'red') return 'red';
	return 'blue';
};
const riskDashboardIconLabel = (tone: RiskDashboardAssuranceTone) => tone === 'neutral'
	? 'Risks: no active risks recorded'
	: `Risks: ${riskAssuranceToneLabel(tone)} assurance state`;

type ProjectTile = {
	title: string;
	icon: string;
	tone: string;
	iconTone?: RiskDashboardAssuranceTone;
	line: string;
	ariaLabel?: string;
	href: string | null;
	destination?: 'narrative' | 'risks';
	featureKey?: FeatureKey;
};

const projectTiles: ProjectTile[] = [
	{
		title: 'Project Narrative',
		icon: '≡',
		tone: 'blue',
		line: 'View key project events, updates, decisions and history.',
		href: null,
		destination: 'narrative',
		featureKey: 'projectDiary',
	},
	{ title: 'Timeline', icon: '▦', tone: 'blue', line: 'Not assessed', href: '#timeline' },
	{ title: 'Risks', icon: '⚠', tone: 'blue', line: 'Open risk management', href: null, destination: 'risks', featureKey: 'riskManagement' },
	{ title: 'Issues', icon: '!', tone: 'blue', line: 'No data yet', href: '#issues' },
	{ title: 'Dependencies', icon: '↔', tone: 'blue', line: 'No data yet', href: '#dependencies' },
	{ title: 'Assumptions', icon: '?', tone: 'blue', line: 'No data yet', href: '#assumptions' },
	{ title: 'Decisions', icon: '⚖', tone: 'blue', line: 'No data yet', href: '#decisions' },
	{ title: 'Actions', icon: '☑', tone: 'blue', line: 'No data yet', href: '#actions' },
];

const gatedFeatureKeys = [...new Set(projectTiles.flatMap((tile) => tile.featureKey ? [tile.featureKey] : []))];
let featureAccessByKey: Partial<Record<FeatureKey, FeatureAccess>> = Object.fromEntries(
	gatedFeatureKeys.map((featureKey) => [featureKey, getFeatureAccess(featureKey)]),
);

try {
	const serverSupabase = createSupabaseServerClient(accessToken);
	const workspace = await getWorkspaceBySlug(serverSupabase, workspaceSlug ?? '', accessToken);
	const organisation = Array.isArray(workspace?.organisations) ? workspace?.organisations[0] : workspace?.organisations;
	if (!workspace || !organisation) {
		message = 'Project not found or you do not have access.';
		Astro.response.status = 404;
	} else if (!can(workspace.role, 'project.viewDashboard')) {
		message = 'Your workspace role does not permit project dashboard access.';
		Astro.response.status = 403;
	} else {
		workspaceName = organisation.name;
		canEditProject = can(workspace.role, 'project.editDetails');
		featureAccessByKey = Object.fromEntries(await Promise.all(
			gatedFeatureKeys.map(async (featureKey) => [
				featureKey,
				await loadFeatureAccess(serverSupabase, featureKey, accessToken),
			] as const),
		));
		const { data, error } = await serverSupabase
			.from('projects')
			.select('id, name, project_ref, description, slug, status, health, created_at, updated_at, created_by')
			.eq('slug', projectSlug)
			.eq('organisation_id', organisation.id)
			.is('deleted_at', null)
			.is('archived_at', null)
			.maybeSingle();
		if (error) throw error;
		project = data;
		if (!project) {
			message = 'Project not found or you do not have access.';
			Astro.response.status = 404;
		} else {
			if (project.created_by) {
				const { data: creator, error: creatorError } = await serverSupabase
					.from('profiles')
					.select('display_name, email')
					.eq('id', project.created_by)
					.maybeSingle();
				if (!creatorError && creator) creatorDisplayName = creator.display_name || creator.email || '';
			}
			const riskFeatureAccess = featureAccessByKey.riskManagement ?? getFeatureAccess('riskManagement');
			if (riskFeatureAccess.isAccessible && can(workspace.role, 'risk.view')) {
				try {
					const risks = await listProjectRisks(organisation.id, project.id, workspace.role, serverSupabase);
					riskDashboardIconTone = deriveProjectRiskDashboardAssuranceTone(risks, new Date());
				} catch {
					riskDashboardIconTone = 'neutral';
				}
			}
		}
	}
} catch (error) {
	message = error instanceof Error ? error.message : 'Unable to load project.';
	Astro.response.status = 500;
}

const visibleProjectTiles = projectTiles.flatMap((tile) => {
	const featureAccess = tile.featureKey
		? featureAccessByKey[tile.featureKey] ?? getFeatureAccess(tile.featureKey)
		: null;
	if (featureAccess && !featureAccess.isVisible) return [];

	const href = project && tile.destination === 'risks'
		? buildProjectRisksPath(workspaceSlug ?? '', project.slug)
		: project && tile.destination === 'narrative'
			? buildProjectNarrativePath(workspaceSlug ?? '', project.slug)
			: tile.href;
	const isAccessible = Boolean(href) && (!featureAccess || featureAccess.isAccessible);
	const unavailableReason = featureAccess && !featureAccess.isAccessible
		? featureAccess.unavailableReason
		: !href
			? 'This capability is not available yet.'
			: null;

	return [{ ...tile, href, featureAccess, isAccessible, unavailableReason }];
});

const resolvedProjectTiles = visibleProjectTiles.map((tile) => tile.destination === 'risks'
	? {
		...tile,
		iconTone: riskDashboardIconTone,
		ariaLabel: riskDashboardIconLabel(riskDashboardIconTone),
	}
	: tile);
---
<AuthenticatedLayout title={project ? `${project.name} | WatchTower` : 'Project | WatchTower'}>
	<section class="project-dashboard" data-project-dashboard>
		{project ? (
			<>
				<ProjectPageHero
					workspaceName={workspaceName}
					projectName={project.name}
					projectRef={project.project_ref}
					title="Project Dashboard"
					description="A project overview and capability hub for this workspace."
					headingId="project-dashboard-heading"
				/>

				<ProjectControlPanel title="Project status" headingId="project-dashboard-status-heading">
					<dl class="project-status-summary" aria-label="Project status summary">
						<div>
							<dt>Status</dt>
							<dd>{formatStatusLabel(project.status)}</dd>
						</div>
						<div>
							<dt>Health</dt>
							<dd>
								<RagReferencePill
									tone={healthTone(project.health)}
									label={formatStatusLabel(formatValue(project.health, 'Not assessed'))}
								/>
							</dd>
						</div>
					</dl>
				</ProjectControlPanel>

				<ProjectContentPanel
					title="Project areas"
					helper="Open a project capability or review its current availability."
					headingId="project-dashboard-areas-heading"
				>
					<div slot="action" data-edit-project-action>
						{canEditProject ? (
							<a class="button button--secondary project-dashboard__edit" href={buildProjectEditPath(workspaceSlug ?? '', project.slug)}>Edit project details</a>
						) : (
							<span class="button button--secondary project-dashboard__edit" aria-disabled="true" data-disabled-edit-action>Edit project details</span>
						)}
					</div>
					<div class="dashboard-tile-grid" aria-label="Project dashboard areas">
						{resolvedProjectTiles.map((tile, index) => !tile.isAccessible ? (
							<article
								class={`dashboard-tile dashboard-tile--${tile.tone} dashboard-tile--icon-${tile.iconTone ?? 'default'} dashboard-tile--unavailable`}
								aria-disabled="true"
								aria-label={tile.ariaLabel ?? tile.title}
								aria-describedby={`dashboard-tile-help-${index}`}
								tabindex="0"
								data-risk-icon-state={tile.destination === 'risks' ? tile.iconTone : undefined}
								data-feature-unavailable={tile.featureAccess?.state ?? 'route-unavailable'}
							>
								<span class="dashboard-tile__icon" aria-hidden="true">{tile.icon}</span>
								<strong>{tile.title}</strong>
								<small id={`dashboard-tile-help-${index}`}>{tile.unavailableReason}</small>
							</article>
						) : (
							<a
								class={`dashboard-tile dashboard-tile--${tile.tone} dashboard-tile--icon-${tile.iconTone ?? 'default'}`}
								href={tile.href}
								aria-label={tile.ariaLabel ?? `${tile.title}: ${tile.line}`}
								data-risk-icon-state={tile.destination === 'risks' ? tile.iconTone : undefined}
							>
								<span class="dashboard-tile__icon" aria-hidden="true">{tile.icon}</span>
								<strong>{tile.title}</strong>
								<small>{tile.line}</small>
							</a>
						))}
					</div>
				</ProjectContentPanel>

				<ProjectContentPanel
					label="Read-only metadata"
					title="Key details"
					headingId="project-information-heading"
				>
					<dl class="project-information">
						<div><dt>Description</dt><dd>{formatValue(project.description)}</dd></div>
						<div><dt>Created</dt><dd>{formatDate(project.created_at)}</dd></div>
						<div><dt>Last updated</dt><dd>{formatDate(project.updated_at)}</dd></div>
						<div><dt>Created by</dt><dd>{formatValue(creatorDisplayName)}</dd></div>
					</dl>
					{!canEditProject && <p data-edit-permission-message>You do not have permission to edit project details.</p>}
				</ProjectContentPanel>

				<a class="text-link project-dashboard__back" href="/app/projects">Back to projects</a>
			</>
		) : (
			<section class="content-card"><p>{message}</p></section>
		)}
	</section>
</AuthenticatedLayout>

<style>
	.project-dashboard {
		display: grid;
		gap: 0.9rem;
	}

	.project-dashboard__back {
		justify-self: start;
	}

	.project-dashboard__edit {
		justify-self: end;
	}

	.project-dashboard :global(#project-dashboard-areas-heading) {
		font-size: clamp(1.45rem, 2.4vw, 2rem);
	}

	.project-status-summary {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.7rem;
		margin: 0;
	}

	.project-status-summary div {
		display: grid;
		gap: 0.25rem;
	}

	.project-status-summary dt,
	.project-information dt {
		color: var(--muted);
		font-size: 0.83rem;
		font-weight: 850;
	}

	.project-status-summary dd,
	.project-information dd {
		margin: 0;
	}

	.dashboard-tile-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(10.5rem, 1fr));
		gap: 1rem;
		max-width: 70rem;
		margin-inline: auto;
	}

	.dashboard-tile {
		aspect-ratio: 1;
		display: grid;
		place-items: center;
		align-content: center;
		gap: 0.45rem;
		border: 1px solid color-mix(in srgb, var(--tile-status) 72%, transparent);
		border-radius: 1rem;
		padding: 1rem;
		background:
			radial-gradient(circle at 50% 12%, color-mix(in srgb, var(--tile-status) 32%, transparent), transparent 58%),
			linear-gradient(145deg, color-mix(in srgb, var(--tile-status) 28%, rgba(4, 12, 24, 0.92)), rgba(4, 12, 24, 0.72));
		color: var(--text);
		text-align: center;
		text-decoration: none;
		transition: border-color 160ms ease, box-shadow 160ms ease, transform 160ms ease;
	}

	.dashboard-tile:hover,
	.dashboard-tile:focus-visible {
		border-color: var(--tile-status);
		box-shadow: 0 14px 36px color-mix(in srgb, var(--tile-status) 24%, transparent);
		transform: translateY(-2px);
		outline: none;
	}

	.dashboard-tile--unavailable {
		cursor: not-allowed;
	}

	.dashboard-tile__icon {
		font-size: clamp(2.2rem, 5vw, 3.4rem);
		font-weight: 900;
		line-height: 1;
		color: var(--tile-icon-status, var(--tile-status));
	}

	.dashboard-tile strong {
		font-size: 1.1rem;
	}

	.dashboard-tile small {
		color: var(--muted-strong);
		font-size: 0.9rem;
	}

	.dashboard-tile--blue { --tile-status: #00a0ff; }
	.dashboard-tile--green { --tile-status: #21d36b; }
	.dashboard-tile--amber { --tile-status: #f6a400; }
	.dashboard-tile--red { --tile-status: #ff453a; }
	.dashboard-tile--icon-green { --tile-icon-status: #21d36b; }
	.dashboard-tile--icon-amber { --tile-icon-status: #f6a400; }
	.dashboard-tile--icon-red { --tile-icon-status: #ff453a; }
	.dashboard-tile--icon-neutral,
	.dashboard-tile--icon-default { --tile-icon-status: var(--tile-status); }

	.project-information {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 1rem;
		margin: 0;
	}

	.project-information dd {
		margin: 0.2rem 0 0;
	}

	@media (max-width: 850px) {
		.project-status-summary,
		.project-information {
			grid-template-columns: 1fr;
		}
	}
</style>
