---
import AuthenticatedLayout from '../../../../../layouts/AuthenticatedLayout.astro';
import ProjectContentPanel from '../../../../../components/app/ProjectContentPanel.astro';
import ProjectControlPanel from '../../../../../components/app/ProjectControlPanel.astro';
import ProjectPageHero from '../../../../../components/app/ProjectPageHero.astro';
import RagReferencePill from '../../../../../components/app/RagReferencePill.astro';
import WatchtowerIcon from '../../../../../components/app/WatchtowerIcon.astro';
import {
	dashboardTileSignalStatusLabel,
	deriveProjectDetailsTileSignal,
	deriveProjectNarrativeTileSignal,
	deriveRiskTileAttentionSignal,
	type DashboardTileSignalState,
} from '../../../../../lib/dashboardTileSignals';
import { getFeatureAccess, loadFeatureAccess } from '../../../../../lib/featureFlags';
import type { FeatureAccess, FeatureKey } from '../../../../../lib/featureFlags';
import { can } from '../../../../../lib/permissions';
import { deriveProjectActionState, projectActionStateLabel } from '../../../../../lib/projectAttention';
import { buildProjectDateCards, listProjectDates, type ProjectDateCard } from '../../../../../lib/projectDates';
import { getUnseenProjectNarrativeCount } from '../../../../../lib/projectNarrative';
import { buildProjectActionsPath, buildProjectDetailsPath, buildProjectNarrativePath, buildProjectRisksPath, buildProjectTimelinePath, getWorkspaceBySlug } from '../../../../../lib/projects';
import { buildRiskRegisterViewPath, deriveProjectRiskSignal, listProjectRisks, riskRegisterViewForProjectRiskSignal, type ProjectRisk, type RiskRegisterViewTab } from '../../../../../lib/projectRisks';
import { createSupabaseServerClient, getServerAccessToken } from '../../../../../lib/supabaseServer';
import type { WatchtowerIconKey } from '../../../../../lib/watchtowerIcons';

const projectSlug = Astro.params.projectId;
const workspaceSlug = Astro.params.workspaceSlug;
const accessToken = getServerAccessToken(Astro.cookies);
let project = null;
let workspaceName = '';
let canEditProject = false;
let message = '';
let creatorDisplayName = '';
let projectDateCards: ProjectDateCard[] | null = null;
let projectDetailAssignments = null;
let projectDetailsTileSignal: DashboardTileSignalState = 'unknown';
let projectNarrativeTileSignal: DashboardTileSignalState = 'unknown';
let unseenProjectNarrativeEntries: number | null = null;
let riskTileSignal: DashboardTileSignalState = 'neutral';
let projectActionState: DashboardTileSignalState = 'unknown';
let projectRisksForActionState: ProjectRisk[] | null = [];
let riskRegisterDestinationView: RiskRegisterViewTab = 'active';

const formatDate = (value) => value ? new Date(value).toLocaleString() : 'Not available';
const formatValue = (value, fallback = 'Not available') => value || fallback;
const formatStatusLabel = (value) => value ? value.charAt(0).toUpperCase() + value.slice(1) : 'Unknown';
const projectHealthLabel = 'Unknown';
const tileAriaLabel = (title: string, state: DashboardTileSignalState) => `${title}: ${dashboardTileSignalStatusLabel(state)}`;
const projectNarrativeStatusLabel = (state: DashboardTileSignalState, unseenEntries: number | null) => {
	if (!Number.isInteger(unseenEntries) || unseenEntries < 0) return dashboardTileSignalStatusLabel(state);
	if (unseenEntries === 0) return 'Green no action needed, no unseen entries';
	const entryLabel = unseenEntries === 1 ? 'entry' : 'entries';
	return `${formatStatusLabel(state)} action state, ${unseenEntries} unseen ${entryLabel}`;
};

type ProjectTile = {
	title: string;
	icon: string;
	semanticIcon?: WatchtowerIconKey;
	tone: string;
	iconTone?: DashboardTileSignalState;
	attentionTone?: DashboardTileSignalState;
	statusLabel?: string;
	ariaLabel?: string;
	href: string | null;
	destination?: 'details' | 'narrative' | 'timeline' | 'risks' | 'actions';
	featureKey?: FeatureKey;
};

const projectTiles: ProjectTile[] = [
	{
		title: 'Project Details',
		icon: 'i',
		tone: 'blue',
		attentionTone: 'neutral',
		statusLabel: 'Informational',
		ariaLabel: 'Project Details: Neutral state',
		href: null,
		destination: 'details',
	},
	{
		title: 'Project Narrative',
		icon: '≡',
		tone: 'blue',
		attentionTone: 'neutral',
		statusLabel: 'Informational',
		ariaLabel: 'Project Narrative: Neutral state',
		href: null,
		destination: 'narrative',
		featureKey: 'projectDiary',
	},
	{
		title: 'Timeline',
		icon: '▦',
		tone: 'blue',
		attentionTone: 'green',
		statusLabel: 'Available',
		ariaLabel: 'Open Timeline, Available',
		href: null,
		destination: 'timeline',
	},
	{ title: 'Risks', icon: '', semanticIcon: 'risk', tone: 'blue', attentionTone: 'neutral', statusLabel: 'No active risks recorded', href: null, destination: 'risks', featureKey: 'riskManagement' },
	{ title: 'Issues', icon: '', semanticIcon: 'issue', tone: 'blue', attentionTone: 'unknown', statusLabel: 'Unknown', ariaLabel: 'Open Issues, Unknown state', href: '#issues' },
	{ title: 'Dependencies', icon: '', semanticIcon: 'dependency', tone: 'blue', attentionTone: 'unknown', statusLabel: 'Unknown', ariaLabel: 'Open Dependencies, Unknown state', href: '#dependencies' },
	{ title: 'Assumptions', icon: '', semanticIcon: 'assumption', tone: 'blue', attentionTone: 'unknown', statusLabel: 'Unknown', ariaLabel: 'Open Assumptions, Unknown state', href: '#assumptions' },
	{ title: 'Decisions', icon: '', semanticIcon: 'decision', tone: 'blue', attentionTone: 'unknown', statusLabel: 'Unknown', ariaLabel: 'Open Decisions, Unknown state', href: '#decisions' },
	{ title: 'Actions', icon: '', semanticIcon: 'action', tone: 'blue', attentionTone: 'unknown', statusLabel: 'Unknown', ariaLabel: 'Open Actions, Unknown state', href: null, destination: 'actions' },
];

const gatedFeatureKeys = [...new Set(projectTiles.flatMap((tile) => tile.featureKey ? [tile.featureKey] : []))];
let featureAccessByKey: Partial<Record<FeatureKey, FeatureAccess>> = Object.fromEntries(
	gatedFeatureKeys.map((featureKey) => [featureKey, getFeatureAccess(featureKey)]),
);

try {
	const serverSupabase = createSupabaseServerClient(accessToken);
	const workspace = await getWorkspaceBySlug(serverSupabase, workspaceSlug ?? '', accessToken);
	const organisation = Array.isArray(workspace?.organisations) ? workspace?.organisations[0] : workspace?.organisations;
	if (!workspace || !organisation) {
		message = 'Project not found or you do not have access.';
		Astro.response.status = 404;
	} else if (!can(workspace.role, 'project.viewDashboard')) {
		message = 'Your workspace role does not permit project dashboard access.';
		Astro.response.status = 403;
	} else {
		workspaceName = organisation.name;
		canEditProject = can(workspace.role, 'project.editDetails');
		featureAccessByKey = Object.fromEntries(await Promise.all(
			gatedFeatureKeys.map(async (featureKey) => [
				featureKey,
				await loadFeatureAccess(serverSupabase, featureKey, accessToken),
			] as const),
		));
		const { data, error } = await serverSupabase
			.from('projects')
			.select('id, name, project_ref, description, slug, status, health, project_type, delivery_method, priority, criticality, start_date, target_end_date, next_review_date, review_cadence, governance_route, escalation_route, created_at, updated_at, created_by')
			.eq('slug', projectSlug)
			.eq('organisation_id', organisation.id)
			.is('deleted_at', null)
			.is('archived_at', null)
			.maybeSingle();
		if (error) throw error;
		project = data;
		if (!project) {
			message = 'Project not found or you do not have access.';
			Astro.response.status = 404;
		} else {
			if (project.created_by) {
				const { data: creator, error: creatorError } = await serverSupabase
					.from('profiles')
					.select('display_name, email')
					.eq('id', project.created_by)
					.maybeSingle();
				if (!creatorError && creator) creatorDisplayName = creator.display_name || creator.email || '';
			}
			try {
				const projectDates = await listProjectDates(organisation.id, project.id, workspace.role, serverSupabase);
				projectDateCards = buildProjectDateCards(projectDates, project, new Date());
			} catch {
				projectDateCards = null;
			}
			try {
				const { data: assignments, error: assignmentsError } = await serverSupabase
					.from('project_people')
					.select('project_role, user_id, demo_person_id, status')
					.eq('organisation_id', organisation.id)
					.eq('project_id', project.id)
					.eq('status', 'active');
				if (assignmentsError) throw assignmentsError;
				projectDetailAssignments = assignments ?? [];
			} catch {
				projectDetailAssignments = null;
			}
			projectDetailsTileSignal = deriveProjectDetailsTileSignal(project, projectDateCards, projectDetailAssignments);
			const narrativeFeatureAccess = featureAccessByKey.projectDiary ?? getFeatureAccess('projectDiary');
			if (narrativeFeatureAccess.isAccessible && can(workspace.role, 'narrative.view')) {
				try {
					unseenProjectNarrativeEntries = await getUnseenProjectNarrativeCount(
						organisation.id,
						project.id,
						workspace.role,
						serverSupabase,
						accessToken,
					);
					projectNarrativeTileSignal = deriveProjectNarrativeTileSignal({ unseenEntries: unseenProjectNarrativeEntries });
				} catch {
					unseenProjectNarrativeEntries = null;
					projectNarrativeTileSignal = 'unknown';
				}
			}
			const riskFeatureAccess = featureAccessByKey.riskManagement ?? getFeatureAccess('riskManagement');
			if (riskFeatureAccess.isAccessible && can(workspace.role, 'risk.view')) {
				try {
					const risks = await listProjectRisks(organisation.id, project.id, workspace.role, serverSupabase);
					projectRisksForActionState = risks;
					const riskSignalNow = new Date();
					const riskSignal = deriveProjectRiskSignal(risks, riskSignalNow);
					riskTileSignal = deriveRiskTileAttentionSignal(risks, riskSignalNow);
					riskRegisterDestinationView = riskRegisterViewForProjectRiskSignal(riskSignal);
				} catch {
					projectRisksForActionState = null;
					riskTileSignal = 'unknown';
					riskRegisterDestinationView = 'active';
				}
			}
			projectActionState = deriveProjectActionState({
				project,
				projectDateCards,
				projectPeople: projectDetailAssignments,
				risks: projectRisksForActionState,
			}, new Date());
		}
	}
} catch (error) {
	message = error instanceof Error ? error.message : 'Unable to load project.';
	Astro.response.status = 500;
}

const visibleProjectTiles = projectTiles.flatMap((tile) => {
	const featureAccess = tile.featureKey
		? featureAccessByKey[tile.featureKey] ?? getFeatureAccess(tile.featureKey)
		: null;
	if (featureAccess && !featureAccess.isVisible) return [];

	const href = project && tile.destination === 'risks'
		? buildRiskRegisterViewPath(buildProjectRisksPath(workspaceSlug ?? '', project.slug), riskRegisterDestinationView)
		: project && tile.destination === 'narrative'
			? buildProjectNarrativePath(workspaceSlug ?? '', project.slug)
			: project && tile.destination === 'details'
				? buildProjectDetailsPath(workspaceSlug ?? '', project.slug)
				: project && tile.destination === 'actions'
					? buildProjectActionsPath(workspaceSlug ?? '', project.slug)
					: project && tile.destination === 'timeline'
						? buildProjectTimelinePath(workspaceSlug ?? '', project.slug)
					: tile.href;
	const isAccessible = Boolean(href) && (!featureAccess || featureAccess.isAccessible);
	const unavailableReason = featureAccess && !featureAccess.isAccessible
		? featureAccess.unavailableReason
		: !href
			? 'This capability is not available yet.'
			: null;

	return [{ ...tile, href, featureAccess, isAccessible, unavailableReason }];
});

const resolvedProjectTiles = visibleProjectTiles.map((tile) => {
	const tileSignal = tile.destination === 'details'
		? projectDetailsTileSignal
		: tile.destination === 'narrative'
			? projectNarrativeTileSignal
			: tile.destination === 'timeline'
				? 'green'
			: tile.destination === 'risks'
				? riskTileSignal
				: tile.destination === 'actions'
					? projectActionState
					: tile.attentionTone ?? 'unknown';
	return {
		...tile,
		iconTone: tileSignal,
		attentionTone: tileSignal,
		statusLabel: tile.destination === 'narrative'
			? projectNarrativeStatusLabel(tileSignal, unseenProjectNarrativeEntries)
			: dashboardTileSignalStatusLabel(tileSignal),
		ariaLabel: tile.destination === 'narrative'
			? `${tile.title}: ${projectNarrativeStatusLabel(tileSignal, unseenProjectNarrativeEntries)}`
			: tileAriaLabel(tile.title, tileSignal),
	};
});
---
<AuthenticatedLayout title={project ? `${project.name} | WatchTower` : 'Project | WatchTower'}>
	<section class="project-dashboard" data-project-dashboard>
		{project ? (
			<>
				<ProjectPageHero
					workspaceName={workspaceName}
					projectName={project.name}
					projectRef={project.project_ref}
					title="Project Dashboard"
					description="A project overview and capability hub for this workspace."
					headingId="project-dashboard-heading"
				/>

				<ProjectControlPanel title="Project status" headingId="project-dashboard-status-heading">
					<dl class="project-status-summary" aria-label="Project status summary">
						<div>
							<dt>Status</dt>
							<dd>{formatStatusLabel(project.status)}</dd>
						</div>
						<div>
							<dt>Action state</dt>
							<dd>
								<RagReferencePill
									tone={projectActionState}
									label={projectActionStateLabel(projectActionState)}
								/>
							</dd>
						</div>
						<div>
							<dt>Health</dt>
							<dd>
								<RagReferencePill
									tone="unknown"
									label={projectHealthLabel}
								/>
							</dd>
						</div>
					</dl>
				</ProjectControlPanel>

				<ProjectContentPanel
					title="Project areas"
					helper="Open a project capability or review its current availability."
					headingId="project-dashboard-areas-heading"
				>
					<div slot="action" data-project-details-action>
						<a class="button button--secondary project-dashboard__details" href={buildProjectDetailsPath(workspaceSlug ?? '', project.slug)}>Project details</a>
					</div>
					<div class="dashboard-tile-grid" aria-label="Project dashboard areas">
						{resolvedProjectTiles.map((tile) => !tile.isAccessible ? (
							<article
								class={`dashboard-tile dashboard-tile--${tile.tone} dashboard-tile--icon-${tile.iconTone ?? 'default'} dashboard-tile--unavailable rag-tile rag-tile--${tile.tone} rag-tile--attention-${tile.attentionTone ?? 'unknown'} rag-tile--disabled`}
								aria-disabled="true"
								aria-label={`${tile.ariaLabel ?? tile.title}, unavailable`}
								title={`${tile.ariaLabel ?? tile.title}, unavailable`}
								tabindex="0"
								data-risk-icon-state={tile.destination === 'risks' ? tile.iconTone : undefined}
								data-rag-tile-state={tile.attentionTone ?? 'unknown'}
								data-dashboard-tile-signal={tile.attentionTone ?? 'unknown'}
								data-feature-unavailable={tile.featureAccess?.state ?? 'route-unavailable'}
							>
								<span class="dashboard-tile__icon" aria-hidden="true">
									{tile.semanticIcon ? <WatchtowerIcon icon={tile.semanticIcon} size="full" decorative /> : tile.icon}
								</span>
								<strong>{tile.title}</strong>
							</article>
						) : (
							<a
								class={`dashboard-tile dashboard-tile--${tile.tone} dashboard-tile--icon-${tile.iconTone ?? 'default'} rag-tile rag-tile--${tile.tone} rag-tile--attention-${tile.attentionTone ?? 'neutral'}`}
								href={tile.href}
								aria-label={`Open ${tile.title}, ${tile.statusLabel ?? 'Neutral state'}`}
								title={`${tile.ariaLabel ?? tile.title}`}
								data-risk-icon-state={tile.destination === 'risks' ? tile.iconTone : undefined}
								data-rag-tile-state={tile.attentionTone ?? 'neutral'}
								data-dashboard-tile-signal={tile.attentionTone ?? 'neutral'}
							>
								<span class="dashboard-tile__icon" aria-hidden="true">
									{tile.semanticIcon ? <WatchtowerIcon icon={tile.semanticIcon} size="full" decorative /> : tile.icon}
								</span>
								<strong>{tile.title}</strong>
							</a>
						))}
					</div>
				</ProjectContentPanel>

				<ProjectContentPanel
					label="Read-only metadata"
					title="Key details"
					headingId="project-information-heading"
				>
					<dl class="project-information">
						<div><dt>Description</dt><dd>{formatValue(project.description)}</dd></div>
						<div><dt>Created</dt><dd>{formatDate(project.created_at)}</dd></div>
						<div><dt>Last updated</dt><dd>{formatDate(project.updated_at)}</dd></div>
						<div><dt>Created by</dt><dd>{formatValue(creatorDisplayName)}</dd></div>
					</dl>
					{!canEditProject && <p data-edit-permission-message>You do not have permission to edit project details.</p>}
				</ProjectContentPanel>

				<a class="text-link project-dashboard__back" href="/app/projects">Back to projects</a>
			</>
		) : (
			<section class="content-card"><p>{message}</p></section>
		)}
	</section>
</AuthenticatedLayout>

<style>
	.project-dashboard {
		display: grid;
		gap: 0.9rem;
	}

	.project-dashboard__back {
		justify-self: start;
	}

	.project-dashboard__details {
		justify-self: end;
	}

	.project-dashboard :global(#project-dashboard-areas-heading) {
		font-size: clamp(1.45rem, 2.4vw, 2rem);
	}

	.project-status-summary {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.7rem;
		margin: 0;
	}

	.project-status-summary div {
		display: grid;
		gap: 0.25rem;
	}

	.project-status-summary dt,
	.project-information dt {
		color: var(--muted);
		font-size: 0.83rem;
		font-weight: 850;
	}

	.project-status-summary dd,
	.project-information dd {
		margin: 0;
	}

	.dashboard-tile-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(9.5rem, 10.75rem));
		justify-content: center;
		gap: 1rem;
		max-width: 70rem;
		margin-inline: auto;
	}

	.dashboard-tile {
		aspect-ratio: 1;
		display: grid;
		place-items: center;
		align-content: center;
		gap: 0.45rem;
		border-radius: 1rem;
		padding: 1rem;
		color: var(--text);
		text-align: center;
		text-decoration: none;
		transition: border-color 160ms ease, box-shadow 160ms ease, transform 160ms ease;
	}

	.dashboard-tile:hover,
	.dashboard-tile:focus-visible {
		border-color: var(--rag-border, var(--rag-reference-border));
		box-shadow: 0 14px 36px var(--rag-background, var(--rag-reference-background));
		transform: translateY(-2px);
		outline: none;
	}

	.dashboard-tile--unavailable {
		cursor: not-allowed;
	}

	.dashboard-tile__icon {
		display: grid;
		place-items: center;
		width: 2.8rem;
		height: 2.8rem;
		font-size: 2.8rem;
		font-weight: 900;
		line-height: 1;
		color: var(--rag-icon-tone, var(--tile-icon-status, var(--tile-status)));
	}

	.dashboard-tile strong {
		display: grid;
		place-items: center;
		min-height: 2.8rem;
		font-size: 1.1rem;
		line-height: 1.18;
	}

	.dashboard-tile--blue { --tile-status: var(--rag-reference); }
	.dashboard-tile--green { --tile-status: var(--rag-green-accent); }
	.dashboard-tile--amber { --tile-status: var(--rag-amber-accent); }
	.dashboard-tile--red { --tile-status: var(--rag-red-accent); }
	.dashboard-tile--icon-green { --tile-icon-status: var(--rag-green-accent); }
	.dashboard-tile--icon-amber { --tile-icon-status: var(--rag-amber-accent); }
	.dashboard-tile--icon-red { --tile-icon-status: var(--rag-red-accent); }
	.dashboard-tile--icon-neutral,
	.dashboard-tile--icon-default { --tile-icon-status: var(--tile-status); }

	.project-information {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 1rem;
		margin: 0;
	}

	.project-information dd {
		margin: 0.2rem 0 0;
	}

	@media (max-width: 850px) {
		.project-status-summary,
		.project-information {
			grid-template-columns: 1fr;
		}
	}
</style>
