---
import AuthenticatedLayout from '../../../../layouts/AuthenticatedLayout.astro';
import DisabledActionHint from '../../../../components/app/DisabledActionHint.astro';
import EmptyState from '../../../../components/app/EmptyState.astro';
import ProjectContentPanel from '../../../../components/app/ProjectContentPanel.astro';
import { buildWorkspaceTeamExportPath, getWorkspaceBySlug } from '../../../../lib/projects';
import { isWorkspaceRole } from '../../../../lib/permissions';
import { createSupabaseServerClient, getServerAccessToken } from '../../../../lib/supabaseServer';
import {
	buildWorkspaceTeamDisplayMembers,
	membershipStateCounts,
	workspaceTeamPersonName,
	type TeamFilter,
	type WorkspaceTeamMember,
} from '../../../../lib/workspaceTeam';

const workspaceSlug = Astro.params.workspaceSlug;
const accessToken = getServerAccessToken(Astro.cookies);
const requestedFilter = String(Astro.url.searchParams.get('state') ?? 'all').trim().toLowerCase();
const search = String(Astro.url.searchParams.get('search') ?? '').trim();
const selectedFilter: TeamFilter = ['all', 'active', 'invitations', 'deactivated'].includes(requestedFilter)
	? requestedFilter as TeamFilter
	: 'all';

let workspaceName = '';
let workspaceRole = '';
let currentUserId = '';
let loadMessage = '';
let loadError = '';
let members: WorkspaceTeamMember[] = [];
let activeCheckout: {
	id: string;
	requested_by: string | null;
	exported_at: string;
	checkout_expires_at: string;
	membership_snapshot_version: number;
} | null = null;

const formatDate = (value: string | null) => value
	? new Intl.DateTimeFormat('en-GB', { dateStyle: 'medium', timeZone: 'UTC' }).format(new Date(value))
	: 'Not available';
const formatDateTime = (value: string | null) => value
	? new Intl.DateTimeFormat('en-GB', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'UTC' }).format(new Date(value))
	: 'Not available';

try {
	const serverSupabase = createSupabaseServerClient(accessToken);
	const workspace = await getWorkspaceBySlug(serverSupabase, workspaceSlug ?? '', accessToken);
	const organisation = Array.isArray(workspace?.organisations) ? workspace?.organisations[0] : workspace?.organisations;
	const { data: userData, error: userError } = accessToken
		? await serverSupabase.auth.getUser(accessToken)
		: await serverSupabase.auth.getUser();
	if (userError) throw userError;
	currentUserId = userData.user?.id ?? '';

	if (!workspace || !organisation) {
		loadMessage = 'Workspace not found or you do not have access.';
		Astro.response.status = 404;
	} else if (!isWorkspaceRole(workspace.role)) {
		loadMessage = 'Your workspace access could not be confirmed.';
		Astro.response.status = 403;
	} else {
		workspaceName = organisation.name;
		workspaceRole = workspace.role;
		const canUseAdminDirectory = workspaceRole === 'owner' || workspaceRole === 'admin';
		const directoryTable = canUseAdminDirectory ? 'workspace_member_admin_directory' : 'workspace_member_directory';
		const selectColumns = canUseAdminDirectory
			? 'organisation_id, organisation_membership_id, profile_id, display_name, first_name, last_name, login_name, role, membership_status, invited_at, invitation_expires_at, accepted_at, deactivated_at, reactivated_at'
			: 'organisation_id, organisation_membership_id, profile_id, display_name, first_name, last_name, login_name, role, membership_status, is_deactivated, deactivated_at, reactivated_at';
		const { data, error } = await serverSupabase
			.from(directoryTable)
			.select(selectColumns)
			.eq('organisation_id', organisation.id);
		if (error) throw error;
		members = data ?? [];

		if (canUseAdminDirectory) {
			const { data: checkoutData, error: checkoutError } = await serverSupabase
				.from('workspace_membership_export_runs')
				.select('id, requested_by, exported_at, checkout_expires_at, membership_snapshot_version')
				.eq('organisation_id', organisation.id)
				.eq('export_mode', 'editable')
				.eq('status', 'checked_out')
				.is('superseded_at', null)
				.gt('checkout_expires_at', new Date().toISOString())
				.order('exported_at', { ascending: false })
				.limit(1)
				.maybeSingle();
			if (checkoutError) throw checkoutError;
			activeCheckout = checkoutData ?? null;
		}
	}
} catch {
	loadError = 'Workspace Team could not be loaded. Refresh the page, or check that your workspace access is still active.';
}

const displayedMembers = buildWorkspaceTeamDisplayMembers(members, {
	currentUserId,
	filter: selectedFilter,
	search,
});
const counts = membershipStateCounts(members);
const filterHref = (filter: TeamFilter) => {
	const params = new URLSearchParams();
	if (filter !== 'all') params.set('state', filter);
	if (search) params.set('search', search);
	const query = params.toString();
	return query ? `${Astro.url.pathname}?${query}` : Astro.url.pathname;
};
const searchAction = Astro.url.pathname;
const canAdministerLater = workspaceRole === 'owner' || workspaceRole === 'admin';
const exportAction = workspaceSlug ? buildWorkspaceTeamExportPath(workspaceSlug) : '';
const checkoutEditorMember = activeCheckout?.requested_by
	? members.find((member) => member.profile_id === activeCheckout?.requested_by)
	: null;
const checkoutEditorName = activeCheckout?.requested_by === currentUserId
	? 'You'
	: checkoutEditorMember
		? workspaceTeamPersonName(checkoutEditorMember)
		: 'Another Workspace administrator';
const checkoutHeldByCurrentUser = Boolean(activeCheckout?.requested_by && activeCheckout.requested_by === currentUserId);
const editableExportDialogId = activeCheckout && !checkoutHeldByCurrentUser
	? 'workspace-team-export-conflict-dialog'
	: 'workspace-team-editable-export-dialog';
const disabledCsvExplanation = canAdministerLater
	? activeCheckout
		? checkoutHeldByCurrentUser
			? `You already have an editable export checked out until ${formatDateTime(activeCheckout.checkout_expires_at)}.`
			: `${checkoutEditorName} has an active editable export until ${formatDateTime(activeCheckout.checkout_expires_at)}.`
		: 'Creates a versioned CSV and starts a 24-hour advisory editing window.'
	: 'Owner or Admin access is required for future team CSV administration.';
const disabledHistoryExplanation = canAdministerLater
	? 'Membership history will be available after the audit review journey is added.'
	: 'Owner or Admin access is required for future membership history.';
---
<AuthenticatedLayout title="Workspace Team | WatchTower">
	<section class="workspace-team-page" data-workspace-team-page>
		<header class="workspace-team-hero" aria-labelledby="workspace-team-heading">
			<div>
				<p class="eyebrow">Workspace</p>
				<h1 id="workspace-team-heading">Workspace Team</h1>
				<p>View the people associated with this workspace, their access role and current membership status.</p>
			</div>
			{workspaceName && (
				<div class="workspace-team-hero__meta" aria-label={`Workspace ${workspaceName}`}>
					<span>{workspaceName}</span>
					<small>{counts.all} visible {counts.all === 1 ? 'membership' : 'memberships'}</small>
				</div>
			)}
		</header>

		{loadError ? (
			<EmptyState title="Workspace Team could not be loaded." tone="error" data-workspace-team-error role="alert">
				<p>{loadError}</p>
			</EmptyState>
		) : loadMessage ? (
			<EmptyState title="Workspace unavailable." tone="error" data-workspace-team-unavailable role="alert">
				<p>{loadMessage}</p>
			</EmptyState>
		) : (
			<>
				<ProjectContentPanel
					title="Team administration"
					helper="Export a controlled Workspace Team CSV for offline preparation. The database remains authoritative."
					headingId="workspace-team-admin-heading"
				>
					{canAdministerLater && activeCheckout && (
						<div class="workspace-team-checkout" data-active-editable-checkout>
							<strong>{checkoutHeldByCurrentUser ? 'You have the current editable team file.' : `${checkoutEditorName} downloaded the current team file for update.`}</strong>
							<p>
								Exported {formatDateTime(activeCheckout.exported_at)}. Editing window expires {formatDateTime(activeCheckout.checkout_expires_at)}.
								Snapshot version {activeCheckout.membership_snapshot_version}.
							</p>
						</div>
					)}
					<div class="workspace-team-admin-actions" data-workspace-team-admin-controls>
						<div>
							{canAdministerLater && exportAction && !checkoutHeldByCurrentUser ? (
								<button
									class="button button--primary"
									type="button"
									aria-haspopup="dialog"
									aria-describedby="workspace-team-csv-disabled"
									data-team-csv-download
									data-workspace-team-export-open={editableExportDialogId}
								>
									Download team CSV for update
								</button>
							) : (
								<button class="button button--primary" type="button" disabled aria-describedby="workspace-team-csv-disabled" data-team-csv-download>
									Download team CSV for update
								</button>
							)}
							<DisabledActionHint
								id="workspace-team-csv-disabled"
								allowed={canAdministerLater}
								allowedText=""
								disabledText={disabledCsvExplanation}
							/>
						</div>
						<div>
							{canAdministerLater && exportAction ? (
								<form method="post" action={exportAction} data-read-only-export-form>
									<input type="hidden" name="export_mode" value="read_only" />
									<button class="button button--secondary" type="submit" data-read-only-team-csv-download>
										Download read-only copy
									</button>
								</form>
							) : (
								<button class="button button--secondary" type="button" disabled aria-describedby="workspace-team-read-only-disabled" data-read-only-team-csv-download>
									Download read-only copy
								</button>
							)}
							<DisabledActionHint
								id="workspace-team-read-only-disabled"
								allowed={canAdministerLater}
								allowedText="Read-only copies are versioned and do not replace an active editing window."
								disabledText="Owner or Admin access is required for read-only team CSV export."
							/>
						</div>
						<div>
							<button class="button button--secondary" type="button" disabled aria-describedby="workspace-team-history-disabled" data-membership-history>
								Membership history
							</button>
							<DisabledActionHint
								id="workspace-team-history-disabled"
								allowed={false}
								allowedText=""
								disabledText={disabledHistoryExplanation}
							/>
						</div>
					</div>

					{canAdministerLater && exportAction && (
						<dialog class="workspace-team-export-dialog" id="workspace-team-editable-export-dialog" aria-labelledby="workspace-team-editable-export-title" data-workspace-team-export-dialog>
							<form method="post" action={exportAction}>
								<input type="hidden" name="export_mode" value="editable" />
								<div class="workspace-team-export-dialog__body">
									<h3 id="workspace-team-editable-export-title" tabindex="-1" data-workspace-team-dialog-focus>Download editable team CSV</h3>
									<p>This creates a versioned export and starts a 24-hour advisory editing window. The CSV is an offline working copy; the database remains the source of truth.</p>
									<p>Future upload validation will compare this export ID and snapshot version against the live Workspace Team data.</p>
								</div>
								<div class="workspace-team-export-dialog__actions">
									<button class="button button--secondary" type="button" data-workspace-team-dialog-cancel>Cancel</button>
									<button class="button button--primary" type="submit">Download editable CSV</button>
								</div>
							</form>
						</dialog>
					)}

					{canAdministerLater && exportAction && activeCheckout && !checkoutHeldByCurrentUser && (
						<dialog class="workspace-team-export-dialog" id="workspace-team-export-conflict-dialog" aria-labelledby="workspace-team-export-conflict-title" data-workspace-team-export-dialog>
							<div class="workspace-team-export-dialog__body">
								<h3 id="workspace-team-export-conflict-title" tabindex="-1" data-workspace-team-dialog-focus>Editing window already active</h3>
								<p>{checkoutEditorName} downloaded this Workspace Team file for update at {formatDateTime(activeCheckout.exported_at)}. Their editing window expires at {formatDateTime(activeCheckout.checkout_expires_at)}.</p>
								<p>Download a read-only copy if you only need the latest data. Take over only when you need a new editable working copy; the earlier editable export will be superseded and ineligible for later upload.</p>
							</div>
							<div class="workspace-team-export-dialog__actions">
								<button class="button button--secondary" type="button" data-workspace-team-dialog-cancel>Cancel</button>
								<form method="post" action={exportAction}>
									<input type="hidden" name="export_mode" value="read_only" />
									<button class="button button--secondary" type="submit">Download read-only copy</button>
								</form>
								<form method="post" action={exportAction}>
									<input type="hidden" name="export_mode" value="editable" />
									<input type="hidden" name="takeover_export_id" value={activeCheckout.id} />
									<input type="hidden" name="confirm_takeover" value="true" />
									<button class="button button--primary" type="submit" data-team-csv-takeover>Take over editing</button>
								</form>
							</div>
						</dialog>
					)}
				</ProjectContentPanel>

				<ProjectContentPanel
					title="Membership list"
					helper="Members are sorted by last name, first name, login name and membership record."
					headingId="workspace-team-list-heading"
				>
					<div class="workspace-team-controls" aria-label="Workspace Team filters">
						<nav class="workspace-team-filters" aria-label="Membership state filters">
							<a href={filterHref('all')} aria-current={selectedFilter === 'all' ? 'page' : undefined}>All <span>{counts.all}</span></a>
							<a href={filterHref('active')} aria-current={selectedFilter === 'active' ? 'page' : undefined}>Active <span>{counts.active}</span></a>
							<a href={filterHref('invitations')} aria-current={selectedFilter === 'invitations' ? 'page' : undefined}>Invitations <span>{counts.invitations}</span></a>
							<a href={filterHref('deactivated')} aria-current={selectedFilter === 'deactivated' ? 'page' : undefined}>Deactivated <span>{counts.deactivated}</span></a>
						</nav>
						<form class="workspace-team-search" method="get" action={searchAction} role="search">
							{selectedFilter !== 'all' && <input type="hidden" name="state" value={selectedFilter} />}
							<label>
								<span>Search team</span>
								<input type="search" name="search" value={search} autocomplete="off" placeholder="Name or login" />
							</label>
							<button class="button button--secondary" type="submit">Search</button>
						</form>
					</div>

					{members.length === 0 ? (
						<EmptyState title="No visible memberships." data-workspace-team-empty>
							<p>No workspace memberships are available to display.</p>
						</EmptyState>
					) : displayedMembers.length === 0 ? (
						<EmptyState title="No matching memberships." data-workspace-team-filter-empty>
							<p>Adjust the state filter or search text to see more workspace people.</p>
						</EmptyState>
					) : (
						<div class="workspace-team-table-wrap">
							<table class="simple-table workspace-team-table" data-workspace-team-table>
								<thead>
									<tr>
										<th scope="col">Person</th>
										<th scope="col">Login</th>
										<th scope="col">Role</th>
										<th scope="col">Status</th>
										<th scope="col">Joined / invited</th>
										<th scope="col">Actions</th>
									</tr>
								</thead>
								<tbody>
									{displayedMembers.map((member) => (
										<tr data-membership-id={member.organisation_membership_id} data-profile-id={member.profile_id} data-membership-status={member.membership_status}>
											<td data-label="Person">
												<strong class={member.membership_status === 'deactivated' ? 'workspace-team-person workspace-team-person--deactivated' : 'workspace-team-person'}>
													{member.personName}
												</strong>
												{member.isCurrentUser && <span class="workspace-team-you" aria-label="This is your membership">You</span>}
											</td>
											<td data-label="Login">{member.loginLabel}</td>
											<td data-label="Role"><span class="workspace-team-role">{member.displayRole}</span></td>
											<td data-label="Status">
												<span class={`workspace-team-status workspace-team-status--${member.statusTone}`} aria-label={`${member.displayStatus}. ${member.statusDescription}`}>
													{member.displayStatus}
												</span>
											</td>
											<td data-label={member.lifecycleDateLabel}>
												<span class="workspace-team-date-label">{member.lifecycleDateLabel}</span>
												<span>{formatDate(member.lifecycleDateValue)}</span>
											</td>
											<td data-label="Actions">
												<span class="workspace-team-row-action" aria-disabled="true">No actions in this release</span>
											</td>
										</tr>
									))}
								</tbody>
							</table>
						</div>
					)}
				</ProjectContentPanel>
			</>
		)}
	</section>
</AuthenticatedLayout>

<script>
	const lastTriggerByDialog = new WeakMap();
	document.querySelectorAll('[data-workspace-team-export-open]').forEach((trigger) => {
		trigger.addEventListener('click', () => {
			const dialogId = trigger.getAttribute('data-workspace-team-export-open');
			const dialog = dialogId ? document.getElementById(dialogId) : null;
			if (!(dialog instanceof HTMLDialogElement)) return;
			lastTriggerByDialog.set(dialog, trigger);
			if (!dialog.open) dialog.showModal();
			const focusTarget = dialog.querySelector('[data-workspace-team-dialog-focus], button, input');
			if (focusTarget instanceof HTMLElement) focusTarget.focus();
		});
	});

	document.querySelectorAll('[data-workspace-team-export-dialog]').forEach((dialog) => {
		if (!(dialog instanceof HTMLDialogElement)) return;
		dialog.addEventListener('close', () => {
			const trigger = lastTriggerByDialog.get(dialog);
			if (trigger instanceof HTMLElement) trigger.focus();
		});
		dialog.querySelectorAll('[data-workspace-team-dialog-cancel]').forEach((button) => {
			button.addEventListener('click', () => dialog.close());
		});
	});
</script>

<style>
	.workspace-team-page {
		display: grid;
		gap: 0.9rem;
	}

	.workspace-team-hero {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1rem;
		border: 1px solid var(--border);
		border-radius: 1.35rem;
		padding: clamp(1rem, 2vw, 1.5rem);
		background: linear-gradient(135deg, rgba(5, 14, 25, 0.95), rgba(4, 12, 24, 0.74));
		box-shadow: 0 18px 50px rgba(0, 0, 0, 0.24);
	}

	.workspace-team-hero h1 {
		margin-bottom: 0.35rem;
		font-size: clamp(2rem, 4vw, 3.3rem);
		letter-spacing: 0;
	}

	.workspace-team-hero p:not(.eyebrow) {
		max-width: 48rem;
		margin: 0;
		color: var(--muted-strong);
	}

	.workspace-team-hero__meta {
		display: grid;
		gap: 0.15rem;
		justify-items: end;
		min-width: 12rem;
		color: var(--muted-strong);
		font-weight: 800;
		text-align: right;
	}

	.workspace-team-hero__meta small {
		color: var(--muted);
	}

	.workspace-team-admin-actions {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.9rem;
	}

	.workspace-team-admin-actions > div {
		display: grid;
		align-content: start;
		gap: 0.4rem;
		border: 1px solid rgba(110, 181, 224, 0.18);
		border-radius: 0.5rem;
		padding: 0.9rem;
		background: rgba(18, 31, 42, 0.58);
	}

	.workspace-team-admin-actions button {
		width: fit-content;
	}

	.workspace-team-admin-actions form {
		margin: 0;
	}

	.workspace-team-admin-actions button:disabled {
		opacity: 0.62;
		cursor: not-allowed;
	}

	.workspace-team-checkout {
		display: grid;
		gap: 0.25rem;
		margin-bottom: 1rem;
		border: 1px solid rgba(245, 171, 53, 0.28);
		border-radius: 0.5rem;
		padding: 0.85rem 0.95rem;
		background: rgba(245, 171, 53, 0.1);
	}

	.workspace-team-checkout p {
		margin: 0;
		color: var(--muted-strong);
	}

	.workspace-team-export-dialog {
		width: min(100% - 2rem, 42rem);
		border: 1px solid rgba(110, 181, 224, 0.34);
		border-radius: 0.75rem;
		padding: 0;
		background: #07111d;
		color: var(--text);
		box-shadow: 0 22px 70px rgba(0, 0, 0, 0.42);
	}

	.workspace-team-export-dialog::backdrop {
		background: rgba(2, 8, 23, 0.72);
	}

	.workspace-team-export-dialog form,
	.workspace-team-export-dialog__body {
		margin: 0;
	}

	.workspace-team-export-dialog__body {
		padding: 1.1rem 1.15rem 0.25rem;
	}

	.workspace-team-export-dialog__body h3 {
		margin-bottom: 0.45rem;
		font-size: 1.35rem;
		letter-spacing: 0;
	}

	.workspace-team-export-dialog__body p {
		margin-bottom: 0.65rem;
		color: var(--muted-strong);
	}

	.workspace-team-export-dialog__actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: flex-end;
		gap: 0.6rem;
		padding: 0.9rem 1.15rem 1.15rem;
	}

	.workspace-team-export-dialog__actions form {
		margin: 0;
	}

	.workspace-team-controls {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1rem;
	}

	.workspace-team-filters {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	.workspace-team-filters a {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		border: 1px solid rgba(110, 181, 224, 0.22);
		border-radius: 999px;
		padding: 0.45rem 0.7rem;
		color: var(--muted-strong);
		font-weight: 800;
		text-decoration: none;
	}

	.workspace-team-filters a[aria-current="page"],
	.workspace-team-filters a:hover,
	.workspace-team-filters a:focus-visible {
		border-color: rgba(0, 160, 255, 0.56);
		background: rgba(0, 160, 255, 0.14);
		outline: none;
	}

	.workspace-team-filters span {
		color: var(--muted);
		font-size: 0.86rem;
	}

	.workspace-team-search {
		display: flex;
		align-items: end;
		gap: 0.5rem;
	}

	.workspace-team-search label {
		display: grid;
		gap: 0.25rem;
		color: var(--muted-strong);
		font-size: 0.88rem;
		font-weight: 800;
	}

	.workspace-team-search input {
		min-width: 14rem;
		border: 1px solid rgba(110, 181, 224, 0.3);
		border-radius: 0.5rem;
		padding: 0.58rem 0.7rem;
		background: rgba(3, 12, 24, 0.7);
		color: var(--text);
		font: inherit;
	}

	.workspace-team-table-wrap {
		overflow: hidden;
	}

	.workspace-team-table th:nth-child(1) {
		width: 26%;
	}

	.workspace-team-table th:nth-child(3),
	.workspace-team-table th:nth-child(4) {
		width: 8.5rem;
	}

	.workspace-team-person {
		display: inline;
		color: var(--text);
	}

	.workspace-team-person--deactivated {
		color: var(--muted-strong);
		font-style: italic;
	}

	.workspace-team-you,
	.workspace-team-role,
	.workspace-team-status,
	.workspace-team-row-action {
		display: inline-flex;
		align-items: center;
		width: fit-content;
		border-radius: 999px;
		padding: 0.22rem 0.5rem;
		font-size: 0.82rem;
		font-weight: 850;
		letter-spacing: 0;
