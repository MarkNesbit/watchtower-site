												</span>
											</td>
											<td data-label={member.lifecycleDateLabel}>
												<span class="workspace-team-date-label">{member.lifecycleDateLabel}</span>
												<span>{formatDate(member.lifecycleDateValue)}</span>
											</td>
											<td data-label="Actions">
												<span class="workspace-team-row-action" aria-disabled="true">No actions in this release</span>
											</td>
										</tr>
									))}
								</tbody>
							</table>
						</div>
					)}
				</ProjectContentPanel>
			</>
		)}
