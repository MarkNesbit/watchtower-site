---
import AuthenticatedLayout from '../../../../layouts/AuthenticatedLayout.astro';
import DisabledActionHint from '../../../../components/app/DisabledActionHint.astro';
import EmptyState from '../../../../components/app/EmptyState.astro';
import ProjectContentPanel from '../../../../components/app/ProjectContentPanel.astro';
import {
	buildWorkspaceTeamCheckoutReleasePath,
	buildWorkspaceTeamExportPath,
	buildWorkspaceTeamImportApplyPath,
	buildWorkspaceTeamImportReviewDraftPath,
	buildWorkspaceTeamImportPath,
	buildWorkspaceTeamImportReviewConfirmPath,
	buildWorkspaceTeamImportReviewPath,
	buildWorkspaceTeamInvitationSendPath,
	buildWorkspaceTeamMemberRolePath,
	buildWorkspaceTeamMemberSessionPath,
	getWorkspaceBySlug,
} from '../../../../lib/projects';
import { can, isWorkspaceRole } from '../../../../lib/permissions';
import { createSupabaseServerClient, getServerAccessToken } from '../../../../lib/supabaseServer';
import { WORKSPACE_TEAM_IMPORT_MAX_FILE_BYTES } from '../../../../lib/workspaceTeamCsvImport';
import { normaliseWorkspaceTeamSnapshotVersion } from '../../../../lib/workspaceTeamCsv';
import {
	applyWorkspaceTeamActiveEditableCheckoutFilters,
	buildWorkspaceTeamDisplayMembers,
	isWorkspaceTeamActiveEditableCheckout,
	membershipStateCounts,
	workspaceTeamRoleAuthority,
	workspaceRoleLabel,
	workspaceTeamPersonName,
	type TeamFilter,
	type WorkspaceTeamActiveEditableCheckout,
	type WorkspaceTeamMember,
} from '../../../../lib/workspaceTeam';
import {
	currentInvitationActionForSubmission,
	invitationLifecycleCounts,
	invitationNeedsCancellation,
	workspaceInvitationActionLabel,
	workspaceInvitationStatusLabel,
	workspaceInvitationTone,
} from '../../../../lib/workspaceInvitations';

Astro.response.headers.set('Cache-Control', 'private, no-store, no-cache, must-revalidate');
Astro.response.headers.set('Pragma', 'no-cache');
Astro.response.headers.set('Expires', '0');

const workspaceSlug = Astro.params.workspaceSlug;
const accessToken = getServerAccessToken(Astro.cookies);
const runtimeEnv = (Astro.locals as { runtime?: { env?: Record<string, unknown> } } | undefined)?.runtime?.env;
const requestedFilter = String(Astro.url.searchParams.get('state') ?? 'all').trim().toLowerCase();
const search = String(Astro.url.searchParams.get('search') ?? '').trim();
const requestedImportRunId = String(Astro.url.searchParams.get('import_run') ?? '').trim();
const selectedFilter: TeamFilter = ['all', 'active', 'invitations', 'deactivated'].includes(requestedFilter)
	? requestedFilter as TeamFilter
	: 'all';

let workspaceName = '';
let workspaceRole = '';
let currentUserId = '';
let loadMessage = '';
let loadError = '';
let members: WorkspaceTeamMember[] = [];
let importRun: {
	id: string;
	status: string;
	uploaded_at: string;
	original_filename: string | null;
	file_hash: string | null;
	source_snapshot_version: number | string | null;
	live_snapshot_version: number | string | null;
	approved_live_snapshot_version: string | null;
	approved_change_set_version: number;
	approved_change_set_snapshot_version: number | string | null;
	approved_change_set_summary: Record<string, number> | null;
	approved_at: string | null;
	approved_by: string | null;
	applied_at: string | null;
	checkout_expired: boolean;
	source_stale: boolean;
	source_superseded: boolean;
	validation_summary: Record<string, number> | null;
	failure_message: string | null;
} | null = null;
let importRows: Array<{
	id: string;
	source_row_number: number;
	supplied_membership_id: string | null;
	supplied_user_id: string | null;
	proposed_change_type: string;
	validation_state: string;
	validation_messages: Array<{ field?: string; message?: string }> | null;
	proposed_values: Record<string, unknown> | null;
	field_differences: Array<{ field?: string; from?: unknown; to?: unknown }> | null;
	is_unchanged: boolean;
}> = [];
type JsonRecord = Record<string, unknown>;
type ReviewModalItem = {
	row_id: string;
	decision_id: string | null;
	source_row_number: number;
	proposed_change_type: string;
	validation_state: string;
	validation_messages: Array<{ field?: string; message?: string }>;
	source_export_values: JsonRecord;
	current_live_values: JsonRecord;
	proposed_values: JsonRecord;
	field_differences: Array<{ field?: string; from?: unknown; to?: unknown }>;
	live_recalculation_status: string;
	live_recalculation_messages: Array<{ message?: string }>;
	impact_counts: JsonRecord;
	decision: string;
	review_selected: boolean | null;
	review_draft_reason: string | null;
	review_draft_updated_at: string | null;
};
let reviewModalItems: ReviewModalItem[] = [];
let activeCheckout: WorkspaceTeamActiveEditableCheckout | null = null;
let latestApplicationRun: {
	id: string;
	status: string;
	requested_at: string;
	completed_at: string | null;
	expected_counts: Record<string, number> | null;
	applied_counts: Record<string, number> | null;
	failure_code: string | null;
	failure_message: string | null;
	invitation_handoff_count: number;
} | null = null;
let applicationLiveSnapshotVersion: string | null = null;
let checkoutLoadError = '';
let importLoadError = '';
let reviewLoadError = '';
let applicationLoadError = '';
let membershipSnapshotVersion: string | null = null;

const asRecord = (value: unknown): JsonRecord => value && typeof value === 'object' && !Array.isArray(value) ? value as JsonRecord : {};
const asArray = <T,>(value: unknown): T[] => Array.isArray(value) ? value as T[] : [];
const textValue = (value: unknown, fallback = 'Not set') => {
	const text = value === null || value === undefined ? '' : String(value).trim();
	return text || fallback;
};
const labelFromToken = (value: unknown, fallback = 'Not set') => {
	const text = textValue(value, fallback);
	if (text === fallback) return text;
	return text.split('_').filter(Boolean).map((part) => part.charAt(0).toUpperCase() + part.slice(1)).join(' ');
};
const fieldLabel = (value: unknown) => ({
	first_name: 'First name',
	last_name: 'Last name',
	email: 'Contact email',
	workspace_role: 'Workspace role',
	membership_status: 'Membership status',
}[String(value)] ?? labelFromToken(value));
const formatDate = (value: string | null) => value
	? new Intl.DateTimeFormat('en-GB', { dateStyle: 'medium', timeZone: 'UTC' }).format(new Date(value))
	: 'Not available';
const formatDateTime = (value: string | null) => value
	? new Intl.DateTimeFormat('en-GB', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'UTC' }).format(new Date(value))
	: 'Not available';
const logWorkspaceTeamLoadFailure = (
	queryName: string,
	error: unknown,
	context: { workspaceId?: string | null; importRunId?: string | null } = {},
) => {
	const supabaseError = error as { code?: string; message?: string; details?: string; hint?: string };
	console.error('workspace_team_page_section_load_failed', {
		routeName: 'workspace_team_page',
		workspaceId: context.workspaceId ?? null,
		importRunId: context.importRunId ?? null,
		queryName,
		code: supabaseError?.code,
		message: supabaseError?.message ?? (error instanceof Error ? error.message : 'Unknown Team page load failure'),
		details: supabaseError?.details,
		hint: supabaseError?.hint,
	});
};

try {
	const serverSupabase = createSupabaseServerClient(accessToken, runtimeEnv);
	const workspace = await getWorkspaceBySlug(serverSupabase, workspaceSlug ?? '', accessToken);
	const organisation = Array.isArray(workspace?.organisations) ? workspace?.organisations[0] : workspace?.organisations;
	const { data: userData, error: userError } = accessToken
		? await serverSupabase.auth.getUser(accessToken)
		: await serverSupabase.auth.getUser();
	if (userError) throw userError;
	currentUserId = userData.user?.id ?? '';

	if (!workspace || !organisation) {
		loadMessage = 'Workspace not found or you do not have access.';
		Astro.response.status = 404;
	} else if (!isWorkspaceRole(workspace.role)) {
		loadMessage = 'Your workspace access could not be confirmed.';
		Astro.response.status = 403;
	} else if (!can(workspace.role, 'workspaceTeam.view')) {
		loadMessage = 'Only active Workspace Owners and Admins can access Workspace Team.';
		Astro.response.status = 403;
	} else {
		workspaceName = organisation.name;
		workspaceRole = workspace.role;
		const canUseAdminDirectory = can(workspaceRole, 'workspaceTeam.view');
		const directoryTable = canUseAdminDirectory ? 'workspace_member_admin_directory' : 'workspace_member_directory';
		const selectColumns = canUseAdminDirectory
			? 'organisation_id, organisation_membership_id, profile_id, display_name, first_name, last_name, login_name, contact_email, role, membership_status, invited_at, invitation_expires_at, joined_at, accepted_at, deactivated_at, reactivated_at, invitation_id, invitation_status, invitation_delivered_at, invitation_opened_at, invitation_accepted_at, invitation_cancelled_at, invitation_superseded_at, invitation_delivery_attempt_count, invitation_last_delivery_attempt_at, invitation_failure_code, invitation_failure_message, invitation_delivery_strategy, auth_user_id, last_login_at, updated_at'
			: 'organisation_id, organisation_membership_id, profile_id, display_name, first_name, last_name, login_name, role, membership_status, is_deactivated, joined_at, deactivated_at, reactivated_at, auth_user_id';
		const { data, error } = await serverSupabase
			.from(directoryTable)
			.select(selectColumns)
			.eq('organisation_id', organisation.id);
		if (error) throw error;
		members = data ?? [];

		if (canUseAdminDirectory) {
			try {
				const { data: snapshotTextData, error: snapshotTextError } = await serverSupabase.rpc('current_workspace_membership_snapshot_version_text', {
					target_organisation_id: organisation.id,
				});
				if (snapshotTextError) throw snapshotTextError;
				membershipSnapshotVersion = normaliseWorkspaceTeamSnapshotVersion(snapshotTextData);
			} catch (error) {
				logWorkspaceTeamLoadFailure('current_workspace_membership_snapshot_version_text_member_modal', error, { workspaceId: organisation.id });
				membershipSnapshotVersion = null;
			}

			try {
				const { data: checkoutData, error: checkoutError } = await applyWorkspaceTeamActiveEditableCheckoutFilters(
					serverSupabase.from('workspace_membership_export_runs'),
					organisation.id,
				).maybeSingle();
				if (checkoutError) throw checkoutError;
				activeCheckout = isWorkspaceTeamActiveEditableCheckout(checkoutData, organisation.id) ? checkoutData : null;
			} catch (error) {
				logWorkspaceTeamLoadFailure('active_editable_checkout', error, { workspaceId: organisation.id });
				checkoutLoadError = 'The team directory loaded, but the editable checkout status could not be retrieved. Refresh this section before downloading an editable CSV.';
			}

			if (requestedImportRunId) {
				try {
					const { data: importData, error: importError } = await serverSupabase
						.from('workspace_membership_import_runs')
						.select('id, status, uploaded_at, original_filename, file_hash, source_snapshot_version, live_snapshot_version, approved_live_snapshot_version, approved_change_set_version, approved_change_set_snapshot_version, approved_change_set_summary, approved_at, approved_by, applied_at, checkout_expired, source_stale, source_superseded, validation_summary, failure_message')
						.eq('organisation_id', organisation.id)
						.eq('id', requestedImportRunId)
						.maybeSingle();
					if (importError) throw importError;
					importRun = importData ?? null;
				} catch (error) {
					logWorkspaceTeamLoadFailure('workspace_membership_import_runs_latest', error, { workspaceId: organisation.id, importRunId: requestedImportRunId });
					importLoadError = 'The team directory loaded, but the latest import status could not be retrieved. Refresh the Team page to try again.';
				}

				if (importRun) {
					try {
						const { data: rowData, error: rowError } = await serverSupabase
							.from('workspace_membership_import_rows')
							.select('id, source_row_number, supplied_membership_id, supplied_user_id, proposed_change_type, validation_state, validation_messages, proposed_values, field_differences, is_unchanged')
							.eq('organisation_id', organisation.id)
							.eq('import_run_id', importRun.id)
							.or('is_unchanged.eq.false,validation_state.eq.error,validation_state.eq.warning')
							.order('source_row_number', { ascending: true });
						if (rowError) throw rowError;
						importRows = rowData ?? [];
					} catch (error) {
						logWorkspaceTeamLoadFailure('workspace_membership_import_rows_summary', error, { workspaceId: organisation.id, importRunId: importRun.id });
						importLoadError = 'The team directory loaded, but the import row summary could not be retrieved. Refresh the Team page to try again.';
					}

					if (['validated', 'stale_review_required', 'approval_pending', 'approved_for_application', 'application_failed_pending_review'].includes(importRun.status) && !importRun.source_superseded) {
						try {
							const { data: proposalData, error: proposalError } = await serverSupabase.rpc('recalculate_workspace_membership_change_proposals', {
								target_import_run_id: importRun.id,
							});
							if (proposalError) throw proposalError;
							reviewModalItems = asArray<ReviewModalItem>(proposalData).map((item) => ({
								...item,
								validation_messages: asArray<{ field?: string; message?: string }>(item.validation_messages),
								source_export_values: asRecord(item.source_export_values),
								current_live_values: asRecord(item.current_live_values),
								proposed_values: asRecord(item.proposed_values),
								field_differences: asArray<{ field?: string; from?: unknown; to?: unknown }>(item.field_differences),
								live_recalculation_messages: asArray<{ message?: string }>(item.live_recalculation_messages),
								impact_counts: asRecord(item.impact_counts),
								review_selected: typeof item.review_selected === 'boolean' ? item.review_selected : null,
								review_draft_reason: typeof item.review_draft_reason === 'string' ? item.review_draft_reason : null,
								review_draft_updated_at: typeof item.review_draft_updated_at === 'string' ? item.review_draft_updated_at : null,
							}));
						} catch (error) {
							logWorkspaceTeamLoadFailure('recalculate_workspace_membership_change_proposals', error, { workspaceId: organisation.id, importRunId: importRun.id });
							reviewLoadError = 'The team directory loaded, but review proposals could not be refreshed. Refresh the Team page before continuing the review.';
						}
					}

					if (['approved_for_application', 'application_failed_pending_review', 'applied'].includes(importRun.status)) {
						try {
							const { data: snapshotTextData, error: snapshotTextError } = await serverSupabase.rpc('current_workspace_membership_snapshot_version_text', {
								target_organisation_id: organisation.id,
							});
							if (snapshotTextError) throw snapshotTextError;
							applicationLiveSnapshotVersion = normaliseWorkspaceTeamSnapshotVersion(snapshotTextData);
						} catch (error) {
							logWorkspaceTeamLoadFailure('current_workspace_membership_snapshot_version_text', error, { workspaceId: organisation.id, importRunId: importRun.id });
							applicationLoadError = 'The team directory loaded, but application eligibility could not be refreshed. Refresh the Team page before applying approved changes.';
						}

						try {
							const { data: applicationRunData, error: applicationRunError } = await serverSupabase
								.from('workspace_membership_change_application_runs')
								.select('id, status, requested_at, completed_at, expected_counts, applied_counts, failure_code, failure_message, invitation_handoff_count')
								.eq('organisation_id', organisation.id)
								.eq('import_run_id', importRun.id)
								.order('created_at', { ascending: false })
								.limit(1)
								.maybeSingle();
							if (applicationRunError) throw applicationRunError;
							latestApplicationRun = applicationRunData ?? null;
						} catch (error) {
							logWorkspaceTeamLoadFailure('workspace_membership_change_application_runs_latest', error, { workspaceId: organisation.id, importRunId: importRun.id });
							applicationLoadError = 'The team directory loaded, but the latest application run could not be retrieved. Refresh the Team page before applying approved changes.';
						}
					}
				}
			}
		}
	}
} catch (error) {
	logWorkspaceTeamLoadFailure('workspace_membership_directory_critical', error);
	loadError = 'Workspace Team could not be loaded. Refresh the page, or check that your workspace access is still active.';
}

const displayedMembers = buildWorkspaceTeamDisplayMembers(members, {
	currentUserId,
	filter: selectedFilter,
	search,
});
const counts = membershipStateCounts(members);
const invitationCounts = invitationLifecycleCounts(members);
const filterHref = (filter: TeamFilter) => {
	const params = new URLSearchParams();
	if (filter !== 'all') params.set('state', filter);
	if (search) params.set('search', search);
	const query = params.toString();
	return query ? `${Astro.url.pathname}?${query}` : Astro.url.pathname;
};
const searchAction = Astro.url.pathname;
const canAdministerLater = can(workspaceRole, 'workspaceTeam.manageRoles');
const exportAction = workspaceSlug ? buildWorkspaceTeamExportPath(workspaceSlug) : '';
const checkoutReleaseAction = workspaceSlug ? buildWorkspaceTeamCheckoutReleasePath(workspaceSlug) : '';
const importAction = workspaceSlug ? buildWorkspaceTeamImportPath(workspaceSlug) : '';
const importReviewPath = workspaceSlug && importRun ? buildWorkspaceTeamImportReviewPath(workspaceSlug, importRun.id) : '';
const importReviewConfirmPath = workspaceSlug && importRun ? buildWorkspaceTeamImportReviewConfirmPath(workspaceSlug, importRun.id) : '';
const importReviewDraftPath = workspaceSlug && importRun ? buildWorkspaceTeamImportReviewDraftPath(workspaceSlug, importRun.id) : '';
const importApplyPath = workspaceSlug && importRun ? buildWorkspaceTeamImportApplyPath(workspaceSlug, importRun.id) : '';
const invitationSendAction = workspaceSlug ? buildWorkspaceTeamInvitationSendPath(workspaceSlug) : '';
const memberSessionAction = workspaceSlug ? buildWorkspaceTeamMemberSessionPath(workspaceSlug) : '';
const memberRoleAction = workspaceSlug ? buildWorkspaceTeamMemberRolePath(workspaceSlug) : '';
const importMaxSizeLabel = `${Math.round(WORKSPACE_TEAM_IMPORT_MAX_FILE_BYTES / 1024 / 1024)} MB`;
const checkoutEditorMember = activeCheckout?.requested_by
	? members.find((member) => member.profile_id === activeCheckout?.requested_by)
	: null;
const checkoutEditorName = activeCheckout?.requested_by === currentUserId
	? 'You'
	: checkoutEditorMember
		? workspaceTeamPersonName(checkoutEditorMember)
		: 'Another Workspace administrator';
const checkoutHeldByCurrentUser = Boolean(activeCheckout?.requested_by && activeCheckout.requested_by === currentUserId);
const activeCheckoutSnapshotVersion = activeCheckout
	? normaliseWorkspaceTeamSnapshotVersion(activeCheckout.membership_snapshot_version)
	: null;
const editableExportDialogId = activeCheckout && !checkoutHeldByCurrentUser
	? 'workspace-team-export-conflict-dialog'
	: 'workspace-team-editable-export-dialog';
const disabledCsvExplanation = canAdministerLater
	? activeCheckout
		? checkoutHeldByCurrentUser
			? `You already have an editable export checked out until ${formatDateTime(activeCheckout.checkout_expires_at)}.`
			: `${checkoutEditorName} has an active editable export until ${formatDateTime(activeCheckout.checkout_expires_at)}.`
		: 'Creates a versioned CSV and starts a 24-hour advisory editing window.'
	: 'Owner or Admin access is required for future team CSV administration.';
const disabledHistoryExplanation = canAdministerLater
	? 'Membership history will be available after the audit review journey is added.'
	: 'Owner or Admin access is required for future membership history.';
const disabledUploadExplanation = canAdministerLater
	? 'Upload an amended editable Workspace Team CSV for validation only. No changes are applied.'
	: 'Owner or Admin access is required for team CSV upload validation.';
const checkoutReleaseState = String(Astro.url.searchParams.get('checkout_release') ?? '');
const checkoutReleaseError = String(Astro.url.searchParams.get('checkout_release_error') ?? '');
const checkoutReleaseMessage = checkoutReleaseState === 'success'
	? 'Editable team-file checkout undone.'
	: checkoutReleaseState === 'error'
		? ({
			holder_only: 'Only the current checkout holder can undo this editable file checkout.',
			not_holder: 'Only the current checkout holder can undo this editable file checkout.',
			already_released: 'That editable checkout has already been undone. Refresh the page and download a new editable copy if needed.',
			expired: 'That editable checkout has expired. Refresh the page and download a new editable copy if needed.',
			superseded: 'That editable checkout has been superseded. Refresh the page and check the current notice.',
			no_active_checkout: 'That editable checkout is no longer active. Refresh the page and check the current notice.',
			not_active: 'That editable checkout is no longer active. Refresh the page and check the current notice.',
			stale: 'The editable checkout changed before Undo completed. Refresh the page and try again if needed.',
			permission: 'Only active Workspace Owners and Admins can undo an editable team-file checkout.',
			permission_denied: 'Only active Workspace Owners and Admins can undo an editable team-file checkout.',
			audit_failed: 'The checkout could not be released because its audit event could not be recorded. Try again, or contact support if this continues.',
			rpc_failed: 'Checkout Undo is temporarily unavailable. Refresh the page and try again.',
			signin: 'Sign in before undoing an editable team-file checkout.',
			workspace: 'Workspace access could not be confirmed for checkout Undo.',
			missing_export: 'The checkout could not be identified. Refresh the page and try again.',
			failed: 'Editable team-file checkout could not be released. Refresh the page and try again.',
		} as Record<string, string>)[checkoutReleaseError] ?? 'Editable team-file checkout could not be released. Refresh the page and try again.'
		: '';
const reviewConfirmationState = String(Astro.url.searchParams.get('review_confirmation') ?? '');
const reviewConfirmationMessage = ({
	success: 'Selected team changes approved for later application. No workspace access changes were made.',
	error: 'Selected team changes could not be confirmed. Open review again to check any blocked or changed rows.',
	permission: 'Only active Workspace Owners and Admins can confirm team changes.',
	signin: 'Sign in before confirming team changes.',
	workspace: 'Workspace access could not be confirmed for team change review.',
	method: 'Team change confirmation requires the review form.',
} as Record<string, string>)[reviewConfirmationState] ?? '';
const membershipApplicationState = String(Astro.url.searchParams.get('membership_application') ?? '');
const membershipApplicationError = String(Astro.url.searchParams.get('membership_application_error') ?? '');
const membershipApplicationMessage = membershipApplicationState === 'success'
	? 'Approved Workspace Team changes applied.'
	: membershipApplicationState === 'already_applied'
		? 'This approved Workspace Team change set has already been applied.'
		: membershipApplicationState === 'error'
			? ({
				signin: 'Sign in before applying approved team changes.',
				workspace: 'Workspace access could not be confirmed for team change application.',
				permission: 'Only active Workspace Owners and Admins can apply approved team changes.',
				permission_denied: 'Only active Workspace Owners and Admins can apply approved team changes.',
				import_not_found: 'The approved import could not be found. Refresh the page and choose the import again.',
				not_ready: 'This import is not approved for application.',
				superseded: 'The source export has been superseded. Download and review a fresh editable CSV.',
				drift_detected: 'Workspace Team data changed after approval. Re-upload or re-review before applying.',
				decision_drift: 'The approved decisions changed after confirmation. Re-open review before applying.',
				target_drift: 'A target membership or profile changed after approval. Re-upload or re-review before applying.',
				result_lookup_failed: 'The application completed but the result could not be reloaded. Refresh the Team page.',
				method: 'Team change application requires the confirmation form.',
				failed: 'Approved Workspace Team changes could not be applied. No partial membership changes were committed.',
			} as Record<string, string>)[membershipApplicationError] ?? 'Approved Workspace Team changes could not be applied. No partial membership changes were committed.'
			: '';
const invitationDeliveryState = String(Astro.url.searchParams.get('invitation_delivery') ?? '');
const invitationDeliveryError = String(Astro.url.searchParams.get('invitation_delivery_error') ?? '');
const invitationDeliverySent = Number(Astro.url.searchParams.get('invitation_delivery_sent') ?? 0);
const invitationDeliveryFailed = Number(Astro.url.searchParams.get('invitation_delivery_failed') ?? 0);
const invitationDeliveryMessage = invitationDeliveryState === 'success'
	? `${invitationDeliverySent} ${invitationDeliverySent === 1 ? 'invitation' : 'invitations'} sent. Delivery alone does not activate workspace access.`
	: invitationDeliveryState === 'partial'
		? `${invitationDeliverySent} ${invitationDeliverySent === 1 ? 'invitation' : 'invitations'} sent. ${invitationDeliveryFailed} could not be sent and can be retried.`
		: invitationDeliveryState === 'cancelled'
			? 'Invitation cancelled. Membership remains invited and can receive a new invitation later.'
			: invitationDeliveryState === 'error'
				? ({
					signin: 'Sign in before administering invitations.',
					workspace: 'Workspace access could not be confirmed for invitation administration.',
					permission: 'Only active Workspace Owners and Admins can administer invitations.',
					permission_denied: 'Only active Workspace Owners and Admins can administer invitations.',
					empty_selection: 'No invited memberships are currently eligible for invitation delivery.',
					missing_invitation: 'The invitation could not be identified. Refresh the Team page and try again.',
					provider_not_configured: 'Invitation email provider is not configured. Rows remain retryable.',
					retry_requires_new_operation_key: 'Refresh the Team page before retrying this failed invitation.',
					method: 'Invitation administration requires the confirmation form.',
					failed: 'Invitation delivery could not be completed. Check row status and retry.',
				} as Record<string, string>)[invitationDeliveryError] ?? `${invitationDeliverySent} delivered. ${invitationDeliveryFailed} could not be delivered and can be retried.`
				: '';
const invitationAcceptanceMessage = String(Astro.url.searchParams.get('invitation_acceptance') ?? '') === 'success'
	? 'Invitation accepted. Membership is active with the approved role.'
	: '';
const memberRoleState = String(Astro.url.searchParams.get('member_role') ?? '');
const memberRoleError = String(Astro.url.searchParams.get('member_role_error') ?? '');
