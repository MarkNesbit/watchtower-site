---
import AuthenticatedLayout from '../../../../layouts/AuthenticatedLayout.astro';
import DisabledActionHint from '../../../../components/app/DisabledActionHint.astro';
import EmptyState from '../../../../components/app/EmptyState.astro';
import ProjectContentPanel from '../../../../components/app/ProjectContentPanel.astro';
import {
	buildWorkspaceTeamCheckoutReleasePath,
	buildWorkspaceTeamExportPath,
	buildWorkspaceTeamImportPath,
	buildWorkspaceTeamImportReviewPath,
	getWorkspaceBySlug,
} from '../../../../lib/projects';
import { isWorkspaceRole } from '../../../../lib/permissions';
import { createSupabaseServerClient, getServerAccessToken } from '../../../../lib/supabaseServer';
import { WORKSPACE_TEAM_IMPORT_MAX_FILE_BYTES } from '../../../../lib/workspaceTeamCsvImport';
import {
	applyWorkspaceTeamActiveEditableCheckoutFilters,
	buildWorkspaceTeamDisplayMembers,
	isWorkspaceTeamActiveEditableCheckout,
	membershipStateCounts,
	workspaceTeamPersonName,
	type TeamFilter,
	type WorkspaceTeamActiveEditableCheckout,
	type WorkspaceTeamMember,
} from '../../../../lib/workspaceTeam';

Astro.response.headers.set('Cache-Control', 'private, no-store, no-cache, must-revalidate');
Astro.response.headers.set('Pragma', 'no-cache');
Astro.response.headers.set('Expires', '0');

const workspaceSlug = Astro.params.workspaceSlug;
const accessToken = getServerAccessToken(Astro.cookies);
const requestedFilter = String(Astro.url.searchParams.get('state') ?? 'all').trim().toLowerCase();
const search = String(Astro.url.searchParams.get('search') ?? '').trim();
const requestedImportRunId = String(Astro.url.searchParams.get('import_run') ?? '').trim();
const selectedFilter: TeamFilter = ['all', 'active', 'invitations', 'deactivated'].includes(requestedFilter)
	? requestedFilter as TeamFilter
	: 'all';

let workspaceName = '';
let workspaceRole = '';
let currentUserId = '';
let loadMessage = '';
let loadError = '';
let members: WorkspaceTeamMember[] = [];
let importRun: {
	id: string;
	status: string;
	uploaded_at: string;
	original_filename: string | null;
	file_hash: string | null;
	source_snapshot_version: number | null;
	live_snapshot_version: number | null;
	checkout_expired: boolean;
	source_stale: boolean;
	source_superseded: boolean;
	validation_summary: Record<string, number> | null;
	failure_message: string | null;
} | null = null;
let importRows: Array<{
	id: string;
	source_row_number: number;
	supplied_membership_id: string | null;
	supplied_user_id: string | null;
	proposed_change_type: string;
	validation_state: string;
	validation_messages: Array<{ field?: string; message?: string }> | null;
	proposed_values: Record<string, unknown> | null;
	field_differences: Array<{ field?: string; from?: unknown; to?: unknown }> | null;
	is_unchanged: boolean;
}> = [];
let activeCheckout: WorkspaceTeamActiveEditableCheckout | null = null;

const formatDate = (value: string | null) => value
	? new Intl.DateTimeFormat('en-GB', { dateStyle: 'medium', timeZone: 'UTC' }).format(new Date(value))
	: 'Not available';
const formatDateTime = (value: string | null) => value
	? new Intl.DateTimeFormat('en-GB', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'UTC' }).format(new Date(value))
	: 'Not available';

try {
	const serverSupabase = createSupabaseServerClient(accessToken);
	const workspace = await getWorkspaceBySlug(serverSupabase, workspaceSlug ?? '', accessToken);
	const organisation = Array.isArray(workspace?.organisations) ? workspace?.organisations[0] : workspace?.organisations;
	const { data: userData, error: userError } = accessToken
		? await serverSupabase.auth.getUser(accessToken)
		: await serverSupabase.auth.getUser();
	if (userError) throw userError;
	currentUserId = userData.user?.id ?? '';

	if (!workspace || !organisation) {
		loadMessage = 'Workspace not found or you do not have access.';
		Astro.response.status = 404;
	} else if (!isWorkspaceRole(workspace.role)) {
		loadMessage = 'Your workspace access could not be confirmed.';
		Astro.response.status = 403;
	} else {
		workspaceName = organisation.name;
		workspaceRole = workspace.role;
		const canUseAdminDirectory = workspaceRole === 'owner' || workspaceRole === 'admin';
		const directoryTable = canUseAdminDirectory ? 'workspace_member_admin_directory' : 'workspace_member_directory';
		const selectColumns = canUseAdminDirectory
			? 'organisation_id, organisation_membership_id, profile_id, display_name, first_name, last_name, login_name, role, membership_status, invited_at, invitation_expires_at, accepted_at, deactivated_at, reactivated_at'
			: 'organisation_id, organisation_membership_id, profile_id, display_name, first_name, last_name, login_name, role, membership_status, is_deactivated, deactivated_at, reactivated_at';
		const { data, error } = await serverSupabase
			.from(directoryTable)
			.select(selectColumns)
			.eq('organisation_id', organisation.id);
		if (error) throw error;
		members = data ?? [];

		if (canUseAdminDirectory) {
			const { data: checkoutData, error: checkoutError } = await applyWorkspaceTeamActiveEditableCheckoutFilters(
				serverSupabase.from('workspace_membership_export_runs'),
				organisation.id,
			).maybeSingle();
			if (checkoutError) throw checkoutError;
			activeCheckout = isWorkspaceTeamActiveEditableCheckout(checkoutData, organisation.id) ? checkoutData : null;

			if (requestedImportRunId) {
				const { data: importData, error: importError } = await serverSupabase
					.from('workspace_membership_import_runs')
					.select('id, status, uploaded_at, original_filename, file_hash, source_snapshot_version, live_snapshot_version, checkout_expired, source_stale, source_superseded, validation_summary, failure_message')
					.eq('organisation_id', organisation.id)
					.eq('id', requestedImportRunId)
					.maybeSingle();
				if (importError) throw importError;
				importRun = importData ?? null;

				if (importRun) {
					const { data: rowData, error: rowError } = await serverSupabase
						.from('workspace_membership_import_rows')
						.select('id, source_row_number, supplied_membership_id, supplied_user_id, proposed_change_type, validation_state, validation_messages, proposed_values, field_differences, is_unchanged')
						.eq('organisation_id', organisation.id)
						.eq('import_run_id', importRun.id)
						.or('is_unchanged.eq.false,validation_state.eq.error,validation_state.eq.warning')
						.order('source_row_number', { ascending: true });
					if (rowError) throw rowError;
					importRows = rowData ?? [];
				}
			}
		}
	}
} catch {
	loadError = 'Workspace Team could not be loaded. Refresh the page, or check that your workspace access is still active.';
}

const displayedMembers = buildWorkspaceTeamDisplayMembers(members, {
	currentUserId,
	filter: selectedFilter,
	search,
});
const counts = membershipStateCounts(members);
const filterHref = (filter: TeamFilter) => {
	const params = new URLSearchParams();
	if (filter !== 'all') params.set('state', filter);
	if (search) params.set('search', search);
	const query = params.toString();
	return query ? `${Astro.url.pathname}?${query}` : Astro.url.pathname;
};
const searchAction = Astro.url.pathname;
const canAdministerLater = workspaceRole === 'owner' || workspaceRole === 'admin';
const exportAction = workspaceSlug ? buildWorkspaceTeamExportPath(workspaceSlug) : '';
const checkoutReleaseAction = workspaceSlug ? buildWorkspaceTeamCheckoutReleasePath(workspaceSlug) : '';
const importAction = workspaceSlug ? buildWorkspaceTeamImportPath(workspaceSlug) : '';
const importReviewPath = workspaceSlug && importRun ? buildWorkspaceTeamImportReviewPath(workspaceSlug, importRun.id) : '';
const importMaxSizeLabel = `${Math.round(WORKSPACE_TEAM_IMPORT_MAX_FILE_BYTES / 1024 / 1024)} MB`;
const checkoutEditorMember = activeCheckout?.requested_by
	? members.find((member) => member.profile_id === activeCheckout?.requested_by)
	: null;
const checkoutEditorName = activeCheckout?.requested_by === currentUserId
	? 'You'
	: checkoutEditorMember
		? workspaceTeamPersonName(checkoutEditorMember)
		: 'Another Workspace administrator';
const checkoutHeldByCurrentUser = Boolean(activeCheckout?.requested_by && activeCheckout.requested_by === currentUserId);
const editableExportDialogId = activeCheckout && !checkoutHeldByCurrentUser
	? 'workspace-team-export-conflict-dialog'
	: 'workspace-team-editable-export-dialog';
const disabledCsvExplanation = canAdministerLater
	? activeCheckout
		? checkoutHeldByCurrentUser
			? `You already have an editable export checked out until ${formatDateTime(activeCheckout.checkout_expires_at)}.`
			: `${checkoutEditorName} has an active editable export until ${formatDateTime(activeCheckout.checkout_expires_at)}.`
		: 'Creates a versioned CSV and starts a 24-hour advisory editing window.'
	: 'Owner or Admin access is required for future team CSV administration.';
const disabledHistoryExplanation = canAdministerLater
	? 'Membership history will be available after the audit review journey is added.'
	: 'Owner or Admin access is required for future membership history.';
const disabledUploadExplanation = canAdministerLater
	? 'Upload an amended editable Workspace Team CSV for validation only. No changes are applied.'
	: 'Owner or Admin access is required for team CSV upload validation.';
const checkoutReleaseState = String(Astro.url.searchParams.get('checkout_release') ?? '');
const checkoutReleaseError = String(Astro.url.searchParams.get('checkout_release_error') ?? '');
const checkoutReleaseMessage = checkoutReleaseState === 'success'
	? 'Editable team-file checkout undone.'
	: checkoutReleaseState === 'error'
		? ({
			holder_only: 'Only the current checkout holder can undo this editable file checkout.',
			not_holder: 'Only the current checkout holder can undo this editable file checkout.',
			already_released: 'That editable checkout has already been undone. Refresh the page and download a new editable copy if needed.',
			expired: 'That editable checkout has expired. Refresh the page and download a new editable copy if needed.',
			superseded: 'That editable checkout has been superseded. Refresh the page and check the current notice.',
			no_active_checkout: 'That editable checkout is no longer active. Refresh the page and check the current notice.',
			not_active: 'That editable checkout is no longer active. Refresh the page and check the current notice.',
			stale: 'The editable checkout changed before Undo completed. Refresh the page and try again if needed.',
			permission: 'Only active Workspace Owners and Admins can undo an editable team-file checkout.',
			permission_denied: 'Only active Workspace Owners and Admins can undo an editable team-file checkout.',
			audit_failed: 'The checkout could not be released because its audit event could not be recorded. Try again, or contact support if this continues.',
			rpc_failed: 'Checkout Undo is temporarily unavailable. Refresh the page and try again.',
			signin: 'Sign in before undoing an editable team-file checkout.',
			workspace: 'Workspace access could not be confirmed for checkout Undo.',
			missing_export: 'The checkout could not be identified. Refresh the page and try again.',
			failed: 'Editable team-file checkout could not be released. Refresh the page and try again.',
		} as Record<string, string>)[checkoutReleaseError] ?? 'Editable team-file checkout could not be released. Refresh the page and try again.'
		: '';
const importSummary = importRun?.validation_summary ?? {};
const importGroups = {
	additions: importRows.filter((row) => row.proposed_change_type === 'addition'),
	corrections: importRows.filter((row) => row.proposed_change_type === 'identity_correction'),
	deactivations: importRows.filter((row) => row.proposed_change_type === 'deactivation'),
	reactivations: importRows.filter((row) => row.proposed_change_type === 'reactivation'),
	warnings: importRows.filter((row) => row.validation_state === 'warning'),
	invalid: importRows.filter((row) => row.validation_state === 'error' || row.proposed_change_type === 'invalid'),
};
const importStatusLabel = (status: string) => status
	.split('_')
	.filter(Boolean)
	.map((part) => part.charAt(0).toUpperCase() + part.slice(1))
	.join(' ');
const importRowIdentity = (row: typeof importRows[number]) => row.supplied_membership_id || row.supplied_user_id || 'New workspace person';
const fieldDifferenceLabel = (difference: { field?: string; from?: unknown; to?: unknown }) => {
	const field = difference.field ?? 'field';
	const fromValue = difference.from === null || difference.from === undefined || difference.from === '' ? 'blank' : String(difference.from);
	const toValue = difference.to === null || difference.to === undefined || difference.to === '' ? 'blank' : String(difference.to);
	return `${field}: ${fromValue} -> ${toValue}`;
};
const validationMessageLabel = (entry: { field?: string; message?: string }) => entry.field
	? `${entry.field}: ${entry.message ?? 'Validation issue'}`
	: entry.message ?? 'Validation issue';
---
<AuthenticatedLayout title="Workspace Team | WatchTower">
	<section class="workspace-team-page" data-workspace-team-page>
		<header class="workspace-team-hero" aria-labelledby="workspace-team-heading">
			<div>
				<p class="eyebrow">Workspace</p>
				<h1 id="workspace-team-heading">Workspace Team</h1>
				<p>View the people associated with this workspace, their access role and current membership status.</p>
			</div>
			{workspaceName && (
				<div class="workspace-team-hero__meta" aria-label={`Workspace ${workspaceName}`}>
					<span>{workspaceName}</span>
					<small>{counts.all} visible {counts.all === 1 ? 'membership' : 'memberships'}</small>
				</div>
			)}
		</header>

		{loadError ? (
			<EmptyState title="Workspace Team could not be loaded." tone="error" data-workspace-team-error role="alert">
				<p>{loadError}</p>
			</EmptyState>
		) : loadMessage ? (
			<EmptyState title="Workspace unavailable." tone="error" data-workspace-team-unavailable role="alert">
				<p>{loadMessage}</p>
			</EmptyState>
		) : (
			<>
				<ProjectContentPanel
					title="Team administration"
					helper="Export a controlled Workspace Team CSV for offline preparation. The database remains authoritative."
					headingId="workspace-team-admin-heading"
				>
					{canAdministerLater && activeCheckout && (
						<div class="workspace-team-checkout" data-active-editable-checkout>
							<strong>{checkoutHeldByCurrentUser ? 'You have the current editable team file.' : `${checkoutEditorName} downloaded the current team file for update.`}</strong>
							<p>
								Exported {formatDateTime(activeCheckout.exported_at)}. Editing window expires {formatDateTime(activeCheckout.checkout_expires_at)}.
								Snapshot version {activeCheckout.membership_snapshot_version}.
							</p>
							{checkoutHeldByCurrentUser && checkoutReleaseAction && (
								<button
									class="button button--secondary workspace-team-checkout__undo"
									type="button"
									aria-haspopup="dialog"
									data-workspace-team-checkout-release-open="workspace-team-checkout-release-dialog"
									data-team-csv-checkout-undo
								>
									Undo
								</button>
							)}
						</div>
					)}
					<div class="workspace-team-admin-actions" data-workspace-team-admin-controls>
						<div>
							{canAdministerLater && exportAction && !checkoutHeldByCurrentUser ? (
								<button
									class="button button--primary"
									type="button"
									aria-haspopup="dialog"
									aria-describedby="workspace-team-csv-disabled"
									data-team-csv-download
									data-workspace-team-export-open={editableExportDialogId}
								>
									Download team CSV for update
								</button>
							) : (
								<button class="button button--primary" type="button" disabled aria-describedby="workspace-team-csv-disabled" data-team-csv-download>
									Download team CSV for update
								</button>
							)}
							<DisabledActionHint
								id="workspace-team-csv-disabled"
								allowed={canAdministerLater}
								allowedText=""
								disabledText={disabledCsvExplanation}
							/>
						</div>
						<div>
							{canAdministerLater && exportAction ? (
								<form method="post" action={exportAction} data-read-only-export-form data-workspace-team-export-download-form>
									<input type="hidden" name="export_mode" value="read_only" />
									<button class="button button--secondary" type="submit" data-read-only-team-csv-download>
										Download read-only copy
									</button>
								</form>
							) : (
								<button class="button button--secondary" type="button" disabled aria-describedby="workspace-team-read-only-disabled" data-read-only-team-csv-download>
									Download read-only copy
								</button>
							)}
							<DisabledActionHint
								id="workspace-team-read-only-disabled"
								allowed={canAdministerLater}
								allowedText="Read-only copies are versioned and do not replace an active editing window."
								disabledText="Owner or Admin access is required for read-only team CSV export."
							/>
						</div>
						<div>
							{canAdministerLater && importAction ? (
								<button
									class="button button--secondary"
									type="button"
									aria-haspopup="dialog"
									aria-describedby="workspace-team-upload-disabled"
									data-workspace-team-import-open="workspace-team-import-dialog"
									data-team-csv-upload
								>
									Upload amended team CSV
								</button>
							) : (
								<button class="button button--secondary" type="button" disabled aria-describedby="workspace-team-upload-disabled" data-team-csv-upload>
									Upload amended team CSV
								</button>
							)}
							<DisabledActionHint
								id="workspace-team-upload-disabled"
								allowed={canAdministerLater}
								allowedText="Validates a returned editable CSV and records comparison evidence only."
								disabledText={disabledUploadExplanation}
							/>
						</div>
						<div>
							<button class="button button--secondary" type="button" disabled aria-describedby="workspace-team-history-disabled" data-membership-history>
								Membership history
							</button>
							<DisabledActionHint
								id="workspace-team-history-disabled"
								allowed={false}
								allowedText=""
								disabledText={disabledHistoryExplanation}
							/>
						</div>
					</div>
					<p class="workspace-team-export-message" role="alert" data-workspace-team-export-page-message hidden></p>
					{checkoutReleaseMessage && (
						<p class={checkoutReleaseState === 'success' ? 'workspace-team-release-message' : 'workspace-team-release-message workspace-team-release-message--error'} role="status" data-workspace-team-checkout-release-message>
							{checkoutReleaseMessage}
						</p>
					)}

					{canAdministerLater && importRun && (
						<section class="workspace-team-import-result" aria-labelledby="workspace-team-import-result-heading" data-workspace-team-import-result>
							<div class="workspace-team-import-result__heading">
								<div>
									<p class="eyebrow">CSV validation</p>
									<h3 id="workspace-team-import-result-heading">{importStatusLabel(importRun.status)}</h3>
									<p>
										{importRun.original_filename ?? 'Workspace Team CSV'} uploaded {formatDateTime(importRun.uploaded_at)}.
										{importRun.file_hash && ` File hash ${importRun.file_hash.slice(0, 12)}...`}
									</p>
								</div>
								<strong>{importRun.status === 'validated' ? 'Ready for review' : importRun.status === 'stale_review_required' ? 'Stale review required' : importRun.status === 'approved_for_application' ? 'Approved for application' : 'Needs correction'}</strong>
							</div>
							{(importRun.checkout_expired || importRun.source_stale || importRun.source_superseded || importRun.failure_message) && (
								<div class="workspace-team-import-warnings" role="status">
									{importRun.checkout_expired && <p>The source editable checkout window has expired. The file was compared with the current live Workspace Team state.</p>}
									{importRun.source_stale && <p>The source snapshot is stale. Live Workspace Team data has changed since export.</p>}
									{importRun.source_superseded && <p>This source export has been superseded and cannot progress.</p>}
									{importRun.failure_message && <p>{importRun.failure_message}</p>}
								</div>
							)}
							<div class="workspace-team-import-summary" aria-label="CSV validation summary">
								<span><strong>{importSummary.additions ?? 0}</strong> additions</span>
								<span><strong>{importSummary.identity_corrections ?? 0}</strong> corrections</span>
								<span><strong>{importSummary.deactivations ?? 0}</strong> deactivations</span>
								<span><strong>{importSummary.reactivations ?? 0}</strong> reactivations</span>
								<span><strong>{importSummary.unchanged ?? 0}</strong> unchanged</span>
								<span><strong>{importSummary.invalid_rows ?? 0}</strong> invalid</span>
							</div>
							{importReviewPath && ['validated', 'stale_review_required', 'approved_for_application'].includes(importRun.status) && !importRun.source_superseded && (
								<p class="workspace-team-import-review-link">
									<a class="button button--primary" href={importReviewPath} data-workspace-team-import-review-link>
										Review proposed changes
									</a>
								</p>
							)}
							{([
								['Proposed additions', importGroups.additions],
								['Proposed corrections', importGroups.corrections],
								['Proposed deactivations', importGroups.deactivations],
								['Proposed reactivations', importGroups.reactivations],
								['Warnings', importGroups.warnings],
								['Invalid rows', importGroups.invalid],
							] as const).map(([title, rows]) => rows.length > 0 && (
								<div class="workspace-team-import-group">
									<h4>{title}</h4>
									<ul>
										{rows.map((row) => (
											<li>
												<strong>Row {row.source_row_number}: {importRowIdentity(row)}</strong>
												{row.field_differences && row.field_differences.length > 0 && (
													<p>{row.field_differences.map(fieldDifferenceLabel).join('; ')}</p>
												)}
												{row.validation_messages && row.validation_messages.length > 0 && (
													<p>{row.validation_messages.map(validationMessageLabel).join('; ')}</p>
												)}
											</li>
										))}
									</ul>
								</div>
							))}
						</section>
					)}

					{canAdministerLater && importAction && (
						<dialog class="workspace-team-export-dialog" id="workspace-team-import-dialog" aria-labelledby="workspace-team-import-title" data-workspace-team-import-dialog>
							<form method="post" action={importAction} enctype="multipart/form-data">
								<div class="workspace-team-export-dialog__body">
									<h3 id="workspace-team-import-title" tabindex="-1" data-workspace-team-dialog-focus>Upload amended team CSV</h3>
									<p>Use the editable Workspace Team CSV returned from this workspace. Validation records comparison evidence only; it does not approve, apply, invite, deactivate or reactivate anyone.</p>
									<p>Accepted file type: .csv. Maximum file size: {importMaxSizeLabel}.</p>
									<label class="workspace-team-import-file">
										<span>Workspace Team CSV</span>
										<input type="file" name="team_csv" accept=".csv,text/csv" required data-workspace-team-import-file />
									</label>
									<p class="workspace-team-import-selected" data-workspace-team-import-selected>No file selected.</p>
								</div>
								<div class="workspace-team-export-dialog__actions">
									<button class="button button--secondary" type="button" data-workspace-team-dialog-cancel>Cancel</button>
									<button class="button button--primary" type="submit">Upload and validate</button>
								</div>
							</form>
						</dialog>
					)}

					{canAdministerLater && activeCheckout && checkoutHeldByCurrentUser && checkoutReleaseAction && (
						<dialog class="workspace-team-export-dialog" id="workspace-team-checkout-release-dialog" aria-labelledby="workspace-team-checkout-release-title" aria-describedby="workspace-team-checkout-release-description" data-workspace-team-checkout-release-dialog>
							<form method="post" action={checkoutReleaseAction} data-workspace-team-checkout-release-form>
								<input type="hidden" name="export_id" value={activeCheckout.id} />
								<div class="workspace-team-export-dialog__body">
									<h3 id="workspace-team-checkout-release-title" tabindex="-1" data-workspace-team-dialog-focus>Undo editable file checkout?</h3>
									<p id="workspace-team-checkout-release-description">This will release your current editable team file so another Owner or Admin can download a new editable copy. Your downloaded CSV will not be deleted, but it may become stale or superseded.</p>
								</div>
								<div class="workspace-team-export-dialog__actions">
									<button class="button button--secondary" type="button" data-workspace-team-dialog-cancel>Keep checkout</button>
									<button class="button button--primary" type="submit" data-team-csv-checkout-undo-confirm>Undo checkout</button>
								</div>
							</form>
						</dialog>
					)}

					{canAdministerLater && exportAction && (
						<dialog class="workspace-team-export-dialog" id="workspace-team-editable-export-dialog" aria-labelledby="workspace-team-editable-export-title" data-workspace-team-export-dialog>
							<form method="post" action={exportAction} data-workspace-team-export-download-form>
								<input type="hidden" name="export_mode" value="editable" />
								<div class="workspace-team-export-dialog__body">
									<h3 id="workspace-team-editable-export-title" tabindex="-1" data-workspace-team-dialog-focus>Download editable team CSV</h3>
									<p>This creates a versioned export and starts a 24-hour advisory editing window. The CSV is an offline working copy; the database remains the source of truth.</p>
									<p>Future upload validation will compare this export ID and snapshot version against the live Workspace Team data.</p>
									<p class="workspace-team-export-message" role="alert" data-workspace-team-export-message hidden></p>
								</div>
								<div class="workspace-team-export-dialog__actions">
									<button class="button button--secondary" type="button" data-workspace-team-dialog-cancel>Cancel</button>
									<button class="button button--primary" type="submit">Download editable CSV</button>
								</div>
							</form>
						</dialog>
					)}

					{canAdministerLater && exportAction && activeCheckout && !checkoutHeldByCurrentUser && (
						<dialog class="workspace-team-export-dialog" id="workspace-team-export-conflict-dialog" aria-labelledby="workspace-team-export-conflict-title" data-workspace-team-export-dialog>
							<div class="workspace-team-export-dialog__body">
								<h3 id="workspace-team-export-conflict-title" tabindex="-1" data-workspace-team-dialog-focus>Editing window already active</h3>
								<p>{checkoutEditorName} downloaded this Workspace Team file for update at {formatDateTime(activeCheckout.exported_at)}. Their editing window expires at {formatDateTime(activeCheckout.checkout_expires_at)}.</p>
								<p>Download a read-only copy if you only need the latest data. Take over only when you need a new editable working copy; the earlier editable export will be superseded and ineligible for later upload.</p>
								<p class="workspace-team-export-message" role="alert" data-workspace-team-export-message hidden></p>
							</div>
							<div class="workspace-team-export-dialog__actions">
								<button class="button button--secondary" type="button" data-workspace-team-dialog-cancel>Cancel</button>
								<form method="post" action={exportAction} data-workspace-team-export-download-form>
									<input type="hidden" name="export_mode" value="read_only" />
									<button class="button button--secondary" type="submit">Download read-only copy</button>
								</form>
								<form method="post" action={exportAction} data-workspace-team-export-download-form>
									<input type="hidden" name="export_mode" value="editable" />
									<input type="hidden" name="takeover_export_id" value={activeCheckout.id} />
									<input type="hidden" name="confirm_takeover" value="true" />
									<button class="button button--primary" type="submit" data-team-csv-takeover>Take over editing</button>
								</form>
							</div>
						</dialog>
					)}
				</ProjectContentPanel>

				<ProjectContentPanel
					title="Membership list"
					helper="Members are sorted by last name, first name, login name and membership record."
					headingId="workspace-team-list-heading"
				>
					<div class="workspace-team-controls" aria-label="Workspace Team filters">
						<nav class="workspace-team-filters" aria-label="Membership state filters">
							<a href={filterHref('all')} aria-current={selectedFilter === 'all' ? 'page' : undefined}>All <span>{counts.all}</span></a>
							<a href={filterHref('active')} aria-current={selectedFilter === 'active' ? 'page' : undefined}>Active <span>{counts.active}</span></a>
							<a href={filterHref('invitations')} aria-current={selectedFilter === 'invitations' ? 'page' : undefined}>Invitations <span>{counts.invitations}</span></a>
							<a href={filterHref('deactivated')} aria-current={selectedFilter === 'deactivated' ? 'page' : undefined}>Deactivated <span>{counts.deactivated}</span></a>
						</nav>
						<form class="workspace-team-search" method="get" action={searchAction} role="search">
							{selectedFilter !== 'all' && <input type="hidden" name="state" value={selectedFilter} />}
							<label>
								<span>Search team</span>
								<input type="search" name="search" value={search} autocomplete="off" placeholder="Name or login" />
							</label>
							<button class="button button--secondary" type="submit">Search</button>
