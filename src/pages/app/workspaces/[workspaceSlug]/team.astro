										const impact = asRecord(item.impact_counts);
										return (
											<article class={blocked ? 'workspace-team-review-row workspace-team-review-row--blocked' : 'workspace-team-review-row'} data-review-row data-review-search-text={`${reviewItemName(item)} ${reviewItemEmail(item)} ${reviewItemTypeLabel(item)}`.toLowerCase()} data-review-blocked={blocked ? 'true' : 'false'}>
												<div class="workspace-team-review-row__switch">
													{blocked ? (
														<span class="workspace-team-review-row__blocked">Excluded</span>
													) : (
														<label>
															<input type="checkbox" name="selected_import_row_id" value={item.row_id} checked={reviewModalIsReconfirmation ? item.decision === 'approved' : item.review_selected !== false} data-review-switch aria-describedby={`review-row-${item.row_id}-details`} />
															<span>Include</span>
														</label>
													)}
												</div>
												<div class="workspace-team-review-row__person" id={`review-row-${item.row_id}-details`}>
													<strong>{reviewItemName(item)}</strong>
													<span>{reviewItemEmail(item)}</span>
													<small>CSV row {item.source_row_number}</small>
												</div>
												<div class="workspace-team-review-row__change">
													<span>{reviewItemRole(item)} · {reviewItemTypeLabel(item)}</span>
													{item.proposed_change_type === 'identity_correction' && item.field_differences.length > 0 && (
														<small>{item.field_differences.map(fieldDifferenceLabel).join('; ')}</small>
													)}
													{item.proposed_change_type === 'deactivation' && (
														<small>{Number(impact.active_risks_owned ?? 0)} risks, {Number(impact.non_terminal_actions_assigned ?? 0)} actions, {Number(impact.non_terminal_approvals_held ?? 0)} approvals, {Number(impact.active_project_roles ?? 0)} project roles</small>
													)}
													{item.proposed_change_type === 'reactivation' && (
														<small>Current state {labelFromToken(item.current_live_values.membership_status)}.</small>
													)}
													{messages.length > 0 && <small>{messages.join('; ')}</small>}
													{!blocked && !reviewModalIsReconfirmation && (
														<label class="workspace-team-review-row__draft-note">
															<span>Exclusion comment</span>
															<textarea name={`review_draft_reason_${item.row_id}`} rows="2" placeholder="Optional note for this saved review choice" data-review-draft-reason>{item.review_draft_reason ?? ''}</textarea>
														</label>
													)}
													{!blocked && !reviewModalIsReconfirmation && (
														<small class="workspace-team-review-row__save-state" data-review-save-state>Saved</small>
													)}
												</div>
											</article>
										);
									})}
								</div>
								<div class="workspace-team-review-modal__confirm" hidden data-review-confirmation>
									<h4>{reviewModalIsReconfirmation ? 'Reconfirm approved team changes?' : 'Confirm selected team changes?'}</h4>
									<p><strong data-review-confirm-selected>{reviewModalInitialSelectedCount}</strong> changes will be approved for application.</p>
									<p><strong data-review-confirm-excluded>{reviewModalInitialExcludedCount}</strong> changes will be excluded. No workspace access changes will be made until the application stage.</p>
									<label>
										<span>Optional batch note</span>
										<input type="text" name="batch_reason" placeholder="Optional audit note" />
									</label>
								</div>
								<div class="workspace-team-review-modal__footer">
									<span data-review-footer-count>{reviewModalInitialSelectedCount} selected · {reviewModalInitialExcludedCount} excluded</span>
									<div>
										<button class="button button--secondary" type="button" data-workspace-team-dialog-cancel>Cancel</button>
										<button class="button button--secondary" type="button" hidden data-review-back>Back to review</button>
										<button class="button button--primary" type="button" data-review-accept>Accept {reviewModalInitialSelectedCount} selected changes</button>
										<button class="button button--primary" type="submit" hidden data-review-confirm>{reviewModalIsReconfirmation ? 'Reconfirm selected changes' : 'Confirm selected changes'}</button>
									</div>
								</div>
							</form>
						</dialog>
					)}

					{canAdministerLater && invitationSendAction && invitationCounts.eligibleToSend > 0 && (
						<dialog class="workspace-team-export-dialog" id="workspace-team-invitation-bulk-dialog" aria-labelledby="workspace-team-invitation-bulk-title" aria-describedby="workspace-team-invitation-bulk-description" data-workspace-team-invitation-dialog>
							<form method="post" action={invitationSendAction}>
								<input type="hidden" name="scope" value="eligible" />
								<input type="hidden" name="operation_key" value={invitationOperationKey} />
								<div class="workspace-team-export-dialog__body">
									<h3 id="workspace-team-invitation-bulk-title" tabindex="-1" data-workspace-team-dialog-focus>Send workspace invitations?</h3>
									<p id="workspace-team-invitation-bulk-description">{invitationCounts.eligibleToSend} invitations will be prepared. Recipients receive access only after completing account setup and acceptance.</p>
									<p>Each invitation is linked to one person, expires after the configured period and preserves the approved role.</p>
								</div>
								<div class="workspace-team-export-dialog__actions">
									<button class="button button--secondary" type="button" data-workspace-team-dialog-cancel>Cancel</button>
									<button class="button button--primary" type="submit">Send {invitationCounts.eligibleToSend} {invitationCounts.eligibleToSend === 1 ? 'invitation' : 'invitations'}</button>
								</div>
							</form>
						</dialog>
					)}

					{canAdministerLater && importAction && (
						<dialog class="workspace-team-export-dialog" id="workspace-team-import-dialog" aria-labelledby="workspace-team-import-title" data-workspace-team-import-dialog>
							<form method="post" action={importAction} enctype="multipart/form-data">
								<div class="workspace-team-export-dialog__body">
									<h3 id="workspace-team-import-title" tabindex="-1" data-workspace-team-dialog-focus>Upload amended team CSV</h3>
									<p>Use the editable Workspace Team CSV returned from this workspace. Validation records comparison evidence only; it does not approve, apply, invite, deactivate or reactivate anyone.</p>
									<p>Accepted file type: .csv. Maximum file size: {importMaxSizeLabel}.</p>
									<label class="workspace-team-import-file">
										<span>Workspace Team CSV</span>
										<input type="file" name="team_csv" accept=".csv,text/csv" required data-workspace-team-import-file />
									</label>
									<p class="workspace-team-import-selected" data-workspace-team-import-selected>No file selected.</p>
								</div>
								<div class="workspace-team-export-dialog__actions">
									<button class="button button--secondary" type="button" data-workspace-team-dialog-cancel>Cancel</button>
									<button class="button button--primary" type="submit">Upload and validate</button>
								</div>
							</form>
						</dialog>
					)}

					{canAdministerLater && importRun && importApplyPath && importRun.status === 'approved_for_application' && (
						<dialog class="workspace-team-export-dialog" id="workspace-team-application-dialog" aria-labelledby="workspace-team-application-title" aria-describedby="workspace-team-application-description" data-workspace-team-application-dialog>
							<form method="post" action={importApplyPath} data-workspace-team-application-form>
								<input type="hidden" name="operation_key" value={applicationOperationKey} />
								<div class="workspace-team-export-dialog__body">
									<h3 id="workspace-team-application-title" tabindex="-1" data-workspace-team-dialog-focus>Apply approved team changes?</h3>
									<p id="workspace-team-application-description">This will update workspace membership and profile data for the approved changes. The operation will either complete in full or make no changes.</p>
									{Number(applicationSummary.approved_additions ?? 0) > 0 && (
										<p>New members will be created in an invited state. Invitation delivery will follow separately.</p>
									)}
								</div>
								<div class="workspace-team-export-dialog__actions">
									<button class="button button--secondary" type="button" data-workspace-team-dialog-cancel>Cancel</button>
									<button class="button button--primary" type="submit" data-workspace-team-application-submit>Apply changes</button>
								</div>
							</form>
						</dialog>
					)}

					{canAdministerLater && activeCheckout && checkoutHeldByCurrentUser && checkoutReleaseAction && (
						<dialog class="workspace-team-export-dialog" id="workspace-team-checkout-release-dialog" aria-labelledby="workspace-team-checkout-release-title" aria-describedby="workspace-team-checkout-release-description" data-workspace-team-checkout-release-dialog>
							<form method="post" action={checkoutReleaseAction} data-workspace-team-checkout-release-form>
								<input type="hidden" name="export_id" value={activeCheckout.id} />
								<div class="workspace-team-export-dialog__body">
									<h3 id="workspace-team-checkout-release-title" tabindex="-1" data-workspace-team-dialog-focus>Undo editable file checkout?</h3>
									<p id="workspace-team-checkout-release-description">This will release your current editable team file so another Owner or Admin can download a new editable copy. Your downloaded CSV will not be deleted, but it may become stale or superseded.</p>
								</div>
								<div class="workspace-team-export-dialog__actions">
									<button class="button button--secondary" type="button" data-workspace-team-dialog-cancel>Keep checkout</button>
									<button class="button button--primary" type="submit" data-team-csv-checkout-undo-confirm>Undo checkout</button>
								</div>
							</form>
						</dialog>
					)}

					{canAdministerLater && exportAction && (
						<dialog class="workspace-team-export-dialog" id="workspace-team-editable-export-dialog" aria-labelledby="workspace-team-editable-export-title" data-workspace-team-export-dialog>
							<form method="post" action={exportAction} data-workspace-team-export-download-form>
								<input type="hidden" name="export_mode" value="editable" />
								<div class="workspace-team-export-dialog__body">
									<h3 id="workspace-team-editable-export-title" tabindex="-1" data-workspace-team-dialog-focus>Download editable team CSV</h3>
									<p>This creates a versioned export and starts a 24-hour advisory editing window. The CSV is an offline working copy; the database remains the source of truth.</p>
									<p>Future upload validation will compare this export ID and snapshot version against the live Workspace Team data.</p>
									<p class="workspace-team-export-message" role="alert" data-workspace-team-export-message hidden></p>
								</div>
								<div class="workspace-team-export-dialog__actions">
									<button class="button button--secondary" type="button" data-workspace-team-dialog-cancel>Cancel</button>
									<button class="button button--primary" type="submit">Download editable CSV</button>
								</div>
							</form>
						</dialog>
					)}

					{canAdministerLater && exportAction && activeCheckout && !checkoutHeldByCurrentUser && (
						<dialog class="workspace-team-export-dialog" id="workspace-team-export-conflict-dialog" aria-labelledby="workspace-team-export-conflict-title" data-workspace-team-export-dialog>
							<div class="workspace-team-export-dialog__body">
								<h3 id="workspace-team-export-conflict-title" tabindex="-1" data-workspace-team-dialog-focus>Editing window already active</h3>
								<p>{checkoutEditorName} downloaded this Workspace Team file for update at {formatDateTime(activeCheckout.exported_at)}. Their editing window expires at {formatDateTime(activeCheckout.checkout_expires_at)}.</p>
								<p>Download a read-only copy if you only need the latest data. Take over only when you need a new editable working copy; the earlier editable export will be superseded and ineligible for later upload.</p>
								<p class="workspace-team-export-message" role="alert" data-workspace-team-export-message hidden></p>
							</div>
							<div class="workspace-team-export-dialog__actions">
								<button class="button button--secondary" type="button" data-workspace-team-dialog-cancel>Cancel</button>
								<form method="post" action={exportAction} data-workspace-team-export-download-form>
									<input type="hidden" name="export_mode" value="read_only" />
									<button class="button button--secondary" type="submit">Download read-only copy</button>
								</form>
								<form method="post" action={exportAction} data-workspace-team-export-download-form>
									<input type="hidden" name="export_mode" value="editable" />
									<input type="hidden" name="takeover_export_id" value={activeCheckout.id} />
									<input type="hidden" name="confirm_takeover" value="true" />
									<button class="button button--primary" type="submit" data-team-csv-takeover>Take over editing</button>
								</form>
							</div>
						</dialog>
					)}
				</ProjectContentPanel>

				<ProjectContentPanel
					title="Membership list"
					helper="Members are sorted by last name, first name, login name and membership record."
					headingId="workspace-team-list-heading"
				>
					<div class="workspace-team-controls" aria-label="Workspace Team filters">
						<nav class="workspace-team-filters" aria-label="Membership state filters">
							<a href={filterHref('all')} aria-current={selectedFilter === 'all' ? 'page' : undefined}>All <span>{counts.all}</span></a>
							<a href={filterHref('active')} aria-current={selectedFilter === 'active' ? 'page' : undefined}>Active <span>{counts.active}</span></a>
							<a href={filterHref('invitations')} aria-current={selectedFilter === 'invitations' ? 'page' : undefined}>Invitations <span>{counts.invitations}</span></a>
							<a href={filterHref('deactivated')} aria-current={selectedFilter === 'deactivated' ? 'page' : undefined}>Deactivated <span>{counts.deactivated}</span></a>
						</nav>
						<form class="workspace-team-search" method="get" action={searchAction} role="search">
							{selectedFilter !== 'all' && <input type="hidden" name="state" value={selectedFilter} />}
							<label>
								<span>Search team</span>
								<input type="search" name="search" value={search} autocomplete="off" placeholder="Name or login" />
							</label>
							<button class="button button--secondary" type="submit">Search</button>
						</form>
					</div>

					{members.length === 0 ? (
						<EmptyState title="No visible memberships." data-workspace-team-empty>
							<p>No workspace memberships are available to display.</p>
						</EmptyState>
					) : displayedMembers.length === 0 ? (
						<EmptyState title="No matching memberships." data-workspace-team-filter-empty>
							<p>Adjust the state filter or search text to see more workspace people.</p>
						</EmptyState>
					) : (
						<div class="workspace-team-table-wrap">
							<table class="simple-table workspace-team-table" data-workspace-team-table>
								<thead>
									<tr>
										<th scope="col">Person</th>
										<th scope="col">Login</th>
										<th scope="col">Role</th>
										<th scope="col">Status</th>
										<th scope="col">Invitation</th>
										<th scope="col">Joined / invited</th>
										<th scope="col">Actions</th>
									</tr>
								</thead>
								<tbody>
									{displayedMembers.map((member) => (
										<tr data-membership-id={member.organisation_membership_id} data-profile-id={member.profile_id} data-membership-status={member.membership_status}>
											<td data-label="Person">
												{member.membership_status === 'active' && canAdministerLater ? (
													<button
														class="workspace-team-person-pill workspace-team-person-pill--active"
														type="button"
														aria-haspopup="dialog"
														aria-label={`${member.personName}, active member. Open member details.`}
														data-workspace-team-member-open={`workspace-team-member-dialog-${member.organisation_membership_id}`}
													>
														<span>{member.personName}</span>
														<small>Active · Details</small>
													</button>
												) : member.membership_status === 'invited' || member.membership_status === 'invite_expired' ? (
													<span class="workspace-team-person-pill workspace-team-person-pill--invited" aria-label={`${member.personName}, ${member.displayStatus.toLowerCase()} member. Member details are not available until the invitation is accepted.`}>
														<span>{member.personName}</span>
														<small>{member.displayStatus}</small>
													</span>
												) : (
													<strong class={member.membership_status === 'deactivated' ? 'workspace-team-person workspace-team-person--deactivated' : 'workspace-team-person'}>
														{member.personName}
													</strong>
												)}
												{member.isCurrentUser && <span class="workspace-team-you" aria-label="This is your membership">You</span>}
											</td>
											<td data-label="Login">{member.loginLabel}</td>
											<td data-label="Role"><span class="workspace-team-role">{member.displayRole}</span></td>
											<td data-label="Status">
												<span class={`workspace-team-status workspace-team-status--${member.statusTone}`} aria-label={`${member.displayStatus}. ${member.statusDescription}`}>
													{member.displayStatus}
												</span>
											</td>
											<td data-label="Invitation">
												<span class={`workspace-team-status workspace-team-status--${workspaceInvitationTone(member.invitation_status)}`} aria-label={workspaceInvitationStatusLabel(member.invitation_status)}>
													{member.membership_status === 'active' ? 'Accepted' : workspaceInvitationStatusLabel(member.invitation_status)}
												</span>
												{member.invitation_failure_message && <small class="workspace-team-invitation-failure">{member.invitation_failure_message}</small>}
											</td>
											<td data-label={member.lifecycleDateLabel}>
												<span class="workspace-team-date-label">{member.lifecycleDateLabel}</span>
												<span>{formatDate(member.lifecycleDateValue)}</span>
											</td>
											<td data-label="Actions">
												{canAdministerLater && invitationSendAction && (member.membership_status === 'invited' || member.membership_status === 'invite_expired') ? (
													<div class="workspace-team-row-actions">
														<form method="post" action={invitationSendAction}>
															<input type="hidden" name="membership_id" value={member.organisation_membership_id} />
															<input type="hidden" name="operation_key" value={crypto.randomUUID()} />
															<input type="hidden" name="invitation_action" value={currentInvitationActionForSubmission(member.invitation_status)} />
															{currentInvitationActionForSubmission(member.invitation_status) === 'retry' && (
																<input type="hidden" name="retry_operation_key" value={crypto.randomUUID()} />
															)}
															<button class="button button--secondary" type="submit">{workspaceInvitationActionLabel(member)}</button>
														</form>
														{member.invitation_id && invitationNeedsCancellation(member.invitation_status) && (
															<form method="post" action={invitationSendAction}>
																<input type="hidden" name="invitation_id" value={member.invitation_id} />
																<input type="hidden" name="invitation_action" value="cancel" />
																<button class="button button--secondary" type="submit">Cancel invitation</button>
															</form>
														)}
													</div>
												) : member.membership_status === 'active' ? (
													<span class="workspace-team-row-action" aria-disabled="true">Invitation accepted</span>
												) : (
													<span class="workspace-team-row-action" aria-disabled="true">No action available</span>
												)}
											</td>
										</tr>
									))}
								</tbody>
							</table>
						</div>
					)}
					{canAdministerLater && memberRoleAction && memberSessionAction && displayedMembers.filter((member) => member.membership_status === 'active').map((member) => {
						const roleAuthority = workspaceTeamRoleAuthority(workspaceRole, member.role, member.isCurrentUser);
						const modalId = `workspace-team-member-dialog-${member.organisation_membership_id}`;
						const memberTitleId = `${modalId}-title`;
						const memberDescriptionId = `${modalId}-description`;
						const roleSelectId = `${modalId}-role`;
						const roleLabelId = `${modalId}-role-label`;
						const roleHelpId = `${modalId}-role-help`;
						const errorId = `${modalId}-error`;
						return (
							<dialog
								class="workspace-team-member-modal"
								id={modalId}
								aria-labelledby={memberTitleId}
								aria-describedby={memberDescriptionId}
								data-workspace-team-member-dialog
								data-member-session-action={memberSessionAction}
								data-member-role-action={memberRoleAction}
								data-member-id={member.organisation_membership_id}
								data-member-can-edit={roleAuthority.canEdit ? 'true' : 'false'}
							>
								<form method="post" action={memberRoleAction} data-workspace-team-member-role-form data-member-initial-role={member.role} data-member-session-id="">
									<input type="hidden" name="membership_id" value={member.organisation_membership_id} />
									<input type="hidden" name="expected_snapshot_version" value={membershipSnapshotVersion ?? ''} />
									<input type="hidden" name="edit_session_id" value="" data-member-session-input />
									<div class="workspace-team-member-modal__header">
										<div>
											<p class="eyebrow">Member details</p>
											<h3 id={memberTitleId} tabindex="-1" data-workspace-team-dialog-focus>{member.personName}</h3>
											<p id={memberDescriptionId}>Workspace: {workspaceName}. Identity fields are read-only in this view.</p>
										</div>
										<button class="workspace-team-member-modal__close" type="button" data-workspace-team-member-close aria-label={`Close ${member.personName} details`}>x</button>
									</div>
									<p class="workspace-team-member-modal__notice" role="status" data-member-lock-notice hidden></p>
									<p class="workspace-team-member-modal__error" role="alert" id={errorId} data-member-error hidden></p>
									<div class="workspace-team-member-modal__body">
										<section class="workspace-team-member-modal__section" aria-labelledby={`${modalId}-identity-heading`}>
											<h4 id={`${modalId}-identity-heading`}>Identity</h4>
											<dl class="workspace-team-member-modal__details">
												<div><dt>Full name</dt><dd>{member.personName}</dd></div>
												<div><dt>Login name</dt><dd>{member.loginLabel}</dd></div>
												<div><dt>Contact email</dt><dd>{member.contact_email ?? 'Not available'}</dd></div>
											</dl>
										</section>
										<section class="workspace-team-member-modal__section" aria-labelledby={`${modalId}-membership-heading`}>
											<h4 id={`${modalId}-membership-heading`}>Membership</h4>
											<dl class="workspace-team-member-modal__details">
												<div class="workspace-team-member-modal__role-row">
													<dt id={roleLabelId}>Workspace role</dt>
													<dd>
														{roleAuthority.canEdit ? (
															<select
																id={roleSelectId}
																name="target_role"
																aria-labelledby={roleLabelId}
																aria-describedby={`${roleHelpId} ${errorId}`}
																data-member-role-select
															>
																{roleAuthority.options.map((role) => (
																	<option value={role} selected={member.role === role}>{workspaceRoleLabel(role)}</option>
																))}
															</select>
														) : (
															<div class="workspace-team-member-modal__readonly" data-member-readonly-reason>
																<strong>{member.displayRole}</strong>
																<p>{roleAuthority.reason}</p>
															</div>
														)}
													</dd>
												</div>
												<div><dt>Membership status</dt><dd>{member.displayStatus}</dd></div>
												<div><dt>Invitation status</dt><dd>{member.membership_status === 'active' ? 'Accepted' : workspaceInvitationStatusLabel(member.invitation_status)}</dd></div>
												<div><dt>Joined date</dt><dd>{formatDate(member.joined_at ?? member.accepted_at ?? null)}</dd></div>
												<div><dt>Invited date</dt><dd>{formatDate(member.invited_at ?? null)}</dd></div>
												<div><dt>Accepted date</dt><dd>{formatDate(member.accepted_at ?? member.invitation_accepted_at ?? null)}</dd></div>
												<div><dt>Last login</dt><dd>{formatDateTime(member.last_login_at ?? null)}</dd></div>
											</dl>
											<p class="workspace-team-member-modal__hint" id={roleHelpId}>{roleAuthority.reason}</p>
										</section>
									</div>
									<div class="workspace-team-member-modal__actions">
										<button class="button button--secondary" type="button" data-workspace-team-member-cancel>Cancel</button>
										{roleAuthority.canEdit ? (
											<button class="button button--primary" type="submit" disabled data-member-save>Save</button>
										) : (
											<button class="button button--primary" type="button" disabled data-member-save>Save</button>
										)}
									</div>
								</form>
							</dialog>
						);
					})}
				</ProjectContentPanel>
			</>
		)}
	</section>
</AuthenticatedLayout>

<script>
	const lastTriggerByDialog = new WeakMap();
	document.querySelectorAll('[data-workspace-team-export-open]').forEach((trigger) => {
		trigger.addEventListener('click', () => {
			const dialogId = trigger.getAttribute('data-workspace-team-export-open');
			const dialog = dialogId ? document.getElementById(dialogId) : null;
			if (!(dialog instanceof HTMLDialogElement)) return;
			lastTriggerByDialog.set(dialog, trigger);
			if (!dialog.open) dialog.showModal();
			const focusTarget = dialog.querySelector('[data-workspace-team-dialog-focus], button, input');
			if (focusTarget instanceof HTMLElement) focusTarget.focus();
		});
	});

	document.querySelectorAll('[data-workspace-team-import-open]').forEach((trigger) => {
		trigger.addEventListener('click', () => {
			const dialogId = trigger.getAttribute('data-workspace-team-import-open');
			const dialog = dialogId ? document.getElementById(dialogId) : null;
			if (!(dialog instanceof HTMLDialogElement)) return;
			lastTriggerByDialog.set(dialog, trigger);
			if (!dialog.open) dialog.showModal();
			const focusTarget = dialog.querySelector('[data-workspace-team-dialog-focus], button, input');
			if (focusTarget instanceof HTMLElement) focusTarget.focus();
		});
	});

	document.querySelectorAll('[data-workspace-team-checkout-release-open]').forEach((trigger) => {
		trigger.addEventListener('click', () => {
			const dialogId = trigger.getAttribute('data-workspace-team-checkout-release-open');
			const dialog = dialogId ? document.getElementById(dialogId) : null;
			if (!(dialog instanceof HTMLDialogElement)) return;
			lastTriggerByDialog.set(dialog, trigger);
			if (!dialog.open) dialog.showModal();
			const focusTarget = dialog.querySelector('[data-workspace-team-dialog-focus], button, input');
			if (focusTarget instanceof HTMLElement) focusTarget.focus();
		});
	});

	document.querySelectorAll('[data-workspace-team-review-open]').forEach((trigger) => {
		trigger.addEventListener('click', (event) => {
			event.preventDefault();
			const dialogId = trigger.getAttribute('data-workspace-team-review-open');
			const dialog = dialogId ? document.getElementById(dialogId) : null;
			if (!(dialog instanceof HTMLDialogElement)) return;
			lastTriggerByDialog.set(dialog, trigger);
			if (!dialog.open) dialog.showModal();
			const focusTarget = dialog.querySelector('[data-workspace-team-dialog-focus], [data-review-search], button, input');
			if (focusTarget instanceof HTMLElement) focusTarget.focus();
		});
	});

	document.querySelectorAll('[data-workspace-team-application-open]').forEach((trigger) => {
		trigger.addEventListener('click', (event) => {
			event.preventDefault();
			const dialogId = trigger.getAttribute('data-workspace-team-application-open');
			const dialog = dialogId ? document.getElementById(dialogId) : null;
			if (!(dialog instanceof HTMLDialogElement)) return;
			lastTriggerByDialog.set(dialog, trigger);
			if (!dialog.open) dialog.showModal();
			const focusTarget = dialog.querySelector('[data-workspace-team-dialog-focus], button, input');
			if (focusTarget instanceof HTMLElement) focusTarget.focus();
		});
	});

	document.querySelectorAll('[data-workspace-team-invitation-open]').forEach((trigger) => {
		trigger.addEventListener('click', (event) => {
			event.preventDefault();
			const dialogId = trigger.getAttribute('data-workspace-team-invitation-open');
			const dialog = dialogId ? document.getElementById(dialogId) : null;
			if (!(dialog instanceof HTMLDialogElement)) return;
			lastTriggerByDialog.set(dialog, trigger);
			if (!dialog.open) dialog.showModal();
			const focusTarget = dialog.querySelector('[data-workspace-team-dialog-focus], button, input');
			if (focusTarget instanceof HTMLElement) focusTarget.focus();
		});
	});

	function normalizeMemberRole(value) {
		return String(value || '').trim().toLowerCase();
	}

	function memberDialogDirty(dialog) {
		const form = dialog.querySelector('[data-workspace-team-member-role-form]');
		const select = dialog.querySelector('[data-member-role-select]');
		return form instanceof HTMLFormElement
			&& select instanceof HTMLSelectElement
			&& normalizeMemberRole(select.value) !== normalizeMemberRole(form.dataset.memberInitialRole);
	}

	function resetMemberRoleSelection(dialog) {
		const form = dialog.querySelector('[data-workspace-team-member-role-form]');
		const select = dialog.querySelector('[data-member-role-select]');
		if (!(form instanceof HTMLFormElement) || !(select instanceof HTMLSelectElement)) return;
		select.value = normalizeMemberRole(form.dataset.memberInitialRole);
	}

	function setMemberError(dialog, message) {
		const target = dialog.querySelector('[data-member-error]');
		if (!(target instanceof HTMLElement)) return;
		target.textContent = message;
		target.hidden = !message;
	}

	function setMemberLockNotice(dialog, message) {
		const target = dialog.querySelector('[data-member-lock-notice]');
		if (!(target instanceof HTMLElement)) return;
		target.textContent = message;
		target.hidden = !message;
	}

	function setMemberSession(dialog, sessionId) {
		const form = dialog.querySelector('[data-workspace-team-member-role-form]');
		const input = dialog.querySelector('[data-member-session-input]');
		if (form instanceof HTMLFormElement) form.dataset.memberSessionId = sessionId || '';
		if (input instanceof HTMLInputElement) input.value = sessionId || '';
	}

	function setMemberEditState(dialog, state) {
		if (!(dialog instanceof HTMLElement)) return;
		dialog.dataset.memberEditState = state;
		if (state === 'readonly' || state === 'locked' || state === 'unavailable') {
			dialog.dataset.memberLocked = 'true';
		} else {
			dialog.removeAttribute('data-member-locked');
		}
		const select = dialog.querySelector('[data-member-role-select]');
		if (select instanceof HTMLSelectElement) {
			select.disabled = state !== 'editable';
		}
	}

	function updateMemberSaveState(dialog) {
		const save = dialog.querySelector('[data-member-save]');
		const select = dialog.querySelector('[data-member-role-select]');
		const form = dialog.querySelector('[data-workspace-team-member-role-form]');
		if (!(save instanceof HTMLButtonElement) || !(form instanceof HTMLFormElement)) return;
		const hasChanged = select instanceof HTMLSelectElement
			&& normalizeMemberRole(select.value) !== normalizeMemberRole(form.dataset.memberInitialRole);
		const hasSession = Boolean(form.dataset.memberSessionId);
		const canEdit = dialog instanceof HTMLElement
			&& dialog.dataset.memberCanEdit === 'true'
			&& dialog.dataset.memberEditState === 'editable'
			&& !dialog.dataset.memberLocked;
		save.disabled = !canEdit || !hasChanged || !hasSession;
	}

	async function releaseMemberSession(dialog) {
		const form = dialog.querySelector('[data-workspace-team-member-role-form]');
		const sessionId = form instanceof HTMLFormElement ? form.dataset.memberSessionId || '' : '';
		const sessionAction = dialog instanceof HTMLElement ? dialog.dataset.memberSessionAction || '' : '';
		if (!sessionId || !sessionAction) return;
		setMemberSession(dialog, '');
		const body = new FormData();
		body.set('session_id', sessionId);
		body.set('session_action', 'release');
		body.set('release_source', 'modal_closed');
		try {
			await fetch(sessionAction, { method: 'POST', body, credentials: 'same-origin', keepalive: true });
		} catch {
			// Advisory sessions expire server-side if release cannot be delivered.
		}
	}

	async function acquireMemberSession(dialog) {
		const sessionAction = dialog instanceof HTMLElement ? dialog.dataset.memberSessionAction || '' : '';
		const membershipId = dialog instanceof HTMLElement ? dialog.dataset.memberId || '' : '';
		if (!sessionAction || !membershipId) return;
		setMemberError(dialog, '');
		setMemberLockNotice(dialog, 'Checking edit availability...');
		setMemberEditState(dialog, 'checking');
		setMemberSession(dialog, '');
		updateMemberSaveState(dialog);
		const body = new FormData();
		body.set('membership_id', membershipId);
		body.set('session_action', 'start');
		try {
			const response = await fetch(sessionAction, { method: 'POST', body, credentials: 'same-origin' });
			const payload = await response.json();
			if (!response.ok) throw new Error(payload?.message || 'Member edit availability could not be checked.');
			if (payload.session_id) setMemberSession(dialog, payload.session_id);
			if (payload.can_edit) {
				setMemberEditState(dialog, payload.session_id ? 'editable' : 'unavailable');
				setMemberLockNotice(dialog, payload.session_id
					? payload.message || 'You can edit this member role.'
					: 'An edit session could not be started. Close and reopen this member before saving.');
			} else {
				setMemberEditState(dialog, 'locked');
				setMemberSession(dialog, '');
				setMemberLockNotice(dialog, payload.message || 'This member is read-only.');
			}
		} catch (error) {
			setMemberEditState(dialog, 'unavailable');
			setMemberSession(dialog, '');
			setMemberLockNotice(dialog, '');
			setMemberError(dialog, error instanceof Error ? error.message : 'Member edit availability could not be checked.');
		} finally {
			updateMemberSaveState(dialog);
		}
	}

	function closeMemberDialog(dialog, options = {}) {
		if (!(dialog instanceof HTMLDialogElement)) return;
		if (!options.force && memberDialogDirty(dialog)) {
			const discard = window.confirm('Discard the unsaved role change?');
			if (!discard) return;
			resetMemberRoleSelection(dialog);
		}
		releaseMemberSession(dialog);
		dialog.close();
	}

	document.querySelectorAll('[data-workspace-team-member-open]').forEach((trigger) => {
		trigger.addEventListener('click', (event) => {
			event.preventDefault();
			const dialogId = trigger.getAttribute('data-workspace-team-member-open');
			const dialog = dialogId ? document.getElementById(dialogId) : null;
			if (!(dialog instanceof HTMLDialogElement)) return;
			lastTriggerByDialog.set(dialog, trigger);
			if (!dialog.open) dialog.showModal();
			const focusTarget = dialog.querySelector('[data-workspace-team-dialog-focus], [data-member-role-select], button');
			if (focusTarget instanceof HTMLElement) focusTarget.focus();
			acquireMemberSession(dialog);
		});
	});

	document.querySelectorAll('[data-workspace-team-export-dialog], [data-workspace-team-import-dialog], [data-workspace-team-checkout-release-dialog], [data-workspace-team-review-dialog], [data-workspace-team-application-dialog], [data-workspace-team-invitation-dialog], [data-workspace-team-member-dialog]').forEach((dialog) => {
		if (!(dialog instanceof HTMLDialogElement)) return;
		dialog.addEventListener('close', () => {
			const trigger = lastTriggerByDialog.get(dialog);
			if (trigger instanceof HTMLElement) trigger.focus();
		});
		dialog.addEventListener('keydown', (event) => {
			if (event.key !== 'Tab') return;
			const focusable = Array.from(dialog.querySelectorAll('a[href], button:not([disabled]), input:not([disabled]), textarea:not([disabled]), select:not([disabled]), [tabindex]:not([tabindex="-1"])'))
				.filter((element) => element instanceof HTMLElement && !element.hidden);
			const first = focusable[0];
			const last = focusable[focusable.length - 1];
			if (!(first instanceof HTMLElement) || !(last instanceof HTMLElement)) return;
			if (event.shiftKey && document.activeElement === first) {
				event.preventDefault();
				last.focus();
			} else if (!event.shiftKey && document.activeElement === last) {
				event.preventDefault();
				first.focus();
			}
		});
		dialog.querySelectorAll('[data-workspace-team-dialog-cancel]').forEach((button) => {
			button.addEventListener('click', () => dialog.close());
		});
	});

	document.querySelectorAll('[data-workspace-team-member-dialog]').forEach((dialog) => {
		if (!(dialog instanceof HTMLDialogElement)) return;
		dialog.addEventListener('cancel', (event) => {
			event.preventDefault();
			closeMemberDialog(dialog);
		});
		dialog.querySelectorAll('[data-workspace-team-member-close], [data-workspace-team-member-cancel]').forEach((button) => {
			button.addEventListener('click', () => closeMemberDialog(dialog));
		});
		const select = dialog.querySelector('[data-member-role-select]');
		if (select instanceof HTMLSelectElement) {
			const onRoleChange = () => {
				setMemberError(dialog, '');
				updateMemberSaveState(dialog);
			};
			select.addEventListener('input', onRoleChange);
			select.addEventListener('change', onRoleChange);
			select.disabled = true;
		} else {
			setMemberEditState(dialog, 'readonly');
		}
		const form = dialog.querySelector('[data-workspace-team-member-role-form]');
		if (form instanceof HTMLFormElement) {
			form.addEventListener('submit', async (event) => {
				event.preventDefault();
				const submitButton = event.submitter instanceof HTMLButtonElement
					? event.submitter
					: form.querySelector('[data-member-save]');
				if (submitButton?.disabled) return;
				setMemberError(dialog, '');
				if (submitButton instanceof HTMLButtonElement) {
					submitButton.disabled = true;
					submitButton.dataset.originalText = submitButton.textContent || '';
					submitButton.textContent = 'Saving...';
				}
				try {
					const response = await fetch(form.action, {
						method: 'POST',
						body: new FormData(form),
						credentials: 'same-origin',
						headers: { accept: 'application/json' },
					});
					const payload = await response.json();
					if (!response.ok || !payload.success) {
						throw new Error(payload.message || 'The role change could not be saved. No membership changes were applied.');
					}
					setMemberSession(dialog, '');
					dialog.close('saved');
					window.setTimeout(() => window.location.reload(), 250);
				} catch (error) {
					setMemberError(dialog, error instanceof Error ? error.message : 'The role change could not be saved. No membership changes were applied.');
					updateMemberSaveState(dialog);
				} finally {
					if (submitButton instanceof HTMLButtonElement) {
						submitButton.textContent = submitButton.dataset.originalText || 'Save';
						delete submitButton.dataset.originalText;
						updateMemberSaveState(dialog);
					}
				}
			});
		}
		updateMemberSaveState(dialog);
	});

	function setupReviewModal(dialog) {
		if (!(dialog instanceof HTMLDialogElement)) return;
		const rows = Array.from(dialog.querySelectorAll('[data-review-row]'));
		const selectableSwitches = () => Array.from(dialog.querySelectorAll('[data-review-switch]')).filter((input) => input instanceof HTMLInputElement);
		const selectedCountTarget = dialog.querySelector('[data-review-selected-count]');
		const excludedCountTarget = dialog.querySelector('[data-review-excluded-count]');
		const liveTarget = dialog.querySelector('[data-review-live-count]');
		const footerCount = dialog.querySelector('[data-review-footer-count]');
		const acceptButton = dialog.querySelector('[data-review-accept]');
		const confirmButton = dialog.querySelector('[data-review-confirm]');
		const backButton = dialog.querySelector('[data-review-back]');
		const list = dialog.querySelector('[data-review-list]');
		const confirmation = dialog.querySelector('[data-review-confirmation]');
		const confirmSelected = dialog.querySelector('[data-review-confirm-selected]');
		const confirmExcluded = dialog.querySelector('[data-review-confirm-excluded]');
		const search = dialog.querySelector('[data-review-search]');
		const form = dialog.querySelector('[data-workspace-team-review-form]');
		const draftAction = form instanceof HTMLFormElement ? form.dataset.workspaceTeamReviewDraftAction || '' : '';
		const saveTimers = new WeakMap();
		const pendingSaves = new Set();
		const failedSaves = new Set();

		function counts() {
			const switches = selectableSwitches();
			const selected = switches.filter((input) => input.checked).length;
			return { selected, excluded: switches.length - selected };
		}

		function rowSaveState(row) {
			return row instanceof HTMLElement ? row.querySelector('[data-review-save-state]') : null;
		}

		function rowDraftReason(row) {
			const input = row instanceof HTMLElement ? row.querySelector('[data-review-draft-reason]') : null;
			return input instanceof HTMLTextAreaElement ? input.value : '';
		}

		function setSaveState(row, state, message) {
			const target = rowSaveState(row);
			if (!(target instanceof HTMLElement)) return;
			target.textContent = message;
			target.dataset.reviewSaveState = state;
		}

		async function saveDraft(row) {
			if (!draftAction || !(row instanceof HTMLElement)) return;
			const input = row.querySelector('[data-review-switch]');
			if (!(input instanceof HTMLInputElement)) return;
			pendingSaves.add(row);
			failedSaves['delete'](row);
			setSaveState(row, 'saving', 'Saving...');
			const body = new FormData();
			body.set('import_row_id', input.value);
			body.set('review_selected', input.checked ? 'true' : 'false');
			body.set('review_draft_reason', rowDraftReason(row));
			try {
				const response = await fetch(draftAction, {
					method: 'POST',
					body,
					credentials: 'same-origin',
				});
				if (!response.ok) throw new Error('Draft review choice could not be saved.');
				setSaveState(row, 'saved', 'Saved');
			} catch {
				failedSaves.add(row);
				setSaveState(row, 'error', 'Save failed. Try again before confirming.');
			} finally {
				pendingSaves['delete'](row);
				updateCounts();
			}
		}

		function scheduleDraftSave(row, delay = 0) {
			if (!(row instanceof HTMLElement)) return;
			const existingTimer = saveTimers.get(row);
			if (existingTimer) window.clearTimeout(existingTimer);
			const timer = window.setTimeout(() => {
				saveTimers['delete'](row);
				saveDraft(row);
			}, delay);
			saveTimers.set(row, timer);
			setSaveState(row, 'queued', 'Saving...');
		}

		function updateCounts() {
			const { selected, excluded } = counts();
			const label = `${selected} selected · ${excluded} excluded`;
			if (selectedCountTarget) selectedCountTarget.textContent = String(selected);
			if (excludedCountTarget) excludedCountTarget.textContent = String(excluded);
			if (liveTarget) liveTarget.textContent = label;
			if (footerCount) footerCount.textContent = label;
			if (confirmSelected) confirmSelected.textContent = String(selected);
			if (confirmExcluded) confirmExcluded.textContent = String(excluded);
			if (acceptButton instanceof HTMLButtonElement) {
				acceptButton.disabled = selected === 0;
				acceptButton.textContent = `Accept ${selected} selected ${selected === 1 ? 'change' : 'changes'}`;
			}
			if (confirmButton instanceof HTMLButtonElement) confirmButton.disabled = selected === 0;
			if (confirmButton instanceof HTMLButtonElement && (pendingSaves.size > 0 || failedSaves.size > 0)) confirmButton.disabled = true;
			selectableSwitches().forEach((input) => {
				input.closest('[data-review-row]')?.classList.toggle('workspace-team-review-row--excluded', !input.checked);
			});
		}

		function setConfirming(confirming) {
			if (list instanceof HTMLElement) list.hidden = confirming;
			if (confirmation instanceof HTMLElement) confirmation.hidden = !confirming;
			if (acceptButton instanceof HTMLButtonElement) acceptButton.hidden = confirming;
			if (confirmButton instanceof HTMLButtonElement) confirmButton.hidden = !confirming;
			if (backButton instanceof HTMLButtonElement) backButton.hidden = !confirming;
			updateCounts();
			const focusTarget = confirming ? confirmButton : search;
			if (focusTarget instanceof HTMLElement) focusTarget.focus();
		}

		selectableSwitches().forEach((input) => input.addEventListener('change', () => {
			updateCounts();
			scheduleDraftSave(input.closest('[data-review-row]'));
		}));
		dialog.querySelectorAll('[data-review-draft-reason]').forEach((input) => {
			if (!(input instanceof HTMLTextAreaElement)) return;
			input.addEventListener('input', () => scheduleDraftSave(input.closest('[data-review-row]'), 650));
		});
		dialog.querySelector('[data-review-select-all]')?.addEventListener('click', () => {
			selectableSwitches().forEach((input) => {
				input.checked = true;
				scheduleDraftSave(input.closest('[data-review-row]'));
			});
			updateCounts();
		});
		dialog.querySelector('[data-review-clear-all]')?.addEventListener('click', () => {
			selectableSwitches().forEach((input) => {
				input.checked = false;
				scheduleDraftSave(input.closest('[data-review-row]'));
			});
			updateCounts();
		});
		if (acceptButton instanceof HTMLButtonElement) acceptButton.addEventListener('click', () => setConfirming(true));
		if (backButton instanceof HTMLButtonElement) backButton.addEventListener('click', () => setConfirming(false));
		if (form instanceof HTMLFormElement) {
			form.addEventListener('submit', (event) => {
				if (pendingSaves.size === 0 && failedSaves.size === 0) return;
				event.preventDefault();
				if (failedSaves.size > 0) {
					const firstFailed = Array.from(failedSaves)[0];
					if (firstFailed instanceof HTMLElement) firstFailed.scrollIntoView({ block: 'center' });
				}
				updateCounts();
			});
		}
		if (search instanceof HTMLInputElement) {
			search.addEventListener('input', () => {
				const query = search.value.trim().toLowerCase();
				rows.forEach((row) => {
					if (!(row instanceof HTMLElement)) return;
					row.hidden = Boolean(query) && !String(row.dataset.reviewSearchText || '').includes(query);
				});
			});
		}
		dialog.addEventListener('close', () => setConfirming(false));
		updateCounts();
	}

	setupReviewModal(document.querySelector('[data-workspace-team-review-dialog]'));

	document.querySelectorAll('[data-workspace-team-checkout-release-form]').forEach((form) => {
		if (!(form instanceof HTMLFormElement)) return;
		form.addEventListener('submit', (event) => {
			const submitButton = event.submitter instanceof HTMLButtonElement
				? event.submitter
				: form.querySelector('button[type="submit"]');
			if (submitButton?.disabled) {
				event.preventDefault();
				return;
			}
			if (submitButton instanceof HTMLButtonElement) {
				submitButton.disabled = true;
				submitButton.dataset.originalText = submitButton.textContent || '';
				submitButton.textContent = 'Undoing...';
			}
		});
	});

	document.querySelectorAll('[data-workspace-team-application-form]').forEach((form) => {
		if (!(form instanceof HTMLFormElement)) return;
		form.addEventListener('submit', (event) => {
			const submitButton = event.submitter instanceof HTMLButtonElement
				? event.submitter
				: form.querySelector('button[type="submit"]');
			if (submitButton?.disabled) {
				event.preventDefault();
				return;
			}
			if (submitButton instanceof HTMLButtonElement) {
				submitButton.disabled = true;
				submitButton.dataset.originalText = submitButton.textContent || '';
				submitButton.textContent = 'Applying...';
			}
		});
	});

	document.querySelectorAll('[data-workspace-team-import-file]').forEach((input) => {
		if (!(input instanceof HTMLInputElement)) return;
		input.addEventListener('change', () => {
			const selected = input.files?.[0]?.name || 'No file selected.';
			const message = input.closest('form')?.querySelector('[data-workspace-team-import-selected]');
			if (message instanceof HTMLElement) message.textContent = selected;
		});
	});

	function exportFilenameFromResponse(response) {
		const disposition = response.headers.get('content-disposition') || '';
		const utf8Match = disposition.match(/filename\*=UTF-8''([^;]+)/i);
		if (utf8Match?.[1]) return decodeURIComponent(utf8Match[1]);
		const quotedMatch = disposition.match(/filename="([^"]+)"/i);
		if (quotedMatch?.[1]) return quotedMatch[1];
		const plainMatch = disposition.match(/filename=([^;]+)/i);
		return plainMatch?.[1]?.trim() || 'watchtower-workspace-team.csv';
	}

	function setExportMessage(form, message) {
		const dialog = form.closest('dialog');
		const messageTarget = dialog?.querySelector('[data-workspace-team-export-message]')
			|| document.querySelector('[data-workspace-team-export-page-message]');
		if (!(messageTarget instanceof HTMLElement)) return;
		messageTarget.textContent = message;
		messageTarget.hidden = !message;
	}

	function downloadBlob(blob, filename) {
		const objectUrl = URL.createObjectURL(blob);
		const link = document.createElement('a');
		link.href = objectUrl;
		link.download = filename;
		document.body.append(link);
		link.click();
		link.remove();
		window.setTimeout(() => URL.revokeObjectURL(objectUrl), 1000);
	}

	document.querySelectorAll('[data-workspace-team-export-download-form]').forEach((form) => {
		if (!(form instanceof HTMLFormElement)) return;
		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			const submitButton = event.submitter instanceof HTMLButtonElement
				? event.submitter
				: form.querySelector('button[type="submit"]');
			if (submitButton?.disabled) return;

			setExportMessage(form, '');
			if (submitButton instanceof HTMLButtonElement) {
				submitButton.disabled = true;
				submitButton.dataset.originalText = submitButton.textContent || '';
				submitButton.textContent = 'Preparing CSV...';
			}

			try {
				const formData = new FormData(form);
				const response = await fetch(form.action, {
					method: 'POST',
					body: formData,
					credentials: 'same-origin',
				});

				if (!response.ok) {
					const failureText = await response.text();
					throw new Error(failureText || 'Workspace Team CSV export could not be downloaded.');
				}

				const blob = await response.blob();
				downloadBlob(blob, exportFilenameFromResponse(response));
				const dialog = form.closest('dialog');
				if (dialog instanceof HTMLDialogElement) dialog.close('downloaded');

				if (formData.get('export_mode') === 'editable') {
					window.setTimeout(() => window.location.reload(), 350);
				}
			} catch (error) {
				const message = error instanceof Error && error.message
					? error.message
					: 'Workspace Team CSV export could not be downloaded.';
				setExportMessage(form, message);
			} finally {
				if (submitButton instanceof HTMLButtonElement) {
					submitButton.disabled = false;
					submitButton.textContent = submitButton.dataset.originalText || 'Download CSV';
					delete submitButton.dataset.originalText;
				}
			}
		});
	});
</script>

