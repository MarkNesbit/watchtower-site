---
import AuthenticatedLayout from '../../../layouts/AuthenticatedLayout.astro';
---
<AuthenticatedLayout title="Projects | WatchTower">
	<section class="content-card" data-projects-page>
		<div class="app-page-header">
			<div>
				<p class="eyebrow">Projects</p>
				<h1>Projects</h1>
				<p data-workspace-message>Loading your current workspace…</p>
			</div>
			<a class="button button--primary" href="/app/projects/new">Create Project</a>
		</div>
		<div data-projects-content></div>
	</section>
</AuthenticatedLayout>
<script>
	import { supabase } from '../../../lib/supabaseClient';
	import { getCurrentWorkspace } from '../../../lib/projects';

	const message = document.querySelector('[data-workspace-message]');
	const content = document.querySelector('[data-projects-content]');

	function appendCell(row, value) {
		const cell = document.createElement('td');
		cell.textContent = value;
		row.append(cell);
		return cell;
	}

	const workspace = await getCurrentWorkspace();
	const organisation = Array.isArray(workspace?.organisations) ? workspace?.organisations[0] : workspace?.organisations;

	if (!workspace || !organisation) {
		if (message) message.textContent = 'No active workspace is available for your account.';
		if (content) content.replaceChildren();
	} else {
		if (message) message.textContent = `Current workspace: ${organisation.name}`;
		const { data: projects, error } = await supabase
			.from('projects')
			.select('id, name, status, health, updated_at')
			.eq('organisation_id', organisation.id)
			.is('deleted_at', null)
			.is('archived_at', null)
			.order('updated_at', { ascending: false });

		if (content && error) {
			content.textContent = `Unable to load projects: ${error.message}`;
		} else if (content && (!projects || projects.length === 0)) {
			const empty = document.createElement('p');
			empty.append('No projects yet. ');
			const link = document.createElement('a');
			link.href = '/app/projects/new';
			link.textContent = 'Create the first project';
			empty.append(link, '.');
			content.replaceChildren(empty);
		} else if (content && projects) {
			const table = document.createElement('table');
			table.className = 'simple-table';
			const thead = document.createElement('thead');
			const headerRow = document.createElement('tr');
			for (const heading of ['Name', 'Status', 'Health', 'Last updated']) {
				const cell = document.createElement('th');
				cell.textContent = heading;
				headerRow.append(cell);
			}
			thead.append(headerRow);
			const tbody = document.createElement('tbody');
			for (const project of projects) {
				const row = document.createElement('tr');
				const nameCell = document.createElement('td');
				const link = document.createElement('a');
				link.href = `/app/projects/${project.id}`;
				link.textContent = project.name;
				nameCell.append(link);
				row.append(nameCell);
				appendCell(row, project.status);
				appendCell(row, project.health);
				appendCell(row, new Date(project.updated_at).toLocaleString());
				tbody.append(row);
			}
			table.append(thead, tbody);
			content.replaceChildren(table);
		}
	}
</script>
