---
import AuthenticatedLayout from '../../../layouts/AuthenticatedLayout.astro';
import DisabledActionHint from '../../../components/app/DisabledActionHint.astro';
import EmptyState from '../../../components/app/EmptyState.astro';
import ProjectContentPanel from '../../../components/app/ProjectContentPanel.astro';
import RagReferencePill from '../../../components/app/RagReferencePill.astro';
import { getFeatureAccess, loadFeatureAccess } from '../../../lib/featureFlags';
import { can } from '../../../lib/permissions';
import { deriveProjectActionStatesByProject, projectActionStateLabel } from '../../../lib/projectAttention';
import { buildProjectDateCards } from '../../../lib/projectDates';
import { buildProjectPath, getCurrentWorkspace } from '../../../lib/projects';
import { createSupabaseServerClient, getServerAccessToken } from '../../../lib/supabaseServer';

const accessToken = getServerAccessToken(Astro.cookies);
let workspaceMessage = 'No active workspace is available for your account.';
let loadError = '';
let projects = [];
let workspaceSlug = '';
let workspaceName = '';
let canCreateProject = false;
let createProjectRestriction = 'Select an active workspace before creating a project.';
let projectActionStates = new Map<string, 'red' | 'amber' | 'green' | 'unknown' | 'neutral'>();
let riskFeatureAccess = getFeatureAccess('riskManagement');

try {
	const serverSupabase = createSupabaseServerClient(accessToken);
	const workspace = await getCurrentWorkspace(serverSupabase, accessToken);
	const organisation = Array.isArray(workspace?.organisations) ? workspace?.organisations[0] : workspace?.organisations;
	if (workspace && organisation) {
		workspaceSlug = organisation.slug;
		workspaceName = organisation.name;
		workspaceMessage = `Projects in ${organisation.name}.`;
		canCreateProject = can(workspace.role, 'project.create');
		createProjectRestriction = 'Your workspace role does not permit project creation.';
		if (canCreateProject && workspace.role === 'member') {
			const { data: settings, error: settingsError } = await serverSupabase
				.from('organisation_settings')
				.select('allow_member_project_creation')
				.eq('organisation_id', organisation.id)
				.maybeSingle();
			if (settingsError) throw settingsError;
			canCreateProject = Boolean(settings?.allow_member_project_creation);
			createProjectRestriction = 'Members cannot create projects in this workspace.';
		}
		riskFeatureAccess = await loadFeatureAccess(serverSupabase, 'riskManagement', accessToken);
		const { data, error } = await serverSupabase
			.from('projects')
			.select('id, name, project_ref, slug, status, health, description, project_type, delivery_method, priority, criticality, start_date, target_end_date, next_review_date, review_cadence, governance_route, escalation_route, updated_at')
			.eq('organisation_id', organisation.id)
			.is('deleted_at', null)
			.is('archived_at', null)
			.order('updated_at', { ascending: false });
		if (error) throw error;
		projects = data ?? [];
		const projectIds = projects.map((project) => project.id).filter(Boolean);
		if (projectIds.length > 0) {
			const [{ data: projectDates, error: projectDatesError }, { data: projectPeople, error: projectPeopleError }, risksResult] = await Promise.all([
				serverSupabase
					.from('project_dates')
					.select('id, project_id, date_type, custom_label, target_date, warning_days, is_key_date, removed_at')
					.eq('organisation_id', organisation.id)
					.in('project_id', projectIds),
				serverSupabase
					.from('project_people')
					.select('project_id, project_role, user_id, demo_person_id, status')
					.eq('organisation_id', organisation.id)
					.in('project_id', projectIds)
					.eq('status', 'active'),
				riskFeatureAccess.isAccessible && can(workspace.role, 'risk.view')
					? serverSupabase
						.from('project_risks')
						.select('project_id, risk_ref, title, status, owner_id, actioner_id, review_date, due_date, mitigation_plan, contingency_plan, probability, impact, updated_at')
						.eq('organisation_id', organisation.id)
						.in('project_id', projectIds)
						.is('deleted_at', null)
						.is('archived_at', null)
					: Promise.resolve({ data: [], error: null }),
			]);
			const projectDatesByProjectId = new Map();
			for (const projectDate of projectDates ?? []) {
				const bucket = projectDatesByProjectId.get(projectDate.project_id) ?? [];
				bucket.push(projectDate);
				projectDatesByProjectId.set(projectDate.project_id, bucket);
			}
			const projectPeopleByProjectId = new Map();
			for (const person of projectPeople ?? []) {
				const bucket = projectPeopleByProjectId.get(person.project_id) ?? [];
				bucket.push(person);
				projectPeopleByProjectId.set(person.project_id, bucket);
			}
			const risksByProjectId = new Map();
			for (const risk of risksResult.data ?? []) {
				const bucket = risksByProjectId.get(risk.project_id) ?? [];
				bucket.push(risk);
				risksByProjectId.set(risk.project_id, bucket);
			}
			const factsByProjectId = new Map(projects.map((project) => [
				project.id,
				{
					project,
					projectDateCards: projectDatesError ? null : buildProjectDateCards(projectDatesByProjectId.get(project.id) ?? [], project, new Date()),
					projectPeople: projectPeopleError ? null : projectPeopleByProjectId.get(project.id) ?? [],
					risks: risksResult.error ? null : risksByProjectId.get(project.id) ?? [],
				},
			]));
			projectActionStates = deriveProjectActionStatesByProject(projectIds, factsByProjectId, new Date());
		} else {
			projectActionStates = deriveProjectActionStatesByProject(projectIds, null);
		}
	}
} catch (error) {
	loadError = error instanceof Error ? error.message : 'Unable to load projects.';
}

const formatDate = (value) => value
	? new Intl.DateTimeFormat('en-GB', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'UTC' }).format(new Date(value))
	: 'Not available';
const formatLabel = (value, fallback = 'Not available') => value ? value.charAt(0).toUpperCase() + value.slice(1) : fallback;
const projectHealthLabel = 'Unknown';
---
<AuthenticatedLayout title="Projects | WatchTower">
	<section class="projects-page" data-projects-page>
		<div class="projects-page__header" aria-labelledby="projects-page-heading">
			<div>
				<p class="eyebrow">Projects</p>
				<h1 id="projects-page-heading">Projects</h1>
				<p>{workspaceMessage} View and open projects in the current workspace.</p>
			</div>
			{workspaceName && <RagReferencePill tone="blue" label={workspaceName} ariaLabel={`Current workspace: ${workspaceName}`} />}
		</div>

		<ProjectContentPanel
			title="Project list"
			helper="Open a project dashboard or review its current action state."
			headingId="project-list-heading"
		>
			<div slot="action" class="projects-page__action">
				{canCreateProject ? (
					<a class="button button--primary" href="/app/projects/new">New project</a>
				) : (
					<>
						<span class="button button--primary projects-page__disabled-action" aria-disabled="true" aria-describedby="create-project-restriction">New project</span>
						<DisabledActionHint
							id="create-project-restriction"
							allowed={false}
							allowedText=""
							disabledText={createProjectRestriction}
						/>
					</>
				)}
			</div>

			{loadError ? (
				<EmptyState title="Projects could not be loaded." tone="error" data-projects-list-error role="alert">
					<p>{loadError}</p>
					<p>Refresh the page, or check that your workspace access is still active.</p>
				</EmptyState>
			) : projects.length === 0 ? (
				<EmptyState title="No projects yet." data-projects-empty-state>
					<p>This workspace does not have any active projects yet.</p>
					<p>{canCreateProject ? 'Create the first project when there is delivery work to track.' : createProjectRestriction}</p>
				</EmptyState>
			) : (
				<div class="projects-table-scroll">
					<table class="simple-table projects-table">
						<thead>
							<tr><th scope="col">Action state</th><th scope="col">Project</th><th scope="col">Status</th><th scope="col">Health</th><th scope="col">Last updated</th></tr>
						</thead>
						<tbody>
							{projects.map((project) => (
								<tr>
									<td>
										<RagReferencePill
											tone={projectActionStates.get(project.id) ?? 'unknown'}
											label={project.project_ref ?? 'Not assigned'}
											statusLabel={projectActionStateLabel(projectActionStates.get(project.id) ?? 'unknown')}
											ariaLabel={`Project ${project.project_ref ?? 'not assigned'} action state: ${projectActionStateLabel(projectActionStates.get(project.id) ?? 'unknown')}`}
										/>
									</td>
									<td class="projects-table__name"><a href={buildProjectPath(workspaceSlug, project.slug)} aria-label={`Open ${project.name}`}>{project.name}</a></td>
									<td><span class="projects-table__status">{formatLabel(project.status, 'Unknown')}</span></td>
									<td>
										<RagReferencePill
											tone="unknown"
											label={projectHealthLabel}
										/>
									</td>
									<td><time datetime={project.updated_at}>{formatDate(project.updated_at)}</time></td>
								</tr>
							))}
						</tbody>
					</table>
				</div>
			)}
		</ProjectContentPanel>
	</section>
</AuthenticatedLayout>

<style>
	.projects-page {
		display: grid;
		gap: 0.9rem;
	}

	.projects-page__header {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1rem;
		border: 1px solid var(--border);
		border-radius: 1.35rem;
		padding: clamp(1rem, 2vw, 1.5rem);
		background: linear-gradient(135deg, rgba(5, 14, 25, 0.95), rgba(4, 12, 24, 0.74));
		box-shadow: 0 18px 50px rgba(0, 0, 0, 0.24);
	}

	.projects-page__header h1 {
		margin-bottom: 0.35rem;
		font-size: clamp(2rem, 4vw, 3.3rem);
	}

	.projects-page__header p:not(.eyebrow) {
		max-width: 50rem;
		margin: 0;
		color: var(--muted-strong);
	}

	.projects-page :global(#project-list-heading) {
		font-size: clamp(1.45rem, 2.4vw, 2rem);
	}

	.projects-page__action {
		display: contents;
	}

	.projects-page__disabled-action {
		opacity: 0.68;
		cursor: not-allowed;
	}

	.projects-table-scroll {
		overflow-x: auto;
	}

	.projects-table {
		min-width: 45rem;
	}

	.projects-table th:first-child {
		width: 12rem;
	}

	.projects-table th:nth-child(3),
	.projects-table th:nth-child(4) {
		width: 9rem;
	}

	.projects-table th:nth-child(5) {
		width: 13rem;
	}

	.projects-table th {
		color: var(--muted-strong);
		font-size: 0.78rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.projects-table td {
		vertical-align: middle;
	}

	.projects-table__name {
		min-width: 14rem;
		font-weight: 850;
	}

	.projects-table__name a {
		color: var(--accent-strong);
		text-decoration: underline;
		text-decoration-color: color-mix(in srgb, var(--accent) 48%, transparent);
		text-underline-offset: 0.18em;
	}

	.projects-table__name a:hover,
	.projects-table__name a:focus-visible {
		color: var(--accent-strong);
		text-decoration-color: var(--accent-strong);
	}

	.projects-table__name a:focus-visible {
		border-radius: 0.2rem;
		outline: 3px solid var(--accent-strong);
		outline-offset: 3px;
	}

	.projects-table__status {
		color: var(--muted-strong);
		font-weight: 800;
	}

	.projects-table time {
		color: var(--muted-strong);
	}

	@media (max-width: 760px) {
		.projects-page__header {
			display: grid;
		}
	}
</style>
