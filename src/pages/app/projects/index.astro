---
import AuthenticatedLayout from '../../../layouts/AuthenticatedLayout.astro';
import { getCurrentWorkspace } from '../../../lib/projects';
import { createSupabaseServerClient, getServerAccessToken } from '../../../lib/supabaseServer';

const accessToken = getServerAccessToken(Astro.cookies);
let workspaceMessage = 'No active workspace is available for your account.';
let loadError = '';
let projects = [];

try {
	const serverSupabase = createSupabaseServerClient(accessToken);
	const workspace = await getCurrentWorkspace(serverSupabase, accessToken);
	const organisation = Array.isArray(workspace?.organisations) ? workspace?.organisations[0] : workspace?.organisations;
	if (workspace && organisation) {
		workspaceMessage = `Current workspace: ${organisation.name}`;
		const { data, error } = await serverSupabase
			.from('projects')
			.select('name, project_ref, slug, status, health, updated_at')
			.eq('organisation_id', organisation.id)
			.is('deleted_at', null)
			.is('archived_at', null)
			.order('updated_at', { ascending: false });
		if (error) throw error;
		projects = data ?? [];
	}
} catch (error) {
	loadError = error instanceof Error ? error.message : 'Unable to load projects.';
}
---
<AuthenticatedLayout title="Projects | WatchTower">
	<section class="content-card" data-projects-page>
		<div class="app-page-header">
			<div>
				<p class="eyebrow">Projects</p>
				<h1>Projects</h1>
				<p>{workspaceMessage}</p>
			</div>
			<a class="button button--primary" href="/app/projects/new">Create Project</a>
		</div>
		{loadError ? (
			<p>{loadError}</p>
		) : projects.length === 0 ? (
			<p>No projects yet. <a href="/app/projects/new">Create the first project</a>.</p>
		) : (
			<table class="simple-table">
				<thead>
					<tr><th>Reference</th><th>Name</th><th>Status</th><th>Health</th><th>Last updated</th></tr>
				</thead>
				<tbody>
					{projects.map((project) => (
						<tr>
							<td>{project.project_ref ?? 'Not assigned'}</td>
							<td><a href={`/app/projects/${project.slug}`}>{project.name}</a></td>
							<td>{project.status}</td>
							<td>{project.health}</td>
							<td>{new Date(project.updated_at).toLocaleString()}</td>
						</tr>
					))}
				</tbody>
			</table>
		)}
	</section>
</AuthenticatedLayout>
