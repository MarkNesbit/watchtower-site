---
import AuthenticatedLayout from '../../../layouts/AuthenticatedLayout.astro';
import { createProject, PROJECT_STATUSES } from '../../../lib/projects';
import { createSupabaseServerClient, getServerAccessToken } from '../../../lib/supabaseServer';

let message = '';
const accessToken = getServerAccessToken(Astro.cookies);

if (Astro.request.method === 'POST') {
	const formData = await Astro.request.formData();
	const serverSupabase = createSupabaseServerClient(accessToken);
	try {
		const project = await createProject(
			{
				name: String(formData.get('name') ?? ''),
				description: String(formData.get('description') ?? ''),
				status: String(formData.get('status') ?? 'proposed'),
			},
			serverSupabase,
			accessToken,
		);
		return Astro.redirect(`/app/projects/${project.slug}`);
	} catch (error) {
		message = error instanceof Error ? error.message : 'Unable to create project.';
	}
}
---
<AuthenticatedLayout title="Create Project | WatchTower">
	<section class="content-card">
		<p class="eyebrow">Projects</p>
		<h1>Create Project</h1>
		<form class="auth-card" method="post">
			<label>Name <input name="name" required autocomplete="off" /></label>
			<label>Description <textarea name="description" rows="4"></textarea></label>
			<label>Status
				<select name="status">
					{PROJECT_STATUSES.map((status) => <option value={status} selected={status === 'proposed'}>{status}</option>)}
				</select>
			</label>
			<button class="button button--primary" type="submit">Create Project</button>
			<p class="form-message">{message}</p>
		</form>
	</section>
</AuthenticatedLayout>
