---
import AuthenticatedLayout from '../../../layouts/AuthenticatedLayout.astro';
import { buildProjectPath, buildUniqueProjectRef, createProject, getCurrentWorkspace, PROJECT_STATUSES, suggestProjectRef } from '../../../lib/projects';
import { createSupabaseServerClient, getServerAccessToken } from '../../../lib/supabaseServer';

let message = '';
let projectRefValue = '';
let nameValue = '';
let descriptionValue = '';
let statusValue = 'proposed';
let existingProjectRefs = [];
const accessToken = getServerAccessToken(Astro.cookies);
const serverSupabase = createSupabaseServerClient(accessToken);

try {
	const workspace = await getCurrentWorkspace(serverSupabase, accessToken);
	const organisation = Array.isArray(workspace?.organisations) ? workspace?.organisations[0] : workspace?.organisations;
	if (workspace && organisation) {
		const { data, error } = await serverSupabase
			.from('projects')
			.select('project_ref')
			.eq('organisation_id', organisation.id)
			.not('project_ref', 'is', null);
		if (error) throw error;
		existingProjectRefs = (data ?? []).map((project) => project.project_ref).filter(Boolean);
	}
} catch (error) {
	message = error instanceof Error ? error.message : 'Unable to prepare project reference suggestions.';
}

if (Astro.request.method === 'POST') {
	const formData = await Astro.request.formData();
	nameValue = String(formData.get('name') ?? '');
	descriptionValue = String(formData.get('description') ?? '');
	statusValue = String(formData.get('status') ?? 'proposed');
	projectRefValue = buildUniqueProjectRef(suggestProjectRef(nameValue), existingProjectRefs);
	try {
		const project = await createProject(
			{
				name: nameValue,
				description: descriptionValue,
				status: statusValue,
			},
			serverSupabase,
			accessToken,
		);
		return Astro.redirect(buildProjectPath(project.workspaceSlug, project.slug));
	} catch (error) {
		message = error instanceof Error ? error.message : 'Unable to create project.';
	}
}
---
<AuthenticatedLayout title="Create Project | WatchTower">
	<section class="content-card">
		<p class="eyebrow">Projects</p>
		<h1>Create Project</h1>
		<form class="auth-card" method="post">
			<label>Name <input name="name" value={nameValue} required autocomplete="off" data-project-name /></label>
			<div class="generated-project-reference">
				<span id="project-reference-label">Project reference</span>
				<output
					data-project-reference
					aria-labelledby="project-reference-label"
					aria-describedby="project-reference-help"
					aria-live="polite"
				>{projectRefValue || 'Enter a project name to preview'}</output>
			</div>
			<p class="form-help" id="project-reference-help">Watchtower will assign this fixed project reference when the project is created. It is used in records such as Risk-HHH-003 and cannot be edited afterwards in MVP.</p>
			<label>Description <textarea name="description" rows="4">{descriptionValue}</textarea></label>
			<label>Status
				<select name="status">
					{PROJECT_STATUSES.map((status) => <option value={status} selected={status === statusValue}>{status}</option>)}
				</select>
			</label>
			<button class="button button--primary" type="submit">Create Project</button>
			<p class="form-message">{message}</p>
		</form>
	</section>
	<script define:vars={{ existingProjectRefs }}>
		const genericTerms = new Set(['CRM','APP','WEB','API','MVP','CMS','ERP','INT','MIG','SUPPORT','DISCOVERY','PORTAL','WEBSITE','REBUILD','MIGRATION','INTEGRATION','PLATFORM','PROJECT','PROGRAMME','PHASE']);
		const existingRefs = new Set(existingProjectRefs.map((value) => String(value).trim().toUpperCase()));
		const nameInput = document.querySelector('[data-project-name]');
		const referenceOutput = document.querySelector('[data-project-reference]');
		function suggest(name) {
			const words = name.normalize('NFKD').replace(/[\u0300-\u036f]/g, '').toUpperCase().replace(/[^A-Z0-9]+/g, ' ').trim().split(/\s+/).filter(Boolean);
			const firstDistinctiveIndex = words.findIndex((word) => !genericTerms.has(word) && /^[A-Z]/.test(word));
			const acronymWords = firstDistinctiveIndex >= 0 ? words.slice(firstDistinctiveIndex).filter((word) => /^[A-Z]/.test(word)) : [];
			if (acronymWords.length >= 3) return acronymWords.slice(0, 4).map((word) => word[0]).join('').slice(0, 4);
			const distinctive = words.filter((word) => !genericTerms.has(word));
			const source = (distinctive.length ? distinctive : words).filter((word) => /^[A-Z]/.test(word));
			if (source.length === 2) return `${source[0][0]}${source[1][0]}${source[1][1] || source[0][1] || 'X'}`.slice(0, 4);
			if (!source[0] || !/^[A-Z]/.test(source[0])) return 'PRJ';
			return source[0].slice(0, 4).padEnd(3, source[0][0]);
		}
		function unique(preferred) {
			const normalised = preferred.trim().toUpperCase();
			const base = /^[A-Z][A-Z0-9]{2,3}$/.test(normalised) ? normalised : 'PRJ';
			if (/^[A-Z][A-Z0-9]{2,3}$/.test(base) && !existingRefs.has(base)) return base;
			for (let suffix = 1; suffix <= 999; suffix += 1) {
				const suffixText = String(suffix);
				const candidate = `${base.slice(0, 4 - suffixText.length)}${suffixText}`;
				if (/^[A-Z][A-Z0-9]{2,3}$/.test(candidate) && !existingRefs.has(candidate)) return candidate;
			}
			return base;
		}
		nameInput?.addEventListener('input', () => {
			if (referenceOutput) referenceOutput.textContent = nameInput.value.trim() ? unique(suggest(nameInput.value)) : 'Enter a project name to preview';
		});
	</script>
</AuthenticatedLayout>

<style>
	.generated-project-reference {
		display: grid;
		gap: 0.45rem;
	}

	.generated-project-reference > span {
		font-weight: 800;
	}

	.generated-project-reference output {
		width: fit-content;
		min-width: 4.75rem;
		border: 1px solid var(--border);
		border-radius: 0.7rem;
		padding: 0.65rem 0.8rem;
		background: rgba(4, 12, 24, 0.48);
		color: var(--accent-strong);
		font-weight: 900;
		letter-spacing: 0.08em;
	}
</style>
