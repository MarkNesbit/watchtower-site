---
import AuthenticatedLayout from '../../../../layouts/AuthenticatedLayout.astro';
import { buildProjectRisksPath, getAccessibleProjectsBySlug } from '../../../../lib/projects';
import { createSupabaseServerClient, getServerAccessToken } from '../../../../lib/supabaseServer';

const projectSlug = Astro.params.projectId;
const accessToken = getServerAccessToken(Astro.cookies);
let projects = [];
let message = '';

try {
	const serverSupabase = createSupabaseServerClient(accessToken);
	projects = projectSlug
		? await getAccessibleProjectsBySlug(serverSupabase, projectSlug, accessToken)
		: [];

	if (projects.length === 1) {
		return Astro.redirect(buildProjectRisksPath(projects[0].workspace.slug, projects[0].slug));
	}
	if (projects.length === 0) {
		message = 'Project not found or you do not have access.';
		Astro.response.status = 404;
	} else {
		message = 'This risk link matches projects in more than one workspace. Choose the workspace you intended.';
		Astro.response.status = 409;
	}
} catch {
	message = 'Unable to resolve project.';
	Astro.response.status = 500;
}
---
<AuthenticatedLayout title="Choose project workspace | WatchTower">
	<section class="content-card" data-legacy-project-risks-route>
		<p class="eyebrow">Project risk link</p>
		<h1>{projects.length > 1 ? 'Choose a workspace' : 'Project unavailable'}</h1>
		<p>{message}</p>
		{projects.length > 1 && (
			<ul>
				{projects.map((project) => (
					<li>
						<a href={buildProjectRisksPath(project.workspace.slug, project.slug)}>
							{project.name} — {project.workspace.name}
						</a>
					</li>
				))}
			</ul>
		)}
		<a class="button button--secondary" href="/app/projects">Back to projects</a>
	</section>
</AuthenticatedLayout>
