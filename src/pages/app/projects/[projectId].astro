---
import AuthenticatedLayout from '../../../layouts/AuthenticatedLayout.astro';
const projectId = Astro.params.projectId;
---
<AuthenticatedLayout title="Project | WatchTower">
	<section class="content-card" data-project-detail data-project-id={projectId ?? ''}>
		<p class="eyebrow">Project</p>
		<div data-project-content>Loading project…</div>
	</section>
</AuthenticatedLayout>
<script define:vars={{ projectId: projectId ?? '' }}>
	import { supabase } from '../../../lib/supabaseClient';
	import { getCurrentWorkspace } from '../../../lib/projects';
	const content = document.querySelector('[data-project-content]');
	const workspace = await getCurrentWorkspace();
	const organisation = Array.isArray(workspace?.organisations) ? workspace?.organisations[0] : workspace?.organisations;
	const { data: project, error } = organisation
		? await supabase
			.from('projects')
			.select('name, description, status, health, created_at, updated_at')
			.eq('id', projectId)
			.eq('organisation_id', organisation.id)
			.maybeSingle()
		: { data: null, error: null };

	if (content && !organisation) {
		content.textContent = 'No active workspace is available for your account.';
	} else if (content && error) {
		content.textContent = `Unable to load project: ${error.message}`;
	} else if (content && !project) {
		content.textContent = 'Project not found or you do not have access.';
	} else if (content && project) {
		const comingSoon = ['Risks', 'Issues', 'Decisions', 'Actions', 'Timeline', 'Forecasting'];
		content.innerHTML = `<h1>${project.name}</h1><p>${project.description ?? 'No description provided.'}</p><dl><dt>Status</dt><dd>${project.status}</dd><dt>Health</dt><dd>${project.health}</dd><dt>Created</dt><dd>${new Date(project.created_at).toLocaleString()}</dd><dt>Last updated</dt><dd>${new Date(project.updated_at).toLocaleString()}</dd></dl><div class="placeholder-grid">${comingSoon.map((title) => `<section class="content-card"><h2>${title}</h2><p>Coming soon</p></section>`).join('')}</div>`;
	}
</script>
