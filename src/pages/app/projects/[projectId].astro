---
import AuthenticatedLayout from '../../../layouts/AuthenticatedLayout.astro';
import { can } from '../../../lib/permissions';
import { getCurrentWorkspace } from '../../../lib/projects';
import { createSupabaseServerClient, getServerAccessToken } from '../../../lib/supabaseServer';

const projectSlug = Astro.params.projectId;
const accessToken = getServerAccessToken(Astro.cookies);
let project = null;
let workspaceName = '';
let canEditProject = false;
let message = '';
let creatorDisplayName = '';

const formatDate = (value) => value ? new Date(value).toLocaleString() : 'Not available';
const formatValue = (value, fallback = 'Not available') => value || fallback;

try {
	const serverSupabase = createSupabaseServerClient(accessToken);
	const workspace = await getCurrentWorkspace(serverSupabase, accessToken);
	const organisation = Array.isArray(workspace?.organisations) ? workspace?.organisations[0] : workspace?.organisations;
	if (!workspace || !organisation) {
		message = 'No active workspace is available for your account.';
	} else {
		workspaceName = organisation.name;
		canEditProject = can(workspace.role, 'project.editDetails');
		const { data, error } = await serverSupabase
			.from('projects')
			.select('name, description, slug, status, health, created_at, updated_at, created_by')
			.eq('slug', projectSlug)
			.eq('organisation_id', organisation.id)
			.is('deleted_at', null)
			.is('archived_at', null)
			.maybeSingle();
		if (error) throw error;
		project = data;
		if (!project) {
			message = 'Project not found or you do not have access.';
		} else if (project.created_by) {
			const { data: creator, error: creatorError } = await serverSupabase
				.from('profiles')
				.select('display_name, email')
				.eq('id', project.created_by)
				.maybeSingle();
			if (!creatorError && creator) creatorDisplayName = creator.display_name || creator.email || '';
		}
	}
} catch (error) {
	message = error instanceof Error ? error.message : 'Unable to load project.';
}
---
<AuthenticatedLayout title={project ? `${project.name} | WatchTower` : 'Project | WatchTower'}>
	<section class="content-card" data-project-dashboard>
		<div class="app-page-header">
			<div>
				<p class="eyebrow">Project dashboard</p>
				{project ? <h1>{project.name}</h1> : <h1>Project unavailable</h1>}
				{workspaceName && <p>Workspace: {workspaceName}</p>}
			</div>
			<a class="button" href="/app/projects">Back to projects</a>
		</div>
		{project ? (
			<>
				<section class="content-card" aria-labelledby="project-details-heading">
					<p class="eyebrow">Read-only metadata</p>
					<h2 id="project-details-heading">Project details</h2>
					<dl>
						<dt>Project name</dt><dd>{formatValue(project.name)}</dd>
						<dt>Description</dt><dd>{formatValue(project.description)}</dd>
						<dt>Status</dt><dd>{formatValue(project.status, 'Unknown')}</dd>
						<dt>Health</dt><dd>{formatValue(project.health, 'Not assessed')}</dd>
						<dt>Workspace</dt><dd>{formatValue(workspaceName)}</dd>
						<dt>Created</dt><dd>{formatDate(project.created_at)}</dd>
						<dt>Last updated</dt><dd>{formatDate(project.updated_at)}</dd>
						<dt>Created by</dt><dd>{formatValue(creatorDisplayName)}</dd>
					</dl>
				</section>

				<section class="content-card" aria-labelledby="project-actions-heading">
					<p class="eyebrow">Project actions</p>
					<h2 id="project-actions-heading">Actions</h2>
					{canEditProject ? (
						<a class="button button--primary" href={`/app/projects/${project.slug}/edit`}>Edit project details</a>
					) : (
						<div data-disabled-edit-action>
							<span class="button" aria-disabled="true">Edit project details</span>
							<p>You do not have permission to edit project details.</p>
						</div>
					)}
				</section>
			</>
		) : (
			<p>{message}</p>
		)}
	</section>
</AuthenticatedLayout>
