---
import AuthenticatedLayout from '../../../layouts/AuthenticatedLayout.astro';
import { getInternalRoleSimulationState, roleLabel, type RoleSimulationState } from '../../../lib/internalTesting';
import { createSupabaseServerClient, getServerAccessToken } from '../../../lib/supabaseServer';

const accessToken = getServerAccessToken(Astro.cookies);
let state: RoleSimulationState | null = null;
let loadError = '';

if (accessToken) {
	try {
		const serverSupabase = createSupabaseServerClient(accessToken);
		state = await getInternalRoleSimulationState(serverSupabase, accessToken);
	} catch (error) {
		loadError = error instanceof Error ? error.message : 'Unable to load account tools.';
	}
}
---
<AuthenticatedLayout title="Account | WatchTower">
	<section class="content-card account-page">
		<p class="eyebrow">Account</p>
		<h1>Account</h1>
		<p>Manage account-level options available to your signed-in profile.</p>

		{loadError && <p class="form-message" role="alert">{loadError}</p>}

		<div class="account-tool-list" data-account-tools>
			{state?.isInternalTester && state?.workspace ? (
				<a class="account-tool-list__item" href="/app/account/test-tools" data-test-tools-link>
					<span>
						<strong>Test tools</strong>
						<small>Role simulation for {state.workspace.name}. Effective role: {roleLabel(state.effectiveRole)}.</small>
					</span>
					<span class="text-link">Open</span>
				</a>
			) : (
				<p data-no-test-tools>There are no account tools available for this profile.</p>
			)}
		</div>
	</section>
</AuthenticatedLayout>

<style>
	.account-page {
		display: grid;
		gap: 1rem;
	}

	.account-page h1 {
		font-size: clamp(2.25rem, 5vw, 4rem);
	}

	.account-tool-list {
		display: grid;
		gap: 0.85rem;
		max-width: 44rem;
	}

	.account-tool-list__item {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		border: 1px solid var(--border);
		border-radius: 0.5rem;
		padding: 1rem;
		background: rgba(18, 31, 42, 0.72);
		text-decoration: none;
	}

	.account-tool-list__item span:first-child {
		display: grid;
		gap: 0.15rem;
	}

	.account-tool-list__item small {
		color: var(--muted);
		font-weight: 700;
	}
</style>
