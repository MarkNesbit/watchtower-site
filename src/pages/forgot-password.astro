---
import { env } from 'cloudflare:workers';
import ForgotPasswordForm from '../components/auth/ForgotPasswordForm.astro';
import AuthLayout from '../layouts/AuthLayout.astro';
import {
	PASSWORD_RESET_PUBLIC_CONFIRMATION,
	buildPasswordResetCompletionUrl,
	passwordResetEmailConfigDiagnostics,
	sendPasswordResetEmail,
	validateSupabaseRecoveryActionLink,
	type PasswordResetDeliveryEnv,
} from '../lib/passwordResetDelivery';
import {
	isPasswordResetRateLimited,
	passwordResetAuditPayload,
	passwordResetDiagnostic,
	passwordResetRateLimitKey,
	resolvePasswordResetLoginName,
	type PasswordResetResolutionResult,
} from '../lib/passwordResetLoginName';
import { createSupabaseAdminClient } from '../lib/supabaseServer';

type RuntimeEnv = Record<string, unknown>;
type SupabaseError = {
	code?: string | null;
	message?: string | null;
};

function safeLogMessage(error: unknown, fallback = 'Password reset request failed') {
	const supabaseError = error as SupabaseError;
	const message = error instanceof Error ? error.message : supabaseError?.message ?? fallback;
	return String(message)
		.replace(/https?:\/\/\S+/gi, '[redacted-link]')
		.replace(/[^\s@]+@[^\s@]+/g, '[redacted-email]')
		.replace(/\beyJ[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\b/g, '[redacted-token]')
		.replace(/re_[a-z0-9_-]+/gi, '[redacted-secret]')
		.replace(/\b(?:token|password|authorization|secret|key)\b/gi, '[redacted]')
		.slice(0, 240) || fallback;
}

function logPasswordReset(eventName: string, details: Record<string, unknown>) {
	console.info(eventName, {
		routeName: 'forgot_password',
		...details,
	});
}

async function recordPasswordResetAudit(adminSupabase, resolution: PasswordResetResolutionResult, outcome: string, deliveryPath?: string) {
	if (!('profileId' in resolution) || !resolution.profileId) return;
	const { error } = await adminSupabase.from('audit_log').insert({
		organisation_id: null,
		actor_user_id: resolution.status === 'resolved' ? resolution.authUserId : null,
		action: 'user.password_reset_requested',
		entity_type: 'profile',
		entity_id: resolution.profileId,
		new_values: passwordResetAuditPayload({
			outcome,
			deliveryPath,
			activeMembershipCount: 'activeMembershipCount' in resolution ? resolution.activeMembershipCount ?? null : null,
		}),
	});
	if (error) {
		logPasswordReset('password_reset_audit_failed', {
			classifiedOutcome: 'failed',
			safeErrorCode: error.code ?? null,
			safeErrorMessage: safeLogMessage(error),
		});
	}
}

const noStoreHeaders = {
	'Cache-Control': 'private, no-store, no-cache, must-revalidate',
	Pragma: 'no-cache',
	Expires: '0',
};
for (const [header, value] of Object.entries(noStoreHeaders)) {
	Astro.response.headers.set(header, value);
}

let message = '';

if (Astro.request.method === 'POST') {
	message = PASSWORD_RESET_PUBLIC_CONFIRMATION;
	const formData = await Astro.request.formData();
	const loginName = String(formData.get('loginName') ?? '');
	const runtimeEnv = env as RuntimeEnv;

	try {
		const throttleKey = await passwordResetRateLimitKey(loginName, Astro.request);
		if (isPasswordResetRateLimited(throttleKey)) {
			logPasswordReset('password_reset_login_resolution_failed', {
				classifiedOutcome: 'throttled',
			});
		} else {
			const adminSupabase = createSupabaseAdminClient(runtimeEnv);
			const resolution = await resolvePasswordResetLoginName(adminSupabase, loginName);
			if (resolution.status !== 'resolved') {
				logPasswordReset('password_reset_login_resolution_failed', {
					...passwordResetDiagnostic(resolution),
					classifiedOutcome: resolution.status,
				});
				await recordPasswordResetAudit(adminSupabase, resolution, resolution.status);
			} else {
				const resetRedirectTo = buildPasswordResetCompletionUrl(runtimeEnv as PasswordResetDeliveryEnv);
				if (!resetRedirectTo) {
					logPasswordReset('password_reset_delivery_failed', {
						classifiedOutcome: 'provider_failure',
						failureStage: 'redirect_origin',
						deliveryPath: 'watchtower_resend_contact_email',
						...passwordResetEmailConfigDiagnostics(runtimeEnv as PasswordResetDeliveryEnv),
					});
					await recordPasswordResetAudit(adminSupabase, resolution, 'provider_failure', 'watchtower_resend_contact_email');
				} else {
					logPasswordReset('password_reset_delivery_requested', {
						classifiedOutcome: 'requested',
						deliveryPath: 'watchtower_resend_contact_email',
						activeMembershipCount: resolution.activeMembershipCount,
					});
					const { data: linkData, error: linkError } = await adminSupabase.auth.admin.generateLink({
						type: 'recovery',
						email: resolution.authEmail,
						options: {
							redirectTo: resetRedirectTo,
						},
					});
					const actionLinkValidation = validateSupabaseRecoveryActionLink(linkData?.properties, runtimeEnv as PasswordResetDeliveryEnv);
					if (linkError || actionLinkValidation.status !== 'valid') {
						if (!linkError && actionLinkValidation.status === 'invalid' && actionLinkValidation.failureCode === 'provider_host_invalid') {
							logPasswordReset('password_reset_provider_origin_mismatch', {
								...actionLinkValidation.diagnostics,
								safeErrorCode: actionLinkValidation.failureCode,
							});
						}
						logPasswordReset('password_reset_delivery_failed', {
							classifiedOutcome: 'provider_failure',
							failureStage: 'generate_link',
							deliveryPath: 'watchtower_resend_contact_email',
							safeErrorCode: linkError?.code ?? (actionLinkValidation.status === 'invalid' ? actionLinkValidation.failureCode : null),
							safeErrorMessage: linkError ? safeLogMessage(linkError) : 'Recovery link could not be validated.',
						});
						await recordPasswordResetAudit(adminSupabase, resolution, 'provider_failure', 'watchtower_resend_contact_email');
					} else {
						const deliveryResult = await sendPasswordResetEmail({
							recipientEmail: resolution.contactEmail,
							actionLink: actionLinkValidation.actionLink,
							env: runtimeEnv as PasswordResetDeliveryEnv,
						});
						if (deliveryResult.status === 'delivered') {
							logPasswordReset('password_reset_delivery_completed', {
								classifiedOutcome: 'success',
								deliveryPath: 'watchtower_resend_contact_email',
							});
							await recordPasswordResetAudit(adminSupabase, resolution, 'success', 'watchtower_resend_contact_email');
						} else {
							logPasswordReset('password_reset_delivery_failed', {
								classifiedOutcome: deliveryResult.failureCode === 'provider_rate_limited' ? 'throttled' : 'provider_failure',
								failureStage: 'send_email',
								deliveryPath: 'watchtower_resend_contact_email',
								safeErrorCode: deliveryResult.failureCode ?? null,
								safeErrorMessage: deliveryResult.failureMessage ? safeLogMessage(deliveryResult.failureMessage) : null,
							});
							await recordPasswordResetAudit(adminSupabase, resolution, deliveryResult.failureCode ?? 'provider_failure', 'watchtower_resend_contact_email');
						}
					}
				}
			}
		}
	} catch (error) {
		logPasswordReset('password_reset_delivery_failed', {
			classifiedOutcome: 'failed',
			failureStage: 'unexpected',
			safeErrorMessage: safeLogMessage(error),
		});
	}
}
---
<AuthLayout title="Forgot password | WatchTower" description="Request a WatchTower password reset link.">
	<ForgotPasswordForm message={message} />
</AuthLayout>
