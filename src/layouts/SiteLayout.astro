---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

type Props = {
	title?: string;
	description?: string;
};

const {
	title = 'WatchTower | Delivery Intelligence Platform',
	description = 'WatchTower is a Delivery Intelligence Platform for evidence-based forecasting and delivery risk clarity.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<a class="skip-link" href="#main-content">Skip to content</a>
		<div class="page-shell">
			<Header />
			<main id="main-content">
				<slot />
			</main>
			<Footer />
		</div>
	</body>
</html>

<style is:global>
	:root {
		color-scheme: light dark;
		--accent: #00a0ff;
		--accent-strong: #39c2ff;
		--navy: #020817;
		--charcoal: #0c141d;
		--charcoal-soft: #111d28;
		--panel: #121f2a;
		--border: rgba(110, 181, 224, 0.22);
		--text: #f4f8fb;
		--muted: #aab8c4;
		--muted-strong: #d7e2ea;
		--light: #f4f7fa;
		--light-panel: #ffffff;
		--light-text: #102033;
		--light-muted: #526173;
		--light-border: #dce6ee;
		--max-width: 1180px;
		font-family:
			Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
	}

	* {
		box-sizing: border-box;
	}

	html {
		background: var(--navy);
		scroll-behavior: smooth;
	}

	body {
		min-width: 320px;
		margin: 0;
		background:
			radial-gradient(circle at 15% 0%, rgba(0, 160, 255, 0.22), transparent 30rem),
			linear-gradient(180deg, #020817 0%, #08111a 46%, #f4f7fa 46%, #eef3f7 100%);
		color: var(--text);
		font-size: 16px;
		line-height: 1.6;
	}

	body::before {
		position: fixed;
		inset: 0;
		z-index: -1;
		background-image:
			linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
			linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
		background-size: 64px 64px;
		content: "";
		mask-image: linear-gradient(to bottom, black, transparent 62%);
	}

	a {
		color: inherit;
	}

	img {
		max-width: 100%;
		height: auto;
	}

	p,
	h1,
	h2,
	h3 {
		margin-top: 0;
	}

	p {
		color: var(--muted);
	}

	h1,
	h2,
	h3 {
		color: inherit;
		line-height: 1.06;
		letter-spacing: -0.045em;
	}

	h1 {
		max-width: 980px;
		font-size: clamp(3rem, 6.4vw, 6.4rem);
	}

	h2 {
		font-size: clamp(2rem, 4vw, 3.6rem);
	}

	h3 {
		font-size: clamp(1.25rem, 2vw, 1.65rem);
	}

	.skip-link {
		position: absolute;
		left: 1rem;
		top: 1rem;
		z-index: 20;
		padding: 0.6rem 0.9rem;
		border-radius: 999px;
		background: var(--accent);
		color: #00111e;
		font-weight: 800;
		transform: translateY(-140%);
	}

	.skip-link:focus {
		transform: translateY(0);
	}

	.page-shell {
		width: min(100% - 2rem, var(--max-width));
		margin-inline: auto;
	}

	.site-header {
		position: sticky;
		top: 1rem;
		z-index: 10;
		display: flex;
		align-items: center;
		gap: 1.25rem;
		margin-top: 1rem;
		padding: 0.85rem 1rem 0.85rem 1.25rem;
		border: 1px solid rgba(124, 199, 244, 0.2);
		border-radius: 1.45rem;
		background: rgba(4, 12, 24, 0.86);
		backdrop-filter: blur(20px);
		box-shadow: 0 18px 56px rgba(0, 0, 0, 0.28);
	}

	.brand {
		display: inline-flex;
		align-items: center;
		justify-content: flex-start;
		flex: 0 0 auto;
	}

	.brand img {
		width: clamp(13rem, 22vw, 18.5rem);
		max-height: 5.4rem;
		object-fit: contain;
		object-position: left center;
	}

	.header-actions {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 0.75rem;
		margin-left: auto;
	}

	.nav,
	.site-footer nav {
		display: flex;
		align-items: center;
		gap: 0.35rem;
		flex-wrap: wrap;
	}

	.nav a,
	.nav__item,
	.site-footer nav a,
	.login-slot {
		border-radius: 999px;
		color: var(--muted-strong);
		font-size: 0.95rem;
		font-weight: 700;
		padding: 0.62rem 0.9rem;
		text-decoration: none;
	}

	.nav a:hover,
	.nav a:focus-visible,
	.nav a[aria-current="page"] {
		background: rgba(0, 160, 255, 0.16);
		color: var(--text);
		outline: none;
	}

	.nav__item--disabled {
		color: rgba(215, 226, 234, 0.48);
		cursor: not-allowed;
	}

	.login-slot {
		min-width: 5.2rem;
		border: 1px solid rgba(0, 160, 255, 0.32);
		color: rgba(215, 226, 234, 0.72);
		text-align: center;
	}

	.login-slot[hidden],
	[hidden] {
		display: none !important;
	}

	.login-slot--button {
		background: transparent;
		font: inherit;
		cursor: pointer;
	}

	.site-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.25rem;
		margin-top: 5rem;
		padding: 2rem 0 3rem;
		border-top: 1px solid rgba(16, 32, 51, 0.16);
		color: var(--light-text);
	}

	.footer-brand {
		color: var(--light-text);
		font-size: 1.1rem;
		font-weight: 850;
		text-decoration: none;
	}

	.site-footer p {
		margin: 0.25rem 0 0;
		color: var(--light-muted);
	}

	.site-footer nav a {
		color: var(--light-muted);
	}

	.section {
		padding-block: clamp(3.5rem, 8vw, 7rem);
	}

	.dark-section,
	.hero,
	.home-hero {
		color: var(--text);
	}

	.hero {
		min-height: 58vh;
		display: grid;
		align-items: center;
		padding-block: clamp(4rem, 8vw, 7rem);
	}

	.hero__content {
		max-width: 920px;
	}

	.hero__text {
		max-width: 780px;
		font-size: clamp(1.2rem, 2vw, 1.65rem);
		color: var(--muted-strong);
		white-space: pre-line;
	}

	.home-hero {
		display: grid;
		grid-template-columns: minmax(0, 1.04fr) minmax(22rem, 0.96fr);
		gap: clamp(2rem, 6vw, 4.5rem);
		align-items: center;
		min-height: 82vh;
		padding-block: clamp(3.5rem, 8vw, 7rem);
	}

	.home-hero__logo {
		display: block;
		width: min(100%, 27rem);
		margin-bottom: 1.2rem;
		filter: drop-shadow(0 20px 40px rgba(0, 160, 255, 0.16));
	}

	.home-hero__text {
		max-width: 760px;
		font-size: clamp(1.2rem, 2vw, 1.6rem);
		color: var(--muted-strong);
	}

	.eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: 1rem;
		color: var(--accent-strong);
		font-size: 0.78rem;
		font-weight: 850;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.eyebrow::before {
		width: 0.55rem;
		height: 0.55rem;
		border-radius: 999px;
		background: var(--accent);
		box-shadow: 0 0 24px rgba(0, 160, 255, 0.72);
		content: "";
	}

	.actions {
		display: flex;
		gap: 1rem;
		flex-wrap: wrap;
		margin-top: 2rem;
	}

	.button,
	.text-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border-radius: 999px;
		font-weight: 850;
		text-decoration: none;
		transition: transform 160ms ease, border-color 160ms ease, background 160ms ease;
	}

	.button {
		min-height: 3.15rem;
		padding: 0.9rem 1.2rem;
	}

	.button:hover,
	.text-link:hover {
		transform: translateY(-1px);
	}

	.button--primary {
		background: var(--accent);
		box-shadow: 0 14px 34px rgba(0, 160, 255, 0.24);
		color: #00111e;
	}

	.button--secondary {
		border: 1px solid rgba(215, 226, 234, 0.24);
		color: var(--text);
	}

	.dashboard-preview {
		position: relative;
		overflow: hidden;
		border: 1px solid rgba(124, 199, 244, 0.22);
		border-radius: 2rem;
		background:
			radial-gradient(circle at 82% 14%, rgba(0, 160, 255, 0.2), transparent 14rem),
			linear-gradient(180deg, rgba(18, 31, 42, 0.92), rgba(8, 17, 27, 0.96));
		box-shadow: 0 28px 100px rgba(0, 0, 0, 0.34);
		padding: clamp(1.2rem, 3vw, 1.65rem);
	}

	.dashboard-preview::before {
		position: absolute;
		inset: 0;
		background-image:
			linear-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 1px),
			linear-gradient(90deg, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
		background-size: 44px 44px;
		content: "";
		mask-image: linear-gradient(to bottom, black, transparent 78%);
		pointer-events: none;
	}

	.dashboard-preview__header,
	.dashboard-preview__grid {
		position: relative;
		z-index: 1;
	}

	.dashboard-preview__header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1rem;
	}

	.dashboard-preview__header div {
		display: flex;
		align-items: center;
		gap: 0.65rem;
	}

	.dashboard-preview__header p {
		margin: 0;
		color: var(--muted-strong);
		font-weight: 800;
	}

	.dashboard-preview__header strong {
		border: 1px solid rgba(0, 160, 255, 0.3);
		border-radius: 999px;
		padding: 0.35rem 0.7rem;
		background: rgba(0, 160, 255, 0.1);
		color: var(--accent-strong);
		font-size: 0.78rem;
	}

	.beacon {
		width: 0.75rem;
		height: 0.75rem;
		border-radius: 999px;
		background: var(--accent);
		box-shadow: 0 0 0 8px rgba(0, 160, 255, 0.08), 0 0 30px rgba(0, 160, 255, 0.82);
	}

	.dashboard-preview__grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.85rem;
	}

	.metric-card {
		min-height: 9.5rem;
		border: 1px solid rgba(124, 199, 244, 0.18);
		border-radius: 1.25rem;
		background: rgba(4, 12, 24, 0.68);
		padding: 1rem;
	}

	.metric-card:first-child {
		grid-column: span 2;
		background: linear-gradient(135deg, rgba(0, 160, 255, 0.18), rgba(4, 12, 24, 0.72));
	}

	.metric-card span {
		color: var(--muted);
		font-size: 0.83rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.metric-card strong {
		display: block;
		margin-top: 0.7rem;
		color: var(--text);
		font-size: clamp(1.6rem, 3vw, 2.35rem);
		line-height: 1;
	}

	.metric-card p {
		margin: 0.75rem 0 0;
	}

	.light-section {
		position: relative;
		width: calc(100% + 4rem);
		margin-left: -2rem;
		padding-inline: 2rem;
		border-radius: 2rem;
		background: var(--light);
		color: var(--light-text);
	}

	.light-section p,
	.light-section .content-card p {
		color: var(--light-muted);
	}

	.light-section .eyebrow {
		color: #0076bd;
	}

	.section-heading {
		max-width: 820px;
		margin-bottom: 2rem;
	}

	.section-heading p:not(.eyebrow) {
		font-size: 1.1rem;
	}

	.panel,
	.product-card,
	.roadmap-card,
	.content-card {
		border: 1px solid var(--border);
		border-radius: 1.35rem;
		background: linear-gradient(180deg, rgba(18, 31, 42, 0.94), rgba(8, 17, 27, 0.96));
		box-shadow: 0 24px 80px rgba(0, 0, 0, 0.16);
	}

	.light-section .content-card,
	.light-section .product-card,
	.light-section .roadmap-card {
		border-color: var(--light-border);
		background: var(--light-panel);
		box-shadow: 0 18px 55px rgba(16, 32, 51, 0.08);
	}

	.grid,
	.product-grid,
	.roadmap-grid,
	.content-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
	}

	.content-grid--two {
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}

	.content-grid--three {
		grid-template-columns: repeat(3, minmax(0, 1fr));
	}

	.product-grid--single {
		grid-template-columns: minmax(0, 42rem);
	}

	.panel,
	.content-card {
		padding: clamp(1.35rem, 3vw, 2rem);
	}

	.content-card strong,
	.panel strong {
		color: inherit;
	}

	.product-card {
		display: flex;
		min-height: 100%;
		flex-direction: column;
		padding: clamp(1.35rem, 3vw, 2rem);
	}

	.product-card--featured {
		border-color: rgba(0, 160, 255, 0.42);
		background: linear-gradient(180deg, rgba(0, 160, 255, 0.14), rgba(8, 17, 27, 0.96));
	}

	.light-section .product-card--featured {
		background: linear-gradient(180deg, rgba(0, 160, 255, 0.08), #ffffff);
	}

	.product-card__topline {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1.5rem;
	}

	.product-card__topline img {
		width: min(100%, 12rem);
		max-height: 4.8rem;
		object-fit: contain;
		object-position: left center;
	}

	.product-card__topline span,
	.product-card strong,
	.roadmap-card span,
	.roadmap-card strong {
		display: inline-flex;
		width: fit-content;
		border: 1px solid rgba(0, 160, 255, 0.3);
		border-radius: 999px;
		padding: 0.3rem 0.65rem;
		background: rgba(0, 160, 255, 0.1);
		color: var(--accent-strong);
		font-size: 0.75rem;
		font-weight: 850;
	}

	.light-section .product-card__topline span,
	.light-section .product-card strong,
	.light-section .roadmap-card span,
	.light-section .roadmap-card strong {
		color: #006fb3;
	}

	.product-card__monogram {
		width: 3.2rem;
		height: 3.2rem;
		align-items: center;
		justify-content: center;
		border-radius: 1rem !important;
		font-size: 1rem !important;
	}

	.product-card__positioning {
		color: var(--muted-strong);
		font-size: clamp(1.05rem, 1.45vw, 1.25rem);
		font-weight: 800;
		line-height: 1.25;
	}

	.light-section .product-card__positioning {
		color: var(--light-text);
	}

	.product-card strong {
		margin: 0.2rem 0 1.35rem;
	}

	.product-card a {
		margin-top: auto;
		color: var(--accent-strong);
		font-weight: 850;
		text-decoration: none;
	}

	.light-section .product-card a {
		color: #006fb3;
	}

	.product-card a:hover,
	.text-link:hover {
		text-decoration: underline;
	}

	.text-link {
		margin-top: 1.5rem;
		color: var(--accent-strong);
	}

	.product-hero {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(12rem, 22rem);
		gap: 2rem;
		align-items: center;
	}

	.product-hero__positioning {
		color: var(--muted-strong);
		font-size: clamp(1.25rem, 2vw, 1.8rem);
		font-weight: 800;
	}

	.product-hero__mark {
		display: grid;
		min-height: 18rem;
		place-items: center;
		border: 1px solid rgba(124, 199, 244, 0.22);
		border-radius: 2rem;
		background: radial-gradient(circle, rgba(0, 160, 255, 0.18), transparent 62%), var(--panel);
	}

	.product-hero__mark img {
		width: min(76%, 17rem);
		max-height: 10rem;
		object-fit: contain;
	}

	.roadmap-grid {
		counter-reset: phase;
	}

	.roadmap-card {
		position: relative;
		padding: 1.35rem;
	}

	.roadmap-card::after {
		position: absolute;
		right: 1.25rem;
		top: 1.25rem;
		color: rgba(0, 160, 255, 0.12);
		font-size: 4rem;
		font-weight: 900;
		line-height: 1;
		counter-increment: phase;
		content: counter(phase);
	}

	.roadmap-card h3 {
		margin-top: 1.75rem;
	}

	.roadmap-card strong {
		margin-top: 1rem;
	}

	.content-card ul {
		margin: 0;
		padding-left: 1.2rem;
		color: var(--muted);
	}

	.light-section .content-card ul {
		color: var(--light-muted);
	}

	.content-card li + li {
		margin-top: 0.55rem;
	}

	@media (max-width: 980px) {
		.site-header {
			align-items: flex-start;
			flex-direction: column;
		}

		.header-actions {
			width: 100%;
			justify-content: space-between;
			margin-left: 0;
		}

		.home-hero,
		.product-hero {
			grid-template-columns: 1fr;
		}

		.dashboard-preview {
			max-width: 42rem;
		}
	}

	@media (max-width: 850px) {
		.page-shell {
			width: min(100% - 1.25rem, var(--max-width));
		}

		.site-footer {
			align-items: flex-start;
			border-radius: 1.25rem;
			flex-direction: column;
		}

		.brand img,
		.home-hero__logo {
			width: min(100%, 18rem);
		}

		.header-actions {
			align-items: flex-start;
			flex-direction: column;
		}

		.login-slot {
			min-width: 6rem;
		}

		.nav a,
		.site-footer nav a {
			padding: 0.5rem 0.7rem;
		}

		.hero,
		.home-hero {
			min-height: auto;
		}

		.grid,
		.product-grid,
		.roadmap-grid,
		.content-grid,
		.content-grid--two,
		.content-grid--three {
			grid-template-columns: 1fr;
		}

		.product-hero__mark {
			min-height: 12rem;
		}

		.light-section {
			width: calc(100% + 1.25rem);
			margin-left: -0.625rem;
			padding-inline: 0.625rem;
		}
	}

	@media (max-width: 560px) {
		h1 {
			font-size: 2.65rem;
		}

		.actions,
		.button {
			width: 100%;
		}

		.dashboard-preview__grid,
		.metric-card:first-child {
			grid-template-columns: 1fr;
			grid-column: auto;
		}

		.product-card__topline {
			align-items: flex-start;
			flex-direction: column;
		}

		.product-card__topline img {
			width: min(100%, 12rem);
		}
	}
	.auth-card textarea,
	.auth-card select {
		width: 100%;
		border: 1px solid var(--border);
		border-radius: 0.85rem;
		padding: 0.85rem 1rem;
		background: #07111d;
		color: var(--text);
		font: inherit;
	}

	.app-page-header {
		display: flex;
		align-items: start;
		justify-content: space-between;
		gap: 1rem;
	}

	.simple-table {
		width: 100%;
		border-collapse: collapse;
	}

	.simple-table th,
	.simple-table td {
		padding: 0.75rem;
		border-bottom: 1px solid var(--border);
		text-align: left;
	}

	.placeholder-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
		gap: 1rem;
		margin-top: 1.5rem;
	}
	.placeholder-card {
		overflow-wrap: anywhere;
	}

	.placeholder-route {
		font-size: 0.8rem;
		line-height: 1.4;
	}

</style>
<style is:global>
	.auth-page {
		display: grid;
		place-items: center;
		min-height: 62vh;
	}

	.auth-card {
		display: grid;
		gap: 1rem;
		width: min(100%, 34rem);
		padding: 2rem;
		border: 1px solid var(--border);
		border-radius: 1.5rem;
