---
import AuthStatus from '../components/auth/AuthStatus.astro';
import SignOutButton from '../components/auth/SignOutButton.astro';
import SiteLayout from './SiteLayout.astro';

type Props = { title?: string; description?: string };
const { title = 'WatchTower App', description = 'Authenticated WatchTower workspace area.' } = Astro.props;
---
<SiteLayout title={title} description={description}>
	<AuthStatus />
	<section class="app-shell section">
		<div class="app-shell__bar">
			<div>
				<p class="eyebrow">Workspace</p>
				<strong>WatchTower</strong>
			</div>
			<SignOutButton />
		</div>
		<slot />
	</section>
</SiteLayout>
