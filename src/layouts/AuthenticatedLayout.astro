---
import AuthStatus from '../components/auth/AuthStatus.astro';
import TestingModeBanner from '../components/app/TestingModeBanner.astro';
import SiteLayout from './SiteLayout.astro';
import { getInternalRoleSimulationState, type RoleSimulationState } from '../lib/internalTesting';
import { createSupabaseServerClient, getServerAccessToken } from '../lib/supabaseServer';
import '../styles/rag.css';

type Props = { title?: string; description?: string; hideAppNavigation?: boolean };
const {
	title = 'WatchTower App',
	description = 'Authenticated WatchTower workspace area.',
	hideAppNavigation = false,
} = Astro.props;
const accessToken = getServerAccessToken(Astro.cookies);
let roleSimulationState: RoleSimulationState | null = null;
let serverSessionConfirmed = false;

if (accessToken) {
	try {
		const serverSupabase = createSupabaseServerClient(accessToken);
		const { data, error } = await serverSupabase.auth.getUser(accessToken);
		serverSessionConfirmed = Boolean(data.user && !error);
		if (serverSessionConfirmed) {
			roleSimulationState = await getInternalRoleSimulationState(serverSupabase, accessToken);
		}
	} catch {
		serverSessionConfirmed = false;
		roleSimulationState = null;
	}
}
---
<SiteLayout title={title} description={description} hideAppNavigation={hideAppNavigation}>
	<AuthStatus />
	<section class="app-shell" data-authenticated-shell data-server-authenticated={serverSessionConfirmed ? 'true' : undefined} hidden>
		<TestingModeBanner state={roleSimulationState} returnTo={Astro.url.pathname + Astro.url.search} />
		<slot />
	</section>
</SiteLayout>
