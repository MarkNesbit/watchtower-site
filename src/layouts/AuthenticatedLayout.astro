---
import AuthStatus from '../components/auth/AuthStatus.astro';
import SiteLayout from './SiteLayout.astro';

type Props = { title?: string; description?: string };
const { title = 'WatchTower App', description = 'Authenticated WatchTower workspace area.' } = Astro.props;
---
<SiteLayout title={title} description={description}>
	<AuthStatus />
	<section class="app-shell" data-authenticated-shell hidden>
		<slot />
	</section>
</SiteLayout>
